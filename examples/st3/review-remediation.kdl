version 2

// Keep remediation reachable when an independent review finds defects.
//
// The reviewer is a mission-scoped seat, so it is independent of the durable worker that fixes the
// findings. The review step completes once its report is stored, even when it found defects. If
// finding a defect failed the review step, the remediation step that depends on it could never
// run. Only the final `release-review` decides whether the result is acceptable.
//
// The reviewer's constraint is written in its agent block, so it binds both review steps and not
// the remediation step, whose worker must change files. A mission-level constraint would bind
// every step.
//
//   st agents apply examples/st3/seats/omp.kdl --as person/operator
//   st missions publish examples/st3/review-remediation.kdl --as person/operator
//   st missions start example/review-remediation --id example/review-remediation/1 \
//     --workspace /srv/example/app --as person/operator

mission "example/review-remediation" state="ready" {
  goal "Review the invented payments module independently, fix what the review finds, and decide whether the result is acceptable."

  agent "reviewer" {
    workspace "${ST_WORKSPACE}/review" create=#true
    harness "codex" {
      model "gpt-6-sol"
      effort "high"
    }
    constraint "Do not change repository files."
  }

  step "report-only-review" timeout="1h" {
    assigned-to "agent/${ST_MISSION_RUN}/reviewer"
    goal "Review the payments module on main. Store the findings with `st documents put` and complete this step with the stored document reference, even when findings exist."
  }

  step "remediate-findings" timeout="2h" {
    assigned-to "agent/example/worker"
    depends-on { step "report-only-review" completed }
    goal "Resolve every finding in the stored report, commit and push the changes, and complete this step with each finding and how it was resolved."
  }

  step "release-review" timeout="1h" {
    assigned-to "agent/${ST_MISSION_RUN}/reviewer"
    depends-on { step "remediate-findings" completed }
    goal "Check each change against its finding on the pushed branch. Complete this step if every finding is resolved; fail it with the unresolved findings otherwise."
  }

  finally {
    step "stop-reviewer" {
      agentless
      stop "agent/${ST_MISSION_RUN}/reviewer"
    }
  }
}
