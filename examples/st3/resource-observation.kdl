version 2

// Observe one local file and gate work on its state. The observer belongs to the run; its facts
// are `status` (`ready`, `missing`, or `unreadable`), `path`, `content_hash`, `size`, and `mode`,
// never the content.
//
//   st apply examples/st3/resource-observation.kdl --as person/operator
//   st missions start example/config-check --id example/config-check/1 \
//     --workspace /srv/example/app --as person/operator

resource "example/config" { kind "filesystem.file" }

mission "example/config-check" state="ready" {
  completion { when "all-steps-exhausted" }
  goal "Observe one local file and verify its current state."

  observer "config" {
    resource "resource/example/config"
    provider "local.file"
    locator "${ST_WORKSPACE}/config.toml"
    field "status"
    field "content_hash"
  }

  step "check" {
    agentless
    gate "the config file is available" {
      field "status" "resource/example/config" is "ready"
    }
  }
}
