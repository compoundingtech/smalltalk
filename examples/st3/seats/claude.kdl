version 2

// A durable Claude Code seat.
//
// A seat is a top-level agent. It has no mission owner, so finishing, revising, or cancelling a
// mission never stops it. Work reaches it as mission steps assigned to its exact subject,
// `agent/example/worker`, and waits in its seat queue.
//
// Every seat file in this directory declares the same `example/worker` seat with a different
// harness, so each mission example works with whichever one you apply. Apply one of them. To run
// several side by side, give each its own identity and change `assigned-to` to match.
//
// Log Claude Code in as the user who runs the st daemon, and replace the workspace with an
// existing checkout on this host. st always loads its native channel into Claude, so do not add
// channel or hook arguments.
//
//   st apply --no-gate-check examples/st3/seats/claude.kdl --as person/operator
//   st agents show agent/example/worker
//   st agents stop agent/example/worker --as person/operator
agent "example/worker" {
  workspace "/srv/example/app"
  restart "always"
  harness "claude" {
    model "claude-sonnet-5"
    effort "medium"
  }
}
