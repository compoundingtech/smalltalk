version 2

// A durable reviewing seat for ../many-to-many.kdl.
//
// It is a seat like the worker seats beside it, with its own identity and its own checkout of the
// invented repository, so it reads a pushed branch without disturbing the worker's checkout.
// Missions give it review steps by assigning them to `agent/example/reviewer`. Apply it with a
// worker seat and seats/planner.kdl:
//
//   st agents apply examples/st3/seats/reviewer.kdl --as person/operator
//   st agents queue agent/example/reviewer
agent "example/reviewer" {
  workspace "/srv/example/reviewer"
  restart "always"
  harness "claude" {
    model "claude-sonnet-5"
    effort "medium"
  }
}
