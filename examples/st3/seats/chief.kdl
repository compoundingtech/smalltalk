version 2

// A durable coordinating seat that may reorder the worker seat's queue.
//
// A seat has no authority over any queue by default, including its own. `queue-authority` lets
// this agent move runs in the queues it names: an exact seat identity or a terminal `/*`
// namespace, without the `agent/` prefix. Only a person can grant it. st refuses a top-level
// declaration that an agent publishes when it carries `queue-authority` or `mission-authority`.
//
// Apply it as a person, after one of the worker seat files beside it:
//
//   st agents apply examples/st3/seats/chief.kdl --as person/operator
//
// The chief then moves a queued run with its own identity, and the move records it as the actor:
//
//   st agents queue move agent/example/worker mission-run/example/release-notes/2026-10-01 \
//     --top --reason "the release needs its notes first" --as agent/example/chief
//
// ../seat-queue.kdl walks through the complete queue.
agent "example/chief" {
  workspace "/srv/example/app"
  restart "always"
  harness "omp" {
    model "openai-codex/gpt-6-astra"
    effort "medium"
  }
  queue-authority {
    move "example/worker"
  }
}
