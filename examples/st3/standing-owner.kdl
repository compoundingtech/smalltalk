version 2

mission "example/repository-owner" state="ready" {
  goal "Keep one repository owner available for current and future mission work."

  agent "owner" {
    identity "repository-owner"
    workspace "."
    render { git-exclude ".st3/" }
    harness "codex" {
      model "gpt-5.6-sol"
      effort "high"
    }
    mission-authority {
      publish "example/repository-owner/*"
      start "example/repository-owner/*"
      revise "example/repository-owner/*"
    }
    restart "always"
  }
}
