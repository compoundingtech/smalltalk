version 2

// Repeat a bounded fix round until the pushed branch passes its tests.
//
// Each round is a fresh child mission with fresh `fix` work for the seat. After a round, the
// `until` gate tests the branch as pushed to origin, using test-pushed-branch.sh, so it never
// passes on uncommitted files in a worker's tree. A failure starts the next round, and
// `${loop.feedback}` tells the worker which gate failed. After five rounds the loop fails.
//
// A gate result is cached by the gate's definition, and an `until` gate belongs to the loop, not
// to one round. The shell comment `# round ${loop.round}` makes each round's command different so
// each round tests again.
//
// The run workspace is a clone of the project with test-pushed-branch.sh copied into it:
//
//   /bin/bash -n examples/st3/test-pushed-branch.sh
//   /bin/cp examples/st3/test-pushed-branch.sh /srv/example/app/
//   st apply --no-gate-check examples/st3/seats/omp.kdl --as person/operator
//   st apply examples/st3/loop-until-green.kdl --as person/operator
//   st missions start example/loop-until-green --id example/loop-until-green/1 \
//     --workspace /srv/example/app --as person/operator --follow
//
// For GitHub checks instead of a local test run, see wait-for-green-checks.kdl.

mission "example/loop-until-green" state="ready" {
  goal "Make the invented parser tests pass on the pushed fix/parser branch, in at most five rounds."

  loop "improve" timeout="5h" {
    max-rounds 5
    until {
      gate "the pushed branch passes its tests" {
        exec "/bin/bash ./test-pushed-branch.sh fix/parser # round ${loop.round}"
        host "local"
        workspace "${ST_WORKSPACE}"
        time-limit "20m"
      }
    }
    round {
      completion { when "all-steps-exhausted" }
      step "fix" timeout="1h" {
        assigned-to "agent/example/worker"
        goal "Fix the failing parser tests in round ${loop.round}, then commit and push the fix/parser branch."
        goal "Read ${loop.feedback} when it is present; it names the gate that failed after the last push."
      }
    }
    on-exhausted {
      fail
      attention "The parser tests still fail after five rounds" {
        reviewer "person/operator"
        severity "error"
      }
    }
  }
}
