version 2

// The finite missions that github-intake.kdl starts, one run for each new pull request or issue.
//
// Publish this file before github-intake.kdl. The intake names these missions and each new
// request starts their current ready revision:
//
//   st apply examples/st3/github-intake-work.kdl --as person/operator
// A later review revision needs only a publish; future requests use it automatically.
//
// Each run receives the discovered item as its `source` input, pinned to the exact discovery
// claim, so later changes to the pull request or issue do not change what the run reviews.
// Results go in the step completion or a stored document, not in a message.

mission "example/app/review-pull-request" state="ready" {
  concurrent-runs max=3
  input "source" kind="resource"
  goal "Review one newly ready pull request and record the review in the graph."

  step "review" timeout="1h" {
    assigned-to "agent/example/worker"
    goal "Review the pull request in ${input.source}: read the diff, run the affected tests, and note every defect with its file and line. Put the checkout in ${ST_WORKSPACE}/checkout, set TMPDIR=${ST_WORKSPACE}/tmp and CARGO_TARGET_DIR=${ST_WORKSPACE}/target, and never use /tmp."
    goal "Store the full review with `st documents put`, and complete this step with a short verdict and the stored document reference."
    constraint "Do not comment on, approve, merge, or push to the pull request."
  }

  finally {
    step "remove-review-files" {
      agentless
      exec "remove-review-files" {
        host "local"
        workspace "${ST_WORKSPACE}"
        command "rm -rf -- checkout tmp target"
        restart "never"
      }
      gate "review files were removed" {
        field "exit_code" "exec/${ST_MISSION_RUN}/remove-review-files" "is" 0
      }
    }
  }
}

mission "example/app/triage-issue" state="ready" {
  concurrent-runs max=3
  input "source" kind="resource"
  goal "Triage one new issue and record the result in the graph."

  step "triage" timeout="45m" {
    assigned-to "agent/example/worker"
    goal "Try to reproduce the issue in ${input.source} on main, and find the code that is most likely responsible."
    goal "Complete this step with whether it reproduced, the exact steps, and the suspected files."
    constraint "Do not comment on, label, or close the issue."
  }
}
