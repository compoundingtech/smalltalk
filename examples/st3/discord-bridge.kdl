version 2

// Invented placement, paths and subjects. Adapt before previewing and applying.
// This is a Python program seat; no model harness or secret value is declared.
agent "example/discord-bridge" {
  name "Discord bridge"
  host "local"
  workspace "/srv/example/smalltalk"
  restart "always"
  tags st3.adapter.source="external/discord/user/404" st3.adapter.target="agent/example/discord-test"
  argv "/usr/bin/python3" "-I" "/srv/example/smalltalk/scripts/st3-discord-bridge" "run" "--agent" "agent/example/discord-test" "--route" "/srv/example/discord/trial.json" "--token-file" "/srv/example/discord/bot.env"
}
