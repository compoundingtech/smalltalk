version 2

// Delegate one step to an inline child mission with its own mission-scoped agent.
//
// The `change` step is assigned to the run's own `owner` agent. Its nested steps inherit that
// selector, and the step completes when they do. `finally` stops the owner whatever the outcome.
//
//   st missions publish examples/st3/nested-mission.kdl --as person/operator
//   st missions start example/nested-change --id example/nested-change/1 \
//     --workspace /srv/example/app --as person/operator

mission "example/nested-change" state="ready" {
  completion { when "all-steps-exhausted" }
  goal "Keep one owner responsible for a complete nested change."

  agent "owner" {
    workspace "."
    harness "codex" { effort "high" }
    restart "always"
  }

  step "change" {
    assigned-to "agent/${ST_MISSION_RUN}/owner"
    goal "Complete the nested implementation mission."

    mission "implementation" {
      completion { when "all-steps-exhausted" }
      goal "Implement and verify one bounded change."
      step "implement" { goal "Implement the requested change with focused tests." }
      step "verify" {
        depends-on { step "implement" completed }
        goal "Run the focused and regression tests."
      }
    }
  }

  finally {
    step "stop-owner" {
      agentless
      stop "agent/${ST_MISSION_RUN}/owner"
    }
  }
}
