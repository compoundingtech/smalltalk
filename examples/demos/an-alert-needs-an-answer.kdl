version 2

// An agent needs a decision only a person can make.
//
// Marrowpine is an invented bookkeeping service. Its migrator finds that a database migration
// will lock the invoices table for about four minutes and raises an alert above Robin's
// message input. Robin answers it there, then types a note to the agent.
//
// Play it (it erases and reseeds the `demo` instance each time, never your own fleet):
//
//   st --instance demo demo play examples/demos/an-alert-needs-an-answer.kdl
//
// Press F8 for each beat without `after`; Ctrl+Q ends the demo. Click the alert to answer it.
// Every name here is invented.

demo "an-alert-needs-an-answer" {
  title "An alert that needs an answer"
  me "robin"
  machine "ledger"
}

seed {
  agent "marrowpine/migrator" { name "Migrator"; }
  agent "marrowpine/oncall" { name "On-call"; }

  mission "marrowpine/invoice-index" state="ready" {
    goal "Add the due-date index to the invoices table without disturbing customers."
    step "migrate" timeout="2h" {
      assigned-to "agent/marrowpine/migrator"
      goal "Write, rehearse and run the due-date index migration."
    }
  }

  say "agent/marrowpine/oncall" ago="50m" "Quiet night: no pages, error rate flat at 0.02%."
  say "agent/marrowpine/migrator" ago="25m" "The due-date index migration is written. Rehearsing it on last night's snapshot next."
  run "marrowpine/invoice-index" id="marrowpine/invoice-index/1"
}

beats {
  open "agent/marrowpine/migrator"
  claim "agent/marrowpine/migrator" after="1s" run="marrowpine/invoice-index/1" step="migrate"
  tool "agent/marrowpine/migrator" after="1s" "Bash" input="./rehearse-migration --snapshot nightly" takes="3s" output="""
    index created in 3m 52s
    invoices table locked for writes the whole time
    """
  say "agent/marrowpine/migrator" after="1s" """
    The rehearsal worked, but the invoices table is **locked for writes for about four minutes**.

    During business hours that blocks anyone saving an invoice. I'll ask Robin before running it.
    """
  progress "agent/marrowpine/migrator" after="0.5s" run="marrowpine/invoice-index/1" step="migrate" "Rehearsed: a 4 minute write lock on invoices. Asking Robin when to run it."
  ask "agent/marrowpine/migrator" after="1.5s" run="marrowpine/invoice-index/1" step="migrate" title="Run the invoice migration now?" why="It locks invoice saving for about four minutes; only you can choose when customers notice." "The due-date index locks the invoices table for about four minutes. Run it now, or tonight at 02:00 when nobody is saving invoices?" {
    answer "tonight" "Tonight at 02:00" then="The migrator schedules it for 02:00 and tells on-call."
    answer "now" "Run it now" outcome="decline" then="The migrator runs it at once; saving invoices waits about four minutes."
  }
  // Robin answers the alert by clicking it, then presses F8.
  focus "agent/marrowpine/oncall"
  say "agent/marrowpine/oncall" after="1s" "Heads up: the invoice migration runs tonight at 02:00. I'll watch the write latency then."
  focus "agent/marrowpine/migrator" after="2s"
  type "Thanks. Post the timing in the morning, please." send=#true
  say "agent/marrowpine/migrator" after="1.5s" "Will do. Scheduled for 02:00; I'll post how long the lock took when it's done."
}
