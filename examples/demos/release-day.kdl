version 2

// Two agents talk while a release mission moves.
//
// Copperwren is an invented weather-station dashboard. Its builder works through the release
// mission's build step while its reviewer reads along; the mission view opens below the
// builder's conversation, and the step moves from ready to claimed to completed on screen.
//
// Play it (it erases and reseeds the `demo` instance each time, never your own fleet):
//
//   st --instance demo demo play examples/demos/release-day.kdl
//
// Press F8 for each beat without `after`; Ctrl+Q ends the demo. Every name here is invented.

demo "release-day" {
  title "Two agents talk while a release mission moves"
  me "robin"
  machine "studio"
}

seed {
  agent "copperwren/builder" { name "Builder"; }
  agent "copperwren/reviewer" { name "Reviewer"; }

  mission "copperwren/release" state="ready" {
    goal "Release Copperwren 2.3 with the new rainfall chart."
    step "build" timeout="1h" {
      assigned-to "agent/copperwren/builder"
      goal "Build the 2.3 release and run the full test suite."
    }
    step "review" timeout="1h" {
      assigned-to "agent/copperwren/reviewer"
      depends-on { step "build" completed }
      goal "Review the rainfall chart change and the release notes."
    }
  }

  say "agent/copperwren/builder" ago="35m" "Morning, Robin. Yesterday's rainfall chart branch is merged; I'll pick up the 2.3 release when it starts."
  say "agent/copperwren/reviewer" ago="30m" "I read the rainfall chart diff last night. Two small notes on the axis labels; I'll raise them in review."
  send from="person/robin" to="agent/copperwren/builder" "Let's ship 2.3 today if the tests are green."
  say "agent/copperwren/builder" ago="12m" "Sounds good. I'll start as soon as the release run is up."
  run "copperwren/release" id="copperwren/release/2-3"
  document "copperwren/release-notes-2-3" file="release-notes-2-3.md"
}

beats {
  // The presenter starts recording, then presses F8.
  open "agent/copperwren/builder"
  claim "agent/copperwren/builder" after="1.5s" run="copperwren/release/2-3" step="build"
  open "mission-run/copperwren/release/2-3" after="1s" split="below" by="agent/copperwren/builder"
  say "agent/copperwren/builder" after="1s" "Picked up the build step for 2.3. Building and running the full suite now."
  tool "agent/copperwren/builder" after="0.5s" "Bash" input="cargo test --workspace" takes="3s" output="test result: ok. 412 passed; 0 failed; 0 ignored"
  progress "agent/copperwren/builder" after="0.5s" run="copperwren/release/2-3" step="build" "412 tests pass; packaging the release build."
  send after="2s" from="agent/copperwren/builder" to="agent/copperwren/reviewer" subject="2.3 is built" "The 2.3 build is green: 412 tests pass. The rainfall chart is behind the new-charts flag, as you asked."
  open "agent/copperwren/reviewer" split="right" by="agent/copperwren/builder"
  say "agent/copperwren/reviewer" after="1.5s" """
    Thanks. Reading the rainfall chart change now.

    The flag is right. One fix before it ships: the y axis says **mm** but the values are inches.
    """
  send after="1.5s" from="agent/copperwren/reviewer" to="agent/copperwren/builder" subject="Axis units" "The rainfall y axis label says mm; the series is inches. Change the label to in, please."
  focus "agent/copperwren/builder"
  say "agent/copperwren/builder" after="1.5s" "Good catch. Fixing the label to **in** and rebuilding."
  tool "agent/copperwren/builder" after="0.5s" "Edit" input="web/charts/rainfall.ts" takes="1.2s" output="1 line changed"
  tool "agent/copperwren/builder" after="0.3s" "Bash" input="cargo test --workspace" takes="2.5s" output="test result: ok. 412 passed; 0 failed; 0 ignored"
  complete "agent/copperwren/builder" after="1s" run="copperwren/release/2-3" step="build" "2.3 built with the axis fix; 412 tests pass."
  claim "agent/copperwren/reviewer" after="1.5s" run="copperwren/release/2-3" step="review"
  say "agent/copperwren/reviewer" after="1s" "The axis now reads in. Reviewing the release notes next."
  open "doc/copperwren/release-notes-2-3" split="right" by="agent/copperwren/reviewer"
}
