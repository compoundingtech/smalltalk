{
  "contract": "st3.client.v0",
  "schema": "./client-v0.schema.json",
  "transport": {
    "local": "unix",
    "remote": "fabric-loopback",
    "public_listener": false,
    "remote_mode": "online-thin-client"
  },
  "streams": [
    { "id": "collections.stream", "method": "GET", "path": "/v1/client/collections/stream", "websocket_protocol": "st3.client.collections.v0", "command": "CollectionCommand", "frame": "CollectionFrame", "max_subscriptions": 8 }
  ],
  "reads": [
    { "id": "host.repositories", "method": "GET", "path": "/v1/client/hosts/{id}/repositories", "response": "HostRepositories", "scope": "read.projections" },
    { "id": "sets.list", "method": "GET", "path": "/v1/client/sets", "response": "Page" },
    { "id": "sets.get", "method": "GET", "path": "/v1/client/sets/{id}", "response": "Resource" },
    { "id": "capabilities.get", "method": "GET", "path": "/v1/client/capabilities", "response": "Capabilities" },
    { "id": "document.get", "method": "GET", "path": "/v1/client/documents/content", "response": "DocumentContent" },
    { "id": "subject.definition", "method": "GET", "path": "/v1/client/subject-definition", "response": "SubjectDefinition" },
    { "id": "usage.period", "method": "GET", "path": "/v1/client/usage", "response": "UsagePeriod" },
    { "id": "now.list", "method": "GET", "path": "/v1/client/now", "response": "Page" },
    { "id": "machines.list", "method": "GET", "path": "/v1/client/machines", "response": "Page" },
    { "id": "devices.list", "method": "GET", "path": "/v1/client/devices", "response": "Page" },
    { "id": "attention.list", "method": "GET", "path": "/v1/client/attention", "response": "Page" },
    { "id": "attention.get", "method": "GET", "path": "/v1/client/attention/{id}", "response": "Resource" },
    { "id": "messages.list", "method": "GET", "path": "/v1/client/messages", "response": "Page" },
    { "id": "messages.get", "method": "GET", "path": "/v1/client/messages/{id}", "response": "Resource" },
    { "id": "launches.list", "method": "GET", "path": "/v1/client/launches", "response": "Page" },
    { "id": "launches.get", "method": "GET", "path": "/v1/client/launches/{id}", "response": "Resource" },
    { "id": "launch-variants.list", "method": "GET", "path": "/v1/client/launches/{id}/variants", "response": "Page" },
    { "id": "launch-decisions.list", "method": "GET", "path": "/v1/client/launches/{id}/decisions", "response": "Page" },
    { "id": "launch-approvals.list", "method": "GET", "path": "/v1/client/launches/{id}/approvals", "response": "Page" },
    { "id": "missions.list", "method": "GET", "path": "/v1/client/missions", "response": "Page" },
    { "id": "missions.get", "method": "GET", "path": "/v1/client/missions/{id}", "response": "Resource" },
    { "id": "work.list", "method": "GET", "path": "/v1/client/work", "response": "Page" },
    { "id": "work.get", "method": "GET", "path": "/v1/client/work/{id}", "response": "Resource" },
    { "id": "resources.list", "method": "GET", "path": "/v1/client/resources", "response": "ResourcesPage" },
    { "id": "agents.list", "method": "GET", "path": "/v1/client/agents", "response": "Page" },
    { "id": "agents.get", "method": "GET", "path": "/v1/client/agents/{id}", "response": "Resource" },
    { "id": "agent-declaration.get", "method": "GET", "path": "/v1/client/agent-declarations/{id}", "response": "AgentDeclaration", "scope": "read.declarations" },
    { "id": "agent-queue.get", "method": "GET", "path": "/v1/client/agent-queues/{id}", "response": "AgentQueue" },
    { "id": "runtimes.list", "method": "GET", "path": "/v1/client/runtimes", "response": "Page" },
    { "id": "runtimes.get", "method": "GET", "path": "/v1/client/runtimes/{id}", "response": "Resource" },
    { "id": "observers.list", "method": "GET", "path": "/v1/client/observers", "response": "Page" },
    { "id": "observers.get", "method": "GET", "path": "/v1/client/observers/{id}", "response": "Resource" },
    { "id": "subscriptions.list", "method": "GET", "path": "/v1/client/subscriptions", "response": "Page" },
    { "id": "subscriptions.get", "method": "GET", "path": "/v1/client/subscriptions/{id}", "response": "Resource" },
    { "id": "lanes.list", "method": "GET", "path": "/v1/client/lanes", "response": "Page" },
    { "id": "lanes.get", "method": "GET", "path": "/v1/client/lanes/{id}", "response": "Resource" },
    { "id": "terminals.list", "method": "GET", "path": "/v1/client/terminals", "response": "Page" },
    { "id": "operations.list", "method": "GET", "path": "/v1/client/operations", "response": "Page" },
    { "id": "operations.get", "method": "GET", "path": "/v1/client/operations/{id}", "response": "Resource" },
    { "id": "history.list", "method": "GET", "path": "/v1/client/history", "response": "Page" },
    { "id": "history.get", "method": "GET", "path": "/v1/client/history/{id}", "response": "Resource" },
    { "id": "sessions.list", "method": "GET", "path": "/v1/client/sessions", "response": "Page" },
    { "id": "sessions.get", "method": "GET", "path": "/v1/client/sessions/{id}", "response": "Resource" },
    { "id": "conversation.search", "method": "GET", "path": "/v1/client/conversations/search", "response": "ConversationSearch" },
    { "id": "timeline.list", "method": "GET", "path": "/v1/client/sessions/{id}/timeline", "response": "TimelinePage" },
    { "id": "conversation.changes", "method": "GET", "path": "/v1/client/conversations/{id}/changes", "response": "ConversationChanges" },
    { "id": "events.list", "method": "GET", "path": "/v1/client/events", "response": "EventPage" },
    { "id": "terminal.screen", "method": "GET", "path": "/v1/client/terminals/{id}/screen", "response": "TerminalScreen" },
    {"id": "arrangements.list", "method": "GET", "path": "/v1/client/arrangements", "response": "ArrangementPage", "scope": "read.arrangements"},
    {"id": "arrangements.get", "method": "GET", "path": "/v1/client/arrangements/{person_name}/{uuid}", "response": "Arrangement", "scope": "read.arrangements"},
    {"id": "glasses.list", "method": "GET", "path": "/v1/client/glasses", "response": "Page", "scope": "read.glasses"},
    {"id": "glasses.get", "method": "GET", "path": "/v1/client/glasses/{id}", "response": "Glass", "scope": "read.glasses"}
  ],
  "commands": [
    { "id": "action.submit", "method": "POST", "path": "/v1/client/actions", "request": "ActionRequest", "response": "ActionResult" },
    { "id": "pairing.begin", "method": "POST", "path": "/v1/client/pairings", "request": "PairingBegin", "response": "PairingChallenge", "local_only": true },
    { "id": "pairing.complete", "method": "POST", "path": "/v1/client/pairings/{id}/complete", "request": "PairingComplete", "response": "PairedSession" },
    { "id": "terminal.stream", "method": "GET", "path": "/v1/client/terminals/{id}/stream", "response": "TerminalScreen", "websocket_protocol": "st3.client.terminal.v0" },
    { "id": "conversation.stream", "method": "GET", "path": "/v1/client/conversations/{id}/stream", "response": "ConversationChanges", "websocket_protocol": "st3.client.conversation.v0" },
    {"id": "glasses.put", "method": "PUT", "path": "/v1/client/glasses/{id}", "request": "GlassPut", "response": "Glass", "scope": "control.glasses", "idempotency_header": "Idempotency-Key"},
    {"id": "glasses.delete", "method": "DELETE", "path": "/v1/client/glasses/{id}", "request": "GlassDelete", "response": "Glass", "scope": "control.glasses", "idempotency_header": "Idempotency-Key"}
  ],
  "actions": {
    "arrangement.edit": { "capability": "control.arrangements", "parameters": "ArrangementEditParameters" },
    "review.approve": { "capability": "control.attention", "parameters": "TargetParameters" },
    "review.reject": { "capability": "control.attention", "parameters": "TargetParameters" },
    "review.request-changes": { "capability": "control.attention", "parameters": "TargetParameters" },
    "attention.resolve": { "capability": "control.attention", "parameters": "AttentionResolveParameters" },
    "message.send": { "capability": "control.messages", "parameters": "MessageSendParameters" },
    "message.read": { "capability": "control.messages", "parameters": "TargetParameters" },
    "message.close": { "capability": "control.messages", "parameters": "TargetParameters" },
    "launch.create": { "capability": "control.launches", "parameters": "LaunchCreateParameters" },
    "launch.revise": { "capability": "control.launches", "parameters": "LaunchReviseParameters" },
    "launch.preview": { "capability": "control.launches", "parameters": "LaunchVariantParameters" },
    "launch.approve": { "capability": "control.launches", "parameters": "LaunchVariantParameters" },
    "launch.cancel": { "capability": "control.launches", "parameters": "TargetParameters" },
    "mission.start": { "capability": "control.missions", "parameters": "MissionStartParameters" },
    "mission.revise": { "capability": "control.missions", "parameters": "MissionReviseParameters" },
    "mission.approve-revision": { "capability": "control.missions", "parameters": "TargetParameters" },
    "mission.cancel-revision": { "capability": "control.missions", "parameters": "TargetParameters" },
    "mission.cancel": { "capability": "control.missions", "parameters": "TargetParameters" },
    "session.import": { "capability": "control.missions", "parameters": "TargetParameters" },
    "work.ask": { "capability": "control.work", "parameters": "PersonAskParameters" },
    "work.done": { "capability": "control.attention", "parameters": "PersonStepParameters" },
    "work.cancel-ask": { "capability": "control.work", "parameters": "PersonStepParameters" },
    "work.claim": { "capability": "control.work", "parameters": "TargetParameters" },
    "work.renew": { "capability": "control.work", "parameters": "TargetParameters" },
    "work.progress": { "capability": "control.work", "parameters": "TargetParameters" },
    "work.complete": { "capability": "control.work", "parameters": "TargetParameters" },
    "work.fail": { "capability": "control.work", "parameters": "TargetParameters" },
    "work.release": { "capability": "control.work", "parameters": "TargetParameters" },
    "work.retry": { "capability": "control.work", "parameters": "WorkRetryParameters" },
    "work.publish-mission": { "capability": "control.work", "parameters": "WorkPublishMissionParameters" },
    "agent.create": { "capability": "control.runtimes", "parameters": "AgentCreateParameters" },
    "agent.stop": { "capability": "control.runtimes", "parameters": "AgentStopParameters" },
    "agent.start": { "capability": "control.runtimes", "parameters": "AgentStartParameters" },
    "agent.suspend": { "capability": "control.runtimes", "parameters": "AgentSuspendParameters" },
    "agent.resume": { "capability": "control.runtimes", "parameters": "AgentResumeParameters" },
    "terminal.create": { "capability": "terminal.control", "parameters": "TerminalCreateParameters" },
    "terminal.end": { "capability": "terminal.control", "parameters": "TargetParameters" },
    "agent.queue-move": { "capability": "control.work", "parameters": "AgentQueueMoveParameters" },
    "lane.join": { "capability": "control.work", "parameters": "LaneChangeParameters" },
    "lane.leave": { "capability": "control.work", "parameters": "LaneChangeParameters" },
    "lane.move": { "capability": "control.work", "parameters": "LaneChangeParameters" },
    "lane.mark": { "capability": "control.work", "parameters": "LaneChangeParameters" },
    "lane.approve": { "capability": "control.work", "parameters": "LaneChangeParameters" },
    "runtime.stop": { "capability": "control.runtimes", "parameters": "TargetParameters" },
    "runtime.restart": { "capability": "control.runtimes", "parameters": "TargetParameters" },
    "runtime.reset": { "capability": "control.runtimes", "parameters": "TargetParameters" },
    "runtime.context-clear": { "capability": "control.runtimes", "parameters": "TargetParameters" },
    "runtime.signal": { "capability": "control.runtimes", "parameters": "RuntimeSignalParameters" },
    "terminal.input": { "capability": "terminal.control", "parameters": "TerminalInputParameters" },
    "terminal.resize": { "capability": "terminal.control", "parameters": "TerminalResizeParameters" },
    "terminal.attach": { "capability": "terminal.read", "parameters": "TargetParameters" },
    "terminal.detach": { "capability": "terminal.read", "parameters": "TargetParameters" },
    "pairing.revoke": { "capability": "control.pairing", "parameters": "TargetParameters" }
  },
  "limits": {
    "default_page_items": 50,
    "max_page_items": 200,
    "max_event_items": 500,
    "max_response_bytes": 1048576,
    "max_wait_ms": 30000,
    "event_retention_seconds": 86400,
    "idempotency_retention_seconds": 2592000,
    "max_arrangement_body_bytes": 1048576,
    "max_arrangement_resource_bytes": 524288,
    "max_arrangements": 100,
    "max_arrangement_name_bytes": 256,
    "max_arrangement_key_bytes": 128,
    "max_arrangement_operations": 1024,
    "max_arrangement_folders": 1024,
    "max_arrangement_placements": 4096,
    "pairing_ttl_seconds": 300
  }
}
