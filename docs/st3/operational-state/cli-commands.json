{
  "contract": "st3.cli-purpose.v0",
  "effective_entry": "Each installed row resolves purpose by purpose_id and inherits conformance; no field is optional.",
  "conformance": ["root-help", "nested-help", "human-output", "json-output", "valid-input", "invalid-input", "empty-state", "composed-filters", "exit-codes", "error-envelope", "documented-examples", "bounded-body", "membership-agreement", "count-agreement"],
  "purpose_fields": ["job", "why", "actor", "mode", "model", "inputs", "defaults", "output", "success", "actions", "authority", "recovery", "human_example", "json_example", "workflow"],
  "purposes": {
    "daemon": { "job": "Run the local control daemon", "why": "Serve local projections and reconciliation", "actor": "operator", "mode": "mutation", "model": "daemon.v0", "inputs": "config and local listeners", "defaults": "Unix socket only", "output": "lifecycle diagnostics", "success": "daemon is ready", "actions": "stop via service manager", "authority": "local operator", "recovery": "doctor then restart", "human_example": "st up", "json_example": "st up --json", "workflow": "operator" },
    "now": { "job": "Understand what needs action now", "why": "One bounded operational sitrep", "actor": "person", "mode": "read", "model": "now.v0", "inputs": "optional filters", "defaults": "actionable only", "output": "Now screen", "success": "fresh bounded snapshot", "actions": "typed model actions", "authority": "session actor", "recovery": "show freshness reason", "human_example": "st now", "json_example": "st now --json", "workflow": "product/now" },
    "usage": { "job": "Review harness token usage across the fleet", "why": "Show attributed token spend by agent, mission, model, and host", "actor": "person or agent", "mode": "read", "model": "usage.v0", "inputs": "period and grouping", "defaults": "all groups for the last 24 hours", "output": "ranked token totals", "success": "bounded fleet rollup", "actions": "inspect agent or mission", "authority": "read scope", "recovery": "show available local rollups", "human_example": "st usage --hours 24", "json_example": "st usage --hours 24 --json", "workflow": "product/usage" },
    "missions": { "job": "Author, inspect, and control missions", "why": "Mission definitions, graph progress, and lifecycle are one workflow", "actor": "person or authorized agent", "mode": "read-or-fenced-mutation", "model": "missions-list.v0 or mission-detail.v0", "inputs": "authored KDL, mission/run ID, and filters", "defaults": "current nonterminal", "output": "publication receipt or mission screen", "success": "the exact KDL is published or membership and action agree", "actions": "publish start revise cancel", "authority": "explicit person or agent mission-authority", "recovery": "correct preview blockers or refresh stale generation", "human_example": "st missions publish missions/demo.kdl --as person/operator", "json_example": "st missions publish missions/demo.kdl --as person/operator --json", "workflow": "product/missions" },
    "launch": { "job": "Author and approve a mission launch", "why": "Expose the human launch workflow, not internal planning", "actor": "person", "mode": "read-or-fenced-mutation", "model": "launch.v0", "inputs": "request launch variant token", "defaults": "current variant", "output": "launch screen", "success": "approved revision or explicit state", "actions": "start revise preview approve cancel", "authority": "named person", "recovery": "refresh stale preview", "human_example": "st launch show launch/demo", "json_example": "st launch show launch/demo --json", "workflow": "product/launch" },
    "attention": { "job": "Review person-authorized items", "why": "Keep decisions and faults in one inbox", "actor": "person", "mode": "read-or-fenced-mutation", "model": "attention.v0", "inputs": "explicit person and optional target", "defaults": "unresolved items for the named person", "output": "attention screen", "success": "item resolved or listed", "actions": "approve reject resolve read", "authority": "explicit named person; never ambient identity", "recovery": "refresh stale item", "human_example": "st attention ls --as person/nathan", "json_example": "st attention ls --as person/nathan --json", "workflow": "product/attention" },
    "machines": { "job": "Assess fleet machines and capacity", "why": "Placement needs health and capacity together", "actor": "person or operator", "mode": "read", "model": "machines.v0", "inputs": "fleet host filters", "defaults": "current configured fleet including failures", "output": "machines screen", "success": "fresh labeled topology", "actions": "open diagnostic or replication", "authority": "read scope", "recovery": "show unreachable reason", "human_example": "st machines", "json_example": "st machines --json", "workflow": "product/machines" },
    "agents": { "job": "Find live agents and typed ownership", "why": "Agent state needs list and detail parity", "actor": "person or agent", "mode": "read", "model": "agents-tree.v0", "inputs": "status and history filters", "defaults": "live actionable agents", "output": "agent list or detail", "success": "filters and enrichment preserve membership", "actions": "open conversation runtime or work", "authority": "read scope", "recovery": "use show --all for history", "human_example": "st agents ls --status running --enrich", "json_example": "st agents ls --status running --enrich --json", "workflow": "product/agents" },
    "conversations": { "job": "Read follow and send conversations", "why": "Messages and sessions form one timeline", "actor": "person or agent", "mode": "read-or-fenced-mutation", "model": "conversations.v0", "inputs": "session or canonical message ID", "defaults": "current sessions", "output": "timeline", "success": "ordered turn or durable message", "actions": "sessions timeline send reply read archive", "authority": "participant scope", "recovery": "resume cursor or resync", "human_example": "st conversations timeline session/abc", "json_example": "st conversations timeline session/abc --json", "workflow": "product/conversations" },
    "activity": { "job": "See changes since a cursor", "why": "Resume bounded typed activity", "actor": "person or agent", "mode": "read", "model": "activity.v0", "inputs": "cursor filters wait", "defaults": "latest bounded page", "output": "activity page", "success": "resume cursor returned", "actions": "open subject follow resync", "authority": "read scope", "recovery": "full resync on gap", "human_example": "st activity --follow", "json_example": "st activity --after CURSOR --json", "workflow": "product/activity" },
    "devices": { "job": "Pair scope and revoke devices", "why": "Remote identity needs explicit person control", "actor": "person", "mode": "read-or-fenced-mutation", "model": "devices.v0", "inputs": "device or pairing code", "defaults": "paired current devices", "output": "device screen", "success": "scoped credential state", "actions": "pair revoke", "authority": "local named person", "recovery": "repeat pairing after expiry", "human_example": "st devices --as person/nathan pair iphone", "json_example": "st devices --as person/nathan --json", "workflow": "product/devices" },
    "work": { "job": "Inspect and report mission work", "why": "Humans and workers need one truthful fenced queue contract", "actor": "person or agent", "mode": "read-or-fenced-mutation", "model": "work.v0", "inputs": "optional explicit agent filter; step generation attempt incarnation for actions", "defaults": "all current actionable work", "output": "work queue/detail with effective filters", "success": "list/detail agree and mutations make one durable fenced transition", "actions": "claim renew progress complete fail release publish-mission", "authority": "read scope or explicit eligible agent lease", "recovery": "refresh stale lease", "human_example": "st work ls", "json_example": "st work ls --json", "workflow": "product/work" },
    "terminals": { "job": "Inspect or control a terminal", "why": "Terminal control needs screen and frame fencing", "actor": "person or agent", "mode": "read-or-fenced-mutation", "model": "terminal.v0", "inputs": "terminal incarnation sequence", "defaults": "read-only attach", "output": "screen or ordered frames", "success": "attached or action accepted", "actions": "ls attach peek send signal", "authority": "terminal scope", "recovery": "resync screen", "human_example": "st terminals attach agent/ID", "json_example": "st terminals peek agent/ID --json", "workflow": "product/terminal" },
    "doctor": { "job": "Diagnose local operational faults", "why": "Give operators actionable health checks", "actor": "operator", "mode": "read", "model": "doctor.v0", "inputs": "optional check filter", "defaults": "all bounded checks", "output": "diagnostic report", "success": "checks and exit code agree", "actions": "open repair or service", "authority": "local operator", "recovery": "follow named remediation", "human_example": "st doctor", "json_example": "st doctor --json", "workflow": "operator" },
    "repair": { "job": "Preview and repair operational contradictions", "why": "Converge legacy or interrupted graph state without rewriting history", "actor": "operator", "mode": "read-or-fenced-mutation", "model": "st3.operational-repair.v0", "inputs": "exact dry-run token", "defaults": "read-only deterministic plan", "output": "affected subjects reasons and receipt", "success": "exact plan applied or zero-change retry", "actions": "dry-run apply", "authority": "closed graph-authorized repair classes", "recovery": "rerun dry-run after a stale token", "human_example": "st repair dry-run", "json_example": "st repair dry-run --json", "workflow": "operator" },
    "replication": { "job": "Inspect and repair fleet convergence", "why": "Keep immutable replication faults explicit", "actor": "operator", "mode": "read-or-repair", "model": "replication.v0", "inputs": "peer record replacement", "defaults": "configured peers", "output": "convergence report", "success": "record inspected or repair appended", "actions": "diff inspect repair", "authority": "operator repair capability", "recovery": "append replacement never delete", "human_example": "st replication status", "json_example": "st replication status --json", "workflow": "operator" },
    "service": { "job": "Manage the local st service", "why": "Install and recover daemon supervision", "actor": "operator", "mode": "mutation", "model": "service.v0", "inputs": "service action", "defaults": "user service", "output": "service result", "success": "manager state agrees", "actions": "install status permissions restart reset uninstall", "authority": "local operator", "recovery": "doctor and inspect manager logs", "human_example": "st service status", "json_example": "st service status --json", "workflow": "operator" },
    "subject": { "job": "Inspect any registered subject", "why": "Provide one expert explorer without table leakage", "actor": "expert", "mode": "read", "model": "subject-explorer.v0", "inputs": "subject kind relation cursor", "defaults": "current projection", "output": "typed card relations history", "success": "bounded authorized detail", "actions": "related history typed actions", "authority": "read scope", "recovery": "show redaction or indeterminate reason", "human_example": "st subject show agent/demo", "json_example": "st subject show agent/demo --json", "workflow": "expert" },
    "claim": { "job": "Append or inspect a low-level claim", "why": "Support explicit expert graph operations", "actor": "expert", "mode": "read-or-mutation", "model": "claim.v0", "inputs": "registered subject kind fields fences", "defaults": "none", "output": "claim receipt", "success": "admitted immutable claim", "actions": "append", "authority": "schema write policy", "recovery": "append repair", "human_example": "st claim SUBJECT KIND --field k=v", "json_example": "st claim SUBJECT KIND --field k=v --json", "workflow": "expert" },
    "diagnostic": { "job": "Report a harness failure", "why": "Give agents one authorized typed fault-report path", "actor": "agent", "mode": "mutation", "model": "harness-diagnostic.v0", "inputs": "code reason severity incarnation", "defaults": "active error in the current incarnation", "output": "immutable diagnostic receipt", "success": "same-subject diagnostic admitted", "actions": "report", "authority": "current agent identity", "recovery": "retry the same idempotent report", "human_example": "st diagnostic --code driver-failed --reason 'the harness exited'", "json_example": "st diagnostic --code driver-failed --reason 'the harness exited' --json", "workflow": "worker" },
    "schema": { "job": "Inspect registered graph vocabulary", "why": "Make expert types discoverable", "actor": "expert", "mode": "read", "model": "schema.v0", "inputs": "family or name", "defaults": "summary", "output": "registered schema", "success": "version and digest returned", "actions": "show export", "authority": "read scope", "recovery": "upgrade unsupported version", "human_example": "st schema show work.claimed", "json_example": "st schema claims --json", "workflow": "expert" },
    "documents": { "job": "Store and retrieve immutable documents", "why": "Address exact content outside CLI text", "actor": "expert", "mode": "read-or-mutation", "model": "documents.v0", "inputs": "name hash bytes", "defaults": "latest only for ls", "output": "document metadata or bytes", "success": "hash verified", "actions": "put get ls", "authority": "document capability", "recovery": "retry exact idempotency key", "human_example": "st documents get doc/name@HASH", "json_example": "st documents ls --json", "workflow": "expert" },
    "import": { "job": "Bring an existing native harness session under st", "why": "Preserve useful Codex, Claude, Pi, OMP, and OpenCode context while gaining durable ownership", "actor": "person", "mode": "read-or-fenced-mutation", "model": "session.v0", "inputs": "native session revision and exact process evidence", "defaults": "running native sessions only", "output": "native session cards or import receipt", "success": "the exact predecessor is stopped and one durable ownerless resumed agent seat starts", "actions": "ls show run", "authority": "named person with mission control", "recovery": "stop an ambiguous native process before retrying", "human_example": "st import ls", "json_example": "st import ls --json", "workflow": "product/import" },
    "debug": { "job": "Inspect a low-level runtime diagnostic", "why": "Keep debug primitives out of product workflows", "actor": "expert", "mode": "read-or-fenced-mutation", "model": "debug.v0", "inputs": "typed target", "defaults": "none", "output": "bounded diagnostic", "success": "explicit result", "actions": "trace wait reset export", "authority": "expert capability", "recovery": "use subject history", "human_example": "st trace subject/ID", "json_example": "st trace subject/ID --json", "workflow": "expert" },
    "removed": { "job": "Migrate from a removed spelling", "why": "Reject aliases and direct users to one canonical noun", "actor": "any", "mode": "none", "model": "versioned-error.v0", "inputs": "legacy argv", "defaults": "hard error", "output": "replacement guidance", "success": "nonzero exit with canonical command", "actions": "none", "authority": "none", "recovery": "use replacement", "human_example": "st launch --help", "json_example": "st launch --help", "workflow": "transition" }
  },
  "canonical_roots": ["up", "now", "usage", "missions", "launch", "attention", "machines", "agents", "conversations", "activity", "devices", "work", "terminals", "doctor", "repair", "replication", "service", "subject", "claim", "diagnostic", "trace", "schema", "documents", "import", "completions"],
  "installed_baseline": [
    { "path": "st up", "purpose_id": "daemon", "disposition": "keep" },
    { "path": "st claude", "purpose_id": "removed", "disposition": "replace-with-launch" },
    { "path": "st codex", "purpose_id": "removed", "disposition": "replace-with-launch" },
    { "path": "st preview", "purpose_id": "removed", "disposition": "merge-into-launch-preview" },
    { "path": "st planning", "purpose_id": "removed", "disposition": "replace-with-launch-no-alias" },
    { "path": "st mission", "purpose_id": "missions", "disposition": "rename-missions" },
