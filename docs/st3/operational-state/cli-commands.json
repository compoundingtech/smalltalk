    { "path": "st service", "purpose_id": "service", "disposition": "keep" },
    { "path": "st claude-channel", "purpose_id": "debug", "disposition": "demote-expert" },
    { "path": "st doc", "purpose_id": "documents", "disposition": "rename-documents" },
    { "path": "st eval", "purpose_id": "debug", "disposition": "demote-expert" },
