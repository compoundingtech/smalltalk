    { "path": "st status", "purpose_id": "now", "disposition": "rename-now-no-alias" },
    { "path": "st agents", "purpose_id": "agents", "disposition": "canonicalize-subcommands" },
    { "path": "st runtime", "purpose_id": "debug", "disposition": "demote-expert" },
    { "path": "st context", "purpose_id": "subject", "disposition": "merge-into-subject" },
    { "path": "st resource", "purpose_id": "subject", "disposition": "merge-into-subject" },
    { "path": "st claim", "purpose_id": "claim", "disposition": "keep-expert" },
    { "path": "st diagnostic", "purpose_id": "diagnostic", "disposition": "add-canonical" },
    { "path": "st schema", "purpose_id": "schema", "disposition": "keep-expert" },
    { "path": "st review", "purpose_id": "attention", "disposition": "merge-into-attention" },
    { "path": "st attention", "purpose_id": "attention", "disposition": "keep" },
    { "path": "st work", "purpose_id": "work", "disposition": "keep" },
    { "path": "st message", "purpose_id": "conversations", "disposition": "rename-conversations" },
    { "path": "st gate-result", "purpose_id": "debug", "disposition": "demote-expert" },
    { "path": "st completions", "purpose_id": "debug", "disposition": "keep-expert" },
    { "path": "st planning start|show|preview|submit|revise|approve|cancel|compare|propose", "purpose_id": "removed", "disposition": "replace-with-launch-no-alias" },
    { "path": "st mission show|start", "purpose_id": "missions", "disposition": "rename-missions" },
    { "path": "st pty ls|attach|peek|send|signal|ui", "purpose_id": "terminals", "disposition": "replace-with-terminals-without-legacy-ui" },
    { "path": "st repair dry-run|apply", "purpose_id": "repair", "disposition": "add-canonical" },
    { "path": "st replication status|invalid|inspect|diff|repair", "purpose_id": "replication", "disposition": "keep" },
    { "path": "st service install|status|permissions|restart|reset|uninstall", "purpose_id": "service", "disposition": "keep" },
    { "path": "st claude-channel install|status|uninstall", "purpose_id": "debug", "disposition": "demote-expert" },
    { "path": "st doc put|get|list", "purpose_id": "documents", "disposition": "replace-with-documents-put-get-ls" },
    { "path": "st runtime ls|reset", "purpose_id": "debug", "disposition": "demote-expert" },
    { "path": "st agents ls|show", "purpose_id": "agents", "disposition": "canonicalize-subcommands" },
    { "path": "st context read|write|append", "purpose_id": "subject", "disposition": "merge-into-subject" },
    { "path": "st resource add|ls|read|remove|watch|unwatch|refresh", "purpose_id": "subject", "disposition": "merge-into-subject" },
    { "path": "st schema subjects|resources|claims|show|export", "purpose_id": "schema", "disposition": "keep-expert" },
    { "path": "st review ls|approve|reject", "purpose_id": "attention", "disposition": "merge-into-attention" },
    { "path": "st attention ls|request|resolve", "purpose_id": "attention", "disposition": "canonicalize-subcommands" },
    { "path": "st work ls|show|claim|renew|progress|complete|fail|release|publish-mission|revise|revision", "purpose_id": "work", "disposition": "canonicalize-subcommands" },
    { "path": "st work revision show|generations|generation|approve|cancel", "purpose_id": "missions", "disposition": "merge-into-missions-revise" },
    { "path": "st message send|ls|read|reply|archive|thread|export", "purpose_id": "conversations", "disposition": "rename-conversations" },
    { "path": "st import ls|show|run", "purpose_id": "import", "disposition": "add-canonical" }
  ],
  "release_blocking_regressions": [
    { "id": "agents-running-enrich", "argv": ["st3", "agents", "ls", "--status", "running", "--enrich"], "rule": "human and JSON retain every enriched running agent" },
    { "id": "canonical-message-reply-id", "rule": "the ID printed by send is accepted unchanged by --in-reply-to" }
  ]
}
