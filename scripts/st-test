#!/usr/bin/env python3
"""Run the required checks on this machine and sign what they measured. Nobody has to ask for a signature.

  scripts/st-test [--check NAME]... [--base origin/main] [--push REMOTE] [--attempt N] [--time-limit SECONDS]
  scripts/st-test --list
  scripts/st-test --status [--base origin/main]

For every check that has a local command (the table below) it runs that command once, on the tree the pull
request will be tested as, through scripts/evidence-wrap, and the signer records the exit code and the digest of
the output it measured under this host's key (scripts/evidence-keygen). A failing run is recorded too. It then
asks the verifier, from the accepted base, whether the tree is now covered, and prints one line per check.

The tree: HEAD, the commit you are pushing. The CI gate looks up the note for the pull request head's own tree, so the tree
you built and signed is the tree that counts even when main has moved since; the merge queue still tests the integrated tree.
It tells you how far behind the base the branch is. The command always runs in a fresh throwaway worktree of that commit, never
in this checkout, so untracked or ignored files here cannot change the result; nothing is linked in (the dev shells create
their own helper links).

evidence-wrap, evidence-sign and evidence-verify come from the accepted base, not from the change under test.
Commands that call cargo reach the build admission shim on PATH like any other cargo; nothing here knows about
admission. With --push the signed notes are pushed to REMOTE after they verify, with the identity git uses for REMOTE
(or EVIDENCE_PUSH_TOKEN if set); whether that identity may create refs/notes/evidence/* is a repository rule that
has not been confirmed for agent seats.

It runs `nix develop` and `pnpm install` from the tree under test, on this machine, as this user, with the host's
signing key within reach: code in that tree runs here. That is the cooperative trust of docs/st3/gate-evidence.md
("Host keys"); do not run it on a branch you would not run by hand.

Exit 0 when every selected check passed and was signed; 1 when a check failed, timed out or could not be signed; 2 when it
could not start (a refusal: dirty tree, bad argument); 3 from --status when the tree is not covered.
"""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True

# The local command of each check: exactly the argv the wrapper records and a policy's `wrapper` kind pins.
# A check without an entry cannot be signed from a checkout; it is not listed, and nothing pretends otherwise.
LOCAL = {
    'genie-freshness': ['nix', 'develop', '.#genie', '-c', 'bash', 'scripts/ci-genie-freshness'],
    'typescript-client': ['nix', 'develop', '.#web', '-c', 'bash', '-c',
                          'pnpm install --frozen-lockfile && bash scripts/ci-typescript-client'],
}
BASE_SCRIPTS = ('evidence-wrap', 'evidence-sign', 'evidence-verify')


class Failure(Exception):
    pass


SELECTING = ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_COMMON_DIR',
                  'GIT_NAMESPACE', 'GIT_PREFIX', 'GIT_QUARANTINE_PATH', 'GIT_REPLACE_REF_BASE', 'GIT_NO_REPLACE_OBJECTS', 'GIT_GRAFT_FILE',
                  'GIT_SHALLOW_FILE', 'GIT_INTERNAL_SUPER_PREFIX', 'GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL', 'GIT_AUTHOR_DATE',
                  'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL', 'GIT_COMMITTER_DATE')


def selecting(name):
    """A variable that names a repository or an identity: git exports them to a hook, and a check that kept them would act on the
    caller's repository. Transport and credential variables (GIT_SSH_COMMAND, GIT_ASKPASS, GIT_CONFIG_*, ...) are not here."""
    return name in SELECTING or name.startswith('GIT_PUSH_OPTION')


SEAT_PREFIXES = ('ST_', 'ST2_', 'ST3_', 'CLAUDE', 'ANTHROPIC_')
KEPT_SEAT = ('ST_AGENT', 'ST_SKIP_EVIDENCE')  # exact names, plus every ST_EVIDENCE* switch; this list is the only exception mechanism


def scrub_seat_environment():
    """A CI runner has none of the variables an agent seat carries (identity, mission, session, daemon endpoint, hook and messaging
    settings), and the checks must see what CI sees: tests that read them fail or behave differently under a seat (the ci-local-gate
    drill's claude hook tests did). ST_AGENT stays because the host ranks `nix develop` starts by it (so a check can still read it: the nix wrapper that needs it
    starts the check); the evidence switches stay. The kept list is the only exception mechanism for a future ST_* switch."""
    for name in [name for name in os.environ
                 if name.startswith(SEAT_PREFIXES) and name not in KEPT_SEAT and not name.startswith('ST_EVIDENCE')]:
        del os.environ[name]


def scrub_git_environment():
    """Drop the repository- and identity-selecting GIT_* variables (st2#3014); the notes push keeps its transport variables."""
    for name in [name for name in os.environ if selecting(name)]:
        del os.environ[name]


def git(*args, cwd=None, env=None, check=True, stdin=None):
    done = subprocess.run(['git', *args], cwd=cwd, capture_output=True, input=stdin,
                          env=dict(os.environ, **(env or {})))
    if check and done.returncode != 0:
        raise Failure(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-400:]}')
    return done


def text(done):
    return done.stdout.decode().strip()


def target_commit(base):
    """The commit that is signed: HEAD, the commit being pushed.

    A pull request check is reported on the head commit, and the CI gate looks up the note for the head's own tree (see
    docs/st3/gate-evidence.md, "Which tree a pull request run asks about"), so the tree an agent built and signed is the
    tree that counts, whether or not main has moved since. The merge queue still tests the integrated tree."""
    return text(git('rev-parse', 'HEAD'))


def lane_names(base):
    """The lanes the accepted base defines in .st/required-lanes.json (none when the file is absent or unreadable: then nothing changes)."""
    done = git('show', f'{base}:.st/required-lanes.json', check=False)
    if done.returncode != 0:
        return set()
    try:
        lanes = json.loads(done.stdout.decode())['lanes']
        return set(lanes) if isinstance(lanes, dict) else set()
    except (ValueError, KeyError, UnicodeDecodeError, TypeError):
        return set()


def behind(base):
    """How many commits of the base this branch lacks (0 when it holds the base's tip)."""
    done = git('rev-list', '--count', f'HEAD..{base}', check=False)
    return int(text(done)) if done.returncode == 0 and text(done).isdigit() else None


def target_worktree(base, scratch):
    """(directory, commit): a clean throwaway worktree of that commit.

    Always a fresh worktree, never this checkout, so untracked or ignored files here cannot change the result, and no
    helper directory is linked in: the dev shells create their own."""
    commit = target_commit(base)
    directory = Path(scratch) / 'tree'
    git('worktree', 'add', '--detach', '-q', str(directory), commit)
    return directory, commit


def reap_stale():
    """Remove worktrees an earlier st-test left when it was killed (no TERM, no cleanup): its scratch directory names its pid."""
    listing = text(git('worktree', 'list', '--porcelain', check=False))
    for block in listing.split('\n\n'):
        match = re.search(r'^worktree (\S*/st-test-[^/]+)/tree$', block, re.M)
        if not match:
            continue
        scratch = Path(match.group(1))
        try:
            os.kill(int((scratch / 'pid').read_text()), 0)
            continue  # still running
        except PermissionError:
            continue  # alive, and another user's: not ours to reap
        except (OSError, ValueError):
            pass
        git('worktree', 'remove', '--force', str(scratch / 'tree'), check=False)
        shutil.rmtree(scratch, ignore_errors=True)
    git('worktree', 'prune', check=False)


def covered(verifier, directory, tree, check, base, repository):
    command = [sys.executable, verifier, '--repo', str(directory), '--tree', tree, '--check', check, '--keys-from', base]
    if repository:
        command += ['--policy-from', base, '--repository', repository]
    done = subprocess.run(command, capture_output=True, text=True)
    try:
        result = json.loads(done.stdout)
    except ValueError:
        return False, 'verifier gave no answer: ' + (done.stderr.strip().splitlines() or ['-'])[-1][:120]
    if done.returncode == 0:
        return True, f'covered by {result.get("kind")} {result.get("record", "")[:12]}'
    return False, result.get('reason') or 'not covered'


def repository_of(remote):
    url = text(git('remote', 'get-url', remote, check=False))
    for prefix in ('https://github.com/', 'git@github.com:', 'ssh://git@github.com/'):
        if url.startswith(prefix):
            return url[len(prefix):].removesuffix('.git').strip('/')
    return None


def main(argv):
    scrub_git_environment()
    scrub_seat_environment()
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--check', action='append', default=[], metavar='NAME', help='only this check (repeatable)')
    parser.add_argument('--base', default='origin/main', help='the accepted base (default origin/main)')
    parser.add_argument('--push', metavar='REMOTE', help='push the signed notes here after they verify')
    parser.add_argument('--repository', metavar='OWNER/NAME', help='default: from the remote\'s GitHub URL; without it the policy is not applied')
    parser.add_argument('--attempt', default='1')
    parser.add_argument('--time-limit', type=int, default=7200, help='seconds per check (default 7200)')
    parser.add_argument('--list', action='store_true', help='print the checks and their commands and stop')
    parser.add_argument('--status', action='store_true', help='run nothing: say whether each check is already covered for this tree; exit 0 if all are, 3 if not')
    parser.add_argument('--toolchain-sha256', help='passed to evidence-wrap: skip the nix evaluation, record this digest')
    args = parser.parse_args(argv)
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9._/-]*', args.base):
        raise Failure(f'--base {args.base!r} must be a branch or ref name (it may not start with "-")')
    unknown = [name for name in args.check if name not in LOCAL]
    if unknown:
        raise Failure(f'no local command for {", ".join(unknown)}; known: {", ".join(LOCAL)}')
    checks = args.check or list(LOCAL)
    if args.list:
        for name in checks:
            print(f'{name}: {" ".join(LOCAL[name])}')
        return 0

    remote, _, branch = args.base.partition('/')
    if branch:
        git('fetch', '-q', remote, branch)  # the base moves; the lag and the policy are read at its current tip
    git('rev-parse', '--verify', '-q', args.base + '^{commit}')
    if args.status:
        commit = target_commit(args.base)
        tree = text(git('rev-parse', f'{commit}^{{tree}}'))
        with tempfile.TemporaryDirectory(prefix='st-test-') as scratch:
            verifier = Path(scratch) / 'evidence-verify'
            verifier.write_bytes(git('show', f'{args.base}:scripts/evidence-verify').stdout)
            repository = args.repository or repository_of(remote or 'origin')
            rows = [(name,) + covered(str(verifier), Path('.'), tree, name, args.base, repository) for name in checks]
        for name, is_covered, why in rows:
            print(f'  {name:<20} {"covered" if is_covered else "not covered":<12} {why}')
        return 0 if all(row[1] for row in rows) else 3
    status = git('status', '--porcelain', '--untracked-files=no').stdout.decode().strip()
    if status:
        raise Failure('the checkout has uncommitted changes to tracked files; commit them first, the note is for the committed tree')
    reap_stale()
    with tempfile.TemporaryDirectory(prefix='st-test-') as scratch:
        os.chmod(scratch, 0o700)
        (Path(scratch) / 'pid').write_text(str(os.getpid()))
        tools = {}
        for name in BASE_SCRIPTS:
            path = Path(scratch) / name
            path.write_bytes(git('show', f'{args.base}:scripts/{name}').stdout)
            path.chmod(0o700)
            tools[name] = str(path)
        directory = Path(scratch) / 'tree'
        try:
            directory, commit = target_worktree(args.base, scratch)
            lag = behind(args.base)
            tree = text(git('rev-parse', f'{commit}^{{tree}}', cwd=directory))
            repository = args.repository or repository_of(remote or 'origin')
            signer = os.environ.get('EVIDENCE_SIGNER') or json.dumps([sys.executable, tools['evidence-sign']])
            rows, failed = [], False
            lanes = lane_names(args.base)
            for name in checks:
                wrap = [sys.executable, tools['evidence-wrap'], '--check', name, '--attempt', args.attempt,
                        '--signer', signer, '--verifier', tools['evidence-verify'], '--keys-from', args.base]
                if name in lanes:
                    # The base defines this lane: the note carries the digest of its definition, and a tree that edits the lane is not signed.
                    wrap += ['--lanes-from', args.base]
                if args.toolchain_sha256:
                    wrap += ['--toolchain-sha256', args.toolchain_sha256]
                if args.push:
                    wrap += ['--push', args.push]
                started = time.monotonic()
                try:
                    done = subprocess.run(wrap + ['--'] + LOCAL[name], cwd=directory, timeout=args.time_limit)
                    code = done.returncode
                except subprocess.TimeoutExpired:
                    code = 124
                seconds = round(time.monotonic() - started)
                ok = code == 0
                failed = failed or not ok
                is_covered, why = covered(tools['evidence-verify'], directory, tree, name, args.base, repository)
                rows.append((name, 'passed' if ok else ('timed out' if code == 124 else f'FAILED ({code})'), seconds, why))
            print(f'\nst-test: tree {tree[:12]} (HEAD{f", {lag} commit(s) behind {args.base}: the queue tests the merge" if lag else ""}), in a clean worktree')
            for name, result, seconds, why in rows:
                print(f'  {name:<20} {result:<12} {seconds:>6}s  {why}')
            return 1 if failed else 0
        finally:
            if directory.exists():
                git('worktree', 'remove', '--force', str(directory), check=False)


if __name__ == '__main__':
    # TERM (the pre-push hook's timeout, a closed terminal) unwinds like an error so the throwaway worktree is removed.
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(143))
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as error:
        print(f'st-test: {error}', file=sys.stderr)
        sys.exit(2)
