#!/usr/bin/env bash
# The whole `genie-freshness` required check, from a checkout or a Nix sandbox.
# CI runs it in the genie shell; `checks.genie-freshness` runs it in a derivation. One list, so
# the two cannot drift. It needs git, python3, tar, jq, zstd, ssh-keygen and `genie`, and no network.
set -euo pipefail
cd "$(dirname "$0")/.."

python3 scripts/ci-fractal-web-licenses-test
python3 scripts/ci-fractal-web-licenses --check-lockfile
for test in \
  ci-ready-pr-test ci-draft-admission-test ci-workflow-concurrency-test check-ci-runner-test \
  ci-namespace-usage-test ci-mail-redelivery-canaries-test ci-test-partitions-test \
  ci-test-archive-test ci-evidence-source-test check-ci-test-paths ci-queue-watch-test \
  check-main-ci-test ci-perf-cache-test ci-perf-slot-test ci-perf-scope-test \
  ci-cache-audit-test ci-fractal-web-test ci-evidence-observe-test evidence-verify-test st-test-test evidence-prepush-test evidence-wrap-test ci-evidence-signing-test evidence-publish-test \
  ci-evidence-gate-test evidence-sign-hardening-test; do
  python3 "scripts/$test"
done
genie --check
