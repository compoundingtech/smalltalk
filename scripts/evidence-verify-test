#!/usr/bin/env python3
"""Exercise scripts/evidence-verify against real Git repositories and real SSH signatures."""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / 'scripts/evidence-verify'
loader = importlib.machinery.SourceFileLoader('evidence_verify', str(SCRIPT))
spec = importlib.util.spec_from_loader(loader.name, loader)
evidence_verify = importlib.util.module_from_spec(spec)
loader.exec_module(evidence_verify)

IDENTITY = ['-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid']
NOW = datetime.now(timezone.utc)


def run(*command, cwd=None, stdin=None):
    done = subprocess.run(command, cwd=cwd, input=stdin, capture_output=True, check=False)
    if done.returncode != 0:
        raise AssertionError(done.stderr.decode())
    return done.stdout.decode().strip()


class Fixture:
    def __init__(self, object_format='sha1'):
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        self.repo = self.root / 'repo'
        run('git', 'init', '-q', f'--object-format={object_format}', str(self.repo))
        self.allowed = []
        self.keys = self.root / 'allowed-signers'
        self.counter = 0

    def git(self, *args, stdin=None):
        return run('git', '-C', str(self.repo), *IDENTITY, *args, stdin=stdin)

    def key(self, name, principal=None):
        path = self.root / name
        run('ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(path))
        if principal:
            self.allowed.append(f'{principal} namespaces="git" {path.with_suffix(".pub").read_text()}')
            self.keys.write_text(''.join(self.allowed))
        return path

    def commit(self, content):
        (self.repo / 'file.txt').write_text(content)
        self.git('add', '-A')
        self.git('commit', '-q', '-m', content)
        return self.git('rev-parse', 'HEAD'), self.git('rev-parse', 'HEAD^{tree}')

    def note(self, commit, tree, key, signer, check='unit', command=('make', 'test'), exit_code=0,
             runner='nix', tier='full', seconds=0, sign=True, naive=False, inputs=None, omit_inputs=False, mutate=None, parent=None):
        statement = {
            '_type': 'https://in-toto.io/Statement/v1',
            'subject': [{'name': commit, 'digest': {'gitTree': tree}}],
            'predicateType': 'https://smalltalk.dev/evidence/gate/v1',
            'predicate': {
                'schema_version': 1, 'change_id': 'change-1', 'signer': signer, 'tier': tier,
                're_attests': None, 'producer_sha256': 'a' * 64,
                'observed_at': (NOW + timedelta(seconds=seconds)).replace(tzinfo=None if naive else timezone.utc).isoformat(),
                'observed': {'kind': 'tests', 'runner': runner, 'inputs': inputs or {},
                             'checks': {check: {'command': list(command), 'exit_code': exit_code,
                                                'output_sha256': 'b' * 64}}},
            },
        }
        if omit_inputs:
            del statement['predicate']['observed']['inputs']
        body = json.dumps(statement).encode()
        if mutate is not None:
            body = mutate(body)
        blob = self.git('hash-object', '-w', '--stdin', stdin=body)
        notes = self.git('mktree', stdin=f'100644 blob {blob}\t{tree}\n'.encode())
        args = ['-c', 'gpg.format=ssh', '-c', f'user.signingKey={key}', 'commit-tree']
        if sign:
            args.append('-S')
        record = self.git(*args, notes, '-p', parent or commit, '-m', 'st gate observation v1')
        self.git('update-ref', f'refs/notes/evidence/{record}', record)
        return record

    def verify(self, tree, check='unit', command=None, **options):
        try:
            return 0, evidence_verify.verify(str(self.repo), tree, check, str(self.keys), command, **options)
        except evidence_verify.Failure as failure:
            return 1, {'satisfied': False, 'reason': failure.reason, 'detail': failure.detail, **failure.extra}

    def cli(self, *args):
        done = subprocess.run([sys.executable, str(SCRIPT), '--repo', str(self.repo), *args],
                              capture_output=True, check=False)
        return done.returncode, done.stdout.decode(), done.stderr.decode()


class Verifier(unittest.TestCase):
    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.commit, self.tree = self.f.commit('one')

    def reason(self, *args, **kwargs):
        code, result = self.f.verify(*args, **kwargs)
        self.assertEqual(code, 1, result)
        return result['reason']

    def test_a_trusted_note_satisfies_the_check_and_reports_signer_and_trust_level(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        code, result = self.f.verify(self.tree)
        self.assertEqual(code, 0)
        self.assertEqual((result['record'], result['kind'], result['signer'], result['trust_level']),
                         (record, 'nix', 'machine/ci1', 'machine'))
        self.assertEqual(result['command'], ['make', 'test'])

    def test_wrapper_and_sekrets_are_accepted_kinds_and_unknown_kinds_are_not(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='sekrets')
        self.assertEqual(self.f.verify(self.tree)[1]['kind'], 'sekrets')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='wrapper', seconds=1)
        self.assertEqual(self.f.verify(self.tree)[1]['kind'], 'wrapper')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='hand-typed', seconds=2)
        self.assertEqual(self.reason(self.tree), 'unsupported_kind')

    def test_a_forged_signature_is_rejected(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        raw = run('git', '-C', str(self.f.repo), 'cat-file', 'commit', record)
        forged = self.f.git('hash-object', '-t', 'commit', '-w', '--stdin',
                            stdin=raw.replace('st gate observation v1', 'forged observation').encode())
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', f'refs/notes/evidence/{forged}', forged)
        self.assertEqual(self.reason(self.tree), 'bad_signature')

    def test_an_unsigned_note_is_rejected(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', sign=False)
        self.assertEqual(self.reason(self.tree), 'bad_signature')

    def test_a_key_that_is_not_on_the_list_is_untrusted(self):
        stranger = self.f.key('stranger')
        self.f.note(self.commit, self.tree, stranger, 'machine/ci1')
        self.assertEqual(self.reason(self.tree), 'untrusted_signer')

    def test_the_record_cannot_claim_a_different_signer_than_the_key_proves(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/someone-else')
        self.assertEqual(self.reason(self.tree), 'untrusted_signer')

    def test_a_note_for_another_tree_is_stale_and_no_note_at_all_is_missing(self):
        other_commit, other_tree = self.f.commit('two')
        self.f.note(other_commit, other_tree, self.ci, 'machine/ci1')
        self.assertEqual(self.reason(self.tree), 'stale_tree')
        self.assertEqual(self.reason(self.tree, check='never-ran'), 'no_record')

    def test_a_note_for_a_different_check_does_not_satisfy_this_one(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', check='lint')
        self.assertEqual(self.reason(self.tree, check='unit'), 'wrong_check')

    def test_the_recorded_command_must_match_when_one_is_required(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', command=('true',))
        self.assertEqual(self.f.verify(self.tree, command=['true'])[0], 0)
        self.assertEqual(self.reason(self.tree, command=['make', 'test']), 'wrong_command')

    def test_a_failed_run_fails_and_the_latest_record_decides(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=0)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=1)
        self.assertEqual(self.reason(self.tree), 'check_failed')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=2)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_a_time_without_a_zone_is_not_evidence_and_cannot_crash_the_ordering(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', naive=True)
        self.assertEqual(self.reason(self.tree), 'no_record')
        # Beside a well-formed record the naive one is ignored, not compared against it.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=2, naive=True)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_the_central_observers_record_of_a_ci_job_is_the_observed_kind(self):
        runner = 'github:org/repo/actions/runs/7/attempts/1/jobs/9'
        command = ('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner=runner, command=command)
        code, result = self.f.verify(self.tree, command=list(command), kinds=('observed',))
        self.assertEqual((code, result['kind'], result['command']), (0, 'observed', list(command)))
        code, result = self.f.verify(self.tree, kinds=('wrapper',))
        self.assertEqual((code, result['reason']), (1, 'unsupported_kind'))
        # A different workflow or job named in the command is not the recorded one.
        self.assertEqual(self.reason(self.tree, command=['github-actions', 'org/other', 'x.yml', 'unit']),
                         'wrong_command')

    def test_an_unsigned_degraded_record_is_reported_as_degraded_not_as_a_signature_fault(self):
        self.f.note(self.commit, self.tree, self.ci, None, tier='degraded', sign=False)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['reason'], result['attempts']), (1, 'degraded', 1))
        # It never counts as evidence, and a later full record satisfies the check.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_a_check_names_the_kinds_it_accepts(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='wrapper')
        self.assertEqual(self.f.verify(self.tree, kinds=('nix', 'wrapper'))[0], 0)
        code, result = self.f.verify(self.tree, kinds=('nix',))
        self.assertEqual((code, result['reason']), (1, 'unsupported_kind'))

    def test_an_environment_input_must_match_the_file_in_the_verified_tree(self):
        good = hashlib.sha256(b'one').hexdigest()
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', inputs={'flake_lock_sha256': good})
        self.assertEqual(self.f.verify(self.tree, bind=[('flake_lock_sha256', 'file.txt')])[0], 0)
        # A record made against a different environment does not satisfy this tree.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1,
                    inputs={'flake_lock_sha256': hashlib.sha256(b'other').hexdigest()})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'file.txt')]), 'wrong_input')
        # Missing key, and a path the tree does not have, both fail rather than pass.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=2, inputs={'system': 'x86_64-linux'})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'file.txt')]), 'wrong_input')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=3, inputs={'flake_lock_sha256': good})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'no-such-file')]), 'wrong_input')

    def test_a_bind_never_passes_when_the_file_and_the_key_are_both_absent(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'no-such-file')]), 'wrong_input')
        # An empty-string input cannot match anything either (such a record is malformed).
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1, inputs={'flake_lock_sha256': ''})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'no-such-file')]), 'wrong_input')

    def test_a_record_without_an_inputs_field_is_valid_and_reports_empty_inputs(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', omit_inputs=True)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['inputs']), (0, {}))
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'file.txt')]), 'wrong_input')

    def test_inputs_that_are_not_nonempty_strings_make_a_record_malformed(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', inputs={'attempt': 1})
        self.assertEqual(self.reason(self.tree), 'no_record')

    def test_the_number_of_trusted_records_is_reported_for_loop_protection(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=0)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=1)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['reason'], result['attempts']), (1, 'check_failed', 2))
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=2)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['attempts']), (0, 3))

    def test_the_same_file_contents_in_a_different_tree_is_not_covered(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        (self.f.repo / 'extra.txt').write_text('extra')
        other_commit, other_tree = self.f.commit('one')  # file.txt is byte-identical, the tree is not
        self.assertNotEqual(other_tree, self.tree)
        self.assertEqual(self.reason(other_tree), 'stale_tree')
        self.assertEqual(self.f.verify(self.tree)[1]['record'], record)

    def test_a_record_for_another_repository_is_refused_by_the_runner_prefix(self):
        mine = 'github:org/repo/actions/runs/7/attempts/1/jobs/9'
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner=mine)
        self.assertEqual(self.f.verify(self.tree, runner_prefix='github:org/repo/')[0], 0)
        self.assertEqual(self.reason(self.tree, runner_prefix='github:org/other/'), 'wrong_runner')
        # A prefix without the trailing slash would also match org/repo2; the slash is what anchors it.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1,
                    runner='github:org/repo2/actions/runs/7/attempts/1/jobs/9')
        self.assertEqual(self.reason(self.tree, runner_prefix='github:org/repo/'), 'wrong_runner')

    def test_a_check_accepts_only_the_signer_trust_levels_it_names(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        self.assertEqual(self.f.verify(self.tree, trust_levels=('machine',))[0], 0)
        self.assertEqual(self.reason(self.tree, trust_levels=('fleet', 'namespace')), 'untrusted_level')
        # A newer failure from a level the check does not accept still stops a skip.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=1)
        self.assertEqual(self.reason(self.tree, trust_levels=('fleet',)), 'untrusted_level')

    def test_old_and_future_dated_records_do_not_count(self):
        week = 7 * 24 * 3600
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=-(week + 60))
        self.assertEqual(self.reason(self.tree, max_age=week), 'too_old')
        self.assertEqual(self.f.verify(self.tree)[0], 0)  # no age policy, no age check
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=-(week - 3600))
        self.assertEqual(self.f.verify(self.tree, max_age=week)[0], 0)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=3600)
        self.assertEqual(self.reason(self.tree, max_age=week), 'future_dated')
        # ...and with no age limit at all: a future-dated pass must not become the latest record.
        self.assertEqual(self.reason(self.tree), 'future_dated')
        # A little clock skew is tolerated.
        other = Fixture()
        self.addCleanup(other.tmp.cleanup)
        key = other.key('ci', 'machine/ci1')
        commit, tree = other.commit('skew')
        other.note(commit, tree, key, 'machine/ci1', seconds=60)
        self.assertEqual(other.verify(tree, max_age=week)[0], 0)

    def test_signed_content_edited_after_signing_is_a_bad_signature(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1)
        raw = run('git', '-C', str(self.f.repo), 'cat-file', 'commit', record)
        passing = json.loads(self.f.git('cat-file', 'blob', f'{record}:{self.tree}'))
        passing['predicate']['observed']['checks']['unit']['exit_code'] = 0
        blob = self.f.git('hash-object', '-w', '--stdin', stdin=json.dumps(passing).encode())
        tree = self.f.git('mktree', stdin=f'100644 blob {blob}\t{self.tree}\n'.encode())
        old_tree = self.f.git('rev-parse', f'{record}^{{tree}}')
        forged = self.f.git('hash-object', '-t', 'commit', '-w', '--stdin',
                            stdin=raw.replace(f'tree {old_tree}', f'tree {tree}', 1).encode())
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', f'refs/notes/evidence/{forged}', forged)
        self.assertEqual(self.reason(self.tree), 'bad_signature')

    def test_garbage_in_the_notes_namespace_is_ignored_without_a_crash(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        blob = self.f.git('hash-object', '-w', '--stdin', stdin=b'not a commit')
        self.f.git('update-ref', f'refs/notes/evidence/{blob}', blob)  # a ref to a blob
        empty = self.f.git('mktree', stdin=b'')
        bare = self.f.git('commit-tree', empty, '-p', self.commit, '-m', 'empty notes')
        self.f.git('update-ref', f'refs/notes/evidence/{bare}', bare)  # a note with no statement
        extra = self.f.git('hash-object', '-w', '--stdin', stdin=b'{}')
        two = self.f.git('mktree', stdin=(f'100644 blob {extra}\t{self.tree}\n'
                                          f'100644 blob {extra}\t{"0" * 40}\n').encode())
        crowded = self.f.git('commit-tree', two, '-p', self.commit, '-m', 'two entries')
        self.f.git('update-ref', f'refs/notes/evidence/{crowded}', crowded)  # more than one blob
        self.assertEqual(self.f.verify(self.tree)[1]['record'], record)

    def test_a_note_whose_parent_is_not_its_subject_commit_is_not_evidence(self):
        other_commit, _ = self.f.commit('two')
        # The signed statement names self.commit as its subject but the note hangs off another commit.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', parent=other_commit)
        self.assertEqual(self.reason(self.tree), 'no_record')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_two_conflicting_records_resolve_toward_failure(self):
        moment = 5
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=moment)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=moment)
        self.assertEqual(self.reason(self.tree), 'check_failed')

    def test_a_statement_that_is_not_valid_utf8_is_not_evidence(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1',
                    mutate=lambda body: body.replace(b'"make"', b'"ma\xffke"'))
        self.assertEqual(self.reason(self.tree), 'no_record')

    def test_an_unreadable_repository_is_an_error_with_json_and_never_a_pass(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='github:x/y/jobs/1')
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys),
                                  '--max-age', '86400', '--trust-levels', 'machine', '--runner-prefix', 'github:x/')
        self.assertEqual(code, 0, out)  # sanity: all the options parse and a good record passes
        missing = subprocess.run([sys.executable, str(SCRIPT), '--repo', '/nonexistent', '--tree', self.tree,
                                  '--check', 'unit', '--keys', str(self.f.keys)], capture_output=True)
        self.assertEqual((missing.returncode, json.loads(missing.stdout)['reason']), (1, 'error'))
        for bad in (['--max-age', '0'], ['--max-age', 'soon'], ['--trust-levels', ',']):
            self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys),
                                        *bad)[0], 2)

    def test_only_full_tier_counts(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', tier='test')
        self.assertEqual(self.reason(self.tree), 'untrusted_tier')

    def test_a_ref_that_does_not_name_its_own_commit_is_not_evidence(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', 'refs/notes/evidence/' + '1' * 40, record)
        self.assertEqual(self.reason(self.tree), 'no_record')

    def test_a_note_keyed_to_a_tree_the_subject_commit_does_not_have_is_ignored(self):
        other_commit, other_tree = self.f.commit('two')
        self.f.note(other_commit, other_tree, self.ci, 'machine/ci1')
        # Claim the other commit's note covers our tree by lying about the subject.
        self.f.note(other_commit, self.tree, self.ci, 'machine/ci1')
        self.assertEqual(self.reason(self.tree), 'stale_tree')

    def test_notes_fetched_shallow_verify_without_the_subject_commit(self):
        # How CI gets them: a fresh checkout of the tree plus a depth-1 fetch of the notes refs.
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        other = tempfile.TemporaryDirectory()
        self.addCleanup(other.cleanup)
        run('git', 'init', '-q', other.name)
        run('git', '-C', other.name, 'fetch', '-q', '--depth=1', '--no-tags', 'file://' + str(self.f.repo),
            'refs/notes/evidence/*:refs/notes/evidence/*')
        missing = subprocess.run(['git', '-C', other.name, 'cat-file', '-e', self.commit], capture_output=True)
        self.assertNotEqual(missing.returncode, 0, 'the subject commit must be absent for this test')
        result = evidence_verify.verify(other.name, self.tree, 'unit', str(self.f.keys), None)
        self.assertEqual(result['record'], record)

    def test_the_key_list_comes_from_the_accepted_base_so_revoking_a_key_revokes_its_notes(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'keys')
        base = self.f.git('rev-parse', 'HEAD')
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', base)
        self.assertEqual(code, 0, out)
        (self.f.repo / '.st/evidence-keys').write_text('')
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'revoke')
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', 'HEAD')
        self.assertEqual((code, json.loads(out)['reason']), (1, 'untrusted_signer'))

    def test_usage_errors_exit_two_and_unreadable_input_is_reported_as_an_error(self):
        self.assertEqual(self.f.cli('--check', 'unit', '--keys', str(self.f.keys))[0], 2)
        self.assertEqual(self.f.cli('--tree', self.tree, '--revision', 'HEAD', '--check', 'unit',
                                    '--keys', str(self.f.keys))[0], 2)
        self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys),
                                    '--command', 'not json')[0], 2)
        for bad in (['--kinds', 'nix,hand-typed'], ['--kinds', ''], ['--bind-input', 'novalue']):
            self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys), *bad)[0], 2)
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', '/nonexistent')
        self.assertEqual((code, json.loads(out)['reason']), (1, 'error'))

    def test_revision_resolves_to_its_tree(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        code, out, _ = self.f.cli('--revision', 'HEAD', '--check', 'unit', '--keys', str(self.f.keys))
        self.assertEqual((code, json.loads(out)['tree']), (0, self.tree))

    def test_many_records_still_verify_in_well_under_a_second_each_way(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        for number in range(120):
            commit, tree = self.f.commit(f'filler {number}')
            self.f.note(commit, tree, self.ci, 'machine/ci1')
        started = time.monotonic()
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys))
        found = time.monotonic() - started
        self.assertEqual(code, 0, out)
        started = time.monotonic()
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'absent', '--keys', str(self.f.keys))
        missing = time.monotonic() - started
        self.assertEqual((code, json.loads(out)['reason']), (1, 'wrong_check'))
        print(f'  121 records: found in {found:.3f}s, wrong check in {missing:.3f}s', file=sys.stderr)
        # The requirement is one second; the test allows slack because CI hosts are busy.
        self.assertLess(found, 3.0)
        self.assertLess(missing, 3.0)


OBSERVED = 'github:org/repo/actions/runs/7/attempts/1/jobs/9'


def policy_text(**overrides):
    doc = {'version': 1, 'checks': {'unit': {
        'trust_levels': ['machine'],
        'kinds': {
            'observed': {'command': ['github-actions', '{repository}', '.github/workflows/fleet.yml', '{check}'],
                         'runner_prefix': 'github:{repository}/'},
            'wrapper': {'command': ['make', 'test'], 'required_inputs': ['flake_lock_sha256', 'toolchain_sha256'],
                        'bind_inputs': {'flake_lock_sha256': 'file.txt'}},
        }}}}
    doc['checks']['unit'].update(overrides)
    return json.dumps(doc)


class SkipPolicy(unittest.TestCase):
    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.commit, self.tree = self.f.commit('one')
        self.good = hashlib.sha256(b'one').hexdigest()

    def rules(self, text=None, check='unit'):
        return evidence_verify.policy_rules(text or policy_text(), check, 'org/repo')

    def reason(self, **kwargs):
        code, result = self.f.verify(self.tree, rules=kwargs.pop('rules', None) or self.rules(), **kwargs)
        self.assertEqual(code, 1, result)
        return result['reason']

    def observed(self, **kwargs):
        defaults = dict(runner=OBSERVED, command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'))
        defaults.update(kwargs)
        return self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', **defaults)

    def wrapper(self, **kwargs):
        inputs = {'flake_lock_sha256': self.good, 'toolchain_sha256': 'f' * 64}
        defaults = dict(runner='wrapper', inputs=inputs)
        defaults.update(kwargs)
        return self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', **defaults)

    def test_the_policy_is_validated_strictly_so_a_typo_cannot_weaken_it(self):
        def broken(edit):
            doc = json.loads(policy_text())
            edit(doc)
            with self.assertRaises(evidence_verify.Failure) as caught:
                evidence_verify.policy_rules(json.dumps(doc), 'unit', 'org/repo')
            return caught.exception.reason
        entry = lambda d: d['checks']['unit']
        self.assertEqual(broken(lambda d: d.update(surprise=1)), 'error')
        self.assertEqual(broken(lambda d: d.update(version=2)), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(max_age=60)), 'error')  # misspelt max_age_s
        self.assertEqual(broken(lambda d: entry(d).pop('trust_levels')), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(trust_levels=[])), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(kinds={})), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(max_age_s=True)), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(max_age_s=0)), 'error')
        for bad in ('yes', 1, None, 'true'):
            self.assertEqual(broken(lambda d, bad=bad: entry(d).update(enforce=bad)), 'error', repr(bad))  # enforce is a boolean
        self.assertEqual(broken(lambda d: entry(d)['kinds'].update(hand={'command': ['x']})), 'error')
        self.assertEqual(broken(lambda d: entry(d)['kinds']['wrapper'].update(typo=1)), 'error')
        self.assertEqual(broken(lambda d: entry(d)['kinds']['wrapper'].pop('command')), 'error')
        self.assertEqual(broken(lambda d: entry(d)['kinds']['wrapper'].update(command=[])), 'error')
        self.assertEqual(broken(lambda d: entry(d)['kinds']['wrapper'].update(required_inputs=[1])), 'error')
        with self.assertRaises(evidence_verify.Failure) as caught:
            evidence_verify.policy_rules('not json', 'unit', 'org/repo')
        self.assertEqual(caught.exception.reason, 'error')
        with self.assertRaises(evidence_verify.Failure) as caught:
            evidence_verify.policy_rules(policy_text(), 'other-check', 'org/repo')
        self.assertEqual(caught.exception.reason, 'no_policy')

    def test_placeholders_are_filled_and_binding_an_input_also_requires_it(self):
        rules = self.rules()
        self.assertEqual(rules['kinds']['observed']['command'],
                         ['github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'])
        self.assertEqual(rules['kinds']['observed']['runner_prefix'], 'github:org/repo/')
        self.assertEqual(rules['kinds']['wrapper']['required_inputs'], ['flake_lock_sha256', 'toolchain_sha256'])
        doc = json.loads(policy_text())
        doc['checks']['unit']['kinds']['wrapper'] = {'command': ['x'], 'bind_inputs': {'a': 'file.txt'}}
        self.assertEqual(self.rules(json.dumps(doc))['kinds']['wrapper']['required_inputs'], ['a'])

    def test_each_kind_is_judged_by_its_own_rule(self):
        self.observed()
        self.assertEqual(self.f.verify(self.tree, rules=self.rules())[1]['kind'], 'observed')
        self.assertTrue(self.f.verify(self.tree, rules=self.rules())[1]['policy'])
        self.wrapper(seconds=1)
        self.assertEqual(self.f.verify(self.tree, rules=self.rules())[1]['kind'], 'wrapper')
        # The wrapper rule does not accept the observer's command, nor the other way round.
        self.wrapper(seconds=2, command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'))
        self.assertEqual(self.reason(), 'wrong_command')
        self.observed(seconds=3, command=('make', 'test'))
        self.assertEqual(self.reason(), 'wrong_command')

    def test_a_kind_the_policy_does_not_list_is_unsupported(self):
        doc = json.loads(policy_text())
        del doc['checks']['unit']['kinds']['wrapper']
        self.wrapper()
        self.assertEqual(self.reason(rules=self.rules(json.dumps(doc))), 'unsupported_kind')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='sekrets', seconds=1)
        self.assertEqual(self.reason(rules=self.rules(json.dumps(doc))), 'unsupported_kind')

    def test_a_note_missing_a_required_input_does_not_satisfy_and_adding_an_input_tightens(self):
        self.wrapper(inputs={'flake_lock_sha256': self.good})
        self.assertEqual(self.reason(), 'missing_input')
        self.wrapper(seconds=1)
        self.assertEqual(self.f.verify(self.tree, rules=self.rules())[0], 0)
        doc = json.loads(policy_text())
        doc['checks']['unit']['kinds']['wrapper']['required_inputs'] = ['flake_lock_sha256', 'toolchain_sha256',
                                                                       'wrapper_sha256']
        self.assertEqual(self.reason(rules=self.rules(json.dumps(doc))), 'missing_input')
        self.wrapper(seconds=2, inputs={'flake_lock_sha256': self.good, 'toolchain_sha256': 'f' * 64,
                                         'wrapper_sha256': 'e' * 64})
        self.assertEqual(self.f.verify(self.tree, rules=self.rules(json.dumps(doc)))[0], 0)

    def host_policy(self, **level):
        doc = json.loads(policy_text(trust_levels=['machine', 'host']))
        wrapper = doc['checks']['unit']['kinds']['wrapper']
        wrapper['by_level'] = {'host': dict({'command': ['local', 'run'], 'required_inputs': ['flake_lock_sha256'],
                                              'bind_inputs': {'flake_lock_sha256': 'file.txt'}, 'events': ['pull_request']}, **level)}
        return json.dumps(doc)

    def host_note(self, **kwargs):
        defaults = dict(runner='wrapper', command=('local', 'run'), inputs={'flake_lock_sha256': self.good})
        defaults.update(kwargs)
        if not hasattr(self, 'host_key'):
            self.host_key = self.f.key('hostkey', 'host/box')
        return self.f.note(self.commit, self.tree, self.host_key, 'host/box', **defaults)

    def test_a_signer_level_can_have_its_own_command_inputs_and_events(self):
        # Without by_level the host level is not even accepted for the check; with it, only its own rule applies.
        self.host_note()
        self.assertEqual(self.reason(rules=self.rules(policy_text(trust_levels=['machine']))), 'untrusted_level')
        code, result = self.f.verify(self.tree, rules=self.rules(self.host_policy()))
        self.assertEqual(code, 0, result)
        self.assertEqual((result['kind'], result['events'], result['trust_level']), ('wrapper', ['pull_request'], 'host'))
        # The ordinary signer is still held to the ordinary wrapper rule (its command and required inputs), with no events limit.
        self.wrapper(seconds=5)
        code, result = self.f.verify(self.tree, rules=self.rules(self.host_policy()))
        self.assertEqual((code, result['trust_level'], result['events']), (0, 'machine', None))

    def test_a_host_note_with_the_ordinary_command_or_missing_its_inputs_is_refused(self):
        self.host_note(command=('make', 'test'))
        self.assertEqual(self.reason(rules=self.rules(self.host_policy())), 'wrong_command')
        self.host_note(seconds=1, inputs={})
        self.assertEqual(self.reason(rules=self.rules(self.host_policy())), 'missing_input')
        self.host_note(seconds=2, inputs={'flake_lock_sha256': hashlib.sha256(b'other').hexdigest()})
        self.assertEqual(self.reason(rules=self.rules(self.host_policy())), 'wrong_input')

    def test_by_level_is_validated_strictly(self):
        def reason(edit):
            doc = json.loads(self.host_policy())
            edit(doc['checks']['unit']['kinds']['wrapper']['by_level'])
            try:
                self.rules(json.dumps(doc))
            except evidence_verify.Failure as error:
                return error.reason
            return 'accepted'
        self.assertEqual(reason(lambda b: None), 'accepted')
        self.assertEqual(reason(lambda b: b['host'].update(typo=1)), 'error')
        self.assertEqual(reason(lambda b: b['host'].pop('command')), 'error')
        self.assertEqual(reason(lambda b: b['host'].update(command=[])), 'error')
        self.assertEqual(reason(lambda b: b['host'].pop('events')), 'error')  # required: no events would mean every event
        self.assertEqual(reason(lambda b: b['host'].update(events=[])), 'error')
        self.assertEqual(reason(lambda b: b['host'].update(events=['pull_request', 'pull_request'])), 'error')
        self.assertEqual(reason(lambda b: b['host'].update(events=['push'])), 'error')
        self.assertEqual(reason(lambda b: b.update(unlisted={'command': ['x']})), 'error')  # a level the kind does not accept
        self.assertEqual(reason(lambda b: b.update({'': {'command': ['x']}})), 'error')

    def test_a_bound_input_must_equal_the_file_in_the_verified_tree(self):
        self.wrapper(inputs={'flake_lock_sha256': hashlib.sha256(b'other').hexdigest(), 'toolchain_sha256': 'f' * 64})
        self.assertEqual(self.reason(), 'wrong_input')
        self.wrapper(seconds=1)
        self.assertEqual(self.f.verify(self.tree, rules=self.rules())[0], 0)

    def test_trust_levels_runner_prefix_and_age_come_from_the_policy(self):
        self.observed(runner='github:org/other/actions/runs/7/attempts/1/jobs/9')
        self.assertEqual(self.reason(), 'wrong_runner')
        self.observed(seconds=1)
        self.assertEqual(self.reason(rules=self.rules(policy_text(trust_levels=['fleet']))), 'untrusted_level')
        # No max_age_s means no age limit: a note a year old is fine; a note from the future never is.
        old_commit, old_tree = self.f.commit('old')
        self.f.note(old_commit, old_tree, self.ci, 'machine/ci1', runner=OBSERVED,
                    command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'),
                    seconds=-365 * 24 * 3600)
        self.assertEqual(self.f.verify(old_tree, rules=self.rules())[0], 0)
        code, result = self.f.verify(old_tree, rules=self.rules(policy_text(max_age_s=3600)))
        self.assertEqual((code, result['reason']), (1, 'too_old'))
        future_commit, future_tree = self.f.commit('future')
        self.f.note(future_commit, future_tree, self.ci, 'machine/ci1', runner=OBSERVED,
                    command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'), seconds=3 * 3600)
        code, result = self.f.verify(future_tree, rules=self.rules())
        self.assertEqual((code, result['reason']), (1, 'future_dated'))

    def test_a_weaker_signer_admitted_for_wrapper_notes_never_satisfies_the_observed_rule(self):
        weak = self.f.key('weak', 'local/ci')
        doc = json.loads(policy_text(trust_levels=['fleet', 'machine']))
        doc['checks']['unit']['kinds']['wrapper']['trust_levels'] = ['fleet', 'machine', 'local']
        rules = self.rules(json.dumps(doc))
        flake = {'flake_lock_sha256': self.good, 'toolchain_sha256': 'f' * 64}
        # The weak signer imitates the central observer exactly: runner, command, everything the record says.
        self.f.note(self.commit, self.tree, weak, 'local/ci', runner=OBSERVED,
                    command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'))
        code, result = self.f.verify(self.tree, rules=rules)
        self.assertEqual((code, result['reason']), (1, 'untrusted_level'))
        # It cannot dress an observed-looking command in a wrapper record either: the wrapper rule has its own command.
        self.f.note(self.commit, self.tree, weak, 'local/ci', runner='wrapper', seconds=1, inputs=flake,
                    command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'))
        code, result = self.f.verify(self.tree, rules=rules)
        self.assertEqual((code, result['reason']), (1, 'wrong_command'))
        # Admitted explicitly for wrapper notes, with the wrapper's own command and inputs, it passes as a wrapper.
        self.f.note(self.commit, self.tree, weak, 'local/ci', runner='wrapper', seconds=2, inputs=flake)
        code, result = self.f.verify(self.tree, rules=rules)
        self.assertEqual((code, result['kind'], result['trust_level']), (0, 'wrapper', 'local'))
        # Without that explicit per-kind grant the same wrapper note is refused: no silent promotion.
        strict = self.rules(policy_text(trust_levels=['fleet', 'machine']))
        code, result = self.f.verify(self.tree, rules=strict)
        self.assertEqual((code, result['reason']), (1, 'untrusted_level'))
        # And a newer failing wrapper note from the weak signer still stops a skip of the observed record.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner=OBSERVED, seconds=3,
                    command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'))
        self.f.note(self.commit, self.tree, weak, 'local/ci', runner='wrapper', seconds=4, inputs=flake, exit_code=1)
        code, result = self.f.verify(self.tree, rules=rules)
        self.assertEqual((code, result['reason']), (1, 'check_failed'))

    def test_a_per_kind_trust_level_list_is_validated(self):
        for bad in ([], [''], 'fleet', [1]):
            doc = json.loads(policy_text())
            doc['checks']['unit']['kinds']['wrapper']['trust_levels'] = bad
            with self.assertRaises(evidence_verify.Failure, msg=repr(bad)) as caught:
                self.rules(json.dumps(doc))
            self.assertEqual(caught.exception.reason, 'error')

    def test_the_cli_reads_the_policy_from_the_accepted_base(self):
        self.observed()
        (self.f.repo / '.st').mkdir(exist_ok=True)
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        (self.f.repo / '.st/evidence-skip-policy.json').write_text(policy_text())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'policy')
        base = self.f.git('rev-parse', 'HEAD')
        args = ('--tree', self.tree, '--check', 'unit', '--keys-from', base, '--policy-from', base,
                '--repository', 'org/repo')
        code, out, _ = self.f.cli(*args)
        self.assertEqual((code, json.loads(out)['policy']), (0, True), out)
        code, out, _ = self.f.cli(*args[:-1], 'org/other')  # another repository's placeholders
        self.assertEqual((code, json.loads(out)['reason']), (1, 'wrong_runner'))
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'absent', '--keys-from', base,
                                  '--policy-from', base, '--repository', 'org/repo')
        self.assertEqual((code, json.loads(out)['reason']), (1, 'no_policy'))
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', base,
                                  '--policy-from', self.commit, '--repository', 'org/repo')  # no policy file there
        self.assertEqual((code, json.loads(out)['reason']), (1, 'no_policy'))
        for mixed in (['--max-age', '60'], ['--kinds', 'nix'], ['--command', '["x"]'], ['--trust-levels', 'machine']):
            self.assertEqual(self.f.cli(*args, *mixed)[0], 2, mixed)
        self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', base,
                                    '--policy-from', base)[0], 2)  # needs --repository
        self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', base,
                                    '--repository', 'org/repo')[0], 2)  # only with --policy-from


def two_check_policy(unit_require=None, other_require=None):
    """Two checks, `unit` and `other`, each accepting only the observed kind, with their own `require` mode."""
    doc = json.loads(policy_text())
    unit = doc['checks']['unit']
    del unit['kinds']['wrapper']
    other = json.loads(json.dumps(unit))
    other['kinds']['observed']['command'] = ['github-actions', '{repository}', '.github/workflows/fleet.yml', '{check}']
    doc['checks']['other'] = other
    if unit_require is not None:
        unit['require'] = unit_require
    if other_require is not None:
        other['require'] = other_require
    return json.dumps(doc)


class RequireAll(unittest.TestCase):
    """`require` is the mode for rejecting an unsigned change at queue entry: off / shadow / reject, judged per check."""

    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.commit, self.tree = self.f.commit('one')

    def note(self, check, **kwargs):
        defaults = dict(runner=OBSERVED, command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', check), check=check)
        defaults.update(kwargs)
        key = defaults.pop('key', self.ci)
        signer = defaults.pop('signer', 'machine/ci1')
        return self.f.note(self.commit, self.tree, key, signer, **defaults)

    def judge(self, text):
        return evidence_verify.require_all(str(self.f.repo), self.tree, str(self.f.keys), text, 'org/repo')

    def test_require_defaults_to_off_and_is_validated_strictly(self):
        self.assertEqual(evidence_verify.policy_rules(policy_text(), 'unit', 'org/repo')['require'], 'off')
        for mode in ('off', 'shadow', 'reject'):
            self.assertEqual(evidence_verify.policy_rules(two_check_policy(mode), 'unit', 'org/repo')['require'], mode)
        for bad in ('yes', True, False, 1, None, 'Reject', ['reject'], ''):
            doc = json.loads(two_check_policy())
            doc['checks']['unit']['require'] = bad
            with self.assertRaises(evidence_verify.Failure) as caught:
                evidence_verify.policy_rules(json.dumps(doc), 'unit', 'org/repo')
            self.assertEqual(caught.exception.reason, 'error', repr(bad))

    def test_a_check_with_require_off_is_not_judged_and_nothing_required_is_ok(self):
        result = self.judge(two_check_policy())
        self.assertEqual((result['decision'], result['satisfied'], result['lanes']), ('ok', True, {}))

    def test_shadow_reports_would_reject_and_reject_rejects_and_each_lane_names_its_own_reason(self):
        result = self.judge(two_check_policy('shadow', 'reject'))
        self.assertEqual(result['decision'], 'reject')
        self.assertFalse(result['satisfied'])
        self.assertEqual({k: (v['decision'], v['reason']) for k, v in result['lanes'].items()},
                         {'other': ('reject', 'no_record'), 'unit': ('would-reject', 'no_record')})
        self.note('other')
        result = self.judge(two_check_policy('shadow', 'reject'))
        self.assertEqual(result['decision'], 'would-reject')  # only the shadow lane is missing now
        self.assertEqual(result['lanes']['other']['decision'], 'ok')
        self.assertEqual(result['lanes']['other']['signer'], 'machine/ci1')
        self.note('unit')
        result = self.judge(two_check_policy('shadow', 'reject'))
        self.assertEqual((result['decision'], result['satisfied']), ('ok', True))

    def test_every_refusal_reason_reaches_the_lane_it_belongs_to(self):
        self.f.key('stranger')  # a key that is not on the list
        stranger = self.f.root / 'stranger'
        old_tree = self.tree
        later, _ = self.f.commit('two')  # the tree under test moves on: notes for the first one are now for another tree
        self.tree = self.f.git('rev-parse', 'HEAD^{tree}')
        command = ('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit')
        def good(key=None, **kwargs):
            options = dict(runner=OBSERVED, command=command)
            options.update(kwargs)
            return lambda: self.f.note(later, self.tree, key or self.ci, 'machine/ci1', **options)
        cases = {
            'no_record': (None, lambda: None),
            'stale_tree': (None, lambda: self.f.note(self.commit, old_tree, self.ci, 'machine/ci1', runner=OBSERVED, command=command)),
            'bad_signature': (None, good(sign=False)),
            'untrusted_signer': (None, good(key=stranger)),
            'untrusted_level': (['fleet'], good()),
            'wrong_command': (None, good(command=('make', 'less'))),
            'check_failed': (None, good(exit_code=1)),
            'wrong_runner': (None, good(runner='github:other/repo/actions/runs/7/attempts/1/jobs/9')),
        }
        for reason, (levels, make) in cases.items():
            with self.subTest(reason=reason):
                for ref in self.f.git('for-each-ref', '--format=%(refname)', 'refs/notes/evidence/').split():
                    self.f.git('update-ref', '-d', ref)
                doc = json.loads(two_check_policy('reject'))
                if levels:
                    doc['checks']['unit']['trust_levels'] = levels
                make()
                lane = self.judge(json.dumps(doc))['lanes']['unit']
                self.assertEqual((lane['satisfied'], lane['decision'], lane['reason']), (False, 'reject', reason), lane)

    def test_a_forged_note_under_a_valid_looking_ref_from_an_untrusted_key_is_refused(self):
        self.f.key('forger')
        record = self.note('unit', key=self.f.root / 'forger', signer='machine/ci1')
        self.assertEqual(self.f.git('for-each-ref', '--format=%(refname)', 'refs/notes/evidence/'), f'refs/notes/evidence/{record}')
        lane = self.judge(two_check_policy('reject'))['lanes']['unit']
        self.assertEqual((lane['satisfied'], lane['reason']), (False, 'untrusted_signer'))

    def test_the_cli_exit_code_is_one_only_when_a_reject_lane_fails_and_it_reads_the_base_policy(self):
        (self.f.repo / '.st').mkdir(exist_ok=True)
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        for mode, expected in (('off', (0, 'ok')), ('shadow', (0, 'would-reject')), ('reject', (1, 'reject'))):
            base = self._base(two_check_policy(mode, 'off'))
            code, out, _ = self.f.cli('--tree', self.tree, '--require-all', '--keys-from', base, '--policy-from', base, '--repository', 'org/repo')
            self.assertEqual((code, json.loads(out)['decision']), (expected[0], expected[1]), (mode, out))
        # a pull request's own copy of the policy is not read: asking for the commit without a policy is an error, never a reject
        code, out, _ = self.f.cli('--tree', self.tree, '--require-all', '--keys-from', base, '--policy-from', self.commit, '--repository', 'org/repo')
        self.assertEqual((code, json.loads(out)['decision'], json.loads(out)['reason']), (2, 'error', 'no_policy'))
        for bad in (['--check', 'unit'], ['--project'], ['--command', '["x"]'], ['--kinds', 'observed'], ['--max-age', '60']):
            self.assertEqual(self.f.cli('--tree', self.tree, '--require-all', '--keys-from', base, '--policy-from', base,
                                        '--repository', 'org/repo', *bad)[0], 2, bad)
        self.assertEqual(self.f.cli('--tree', self.tree, '--require-all', '--keys-from', base)[0], 2)  # needs the policy and repository
        self.assertEqual(self.f.cli('--tree', self.tree, '--keys-from', base)[0], 2)  # without --require-all, --check is still required

    def test_a_verifier_that_cannot_decide_exits_two_with_decision_error_never_zero_or_one(self):
        def run_cli(text):
            base = self._base(text)
            return self.f.cli('--tree', self.tree, '--require-all', '--keys-from', base, '--policy-from', base, '--repository', 'org/repo')
        broken = json.loads(two_check_policy('reject'))
        broken['checks']['unit']['require'] = 'sometimes'
        no_command = json.loads(two_check_policy('reject'))
        del no_command['checks']['unit']['kinds']['observed']['command']  # a kind rule without a command is a policy error
        no_level_command = json.loads(two_check_policy('reject'))
        no_level_command['checks']['unit']['kinds']['observed']['by_level'] = {'machine': {'events': ['pull_request']}}
        for name, text in (('invalid json', 'not json'), ('unknown top-level key', json.dumps({'version': 1, 'checks': {}, 'x': 1})),
                           ('invalid require', json.dumps(broken)), ('kind without a command', json.dumps(no_command)),
                           ('by_level without a command', json.dumps(no_level_command))):
            code, out, _ = run_cli(text)
            document = json.loads(out)
            self.assertEqual((code, document['decision'], document['satisfied'], document['reason']), (2, 'error', False, 'error'), (name, out))
        # a base commit that has no policy file at all
        base = self._base('{}')
        self.f.git('rm', '-q', '.st/evidence-skip-policy.json')
        self.f.git('commit', '-q', '-m', 'no policy')
        base = self.f.git('rev-parse', 'HEAD')
        code, out, _ = self.f.cli('--tree', self.tree, '--require-all', '--keys-from', base, '--policy-from', base, '--repository', 'org/repo')
        self.assertEqual((code, json.loads(out)['decision'], json.loads(out)['reason']), (2, 'error', 'no_policy'))
        # an unreadable key list and an unexpected exception inside the judging both end as errors too
        base = self._base(two_check_policy('reject'))
        code, out, _ = self.f.cli('--tree', self.tree, '--require-all', '--keys', str(self.f.root / 'missing-keys'), '--policy-from', base, '--repository', 'org/repo')
        self.assertEqual((code, json.loads(out)['decision']), (2, 'error'))
        import contextlib, io
        original = evidence_verify.require_all
        evidence_verify.require_all = lambda *a, **k: (_ for _ in ()).throw(RuntimeError('boom'))
        try:
            out = io.StringIO()
            with contextlib.redirect_stdout(out):
                code = evidence_verify.main(['--repo', str(self.f.repo), '--tree', self.tree, '--require-all', '--keys-from', base,
                                             '--policy-from', base, '--repository', 'org/repo'])
        finally:
            evidence_verify.require_all = original
        self.assertEqual((code, json.loads(out.getvalue())['decision'], json.loads(out.getvalue())['detail']), (2, 'error', 'RuntimeError: boom'))

    def test_a_lane_is_always_held_to_the_recorded_argv_of_its_kind_because_a_kind_cannot_omit_one(self):
        # (intake-b) require_all passes no command of its own; the kind's rule always supplies one, so a note that ran anything else fails
        self.note('unit', command=('make', 'less'))
        lane = self.judge(two_check_policy('reject'))['lanes']['unit']
        self.assertEqual((lane['satisfied'], lane['reason']), (False, 'wrong_command'))

    def _base(self, text):
        (self.f.repo / '.st').mkdir(exist_ok=True)
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        (self.f.repo / '.st/evidence-skip-policy.json').write_text(text)
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'policy')
        return self.f.git('rev-parse', 'HEAD')


LANES = {'version': 1, 'lanes': {'unit': {'argv': ['make', 'test'], 'definition_paths': ['config/x.json', 'scripts'], 'tree_inputs': ['src']}}}


class LaneDefinitions(unittest.TestCase):
    """A lane is the argv plus the bytes of the scripts that decide what it runs, as they are at the accepted base."""

    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.base_commit, self.base_tree = self.files({'scripts/run.sh': 'run\n', 'scripts/sub/more.sh': 'more\n',
                                                       'config/x.json': '{}\n', 'src/code.rs': 'one\n',
                                                       '.st/required-lanes.json': json.dumps(LANES)})

    def files(self, changes):
        for name, content in changes.items():
            path = self.f.repo / name
            if content is None:
                path.unlink(missing_ok=True)
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '--allow-empty', '-m', 'step')
        return self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')

    def rules(self, text=None, lane='unit'):
        return evidence_verify.lane_rules(text or json.dumps(LANES), lane)

    def definition(self, tree):
        return evidence_verify.lane_definition(str(self.f.repo), self.base_tree, tree, self.rules())

    def note(self, commit, tree, digest, **kwargs):
        inputs = {} if digest is None else {'lane_definition_sha256': digest}
        return self.f.note(commit, tree, self.ci, 'machine/ci1', command=('make', 'test'), inputs=inputs, **kwargs)

    def verdict(self, tree, lane):
        return self.f.verify(tree, command=['make', 'test'], lane=lane)

    def test_the_lane_file_is_validated_strictly(self):
        def broken(edit, lane='unit'):
            doc = json.loads(json.dumps(LANES))
            edit(doc)
            with self.assertRaises(evidence_verify.Failure) as caught:
                evidence_verify.lane_rules(json.dumps(doc), lane)
            return caught.exception.reason
        entry = lambda d: d['lanes']['unit']
        self.assertEqual(broken(lambda d: d.update(surprise=1)), 'error')
        self.assertEqual(broken(lambda d: d.update(version=2)), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(typo=1)), 'error')
        self.assertEqual(broken(lambda d: entry(d).pop('argv')), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(argv=[])), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(argv=['make', 1])), 'error')
        self.assertEqual(broken(lambda d: entry(d).pop('definition_paths')), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(definition_paths=[])), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(definition_paths=['.'])), 'error')  # the whole tree is not a definition
        self.assertEqual(broken(lambda d: entry(d).update(definition_paths=['../x'])), 'error')
        self.assertEqual(broken(lambda d: entry(d).update(tree_inputs=['/abs'])), 'error')
        self.assertEqual(broken(lambda d: None, lane='absent'), 'no_lane')
        with self.assertRaises(evidence_verify.Failure) as caught:
            evidence_verify.lane_rules('not json', 'unit')
        self.assertEqual(caught.exception.reason, 'error')

    def test_the_digest_covers_the_argv_and_every_byte_and_mode_below_the_listed_paths(self):
        first = self.definition(self.base_tree)
        self.assertEqual(first['changed'], [])
        self.assertEqual(first['sha256'], self.definition(self.base_tree)['sha256'])
        rules = self.rules()
        again = evidence_verify.lane_definition(str(self.f.repo), self.base_tree, self.base_tree, dict(rules, argv=['make', 'less']))
        self.assertNotEqual(first['sha256'], again['sha256'])  # another argv is another lane
        for change in ({'scripts/run.sh': 'run!\n'}, {'scripts/sub/more.sh': 'more!\n'}, {'config/x.json': '[]\n'},
                       {'scripts/new.sh': 'new\n'}, {'scripts/sub/more.sh': None}):
            _, tree = self.files(change)
            moved = evidence_verify.lane_definition(str(self.f.repo), tree, tree, self.rules())
            self.assertNotEqual(first['sha256'], moved['sha256'], change)
            self.files({k: v for k, v in {'scripts/run.sh': 'run\n', 'scripts/sub/more.sh': 'more\n', 'config/x.json': '{}\n'}.items()})
            self.files({'scripts/new.sh': None} if (self.f.repo / 'scripts/new.sh').exists() else {})
        _, tree = self.files({'src/code.rs': 'two\n'})  # a tree input is not part of the definition
        self.assertEqual(self.definition(tree)['changed'], [])
        self.assertEqual(self.definition(tree)['sha256'], first['sha256'])
        _, tree = self.files({'scripts-other/x.sh': 'x\n'})  # a sibling with the same prefix is not below scripts
        self.assertEqual(self.definition(tree)['changed'], [])
        with self.assertRaises(evidence_verify.Failure) as caught:
            evidence_verify.lane_definition(str(self.f.repo), self.base_tree, self.base_tree, dict(rules, definition_paths=('absent.sh',)))
        self.assertEqual(caught.exception.reason, 'error')  # a listed path missing at the base is a lane-file error

    def test_a_note_that_carries_the_base_digest_for_an_unchanged_definition_satisfies_the_lane(self):
        digest = self.definition(self.base_tree)
        commit, tree = self.files({'src/code.rs': 'three\n'})  # the change under test touches only a tree input
        self.note(commit, tree, digest['sha256'])
        code, result = self.verdict(tree, self.definition(tree))
        self.assertEqual((code, result['satisfied']), (0, True), result)

    def test_wrong_definition_when_the_note_has_no_digest_or_another_one(self):
        commit, tree = self.files({'src/code.rs': 'four\n'})
        lane = self.definition(tree)
        self.note(commit, tree, None)
        self.assertEqual(self.verdict(tree, lane)[1]['reason'], 'wrong_definition')  # an old note without the input
        self.note(commit, tree, 'f' * 64)
        self.assertEqual(self.verdict(tree, lane)[1]['reason'], 'wrong_definition')
        # a digest made against other scripts (an older base) is not this lane's either
        older = self.definition(self.base_tree)['sha256']
        self.files({'scripts/run.sh': 'changed at the base\n'})
        newer_base = self.f.git('rev-parse', 'HEAD^{tree}')
        commit, tree = self.files({'src/code.rs': 'five\n'})
        lane = evidence_verify.lane_definition(str(self.f.repo), newer_base, tree, self.rules())
        self.note(commit, tree, older)
        self.assertEqual(self.verdict(tree, lane)[1]['reason'], 'wrong_definition')

    def test_definition_changed_when_the_signed_tree_edits_adds_or_deletes_a_listed_blob(self):
        digest = self.definition(self.base_tree)['sha256']
        for change in ({'scripts/run.sh': 'run, but fewer tests\n'}, {'scripts/extra.sh': 'x\n'}, {'config/x.json': None},
                       {'scripts/sub/more.sh': None}):
            commit, tree = self.files(change)
            self.note(commit, tree, digest)  # the note even carries the base's digest: it still must not count
            lane = self.definition(tree)
            self.assertTrue(lane['changed'], change)
            code, result = self.verdict(tree, lane)
            self.assertEqual((code, result['reason']), (1, 'definition_changed'), (change, result))
            self.assertIn(sorted(change)[0], result['detail'])
            self.base_tree = self.base_tree  # the base stays fixed; restore the files for the next case
            self.files({'scripts/run.sh': 'run\n', 'scripts/sub/more.sh': 'more\n', 'config/x.json': '{}\n', 'scripts/extra.sh': None})

    def test_a_check_without_a_lane_is_unsatisfied_under_require_all_when_a_lane_file_is_given(self):
        policy = two_check_policy('reject', 'reject')
        self.f.key('x')
        commit, tree = self.files({'src/code.rs': 'six\n'})
        result = evidence_verify.require_all(str(self.f.repo), tree, str(self.f.keys), policy, 'org/repo',
                                             (json.dumps(LANES), self.base_commit))
        self.assertEqual({k: (v['decision'], v['reason']) for k, v in result['lanes'].items()},
                         {'other': ('reject', 'no_lane'), 'unit': ('reject', 'no_record')})  # `other` has no lane entry; `unit` has one and no note yet
        broken = json.dumps({'version': 1, 'lanes': {'unit': {'argv': []}}})
        with self.assertRaises(evidence_verify.Failure) as caught:
            evidence_verify.require_all(str(self.f.repo), tree, str(self.f.keys), policy, 'org/repo', (broken, self.base_commit))
        self.assertEqual(caught.exception.reason, 'error')  # a broken lane file is an error, not a reject

    def test_the_cli_takes_the_lane_file_from_the_accepted_base(self):
        digest = self.definition(self.base_tree)['sha256']
        commit, tree = self.files({'src/code.rs': 'seven\n'})
        self.note(commit, tree, digest)
        keys = self.f.root / 'allowed-signers'
        args = ('--tree', tree, '--check', 'unit', '--keys', str(keys), '--command', '["make","test"]')
        code, out, _ = self.f.cli(*args, '--lanes-from', self.base_commit)
        self.assertEqual((code, json.loads(out)['satisfied']), (0, True), out)
        code, out, _ = self.f.cli(*args)  # without the flag nothing about the lane is checked (the old behaviour)
        self.assertEqual(code, 0, out)
        code, out, _ = self.f.cli(*args[:3], 'absent', *args[4:], '--lanes-from', self.base_commit)
        self.assertEqual(json.loads(out)['reason'], 'no_lane')
        code, out, _ = self.f.cli(*args, '--lanes-from', commit.replace(commit[:4], 'ffff', 1))  # not a commit
        self.assertEqual((code, json.loads(out)['reason']), (1, 'error'))
        bad = self.files({'.st/required-lanes.json': 'not json'})[0]
        code, out, _ = self.f.cli(*args, '--lanes-from', bad)
        self.assertEqual((code, json.loads(out)['reason']), (1, 'error'))


class CommittedPolicy(unittest.TestCase):
    """The policy file in this repository, parsed by the same code the gate runs."""

    def rules(self, check):
        text = (ROOT / '.st/evidence-skip-policy.json').read_text()
        return evidence_verify.policy_rules(text, check, 'compoundingtech/smalltalk')

    def test_the_committed_lane_file_is_valid_exists_at_head_and_matches_what_st_test_runs(self):
        text = (ROOT / '.st/required-lanes.json').read_text()
        loader = importlib.machinery.SourceFileLoader('st_test_script', str(ROOT / 'scripts/st-test'))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
        policy = (ROOT / '.st/evidence-skip-policy.json').read_text()
        for lane, command in module.LOCAL.items():
            rules = evidence_verify.lane_rules(text, lane)
            self.assertEqual(rules['argv'], command, lane)  # the lane is what the local producer runs
            for path in rules['definition_paths']:
                self.assertTrue((ROOT / path).exists(), path)
            declared = evidence_verify.policy_rules(policy, lane, 'compoundingtech/smalltalk')['inputs']
            if declared is not None:
                self.assertEqual(rules['tree_inputs'], declared, lane)  # what the lane tests is what the policy declares as inputs
        self.assertEqual(set(json.loads(text)['lanes']), set(module.LOCAL))

    def test_no_committed_check_requires_a_signed_note_yet(self):
        text = (ROOT / '.st/evidence-skip-policy.json').read_text()
        for check in json.loads(text)['checks']:
            self.assertEqual(evidence_verify.policy_rules(text, check, 'compoundingtech/smalltalk')['require'], 'off', check)

    def test_declared_inputs_are_exactly_the_reviewed_list_and_all_exist(self):
        # Written out here: changing what a check depends on is a reviewed change to the policy AND to this list.
        declared = {'typescript-client': sorted([
            'apps/fractal-web/package.json', 'apps/fractal-web/packages/st3-sdk/package.json', 'apps/ios',
            'clients/typescript', 'crates/stui/tests/fixtures/quality-hour.json', 'docs/st3/client-v0/fixtures',
            'fixtures/clients', 'flake.lock', 'flake.nix', 'package.json', 'packages/fractal-ui/package.json',
            'pnpm-lock.yaml', 'pnpm-workspace.yaml', 'scripts/ci-typescript-client'])}
        for check in ('linux-gate', 'typescript-client', 'isolation-vm', 'genie-freshness', 'mail-redelivery-canaries'):
            rules = self.rules(check)
            self.assertEqual(sorted(rules['inputs']) if rules['inputs'] else None, declared.get(check), check)
            for path in rules['inputs'] or ():
                self.assertTrue((ROOT / path).exists(), f'{check} declares {path}, which does not exist')
        self.assertEqual(self.rules('typescript-client')['sample_one_in'], 5)

    def test_the_host_level_is_admitted_for_exactly_two_checks_wrapper_kind_and_covers_pull_requests_only(self):
        policy = json.loads((ROOT / '.st/evidence-skip-policy.json').read_text())
        # Nothing enforces anywhere: every check, not only the host ones, keeps enforce false until the flip PR.
        self.assertEqual({check: entry.get('enforce', False) for check, entry in policy['checks'].items()},
                         {check: False for check in policy['checks']})
        with_host = {}
        for check, entry in policy['checks'].items():
            for kind, rule in entry['kinds'].items():
                if 'host' in (rule.get('trust_levels') or []) or 'host' in (rule.get('by_level') or {}):
                    with_host[(check, kind)] = rule
            self.assertNotIn('host', entry['trust_levels'], check)  # never the check's own list, so never `observed`
        self.assertEqual(sorted(with_host), [('genie-freshness', 'wrapper'), ('typescript-client', 'wrapper')])
        for (check, kind), rule in with_host.items():
            self.assertEqual(rule['trust_levels'], ['fleet', 'host'], check)
            override = rule['by_level']['host']
            self.assertEqual(override['events'], ['pull_request'], check)
            self.assertEqual(override['bind_inputs'], {'flake_lock_sha256': 'flake.lock'}, check)
            self.assertEqual(policy['checks'][check].get('enforce', False), False, check)
            rules = self.rules(check)
            self.assertEqual(rules['kinds']['wrapper']['by_level']['host']['events'], ['pull_request'])
        # The commands are the ones scripts/st-test records, so a local note can match.
        script = ROOT / 'scripts/st-test'
        if script.exists():
            loader = importlib.machinery.SourceFileLoader('st_test_policy', str(script))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            st_test = importlib.util.module_from_spec(spec)
            loader.exec_module(st_test)
            for (check, kind), rule in with_host.items():
                self.assertEqual(rule['by_level']['host']['command'], st_test.LOCAL[check], check)

    def test_every_required_check_has_a_valid_entry_that_accepts_only_the_fleet_signer(self):
        for check in ('linux-gate', 'typescript-client', 'isolation-vm', 'genie-freshness', 'mail-redelivery-canaries'):
            rules = self.rules(check)
            self.assertEqual(rules['trust_levels'], ('fleet',), check)
            self.assertIsNone(rules['max_age_s'], check)  # no age limit by default
            self.assertIs(rules['enforce'], False, check)  # skipping is off until the policy says otherwise
            observed = rules['kinds']['observed']
            self.assertEqual(observed['command'], ['github-actions', 'compoundingtech/smalltalk',
                                                   '.github/workflows/fleet.yml', check])
            self.assertEqual(observed['runner_prefix'], 'github:compoundingtech/smalltalk/')
        with self.assertRaises(evidence_verify.Failure):
            self.rules('a-check-nobody-listed')

    def test_the_wrapper_rules_match_what_the_note_jobs_record(self):
        gate = self.rules('linux-gate')['kinds']['wrapper']
        self.assertEqual(gate['command'][:2], ['linux-gate', 'aggregate'])
        jobs = gate['command'][2:]
        self.assertEqual(jobs, sorted(jobs))  # the aggregate lists its needed jobs sorted
        self.assertIn('linux-gate', jobs)
        common = ['attempt', 'flake_lock_sha256', 'system', 'toolchain_sha256', 'wrapper_sha256']
        self.assertEqual(gate['required_inputs'], common)
        self.assertEqual(gate['bind_inputs'], {'flake_lock_sha256': 'flake.lock'})
        canaries = self.rules('mail-redelivery-canaries')['kinds']['wrapper']
        self.assertEqual(canaries['command'], ['bash', 'scripts/ci-linux', 'mail-redelivery-canaries'])
        self.assertEqual(canaries['required_inputs'], sorted(common + ['job', 'stage']))
        self.assertEqual(canaries['bind_inputs'], {'flake_lock_sha256': 'flake.lock'})

    def test_the_step_outcome_notes_of_the_other_three_checks_have_their_own_exact_rules(self):
        expected = {
            'genie-freshness': ['bash', 'scripts/ci-genie-freshness'],
            'typescript-client': ['bash', 'scripts/ci-typescript-client'],
            'isolation-vm': ['isolation-vm', 'nixos-test-driver', 'transport-isolation-vm', 'sekrets-vm'],
        }
        required = ['attempt', 'flake_lock_sha256', 'job', 'step_outcomes', 'steps', 'system', 'toolchain_sha256', 'wrapper_sha256']
        for check, command in expected.items():
            wrapper = self.rules(check)['kinds']['wrapper']
            self.assertEqual(wrapper['command'], command, check)
            self.assertEqual(wrapper['required_inputs'], required, check)
            self.assertEqual(wrapper['bind_inputs'], {'flake_lock_sha256': 'flake.lock'}, check)

    def test_every_required_check_lists_observed_and_wrapper_and_only_the_fleet_signer(self):
        for check in ('linux-gate', 'typescript-client', 'isolation-vm', 'genie-freshness', 'mail-redelivery-canaries'):
            rules = self.rules(check)
            self.assertEqual(sorted(rules['kinds']), ['observed', 'wrapper'], check)
            self.assertEqual(rules['trust_levels'], ('fleet',), check)  # the wrapper signs as fleet/ci
            # No weaker signer is admitted, except the host level for exactly two checks (see the test for the host level).
            host_checks = ('genie-freshness', 'typescript-client')
            self.assertEqual(rules['kinds']['wrapper']['trust_levels'], ('fleet', 'host') if check in host_checks else None, check)
            self.assertIsNone(rules['kinds']['observed']['trust_levels'], check)


class InputKeyed(unittest.TestCase):
    """A note of another tree counts when it carries the same key for the check's declared input paths."""

    PATHS = ['src', 'lock.txt']

    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.commit, self.tree = self.commit_files({'src/a.txt': 'a', 'lock.txt': 'L', 'docs/readme.txt': 'r'})
        self.rules = evidence_verify.policy_rules(policy_text(inputs=self.PATHS), 'unit', 'org/repo')

    def commit_files(self, files):
        for name, content in files.items():
            path = self.f.repo / name
            path.parent.mkdir(parents=True, exist_ok=True)
            if content is None:
                path.unlink()
            else:
                path.write_text(content)
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'change ' + ','.join(sorted(files)))
        return self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')

    def key(self, tree, paths=None):
        return evidence_verify.project(str(self.f.repo), tree, tuple(paths or self.PATHS))

    def observed(self, commit, tree, key, index=True, **kwargs):
        defaults = dict(runner=OBSERVED, command=('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'),
                        inputs={'source_inputs': key})
        defaults.update(kwargs)
        record = self.f.note(commit, tree, self.ci, 'machine/ci1', **defaults)
        if index:
            self.f.git('update-ref', f'refs/notes/evidence-input/unit/{key}/{record}', record)
        return record

    def check(self, tree):
        return self.f.verify(tree, rules=self.rules)

    def test_the_key_changes_with_a_declared_file_and_not_with_any_other(self):
        before = self.key(self.tree)
        _, undeclared = self.commit_files({'docs/readme.txt': 'edited', 'other/new.txt': 'n'})
        self.assertNotEqual(undeclared, self.tree)
        self.assertEqual(self.key(undeclared), before)
        _, declared = self.commit_files({'src/a.txt': 'changed'})
        self.assertNotEqual(self.key(declared), before)
        _, added = self.commit_files({'src/b.txt': 'new file'})
        self.assertNotEqual(self.key(added), self.key(declared))
        _, removed = self.commit_files({'src/b.txt': None})
        self.assertEqual(self.key(removed), self.key(declared))  # back to the same declared content
        _, locked = self.commit_files({'lock.txt': 'L2'})
        self.assertNotEqual(self.key(locked), self.key(removed))

    def listing(self, tree, *paths):
        return subprocess.run(['git', '-C', str(self.f.repo), 'ls-tree', '-r', '-z', '--full-tree', tree, '--', *paths],
                              capture_output=True, check=True).stdout

    def test_a_name_with_a_newline_cannot_project_one_file_as_two_entries(self):
        blob = self.f.git('rev-parse', 'HEAD:lock.txt')
        sneaky = f'src/x\n100644 {blob} 0\tsrc/injected'
        self.commit_files({sneaky: 'content'})
        tree = self.f.git('rev-parse', 'HEAD^{tree}')
        key = self.key(tree)
        # The projection holds exactly the entries the tree holds under the declared paths: the sneaky name is one file.
        self.assertEqual(self.listing(key), self.listing(tree, 'src', 'lock.txt'))
        names = [entry.partition(b'\t')[2] for entry in self.listing(key).split(b'\0') if entry]
        self.assertIn(sneaky.encode(), names)
        self.assertNotIn(b'src/injected', names)

    def test_a_symlink_and_a_gitlink_keep_their_modes_in_the_projection(self):
        link = self.f.repo / 'src/link'
        link.symlink_to('a.txt')
        gitlink = '1' * 40
        self.f.git('add', '-A')
        self.f.git('update-index', '--add', '--cacheinfo', f'160000,{gitlink},src/vendored')
        self.f.git('commit', '-q', '-m', 'link and gitlink')
        tree = self.f.git('rev-parse', 'HEAD^{tree}')
        key = self.key(tree)
        projected = self.listing(key)
        self.assertEqual(projected, self.listing(tree, 'src', 'lock.txt'))
        self.assertIn(b'120000 blob', projected)
        self.assertIn(f'160000 commit {gitlink}'.encode(), projected)
        # Retargeting the link or moving the gitlink changes the key.
        link.unlink()
        link.symlink_to('b.txt')
        self.f.git('add', '-A')
        self.f.git('update-index', '--add', '--cacheinfo', f'160000,{"2" * 40},src/vendored')
        self.f.git('commit', '-q', '-m', 'retarget')
        self.assertNotEqual(self.key(self.f.git('rev-parse', 'HEAD^{tree}')), key)

    def test_declared_paths_that_all_miss_give_no_key_and_match_nothing(self):
        self.assertIsNone(self.key(self.tree, ['nowhere', 'nothing/here']))
        empty = self.f.git('hash-object', '-t', 'tree', '/dev/null')
        # Even a record that claims the empty tree as its key and is indexed under it cannot be found by it.
        self.observed(self.commit, self.tree, empty)
        _, other = self.commit_files({'docs/readme.txt': 'edited'})
        rules = evidence_verify.policy_rules(policy_text(inputs=['nowhere']), 'unit', 'org/repo')
        code, result = self.f.verify(other, rules=rules)
        self.assertEqual((code, result['reason']), (1, 'stale_tree'))
        code, out, _ = self.f.cli('--project', '--check', 'unit', '--revision', 'HEAD', '--paths', 'nowhere')
        self.assertEqual((code, json.loads(out)['source_inputs']), (0, None))

    def test_the_reported_key_is_the_tree_key_even_when_the_rule_checks_required_inputs(self):
        self.commit_files({'file.txt': 'one'})
        commit, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        key = self.key(tree)
        self.f.note(commit, tree, self.ci, 'machine/ci1', runner='wrapper', command=('make', 'test'),
                    inputs={'flake_lock_sha256': hashlib.sha256(b'one').hexdigest(), 'toolchain_sha256': 'x'})
        rules = evidence_verify.policy_rules(policy_text(inputs=self.PATHS), 'unit', 'org/repo')
        code, result = self.f.verify(tree, rules=rules)
        self.assertEqual(code, 0, result)
        self.assertEqual((result['kind'], result['match'], result['source_inputs']), ('wrapper', 'tree', key))

    def test_the_key_depends_on_exactly_the_declared_paths(self):
        whole = self.key(self.tree, ['.'])
        self.assertEqual(whole, self.tree)  # declaring everything is the exact-tree rule
        self.assertNotEqual(self.key(self.tree), whole)
        self.assertNotEqual(self.key(self.tree, ['src']), self.key(self.tree, ['src', 'lock.txt']))
        self.assertEqual(self.key(self.tree, ['lock.txt', 'src']), self.key(self.tree, ['src', 'lock.txt']))
        self.assertEqual(self.key(self.tree, ['src', 'nowhere']), self.key(self.tree, ['src']))  # a missing path adds nothing

    def test_a_note_for_an_earlier_tree_satisfies_a_later_tree_with_the_same_key(self):
        key = self.key(self.tree)
        record = self.observed(self.commit, self.tree, key)
        _, later = self.commit_files({'docs/readme.txt': 'edited'})
        code, result = self.check(later)
        self.assertEqual(code, 0, result)
        self.assertEqual((result['match'], result['matched_tree'], result['source_inputs'], result['record'], result['tree']),
                         ('inputs', self.tree, key, record, later))
        # The exact tree is still found as before, and says so.
        code, result = self.check(self.tree)
        self.assertEqual((code, result['match']), (0, 'tree'))

    def test_a_changed_declared_file_finds_nothing(self):
        self.observed(self.commit, self.tree, self.key(self.tree))
        _, changed = self.commit_files({'src/a.txt': 'edited'})
        code, result = self.check(changed)
        self.assertEqual((code, result['reason']), (1, 'stale_tree'))

    def test_a_check_without_declared_inputs_never_matches_by_key(self):
        self.observed(self.commit, self.tree, self.key(self.tree))
        _, later = self.commit_files({'docs/readme.txt': 'edited'})
        plain = evidence_verify.policy_rules(policy_text(), 'unit', 'org/repo')
        code, result = self.f.verify(later, rules=plain)
        self.assertEqual((code, result['reason']), (1, 'stale_tree'))

    def test_the_index_ref_is_only_a_pointer_everything_must_still_verify(self):
        key = self.key(self.tree)
        _, later = self.commit_files({'docs/readme.txt': 'edited'})
        # Not indexed: found nothing.
        record = self.observed(self.commit, self.tree, key, index=False)
        self.assertEqual(self.check(later)[1]['reason'], 'stale_tree')
        # Indexed under a key the signed statement does not carry: ignored.
        other = '0' * len(key)
        self.f.git('update-ref', f'refs/notes/evidence-input/unit/{other}/{record}', record)
        self.assertEqual(self.check(later)[1]['reason'], 'stale_tree')
        # A ref whose suffix is not the record it points at: ignored.
        forged = self.observed(self.commit, self.tree, 'f' * len(key), index=False)
        self.f.git('update-ref', f'refs/notes/evidence-input/unit/{key}/{forged}', forged)  # the record says another key
        self.assertEqual(self.check(later)[1]['reason'], 'stale_tree')
        self.f.git('update-ref', f'refs/notes/evidence-input/unit/{key}/{"1" * len(key)}', record)
        self.assertEqual(self.check(later)[1]['reason'], 'stale_tree')
        # Properly indexed: found.
        self.f.git('update-ref', f'refs/notes/evidence-input/unit/{key}/{record}', record)
        self.assertEqual(self.check(later)[0], 0)

    def test_every_other_rule_applies_to_a_record_found_by_key(self):
        key = self.key(self.tree)
        _, later = self.commit_files({'docs/readme.txt': 'edited'})
        for label, kwargs, reason in (
                ('failed', dict(exit_code=1), 'check_failed'),
                ('degraded', dict(tier='degraded', sign=False), 'degraded'),
                ('wrong command', dict(command=('other',)), 'wrong_command'),
                ('wrong runner', dict(runner='github:elsewhere/repo/actions/runs/1'), 'wrong_runner'),
                ('unsigned', dict(sign=False), 'bad_signature'),
                ('future', dict(seconds=3600), 'future_dated')):
            with self.subTest(label):
                f = self.__class__('test_the_key_changes_with_a_declared_file_and_not_with_any_other')
                f.setUp()
                self.addCleanup(f.f.tmp.cleanup)
                k = f.key(f.tree)
                f.observed(f.commit, f.tree, k, **kwargs)
                _, newer = f.commit_files({'docs/readme.txt': 'edited'})
                code, result = f.check(newer)
                self.assertEqual((code, result['reason']), (1, reason), label)

    def test_a_newer_failure_with_the_same_key_stops_the_skip_by_itself(self):
        key = self.key(self.tree)
        self.observed(self.commit, self.tree, key)
        _, second = self.commit_files({'docs/readme.txt': 'edited'})
        self.assertEqual(self.check(second)[0], 0)
        self.observed(self.f.git('rev-parse', 'HEAD'), second, key, exit_code=1, seconds=60)  # same key, run for real, failed
        _, third = self.commit_files({'docs/readme.txt': 'edited again'})
        code, result = self.check(third)
        self.assertEqual((code, result['reason']), (1, 'check_failed'))
        self.observed(self.f.git('rev-parse', 'HEAD'), third, key, seconds=120)  # a newer pass lifts it
        _, fourth = self.commit_files({'docs/readme.txt': 'and again'})
        self.assertEqual(self.check(fourth)[0], 0)

    def test_the_policy_validates_inputs_and_sampling(self):
        def reason(**overrides):
            try:
                evidence_verify.policy_rules(policy_text(**overrides), 'unit', 'org/repo')
            except evidence_verify.Failure as failure:
                return failure.reason
            return 'accepted'
        self.assertEqual(reason(inputs=['src', 'lock.txt'], sample_one_in=5), 'accepted')
        for bad in ([], '', 'src', ['/etc'], ['../x'], ['a/../b'], ['a//b'], ['a/./b'], ['src*'], ['a b'], [1], ['x\n'],
                    ['a\\b'], [''], ['src', None]):
            self.assertEqual(reason(inputs=bad), 'error', repr(bad))
        self.assertEqual(reason(inputs=[f'p{i}' for i in range(301)]), 'error')
        for bad in (0, -1, 1001, True, 'five', 2.5, None):
            self.assertEqual(reason(sample_one_in=bad), 'error', repr(bad))
        rules = evidence_verify.policy_rules(policy_text(), 'unit', 'org/repo')
        self.assertEqual((rules['inputs'], rules['sample_one_in']), (None, 1))

    def test_project_on_the_command_line_prints_the_key_for_the_declared_paths(self):
        key = self.key(self.tree)
        code, out, _ = self.f.cli('--project', '--check', 'unit', '--revision', 'HEAD', '--paths', 'src,lock.txt')
        self.assertEqual((code, json.loads(out)['source_inputs']), (0, key))
        code, out, _ = self.f.cli('--project', '--check', 'unit', '--revision', 'HEAD', '--paths', '../x')
        self.assertEqual(code, 1)
        self.assertEqual(json.loads(out)['reason'], 'error')
        self.f.git('add', '-A')
        (self.f.repo / '.st').mkdir(exist_ok=True)
        (self.f.repo / '.st/evidence-skip-policy.json').write_text(policy_text(inputs=self.PATHS))
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'policy')
        base = self.f.git('rev-parse', 'HEAD')
        code, out, _ = self.f.cli('--project', '--check', 'unit', '--revision', 'HEAD', '--policy-from', base,
                                  '--repository', 'org/repo')
        document = json.loads(out)
        self.assertEqual((code, document['paths']), (0, sorted(self.PATHS)))
        self.assertEqual(document['source_inputs'], self.key(self.f.git('rev-parse', 'HEAD^{tree}')))


class Sha256Repository(unittest.TestCase):
    def test_sha256_object_ids_work_including_the_stale_tree_scan(self):
        f = Fixture(object_format='sha256')
        self.addCleanup(f.tmp.cleanup)
        ci = f.key('ci', 'machine/ci1')
        commit, tree = f.commit('one')
        other_commit, other_tree = f.commit('two')
        f.note(other_commit, other_tree, ci, 'machine/ci1')
        self.assertEqual(f.verify(tree)[1]['reason'], 'stale_tree')
        f.note(commit, tree, ci, 'machine/ci1')
        self.assertEqual(f.verify(tree)[0], 0)


if __name__ == '__main__':
    unittest.main()
