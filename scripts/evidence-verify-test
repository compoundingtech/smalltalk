#!/usr/bin/env python3
"""Exercise scripts/evidence-verify against real Git repositories and real SSH signatures."""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from datetime import datetime, timedelta, timezone
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / 'scripts/evidence-verify'
loader = importlib.machinery.SourceFileLoader('evidence_verify', str(SCRIPT))
spec = importlib.util.spec_from_loader(loader.name, loader)
evidence_verify = importlib.util.module_from_spec(spec)
loader.exec_module(evidence_verify)

IDENTITY = ['-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid']
NOW = datetime.now(timezone.utc)


def run(*command, cwd=None, stdin=None):
    done = subprocess.run(command, cwd=cwd, input=stdin, capture_output=True, check=False)
    if done.returncode != 0:
        raise AssertionError(done.stderr.decode())
    return done.stdout.decode().strip()


class Fixture:
    def __init__(self, object_format='sha1'):
        self.tmp = tempfile.TemporaryDirectory()
        self.root = Path(self.tmp.name)
        self.repo = self.root / 'repo'
        run('git', 'init', '-q', f'--object-format={object_format}', str(self.repo))
        self.allowed = []
        self.keys = self.root / 'allowed-signers'
        self.counter = 0

    def git(self, *args, stdin=None):
        return run('git', '-C', str(self.repo), *IDENTITY, *args, stdin=stdin)

    def key(self, name, principal=None):
        path = self.root / name
        run('ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(path))
        if principal:
            self.allowed.append(f'{principal} namespaces="git" {path.with_suffix(".pub").read_text()}')
            self.keys.write_text(''.join(self.allowed))
        return path

    def commit(self, content):
        (self.repo / 'file.txt').write_text(content)
        self.git('add', '-A')
        self.git('commit', '-q', '-m', content)
        return self.git('rev-parse', 'HEAD'), self.git('rev-parse', 'HEAD^{tree}')

    def note(self, commit, tree, key, signer, check='unit', command=('make', 'test'), exit_code=0,
             runner='nix', tier='full', seconds=0, sign=True, naive=False, inputs=None, omit_inputs=False, mutate=None):
        statement = {
            '_type': 'https://in-toto.io/Statement/v1',
            'subject': [{'name': commit, 'digest': {'gitTree': tree}}],
            'predicateType': 'https://smalltalk.dev/evidence/gate/v1',
            'predicate': {
                'schema_version': 1, 'change_id': 'change-1', 'signer': signer, 'tier': tier,
                're_attests': None, 'producer_sha256': 'a' * 64,
                'observed_at': (NOW + timedelta(seconds=seconds)).replace(tzinfo=None if naive else timezone.utc).isoformat(),
                'observed': {'kind': 'tests', 'runner': runner, 'inputs': inputs or {},
                             'checks': {check: {'command': list(command), 'exit_code': exit_code,
                                                'output_sha256': 'b' * 64}}},
            },
        }
        if omit_inputs:
            del statement['predicate']['observed']['inputs']
        body = json.dumps(statement).encode()
        if mutate is not None:
            body = mutate(body)
        blob = self.git('hash-object', '-w', '--stdin', stdin=body)
        notes = self.git('mktree', stdin=f'100644 blob {blob}\t{tree}\n'.encode())
        args = ['-c', 'gpg.format=ssh', '-c', f'user.signingKey={key}', 'commit-tree']
        if sign:
            args.append('-S')
        record = self.git(*args, notes, '-p', commit, '-m', 'st gate observation v1')
        self.git('update-ref', f'refs/notes/evidence/{record}', record)
        return record

    def verify(self, tree, check='unit', command=None, **options):
        try:
            return 0, evidence_verify.verify(str(self.repo), tree, check, str(self.keys), command, **options)
        except evidence_verify.Failure as failure:
            return 1, {'satisfied': False, 'reason': failure.reason, 'detail': failure.detail, **failure.extra}

    def cli(self, *args):
        done = subprocess.run([sys.executable, str(SCRIPT), '--repo', str(self.repo), *args],
                              capture_output=True, check=False)
        return done.returncode, done.stdout.decode(), done.stderr.decode()


class Verifier(unittest.TestCase):
    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.commit, self.tree = self.f.commit('one')

    def reason(self, *args, **kwargs):
        code, result = self.f.verify(*args, **kwargs)
        self.assertEqual(code, 1, result)
        return result['reason']

    def test_a_trusted_note_satisfies_the_check_and_reports_signer_and_trust_level(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        code, result = self.f.verify(self.tree)
        self.assertEqual(code, 0)
        self.assertEqual((result['record'], result['kind'], result['signer'], result['trust_level']),
                         (record, 'nix', 'machine/ci1', 'machine'))
        self.assertEqual(result['command'], ['make', 'test'])

    def test_wrapper_and_sekrets_are_accepted_kinds_and_unknown_kinds_are_not(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='sekrets')
        self.assertEqual(self.f.verify(self.tree)[1]['kind'], 'sekrets')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='wrapper', seconds=1)
        self.assertEqual(self.f.verify(self.tree)[1]['kind'], 'wrapper')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='hand-typed', seconds=2)
        self.assertEqual(self.reason(self.tree), 'unsupported_kind')

    def test_a_forged_signature_is_rejected(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        raw = run('git', '-C', str(self.f.repo), 'cat-file', 'commit', record)
        forged = self.f.git('hash-object', '-t', 'commit', '-w', '--stdin',
                            stdin=raw.replace('st gate observation v1', 'forged observation').encode())
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', f'refs/notes/evidence/{forged}', forged)
        self.assertEqual(self.reason(self.tree), 'bad_signature')

    def test_an_unsigned_note_is_rejected(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', sign=False)
        self.assertEqual(self.reason(self.tree), 'bad_signature')

    def test_a_key_that_is_not_on_the_list_is_untrusted(self):
        stranger = self.f.key('stranger')
        self.f.note(self.commit, self.tree, stranger, 'machine/ci1')
        self.assertEqual(self.reason(self.tree), 'untrusted_signer')

    def test_the_record_cannot_claim_a_different_signer_than_the_key_proves(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/someone-else')
        self.assertEqual(self.reason(self.tree), 'untrusted_signer')

    def test_a_note_for_another_tree_is_stale_and_no_note_at_all_is_missing(self):
        other_commit, other_tree = self.f.commit('two')
        self.f.note(other_commit, other_tree, self.ci, 'machine/ci1')
        self.assertEqual(self.reason(self.tree), 'stale_tree')
        self.assertEqual(self.reason(self.tree, check='never-ran'), 'no_record')

    def test_a_note_for_a_different_check_does_not_satisfy_this_one(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', check='lint')
        self.assertEqual(self.reason(self.tree, check='unit'), 'wrong_check')

    def test_the_recorded_command_must_match_when_one_is_required(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', command=('true',))
        self.assertEqual(self.f.verify(self.tree, command=['true'])[0], 0)
        self.assertEqual(self.reason(self.tree, command=['make', 'test']), 'wrong_command')

    def test_a_failed_run_fails_and_the_latest_record_decides(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=0)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=1)
        self.assertEqual(self.reason(self.tree), 'check_failed')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=2)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_a_time_without_a_zone_is_not_evidence_and_cannot_crash_the_ordering(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', naive=True)
        self.assertEqual(self.reason(self.tree), 'no_record')
        # Beside a well-formed record the naive one is ignored, not compared against it.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=2, naive=True)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_the_central_observers_record_of_a_ci_job_is_the_observed_kind(self):
        runner = 'github:org/repo/actions/runs/7/attempts/1/jobs/9'
        command = ('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner=runner, command=command)
        code, result = self.f.verify(self.tree, command=list(command), kinds=('observed',))
        self.assertEqual((code, result['kind'], result['command']), (0, 'observed', list(command)))
        code, result = self.f.verify(self.tree, kinds=('wrapper',))
        self.assertEqual((code, result['reason']), (1, 'unsupported_kind'))
        # A different workflow or job named in the command is not the recorded one.
        self.assertEqual(self.reason(self.tree, command=['github-actions', 'org/other', 'x.yml', 'unit']),
                         'wrong_command')

    def test_an_unsigned_degraded_record_is_reported_as_degraded_not_as_a_signature_fault(self):
        self.f.note(self.commit, self.tree, self.ci, None, tier='degraded', sign=False)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['reason'], result['attempts']), (1, 'degraded', 1))
        # It never counts as evidence, and a later full record satisfies the check.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1)
        self.assertEqual(self.f.verify(self.tree)[0], 0)

    def test_a_check_names_the_kinds_it_accepts(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='wrapper')
        self.assertEqual(self.f.verify(self.tree, kinds=('nix', 'wrapper'))[0], 0)
        code, result = self.f.verify(self.tree, kinds=('nix',))
        self.assertEqual((code, result['reason']), (1, 'unsupported_kind'))

    def test_an_environment_input_must_match_the_file_in_the_verified_tree(self):
        good = hashlib.sha256(b'one').hexdigest()
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', inputs={'flake_lock_sha256': good})
        self.assertEqual(self.f.verify(self.tree, bind=[('flake_lock_sha256', 'file.txt')])[0], 0)
        # A record made against a different environment does not satisfy this tree.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1,
                    inputs={'flake_lock_sha256': hashlib.sha256(b'other').hexdigest()})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'file.txt')]), 'wrong_input')
        # Missing key, and a path the tree does not have, both fail rather than pass.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=2, inputs={'system': 'x86_64-linux'})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'file.txt')]), 'wrong_input')
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=3, inputs={'flake_lock_sha256': good})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'no-such-file')]), 'wrong_input')

    def test_a_bind_never_passes_when_the_file_and_the_key_are_both_absent(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'no-such-file')]), 'wrong_input')
        # An empty-string input cannot match anything either (such a record is malformed).
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1, inputs={'flake_lock_sha256': ''})
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'no-such-file')]), 'wrong_input')

    def test_a_record_without_an_inputs_field_is_valid_and_reports_empty_inputs(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', omit_inputs=True)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['inputs']), (0, {}))
        self.assertEqual(self.reason(self.tree, bind=[('flake_lock_sha256', 'file.txt')]), 'wrong_input')

    def test_inputs_that_are_not_nonempty_strings_make_a_record_malformed(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', inputs={'attempt': 1})
        self.assertEqual(self.reason(self.tree), 'no_record')

    def test_the_number_of_trusted_records_is_reported_for_loop_protection(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=0)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=1)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['reason'], result['attempts']), (1, 'check_failed', 2))
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=2)
        code, result = self.f.verify(self.tree)
        self.assertEqual((code, result['attempts']), (0, 3))

    def test_the_same_file_contents_in_a_different_tree_is_not_covered(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        (self.f.repo / 'extra.txt').write_text('extra')
        other_commit, other_tree = self.f.commit('one')  # file.txt is byte-identical, the tree is not
        self.assertNotEqual(other_tree, self.tree)
        self.assertEqual(self.reason(other_tree), 'stale_tree')
        self.assertEqual(self.f.verify(self.tree)[1]['record'], record)

    def test_a_record_for_another_repository_is_refused_by_the_runner_prefix(self):
        mine = 'github:org/repo/actions/runs/7/attempts/1/jobs/9'
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner=mine)
        self.assertEqual(self.f.verify(self.tree, runner_prefix='github:org/repo/')[0], 0)
        self.assertEqual(self.reason(self.tree, runner_prefix='github:org/other/'), 'wrong_runner')
        # A prefix without the trailing slash would also match org/repo2; the slash is what anchors it.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=1,
                    runner='github:org/repo2/actions/runs/7/attempts/1/jobs/9')
        self.assertEqual(self.reason(self.tree, runner_prefix='github:org/repo/'), 'wrong_runner')

    def test_a_check_accepts_only_the_signer_trust_levels_it_names(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        self.assertEqual(self.f.verify(self.tree, trust_levels=('machine',))[0], 0)
        self.assertEqual(self.reason(self.tree, trust_levels=('fleet', 'namespace')), 'untrusted_level')
        # A newer failure from a level the check does not accept still stops a skip.
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=1)
        self.assertEqual(self.reason(self.tree, trust_levels=('fleet',)), 'untrusted_level')

    def test_old_and_future_dated_records_do_not_count(self):
        week = 7 * 24 * 3600
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=-(week + 60))
        self.assertEqual(self.reason(self.tree, max_age=week), 'too_old')
        self.assertEqual(self.f.verify(self.tree)[0], 0)  # no age policy, no age check
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=-(week - 3600))
        self.assertEqual(self.f.verify(self.tree, max_age=week)[0], 0)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=3600)
        self.assertEqual(self.reason(self.tree, max_age=week), 'future_dated')
        # ...and with no age limit at all: a future-dated pass must not become the latest record.
        self.assertEqual(self.reason(self.tree), 'future_dated')
        # A little clock skew is tolerated.
        other = Fixture()
        self.addCleanup(other.tmp.cleanup)
        key = other.key('ci', 'machine/ci1')
        commit, tree = other.commit('skew')
        other.note(commit, tree, key, 'machine/ci1', seconds=60)
        self.assertEqual(other.verify(tree, max_age=week)[0], 0)

    def test_signed_content_edited_after_signing_is_a_bad_signature(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1)
        raw = run('git', '-C', str(self.f.repo), 'cat-file', 'commit', record)
        passing = json.loads(self.f.git('cat-file', 'blob', f'{record}:{self.tree}'))
        passing['predicate']['observed']['checks']['unit']['exit_code'] = 0
        blob = self.f.git('hash-object', '-w', '--stdin', stdin=json.dumps(passing).encode())
        tree = self.f.git('mktree', stdin=f'100644 blob {blob}\t{self.tree}\n'.encode())
        old_tree = self.f.git('rev-parse', f'{record}^{{tree}}')
        forged = self.f.git('hash-object', '-t', 'commit', '-w', '--stdin',
                            stdin=raw.replace(f'tree {old_tree}', f'tree {tree}', 1).encode())
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', f'refs/notes/evidence/{forged}', forged)
        self.assertEqual(self.reason(self.tree), 'bad_signature')

    def test_garbage_in_the_notes_namespace_is_ignored_without_a_crash(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        blob = self.f.git('hash-object', '-w', '--stdin', stdin=b'not a commit')
        self.f.git('update-ref', f'refs/notes/evidence/{blob}', blob)  # a ref to a blob
        empty = self.f.git('mktree', stdin=b'')
        bare = self.f.git('commit-tree', empty, '-p', self.commit, '-m', 'empty notes')
        self.f.git('update-ref', f'refs/notes/evidence/{bare}', bare)  # a note with no statement
        extra = self.f.git('hash-object', '-w', '--stdin', stdin=b'{}')
        two = self.f.git('mktree', stdin=(f'100644 blob {extra}\t{self.tree}\n'
                                          f'100644 blob {extra}\t{"0" * 40}\n').encode())
        crowded = self.f.git('commit-tree', two, '-p', self.commit, '-m', 'two entries')
        self.f.git('update-ref', f'refs/notes/evidence/{crowded}', crowded)  # more than one blob
        self.assertEqual(self.f.verify(self.tree)[1]['record'], record)

    def test_two_conflicting_records_resolve_toward_failure(self):
        moment = 5
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', seconds=moment)
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', exit_code=1, seconds=moment)
        self.assertEqual(self.reason(self.tree), 'check_failed')

    def test_a_statement_that_is_not_valid_utf8_is_not_evidence(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1',
                    mutate=lambda body: body.replace(b'"make"', b'"ma\xffke"'))
        self.assertEqual(self.reason(self.tree), 'no_record')

    def test_an_unreadable_repository_is_an_error_with_json_and_never_a_pass(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', runner='github:x/y/jobs/1')
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys),
                                  '--max-age', '60', '--trust-levels', 'machine', '--runner-prefix', 'github:x/')
        self.assertEqual(code, 0, out)  # sanity: all the options parse and a good record passes
        missing = subprocess.run([sys.executable, str(SCRIPT), '--repo', '/nonexistent', '--tree', self.tree,
                                  '--check', 'unit', '--keys', str(self.f.keys)], capture_output=True)
        self.assertEqual((missing.returncode, json.loads(missing.stdout)['reason']), (1, 'error'))
        for bad in (['--max-age', '0'], ['--max-age', 'soon'], ['--trust-levels', ',']):
            self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys),
                                        *bad)[0], 2)

    def test_only_full_tier_counts(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1', tier='test')
        self.assertEqual(self.reason(self.tree), 'untrusted_tier')

    def test_a_ref_that_does_not_name_its_own_commit_is_not_evidence(self):
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', 'refs/notes/evidence/' + '1' * 40, record)
        self.assertEqual(self.reason(self.tree), 'no_record')

    def test_a_note_keyed_to_a_tree_the_subject_commit_does_not_have_is_ignored(self):
        other_commit, other_tree = self.f.commit('two')
        self.f.note(other_commit, other_tree, self.ci, 'machine/ci1')
        # Claim the other commit's note covers our tree by lying about the subject.
        self.f.note(other_commit, self.tree, self.ci, 'machine/ci1')
        self.assertEqual(self.reason(self.tree), 'stale_tree')

    def test_notes_fetched_shallow_verify_without_the_subject_commit(self):
        # How CI gets them: a fresh checkout of the tree plus a depth-1 fetch of the notes refs.
        record = self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        other = tempfile.TemporaryDirectory()
        self.addCleanup(other.cleanup)
        run('git', 'init', '-q', other.name)
        run('git', '-C', other.name, 'fetch', '-q', '--depth=1', '--no-tags', 'file://' + str(self.f.repo),
            'refs/notes/evidence/*:refs/notes/evidence/*')
        missing = subprocess.run(['git', '-C', other.name, 'cat-file', '-e', self.commit], capture_output=True)
        self.assertNotEqual(missing.returncode, 0, 'the subject commit must be absent for this test')
        result = evidence_verify.verify(other.name, self.tree, 'unit', str(self.f.keys), None)
        self.assertEqual(result['record'], record)

    def test_the_key_list_comes_from_the_accepted_base_so_revoking_a_key_revokes_its_notes(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'keys')
        base = self.f.git('rev-parse', 'HEAD')
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', base)
        self.assertEqual(code, 0, out)
        (self.f.repo / '.st/evidence-keys').write_text('')
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'revoke')
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys-from', 'HEAD')
        self.assertEqual((code, json.loads(out)['reason']), (1, 'untrusted_signer'))

    def test_usage_errors_exit_two_and_unreadable_input_is_reported_as_an_error(self):
        self.assertEqual(self.f.cli('--check', 'unit', '--keys', str(self.f.keys))[0], 2)
        self.assertEqual(self.f.cli('--tree', self.tree, '--revision', 'HEAD', '--check', 'unit',
                                    '--keys', str(self.f.keys))[0], 2)
        self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys),
                                    '--command', 'not json')[0], 2)
        for bad in (['--kinds', 'nix,hand-typed'], ['--kinds', ''], ['--bind-input', 'novalue']):
            self.assertEqual(self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys), *bad)[0], 2)
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', '/nonexistent')
        self.assertEqual((code, json.loads(out)['reason']), (1, 'error'))

    def test_revision_resolves_to_its_tree(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        code, out, _ = self.f.cli('--revision', 'HEAD', '--check', 'unit', '--keys', str(self.f.keys))
        self.assertEqual((code, json.loads(out)['tree']), (0, self.tree))

    def test_many_records_still_verify_in_well_under_a_second_each_way(self):
        self.f.note(self.commit, self.tree, self.ci, 'machine/ci1')
        for number in range(120):
            commit, tree = self.f.commit(f'filler {number}')
            self.f.note(commit, tree, self.ci, 'machine/ci1')
        started = time.monotonic()
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'unit', '--keys', str(self.f.keys))
        found = time.monotonic() - started
        self.assertEqual(code, 0, out)
        started = time.monotonic()
        code, out, _ = self.f.cli('--tree', self.tree, '--check', 'absent', '--keys', str(self.f.keys))
        missing = time.monotonic() - started
        self.assertEqual((code, json.loads(out)['reason']), (1, 'wrong_check'))
        print(f'  121 records: found in {found:.3f}s, wrong check in {missing:.3f}s', file=sys.stderr)
        # The requirement is one second; the test allows slack because CI hosts are busy.
        self.assertLess(found, 3.0)
        self.assertLess(missing, 3.0)


class Sha256Repository(unittest.TestCase):
    def test_sha256_object_ids_work_including_the_stale_tree_scan(self):
        f = Fixture(object_format='sha256')
        self.addCleanup(f.tmp.cleanup)
        ci = f.key('ci', 'machine/ci1')
        commit, tree = f.commit('one')
        other_commit, other_tree = f.commit('two')
        f.note(other_commit, other_tree, ci, 'machine/ci1')
        self.assertEqual(f.verify(tree)[1]['reason'], 'stale_tree')
        f.note(commit, tree, ci, 'machine/ci1')
        self.assertEqual(f.verify(tree)[0], 0)


if __name__ == '__main__':
    unittest.main()
