#!/usr/bin/env python3
"""Key handling for a CI job that signs its own result. Testable without GitHub.

  guard             may this job use the signing key? (event, ref, never a fork; a pull request: its authors)
  configure         write the signer's configuration and the key (mode 0600) and mask the key
  once CHECK        record that this job signs CHECK, and refuse a second signature for it
  aggregate FILE    write the facts of an aggregate gate (from the `needs` context) for evidence-wrap
  stage-facts FILE  write the facts of a stage that scripts/ci-linux already ran (its log and timing)
  step-facts FILE   write the facts of a job whose steps already ran (their outcomes), for jobs with no stage log
  cleanup           overwrite and remove the key and everything configure made (run it always)

The key arrives only as the environment secret EVIDENCE_SIGNING_KEY of the `evidence-signing`
environment. The jobs reach that environment only for merge_group, push to main, manual runs on main and
pull requests from this repository (their `environment:` is conditional), and this script refuses anything
else in code; a pull request also needs its authors on the list at the base commit (see check_authors). The signer script and
this one must come from the base commit of the change, never from the tree under test; the
workflow that calls them takes them from there.

Documented gap (accepted): code under test in a job that holds the key can read it, including, for a pull
request from this repository, the code of its author.
"""
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True

ALLOWED_REFS = {
    'merge_group': ['refs/heads/gh-readonly-queue/*'],
    'workflow_dispatch': ['refs/heads/main'],
    'push': ['refs/heads/main'],
    # Same-repository pull requests only; the check on the head repository is in guard().
    'pull_request': ['refs/pull/*/merge'],
}


class Refused(Exception):
    pass


def env(name, default=''):
    return os.environ.get(name, default)


def guard():
    """Event and ref the key may be used for: the merge queue, main, and pull requests from this repository
    (never a fork). A same-repository author controls the workflow file its own pull request runs, so for a
    pull request the key is exposed to that author's code: known defect, recorded in the gate-evidence docs.
    A pull request signs only when its authors are on the list at the base commit (check_authors)."""
    event, ref = env('GITHUB_EVENT_NAME'), env('GITHUB_REF')
    patterns = ALLOWED_REFS.get(event)
    if patterns is None:
        raise Refused(f'refusing event {event!r}: the signing key is for merge_group, push to main, manual runs on main and same-repository pull requests only')
    if not any(fnmatch.fnmatchcase(ref, pattern) for pattern in patterns):
        raise Refused(f'refusing ref {ref!r} for {event}: expected one of {patterns}')
    if event == 'pull_request':
        head, repository = env('PR_HEAD_REPOSITORY'), env('GITHUB_REPOSITORY')
        if not head or not repository or head != repository:
            raise Refused(f'refusing pull request from {head or "an unknown repository"!r}: only pull requests from {repository or "this repository"} may use the key')
        check_authors(env('PR_BASE_SHA'), env('PR_HEAD_SHA'), env('PR_USER'), env('GITHUB_ACTOR'), env('GITHUB_TRIGGERING_ACTOR'))
    return f'{event} on {ref}'


AUTHORS_FILE = '.st/evidence-authors.json'


def _git(*args):
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    done = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-c', 'core.hooksPath=/dev/null', '-c', 'core.pager=cat', *args],
                          capture_output=True, text=True, env=clean)
    if done.returncode:
        raise Refused(f'git {args[0]} failed: {done.stderr.strip()[-300:]}')
    return done.stdout


def _strings(value, what):
    if not isinstance(value, list) or not all(isinstance(item, str) and item for item in value):
        raise Refused(f'{AUTHORS_FILE}: {what} must be a list of nonempty strings')
    return [item.lower() for item in value]


def email_known(email, emails, noreply):
    """Exact address (any case), or [ID+]LOGIN@users.noreply.github.com with a numeric ID, matched whole."""
    return email.lower() in emails or any(pattern.fullmatch(email) for pattern in noreply)


def check_authors(base, head, opener, *actors):
    """A pull request run signs only when its authors are the repository's own. The list is read from the BASE
    commit, so the pull request cannot widen it. Two kinds of check. GitHub authenticates the account that
    opened the pull request and the accounts that started the run (GITHUB_ACTOR is the account that first
    triggered the workflow and does not change on a re-run; GITHUB_TRIGGERING_ACTOR is whoever re-ran it).
    Commit author and committer emails are free text in git (anyone can write any of them), so they only
    catch a stray commit by someone else; Co-authored-by trailers are not read at all. Emails match exactly
    (case-insensitively), or, for the `noreply_logins`, as `[ID+]LOGIN@users.noreply.github.com`; no glob."""
    if not base or not head:
        raise Refused('the pull request base and head commits are not known, so its authors cannot be checked')
    try:
        allowed = json.loads(_git('show', f'{base}:{AUTHORS_FILE}'))
        logins = set(_strings(allowed['logins'], 'logins'))
        emails = set(_strings(allowed['emails'], 'emails'))
        noreply = [re.compile(r'(?:[0-9]+\+)?' + re.escape(login) + r'@users\.noreply\.github\.com', re.IGNORECASE)
                   for login in _strings(allowed['noreply_logins'], 'noreply_logins')]
        web = set(_strings(allowed['committers_also'], 'committers_also'))
    except (Refused, ValueError, KeyError, TypeError, AttributeError) as error:
        raise Refused(f'no usable author list at the base commit ({AUTHORS_FILE}): {error}')

    def known(email):
        return email_known(email, emails, noreply)

    for role, login in (('opened the pull request', opener), *(('started or re-ran this run', actor) for actor in actors)):
        if not login or login.lower() not in logins:
            raise Refused(f'refusing: {login or "an unknown account"!r}, who {role}, is not in the author list')
    for line in _git('log', '--no-merges', '--format=%H %ae %ce', f'{base}..{head}').splitlines():
        sha, author, committer = (line.split(' ') + ['', ''])[:3]
        if not known(author):
            raise Refused(f'refusing: commit {sha[:12]} is authored by {author!r}, who is not in the author list')
        if not (known(committer) or committer.lower() in web):
            raise Refused(f'refusing: commit {sha[:12]} is committed by {committer!r}, who is not in the author list')


def configure(root):
    """Write HOME/.config/st/evidence-sign.json and the key under ROOT; mask the key's lines."""
    key = env('EVIDENCE_SIGNING_KEY')
    if not key.strip():
        raise Refused('EVIDENCE_SIGNING_KEY is empty: the evidence-signing environment secret is not available to this job')
    if not key.endswith('\n'):
        key += '\n'
    for line in key.splitlines():
        if line.strip():
            print(f'::add-mask::{line}')
    home = Path(root) / 'evidence-signer'
    (home / '.config/st').mkdir(parents=True, exist_ok=True)
    home.chmod(0o700)
    (home / '.config/st').chmod(0o700)
    key_path = home / 'signing-key'
    descriptor = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, 'w') as stream:
        stream.write(key)
    scratch = home / 'scratch.git'
    subprocess.run(['git', 'init', '--quiet', '--bare', str(scratch)], check=True)
    config_path = home / '.config/st/evidence-sign.json'
    descriptor = os.open(config_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    config = {'signer': env('EVIDENCE_SIGNER', 'fleet/ci'), 'ssh_key': str(key_path), 'scratch_repo': str(scratch)}
    tool_path = env('EVIDENCE_TOOL_PATH')
    if tool_path:
        # Where this host keeps git and ssh-keygen when it is not in a standard system directory
        # (a Nix sandbox, for instance). The signer never uses the caller's PATH; this is its own.
        for directory in tool_path.split(':'):
            segments = directory.split('/')[1:]
            if not directory.startswith('/') or any(part in ('', '.', '..') for part in (segments[:-1] if segments[-1:] == [''] else segments)):
                raise Refused('EVIDENCE_TOOL_PATH must list absolute directories without empty, . or .. segments')
        config['path'] = tool_path
    with os.fdopen(descriptor, 'w') as stream:
        json.dump(config, stream)
    return home


def once(root, check):
    """One signature per check per job: a retry loop in a job cannot flood the notes."""
    ledger = Path(root) / 'evidence-signed.json'
    signed = json.loads(ledger.read_text()) if ledger.exists() else []
    if check in signed:
        raise Refused(f'this job already signed {check!r}; a second signature for it is refused')
    signed.append(check)
    ledger.write_text(json.dumps(signed))


def add_source_inputs(facts, check):
    """Record the input key of the tested tree when the skip policy at the BASE commit declares inputs for CHECK.

    The key is the git tree of the tested tree reduced to the declared paths, computed by evidence-verify
    (--project) from the same base scripts the rest of the signing uses; a record signed with it can be found
    by another tree whose declared paths are the same. No declaration, no base commit, a base whose
    evidence-verify has no --project yet, or any error: no key, and the record stays an exact-tree record."""
    base, repository = env('PROJECT_BASE_SHA'), env('GITHUB_REPOSITORY')
    verify = Path(__file__).resolve().parent / 'evidence-verify'
    if not (check and base and repository and verify.exists()):
        return
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    key = None
    try:
        done = subprocess.run([sys.executable, str(verify), '--project', '--check', check, '--revision', 'HEAD',
                               '--policy-from', base, '--repository', repository],
                              capture_output=True, text=True, env=clean, timeout=120)
        if done.returncode == 0:
            key = json.loads(done.stdout).get('source_inputs')
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        pass
    if isinstance(key, str) and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', key):
        facts['inputs']['source_inputs'] = key


def aggregate(path):
    """What an aggregate job honestly knows: which jobs it needed, what each reported, its verdict.

    Not the stages' commands, outputs, inventories, timings or toolchains: it did not run them.
    """
    needs = json.loads(env('NEEDS_JSON') or '{}')
    # The gate jobs only feed the skip check below; they are not part of the recorded command or results.
    results = {name: str(entry.get('result', 'unknown')) for name, entry in sorted(needs.items()) if not name.startswith('evidence-gate-')}
    gate = env('GATE_JOB', 'linux-gate')
    if gate not in results:
        raise Refused(f'the {gate!r} job is not among the needed jobs, so there is no verdict to record')
    # An evidence gate that decided to skip says so in its output, set only by its marker step. Required
    # checks whose gate skipped still end in success with their steps skipped, so their own result
    # cannot show it: this output can. No note then, whatever the other results say.
    taken = sorted(name for name, entry in needs.items()
                   if name.startswith('evidence-gate-') and str((entry.get('outputs') or {}).get('skip', '')).lower() == 'true')
    if taken:
        raise Refused(f'not recording: the evidence gate skipped work in this run ({", ".join(taken)}), so it did not test this tree itself')
    # A needed job that did not run (skipped by the evidence gate, or for any other reason) means this
    # run did not itself test those stages. A note that says success would let one real run refresh
    # its own skips forever, so no note is made. Only the merge-queue-only shards may be skipped, and
    # only outside merge groups.
    merge_only = {'linux-tests-shard-3', 'linux-tests-shard-4'} if env('GITHUB_EVENT_NAME') != 'merge_group' else set()
    not_run = sorted(name for name, result in results.items() if result == 'skipped' and name not in merge_only)
    if not_run:
        raise Refused(f'not recording: {", ".join(not_run)} did not run in this workflow run (skipped), so it did not test this tree itself')
    facts = {
        'command': [gate, 'aggregate', *results],
        'exit_code': 0 if results[gate] == 'success' else 1,
        'output': {'gate': results[gate], 'needs': results},
        'inputs': {
            'run_id': env('GITHUB_RUN_ID'), 'run_attempt': env('GITHUB_RUN_ATTEMPT'), 'event_name': env('GITHUB_EVENT_NAME'),
            'ref': env('GITHUB_REF'), 'run_started_at': env('RUN_STARTED_AT'), 'workflow': env('GITHUB_WORKFLOW'),
            'needed_jobs': ','.join(results), 'stage_results': ','.join(f'{n}={r}' for n, r in results.items()),
        },
    }
    facts['inputs'] = {k: v for k, v in facts['inputs'].items() if v}
    Path(path).write_text(json.dumps(facts, sort_keys=True))


def gate_skipped():
    """GATE_SKIP is the job's own evidence gate output. When it says skip, the job took the step-level
    skip and ended in success without doing its work: no note, whatever its steps' outcomes say."""
    if env('GATE_SKIP').lower() == 'true':
        raise Refused('the evidence gate skipped this job\'s work, so it did not test anything itself; no note is made')


def stage_facts(path):
    """What a stage job honestly knows: the command it ran, its exit status, the digest of its log.

    scripts/ci-linux writes RUNNER_TEMP/ci-logs/STAGE.log (the exact output) and STAGE.time
    ("SECONDS STATUS"). A missing timing file means the stage did not finish: that is recorded as
    a failure, never inferred as success.
    """
    gate_skipped()
    stage = env('STAGE')
    if not stage or '/' in stage:
        raise Refused('STAGE must name the ci-linux stage this job ran')
    logs = Path(env('RUNNER_TEMP') or tempfile.gettempdir()) / 'ci-logs'
    log, timing = logs / f'{stage}.log', logs / f'{stage}.time'
    if not log.exists() and not timing.exists():
        # Neither a log nor a timing file: the stage never started (a skipped or cancelled job).
        # Nothing ran, so there is nothing to record, not even a failure.
        raise Refused(f'stage {stage!r} left no log and no timing file: it did not run, so no note is made')
    seconds, status = '', 1
    if timing.exists():
        parts = timing.read_text().split()
        if len(parts) == 2 and parts[0].isdigit() and parts[1].lstrip('-').isdigit():
            seconds, status = parts[0], int(parts[1])
    facts = {
        'command': ['bash', 'scripts/ci-linux', stage],
        'exit_code': status,
        'output_sha256': hashlib.sha256(log.read_bytes() if log.exists() else b'').hexdigest(),
        'inputs': {
            'stage': stage, 'job': env('STAGE_JOB'), 'elapsed_seconds': seconds, 'log_present': 'true' if log.exists() else 'false',
            'partition': env('CI_TEST_PARTITION'), 'run_id': env('GITHUB_RUN_ID'), 'run_attempt': env('GITHUB_RUN_ATTEMPT'),
            'event_name': env('GITHUB_EVENT_NAME'), 'ref': env('GITHUB_REF'), 'workflow': env('GITHUB_WORKFLOW'),
            'runner_name': env('RUNNER_NAME'), 'runner_os': env('RUNNER_OS'), 'runner_arch': env('RUNNER_ARCH'),
        },
    }
    facts['inputs'] = {k: v for k, v in facts['inputs'].items() if v}
    add_source_inputs(facts, env('STAGE_JOB') or stage)
    Path(path).write_text(json.dumps(facts, sort_keys=True))


def step_facts(path):
    """What a job honestly knows about steps it already ran: which command they stand for and how each ended.

    STEP_CHECK is the check name, STEP_COMMAND a JSON array naming the command, STEP_OUTCOMES a JSON
    object {step id: outcome} taken from the steps context. The note is a success only if every step
    succeeded. A step that is skipped, cancelled or missing means the job did not run its work (for
    example it was covered by a trusted note), so no note is made, not even a failure.
    """
    gate_skipped()
    check = env('STEP_CHECK')
    try:
        command = json.loads(env('STEP_COMMAND') or 'null')
        outcomes = json.loads(env('STEP_OUTCOMES') or 'null')
    except ValueError:
        raise Refused('STEP_COMMAND and STEP_OUTCOMES must be JSON')
    if not check or not (isinstance(command, list) and command and all(isinstance(a, str) for a in command)):
        raise Refused('STEP_CHECK and a nonempty STEP_COMMAND array are required')
    if not (isinstance(outcomes, dict) and outcomes and all(isinstance(v, str) for v in outcomes.values())):
        raise Refused('STEP_OUTCOMES must be a nonempty object of step outcomes')
    unrun = sorted(name for name, outcome in outcomes.items() if outcome in ('', 'skipped', 'cancelled'))
    if unrun:
        raise Refused(f'{check!r}: step(s) {", ".join(unrun)} did not run, so the job did not test anything itself; no note is made')
    facts = {
        'command': command,
        'exit_code': 0 if all(outcome == 'success' for outcome in outcomes.values()) else 1,
        'output': {'steps': dict(sorted(outcomes.items()))},
        'inputs': {
            'job': check, 'steps': ','.join(sorted(outcomes)), 'step_outcomes': ','.join(f'{n}={o}' for n, o in sorted(outcomes.items())),
            'run_id': env('GITHUB_RUN_ID'), 'run_attempt': env('GITHUB_RUN_ATTEMPT'), 'event_name': env('GITHUB_EVENT_NAME'),
            'ref': env('GITHUB_REF'), 'workflow': env('GITHUB_WORKFLOW'), 'runner_name': env('RUNNER_NAME'),
            'runner_os': env('RUNNER_OS'), 'runner_arch': env('RUNNER_ARCH'),
        },
    }
    facts['inputs'] = {k: v for k, v in facts['inputs'].items() if v}
    add_source_inputs(facts, check)
    Path(path).write_text(json.dumps(facts, sort_keys=True))


def cleanup(root):
    home = Path(root) / 'evidence-signer'
    key = home / 'signing-key'
    if key.exists():
        key.write_bytes(b'\0' * max(1, key.stat().st_size))
    shutil.rmtree(home, ignore_errors=True)


def main(argv):
    command = argv[0] if argv else ''
    root = env('RUNNER_TEMP') or tempfile.gettempdir()
    try:
        if command == 'guard':
            print(guard())
        elif command == 'configure':
            print(configure(root))
        elif command == 'once' and len(argv) == 2:
            once(root, argv[1])
        elif command == 'aggregate' and len(argv) == 2:
            aggregate(argv[1])
        elif command == 'stage-facts' and len(argv) == 2:
            stage_facts(argv[1])
        elif command == 'step-facts' and len(argv) == 2:
            step_facts(argv[1])
        elif command == 'cleanup':
            cleanup(root)
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except Refused as refusal:
        print(f'::warning::evidence signing skipped: {refusal}')
        return 1
    except (OSError, subprocess.SubprocessError) as error:
        print(f'::warning::evidence signing step {command} failed: {error}')
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
