#!/usr/bin/env python3
"""The tier selector runs FAST only for a pull request that nothing forces to HEAVY, and fails toward running everything."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent.parent
script = root / "scripts/ci-test-tier-select"
tiers = json.loads((root / "scripts/ci-test-tiers.json").read_text())
GIT = ["git", "-c", "user.name=Example", "-c", "user.email=example@example.invalid", "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null"]


def run(*command, cwd):
    return subprocess.run(command, cwd=cwd, check=True, capture_output=True, text=True).stdout.strip()


def select(event, base, head, remote, labels=(), directory=None):
    output = Path(directory) / "output"
    summary = Path(directory) / "summary"
    output.unlink(missing_ok=True)
    env = {**os.environ, "EVENT": event, "BASE_SHA": base, "HEAD_SHA": head, "REMOTE": str(remote), "LABELS": json.dumps(list(labels)),
           "GITHUB_OUTPUT": str(output), "GITHUB_STEP_SUMMARY": str(summary)}
    done = subprocess.run([sys.executable, str(script)], env=env, capture_output=True, text=True)
    assert done.returncode == 0, "the selector must never fail the job: " + done.stderr
    values = dict(line.split("=", 1) for line in output.read_text().splitlines())
    return values["tier"], values["reason"]


with tempfile.TemporaryDirectory() as temp:
    temp = Path(temp)
    repo = temp / "repo"
    repo.mkdir()
    run("git", "init", "-q", "-b", "main", cwd=repo)
    (repo / "scripts").mkdir()
    (repo / "scripts/ci-test-tiers.json").write_text(json.dumps(tiers))
    (repo / "docs").mkdir()
    (repo / "docs/note.md").write_text("one\n")
    run("git", "add", "-A", cwd=repo)
    run(*GIT, "commit", "-qm", "base", cwd=repo)
    base = run("git", "rev-parse", "HEAD", cwd=repo)

    def change(path, text="changed\n"):
        run("git", "checkout", "-q", "--detach", base, cwd=repo)
        target = repo / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        run("git", "add", "-A", cwd=repo)
        run(*GIT, "commit", "-qm", f"change {path}", cwd=repo)
        return run("git", "rev-parse", "HEAD", cwd=repo)

    # Documentation only, no label: FAST.
    head = change("docs/note.md")
    tier, reason = select("pull_request", base, head, repo, directory=temp)
    assert tier == "fast", (tier, reason)
    assert "merge queue" in reason

    # The label forces everything.
    tier, reason = select("pull_request", base, head, repo, labels=["bug", tiers["escalate"]["label"]], directory=temp)
    assert tier == "all" and tiers["escalate"]["label"] in reason, (tier, reason)

    # Paths that force the heavy tier: the heavy modules' files, the scripts they run, the tier and CI configuration, and the
    # replication, schema, store and generated-contract paths.
    for path in ["crates/st3/tests/boot_canaries.rs", "crates/st3/tests/messaging_faults.rs", "crates/st3/tests/convergence.rs",
                 "crates/st3/tests/fleet.rs", "crates/st3/tests/daemon_restart/support.rs", "crates/st3/tests/fixtures/a.json",
                 "scripts/st3-boot-canaries", "scripts/st3-messaging-faults-eval/run", "scripts/ci-test-tiers.json", "scripts/ci-nextest",
                 ".config/nextest.toml", ".github/workflows/fleet.yml", ".github/workflows/workspace-ci.ts",
                 "crates/smallclaims/src/sync/worker.rs", "crates/st3-schema/src/lib.rs", "crates/st3/src/store.rs",
                 "crates/st3/src/store/checkpoint_trim.rs", "crates/st3/src/fleet/mod.rs", "crates/st3/src/peer/mod.rs",
                 "clients/typescript/st3-client/Models.generated.ts", "docs/st3/client-v0/fixtures/x.json"]:
        head = change(path)
        tier, reason = select("pull_request", base, head, repo, directory=temp)
        assert tier == "all" and path in reason, (path, tier, reason)

    # Ordinary source and documentation paths do not force it (nearly every st3 PR would otherwise be heavy).
    for path in ["crates/st3/src/api.rs", "crates/st3/src/reconcile/mod.rs", "crates/st3/tests/getting_started.rs", "docs/st3/gate-evidence.md",
                 "AGENTS.md", "apps/fractal-web/package.json", "release-notes/x.json"]:
        head = change(path)
        tier, reason = select("pull_request", base, head, repo, directory=temp)
        assert tier == "fast", (path, tier, reason)

    # Every other event runs everything; nothing is read.
    for event in ("merge_group", "push", "workflow_dispatch", "schedule", ""):
        assert select(event, base, head, repo, directory=temp)[0] == "all", event

    # Errors run everything: malformed or missing SHAs, an unreadable remote, a list missing from the base, bad labels.
    assert select("pull_request", "", head, repo, directory=temp)[0] == "all"
    assert select("pull_request", base, "z" * 40, repo, directory=temp)[0] == "all"
    assert select("pull_request", base, head, temp / "no-such-repository", directory=temp)[0] == "all"
    run("git", "checkout", "-q", "--detach", base, cwd=repo)
    (repo / "scripts/ci-test-tiers.json").unlink()
    run("git", "add", "-A", cwd=repo)
    run(*GIT, "commit", "-qm", "base without the list", cwd=repo)
    bare = run("git", "rev-parse", "HEAD", cwd=repo)
    (repo / "docs/note.md").write_text("two\n")
    run(*GIT, "commit", "-qam", "docs", cwd=repo)
    tier, reason = select("pull_request", bare, run("git", "rev-parse", "HEAD", cwd=repo), repo, directory=temp)
    assert tier == "all" and "could not be read" in reason, (tier, reason)

    # A pull request cannot shrink its own escalation: the list comes from the BASE, so deleting a pattern in the PR changes
    # nothing, and editing the list matches its own pattern.
    run("git", "checkout", "-q", "--detach", base, cwd=repo)
    shrunk = json.loads(json.dumps(tiers))
    shrunk["escalate"]["paths"] = ["nothing/**"]
    (repo / "scripts/ci-test-tiers.json").write_text(json.dumps(shrunk))
    (repo / "crates/st3/tests").mkdir(parents=True, exist_ok=True)
    (repo / "crates/st3/tests/fleet.rs").write_text("// changed\n")
    run("git", "add", "-A", cwd=repo)
    run(*GIT, "commit", "-qm", "shrink and change", cwd=repo)
    tier, reason = select("pull_request", base, run("git", "rev-parse", "HEAD", cwd=repo), repo, directory=temp)
    assert tier == "all", (tier, reason)

    # The selector writes valid outputs and a summary line.
    assert "Test tier:" in (temp / "summary").read_text()

print("Tier selector tests passed: fast for an unforced pull request, the label, each forcing path, the other events, and every error running everything")
