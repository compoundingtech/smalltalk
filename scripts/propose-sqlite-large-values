#!/usr/bin/env python3
"""Print a deterministic inventory delta for human review; never edit or accept it."""
import argparse
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True
from sqlite_large_values import MANIFEST, inventory_delta


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    try:
        manifest = json.loads((args.root / MANIFEST).read_text())
        proposal = inventory_delta(args.root, manifest)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"SQLite inventory proposal: {error}", file=sys.stderr)
        return 1
    print(json.dumps(proposal, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
