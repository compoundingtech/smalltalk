#!/usr/bin/env python3
"""Exercise cost-stage failure retention without compiling or running native tests."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory(prefix='perf evidence ') as scratch:
    base = Path(scratch)
    tools = base / 'tools'
    tools.mkdir()
    cargo = tools / 'cargo'
    cargo.write_text('#!' + sys.executable + '''
import json, os, pathlib, sys
root = pathlib.Path(os.environ['RUNNER_TEMP'])
with (root / 'calls.jsonl').open('a') as output:
    output.write(json.dumps(sys.argv[1:]) + '\\n')
if 'messaging_faults::link_minutes' in sys.argv:
    # Stand in for a supervised child's retained evidence, including partial failure.
    parent = pathlib.Path(os.environ['ST3_MESSAGING_FAULTS_EVIDENCE'])
    case = parent / 'link_minutes-case' / 'evidence'
    case.mkdir(parents=True)
    for name in ['daemon.log', 'link-events.jsonl', 'trace.json', 'replication.json']:
        (case / name).write_text('retained evidence')
    for _ in range(2):
        print('running 1 test')
        print('test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 10 filtered out; finished in 0.01s')
    sys.exit(int(os.environ['LINK_EXIT']))
elif 'daemon_cost::' in sys.argv:
    pathlib.Path(os.environ['ST_COST_REPORT']).write_text('{}')
else:
    print('running 1 test')
    print('test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 10 filtered out; finished in 0.01s')
''')
    cargo.chmod(0o755)
    jq = tools / 'jq'
    jq.write_text('#!/bin/sh\nexit 0\n')
    jq.chmod(0o755)
    for link_exit in [17, 0]:
        temp = base / str(link_exit)
        temp.mkdir()
        summary = temp / 'summary.md'
        env = dict(os.environ, GITHUB_ACTIONS='true', RUNNER_TEMP=str(temp),
                   GITHUB_STEP_SUMMARY=str(summary), LINK_EXIT=str(link_exit),
                   PATH=str(tools) + os.pathsep + os.environ['PATH'],
                   ST3_MESSAGING_FAULTS_EVIDENCE=str(base / 'wrong-parent'))
        env.pop('CI_RUN_ID', None)
        result = subprocess.run(['bash', str(ROOT / 'scripts/ci-perf'), 'cost'],
                                cwd=ROOT, env=env, capture_output=True, text=True, timeout=20)
        assert result.returncode == link_exit, (result.returncode, result.stdout, result.stderr)
        case = temp / 'perf/link-minutes-evidence/link_minutes-case/evidence'
        assert {p.name for p in case.iterdir()} == {
            'daemon.log', 'link-events.jsonl', 'trace.json', 'replication.json'}
        assert not (base / 'wrong-parent').exists()
        calls = [json.loads(row) for row in (temp / 'calls.jsonl').read_text().splitlines()]
        assert len(calls) == 3, calls  # One link case, one cost check, one outbound check.
        assert sum('messaging_faults::link_minutes' in call for call in calls) == 1
        assert (temp / 'perf/link-minutes.time').read_text().split()[1] == str(link_exit)
        assert (temp / 'perf/cost.time').read_text().split()[1] == str(link_exit)
        assert ('failed' if link_exit else 'passed') in summary.read_text()

# Bind the evidence parent to the real uploader and test harness contracts.
workflow = (ROOT / '.github/workflows/fleet.yml').read_text().split('  perf-cost:', 1)[1]
upload = workflow.split('name: perf-cost-logs', 1)[0].rsplit('uses: actions/upload-artifact@v4', 1)[1]
assert 'if: always()' in upload
assert '${{ runner.temp }}/perf/' in workflow.split('name: perf-cost-logs', 1)[1].split('- name:', 1)[0]
fixture = (ROOT / 'crates/st3/tests/messaging_faults.rs').read_text()
assert 'ST3_MESSAGING_FAULTS_EVIDENCE' in fixture and 'output_root.take().unwrap().keep()' in fixture
print('Perf evidence controls passed: explicit parent, absent CI_RUN_ID, failure retained, no retry, status preserved')
