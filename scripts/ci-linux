#!/usr/bin/env bash
# Run one Linux gate stage inside the pinned devShell: tests, clippy, or fleet-compat.
# Each stage is its own GitHub Actions job on its own runner; `linux-gate` requires all three.
set -euo pipefail
stage=${1:?usage: scripts/ci-linux tests|clippy|fleet-compat|mail-redelivery-canaries|conversation-model}
# Logs stay outside the checkout: the public-content test scans untracked files.
logs="$RUNNER_TEMP/ci-logs"
mkdir -p "$logs"

fleet_compat() {
  local baseline
  baseline=$(jq -er .commit .github/fleet-compat-baseline.json) || return
  # The pinned baseline never changes: after the first run its Nix output is substituted from the
  # keyed local binary cache (scripts/ci-nix-cache) instead of being built again.
  # Building the baseline also runs the pinned pty's own unit tests, and two of its process-table
  # tests are timing-sensitive on a loaded runner (different ones failed on different runs). A
  # failed build leaves nothing behind, so a retry rebuilds only what failed.
  local attempt
  for attempt in 1 2 3; do
    BASELINE="$baseline" nix build --impure --out-link "$RUNNER_TEMP/baseline" --print-build-logs --expr '
      ((builtins.getFlake "github:compoundingtech/smalltalk/${builtins.getEnv "BASELINE"}")
        .packages.${builtins.currentSystem}.st3).overrideAttrs (_: { doCheck = false; })' && break
    [ "$attempt" -lt 3 ] || return 1
    echo "baseline build attempt $attempt failed; retrying" >&2
  done
  export ST3_COMPAT_BIN="$RUNNER_TEMP/baseline/bin/st3"
  test -x "$ST3_COMPAT_BIN" || return
  if "$ST3_COMPAT_BIN" fleet --help > /dev/null 2>&1; then
    echo "the baseline must predate fleet membership" >&2
    return 1
  fi
  cargo test -p st3 --locked --test integration -- --ignored --exact \
    fleet::an_old_build_config_peer_replicates_with_new_members 2>&1 | tee "$logs/compat-result.log" || return
  grep -q "test result: ok. 1 passed" "$logs/compat-result.log"
}

clippy_and_codegen() {
  python3 scripts/ci-build-snapshot-test || return
  python3 scripts/build-stamp-watch-test || return
  python3 scripts/clippy-ratchet-test || return
  cargo metadata --no-deps --format-version 1 --locked > "$logs/clippy-metadata.json" || return
  rustc --version > "$logs/clippy-rustc.txt" || return
  cargo clippy --version > "$logs/clippy-version.txt" || return
  cargo clippy --workspace --all-targets --locked --message-format=json \
    | tee "$logs/clippy-workspace.jsonl" | python3 scripts/clippy_ratchet.py --render || return
  # Workspace consumers enable drawing; check the standalone model separately.
  cargo clippy -p st3-conversation-ui --no-default-features --all-targets --locked --message-format=json \
    | tee "$logs/clippy-model.jsonl" | python3 scripts/clippy_ratchet.py --render || return
  local base_args=()
  if [[ -n "${CLIPPY_BASE_SHA:-}" && "$CLIPPY_BASE_SHA" != 0000000000000000000000000000000000000000 ]]; then
    base_args=(--base-ref "$CLIPPY_BASE_SHA")
  fi
  python3 scripts/clippy_ratchet.py --logs "$logs" "${base_args[@]}" || return
  cargo run --locked -p st3-client-codegen -- --check
}

conversation_model() {
  # A workspace build unifies stui/st's ratatui feature, which would hide model dependencies.
  cargo test -p st3-conversation-ui --no-default-features --locked || return
  local dependencies
  dependencies=$(cargo tree -p st3-conversation-ui --no-default-features --locked -e normal --prefix none) || return
  if [[ "$dependencies" == *ratatui* ]]; then
    echo "the standalone conversation model must not depend on ratatui" >&2
    return 1
  fi
}

# Guard current products before any stage can report success.
python3 scripts/ci-cargo-tools-env-test
python3 scripts/ci-rustc-wrapper-test
python3 scripts/sccache-evidence-test
python3 scripts/check-st-boundary-test
python3 scripts/check-st-boundary

# Diagnostic only, no behaviour change: how much scratch space the tests use, and how much tmpfs
# the runner has, so a later change can decide per runner class whether the tests' temporary files
# belong in /dev/shm (file-backed SQLite stores wait on fsync on a disk). `du` is of everything
# under TMPDIR, polled every five seconds, so it is an upper bound of the tests' own use.
scratch_diagnostic_start() {
  scratch="${TMPDIR:-/tmp}"
  scratch_peak_file=$(mktemp)
  echo 0 > "$scratch_peak_file"
  (
    peak=0
    while sleep 5; do
      used=$(du -sm "$scratch" 2>/dev/null | cut -f1)
      if [[ "${used:-0}" -gt "$peak" ]]; then peak=$used; echo "$peak" > "$scratch_peak_file"; fi
    done
  ) >/dev/null 2>&1 &
  scratch_poller=$!
}
scratch_diagnostic_finish() {
  # The poller holds no pipe of the stage (its output is /dev/null), so the stage never waits for it.
  pkill -P "$scratch_poller" 2>/dev/null || true
  kill "$scratch_poller" 2>/dev/null || true
  echo "Test scratch: TMPDIR=$scratch on $(stat -f -c %T "$scratch"), filesystem $(df -Pm "$scratch" | awk 'NR==2 {print $2}') MiB, peak du of TMPDIR $(cat "$scratch_peak_file") MiB; /dev/shm $(stat -f -c %T /dev/shm 2>/dev/null || echo absent), $(df -Pm /dev/shm 2>/dev/null | awk 'NR==2 {print $2}') MiB, $(df -Pm /dev/shm 2>/dev/null | awk 'NR==2 {print $3}') MiB used at the end; memory $(awk '/MemTotal/ {printf "%d", $2 / 1024}' /proc/meminfo) MiB, peak RSS of the tests not measured"
  rm -f "$scratch_peak_file"
}

start=$SECONDS status=0
# Both native test jobs and the standalone mail canaries use the existing runner
# tmpfs, with short socket paths and evidence retained until job cleanup.
if [[ ( "$stage" == tests || "$stage" == mail-redelivery-canaries ) && -n "${CI_LOCAL_CARGO_HOME:-}" ]]; then
  export TMPDIR="$RUNNER_TEMP/t" TMP="$RUNNER_TEMP/t" TEMP="$RUNNER_TEMP/t"
  mkdir -p "$TMPDIR"
  printf 'Test scratch filesystem: '
  stat -f -c %T "$TMPDIR"
fi
case "$stage" in
  # The nextest --no-run step already compiled the test executables.
  tests) {
    # The standalone feature check is independent of the workspace's unified test build.
    # Only shard 1 (or an unpartitioned local run) needs to perform it.
    if [[ -z "${CI_TEST_EXTRACTED:-}" && "${CI_TEST_PARTITION:-}" != hash:2/2 ]]; then conversation_model || exit $?; fi
    scratch_diagnostic_start
    tests_status=0
    bash scripts/ci-nextest run --test-threads "${CI_TEST_THREADS:-${CI_LOCAL_TEST_THREADS:-$(nproc)}}" --status-level pass || tests_status=$?
    scratch_diagnostic_finish
    exit "$tests_status"
  } 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  conversation-model) conversation_model 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  clippy) clippy_and_codegen 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  fleet-compat) fleet_compat 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  mail-redelivery-canaries) python3 scripts/ci-mail-redelivery-canaries 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  *) echo "unknown stage: $stage" >&2; exit 2 ;;
esac
# `tee` hides the stage's exit status behind a pipeline; pipefail restores it above.
result=passed
[ "$status" -eq 0 ] || result=failed
printf '%s %s\n' "$((SECONDS - start))" "$status" > "$logs/$stage.time"
printf '| %s | %s | %ss | %s |\n' "$stage" "$result" "$((SECONDS - start))" "$status" >> "$GITHUB_STEP_SUMMARY"
exit "$status"
