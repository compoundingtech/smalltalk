#!/usr/bin/env bash
# Run one Linux gate stage inside the pinned devShell: tests, clippy, or fleet-compat.
# Each stage is its own GitHub Actions job on its own runner; `linux-gate` requires all three.
set -euo pipefail
stage=${1:?usage: scripts/ci-linux tests|clippy|fleet-compat}
# Logs stay outside the checkout: the public-content test scans untracked files.
logs="$RUNNER_TEMP/ci-logs"
mkdir -p "$logs"

fleet_compat() {
  local baseline
  baseline=$(jq -er .commit .github/fleet-compat-baseline.json) || return
  # The pinned baseline never changes. Its closure is exported once into the cache volume, keyed on
  # the baseline commit, and imported before the build: Nix then finds the output already valid and
  # builds nothing. (/nix itself cannot be cached; see .github/workflows/workspace-ci.ts.)
  local archive=""
  if [ -n "${CI_CACHE_DIR:-}" ]; then
    mkdir -p "$CI_CACHE_DIR"
    archive="$CI_CACHE_DIR/fleet-compat-baseline-$baseline.nar"
    if [ -s "$archive" ]; then
      echo "baseline cache hit: importing $archive"
      nix-store --import < "$archive" > /dev/null || echo "baseline import failed; building it" >&2
    else
      echo "baseline cache miss: building the pinned baseline"
    fi
  fi
  BASELINE="$baseline" nix build --impure --out-link "$RUNNER_TEMP/baseline" --print-build-logs --expr '
    ((builtins.getFlake "github:compoundingtech/smalltalk/${builtins.getEnv "BASELINE"}")
      .packages.${builtins.currentSystem}.st3).overrideAttrs (_: { doCheck = false; })' || return
  if [ -n "$archive" ] && [ ! -s "$archive" ]; then
    # shellcheck disable=SC2046
    nix-store --export $(nix-store --query --requisites "$RUNNER_TEMP/baseline") > "$archive.tmp" \
      && mv "$archive.tmp" "$archive"
  fi
  export ST3_COMPAT_BIN="$RUNNER_TEMP/baseline/bin/st3"
  test -x "$ST3_COMPAT_BIN" || return
  if "$ST3_COMPAT_BIN" fleet --help > /dev/null 2>&1; then
    echo "the baseline must predate fleet membership" >&2
    return 1
  fi
  cargo test -p st3 --locked --test integration -- --ignored --exact \
    fleet::an_old_build_config_peer_replicates_with_new_members 2>&1 | tee "$logs/compat-result.log" || return
  grep -q "test result: ok. 1 passed" "$logs/compat-result.log"
}

clippy_and_codegen() {
  cargo clippy --workspace --all-targets --locked
  cargo run --locked -p st3-client-codegen -- --check
}

start=$SECONDS status=0
case "$stage" in
  # The nextest --no-run step already compiled the test executables.
  # TRIAL ONLY (Namespace trial copy of #849): skip the messaging fault matrix exactly as st/ci skips it
  # this week; it returns as parallel tests. Without the skip every case times out in fixture
  # startup and its 30-second retries keep this job running for tens of minutes. The -E expression
  # is combined with the ci profile's default-filter. Remove it when the matrix is parallelized.
  tests) cargo nextest run --workspace --locked --profile ci \
    -E 'not test(/^messaging_faults::messages_recover_across_transport_and_process_faults$/)' \
    2>&1 | tee "$logs/$stage.log" || status=$? ;;
  clippy) clippy_and_codegen 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  fleet-compat) fleet_compat 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  *) echo "unknown stage: $stage" >&2; exit 2 ;;
esac
# `tee` hides the stage's exit status behind a pipeline; pipefail restores it above.
result=passed
[ "$status" -eq 0 ] || result=failed
printf '%s %s\n' "$((SECONDS - start))" "$status" > "$logs/$stage.time"
printf '| %s | %s | %ss | %s |\n' "$stage" "$result" "$((SECONDS - start))" "$status" >> "$GITHUB_STEP_SUMMARY"
exit "$status"
