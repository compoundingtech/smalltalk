#!/usr/bin/env python3
"""Boot canary: a real st3 daemon boots seats of one harness against a token-free stand-in provider.

    run BINARY EVIDENCE_DIR HARNESS SCENARIO

HARNESS is claude, codex, pi, omp or opencode. The stand-in provider (stub-*) speaks the real wire
contract of that harness and does what a model does when woken: reads the message and claims the
step it names. SCENARIO is one of

    fresh           a new seat boots
    restart         the seat is restarted and the new incarnation boots
    daemon-restart  the daemon dies with the seat's provider; the new daemon, whose latest
                    observation of the seat is still the dead predecessor, boots a replacement
    reexec          the st binary is replaced; the seat's driver re-execs into it and still
                    takes a message
    concurrent      five seats launch at once
    suspend         the booted seat finishes its step and is suspended: no process remains, a
                    message waits, and resume brings back the same native session, which holds
                    that old mail and reads a fresh message. Then a resume whose transcript is gone fails with a typed reason and the
                    seat stays suspended.
    import          a saved Codex session binds its exact ID and originating home on first import
                    and restart, while a stale copy exists in the daemon's default environment
    utf8            Codex recovers a receipt from a split UTF-8 transcript and keeps delivering
                    through discovery I/O failures, with private, rate-limited warnings.
    idle-hold       Codex/OpenCode make zero hold calls during a real idle minute, then deliver
                    fresh mail and retain native consumption across hold, release and expiry.

Every seat must, within the time bound, claim its step with its current incarnation and read an
st message, and none may park in the crash-loop guard. The verdict is in EVIDENCE_DIR/result.json.
"""
import argparse
from collections import Counter
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
sys.dont_write_bytecode = True
from st_boundary import fresh_seat_findings, output_findings

HARNESSES = ("claude", "codex", "pi", "omp", "opencode")
SCENARIOS = ("fresh", "restart", "daemon-restart", "reexec", "concurrent", "suspend", "utf8", "idle-hold", "channel-missing", "channel-uninitialized", "channel-parked", "import")
MISSION = "canary/boot"
RUN_ID = f"{MISSION}/c1"
LETTERS = "abcde"
IMPORTED_SUBJECT = None


class Failure(Exception):
    pass


def fail(message):
    raise Failure(message)


def until(predicate, timeout, message, alive=lambda: None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        alive()
        value = predicate()
        if value:
            return value
        time.sleep(0.25)
    fail(message)


def install_stub(bin_dir, harness):
    """Put the stand-in on PATH under the provider's own name, with absolute interpreters."""
    python, node = shutil.which("python3"), shutil.which("node")
    interpreter, script = {
        "claude": (python, "stub-claude.py"),
        "codex": (python, "stub-codex.py"),
        "opencode": (python, "stub-opencode.py"),
        "pi": (node, "stub-pi-family.mjs"),
        "omp": (node, "stub-pi-family.mjs"),
    }[harness]
    if not interpreter:
        raise SystemExit(f"{harness}'s stand-in needs {'node' if harness in ('pi', 'omp') else 'python3'} on PATH")
    wrapper = bin_dir / harness
    wrapper.write_text(f'#!/bin/sh\nexec env PYTHONDONTWRITEBYTECODE=1 STUB_HARNESS={harness} "{interpreter}" "{HERE / script}" "$@"\n')
    wrapper.chmod(0o755)


class Node:
    def __init__(self, root, binary, harness):
        self.root, self.harness = root, harness
        for sub in ("bin", "home", "run", "ws", "state"):
            (root / sub).mkdir(parents=True, exist_ok=True)
        # The seat's driver follows ST3_BIN, so re-pointing this link is how a deploy swaps the
        # binary. A link, because a debug st3 is hundreds of megabytes and /tmp is a small tmpfs.
        self.binary = root / "bin/st3"
        self.binary.symlink_to(binary)
        for tool in ("pty", "git"):
            executable = shutil.which(tool)
            if not executable:
                raise SystemExit(f"{tool} must be on PATH")
            (root / "bin" / tool).symlink_to(executable)
        install_stub(root / "bin", harness)
        self.path = f"{root / 'bin'}:/usr/bin:/bin"
        self.endpoint = root / "run/st.sock"
        self.env = {"PATH": self.path, "HOME": str(root / "home"), "SHELL": "/bin/bash",
                    "USER": os.environ.get("USER", "eval"), "LOGNAME": os.environ.get("USER", "eval"),
                    "LANG": "C.UTF-8", "XDG_STATE_HOME": str(root / "home/.local/state"),
                    "XDG_CONFIG_HOME": str(root / "home/.config"),
                    "XDG_DATA_HOME": str(root / "home/.local/share"),
                    "XDG_RUNTIME_DIR": str(root / "run"), "ST3_ENDPOINT": str(self.endpoint),
                    "ST3_DAEMON_WAIT": "0"}
        # The daemon rebuilds PATH from a login shell; pin it to the isolated one.
        profile = f"export PATH='{self.path}'\n"
        for name in (".profile", ".bash_profile", ".bashrc", ".zprofile", ".zshenv"):
            (root / "home" / name).write_text(profile)
        (root / "config.toml").write_text(f'''node = "canary"
person = "person/eval"
state_dir = "{root / 'state'}"
pty_root = "{root / 'pty'}"
socket = "{self.endpoint}"
client_gateway_socket = "{root / 'run/client.sock'}"
''')
        self.log = (root / "daemon.log").open("ab")
        self.daemon = None

    def start(self):
        if not (self.root / "ws/.git").exists():
            subprocess.run(["git", "init", "-q", str(self.root / "ws")], env=self.env, check=True)
            subprocess.run(["git", "-C", str(self.root / "ws"), "-c", "user.name=Canary", "-c", "user.email=canary@example.invalid", "-c", "commit.gpgsign=false", "commit", "--allow-empty", "-qm", "Canary workspace"], env=self.env, check=True)
        self.daemon = subprocess.Popen([str(self.binary), "up", "--config", str(self.root / "config.toml")],
                                       env=self.env, cwd=self.root / "ws", stdin=subprocess.DEVNULL,
                                       stdout=self.log, stderr=self.log, start_new_session=True)
        until(lambda: self.api("/v1/health"), 60, "the daemon did not answer: " + self.tail("daemon.log"),
              lambda: self.daemon.poll() is None or fail("daemon exited: " + self.tail("daemon.log")))

    def kill_daemon(self):
        os.killpg(self.daemon.pid, signal.SIGKILL)
        self.daemon.wait()

    def tail(self, name):
        path = self.root / name
        return path.read_text(errors="replace")[-3000:] if path.exists() else ""

    def cli(self, *args, check=True):
        result = subprocess.run([str(self.binary), "--endpoint", str(self.endpoint), *args], env=self.env,
                                capture_output=True, text=True, timeout=120)
        if check and result.returncode:
            raise Failure(f"st {' '.join(args)}: {result.stderr.strip()} {result.stdout.strip()}")
        return result.stdout

    def json(self, *args):
        return json.loads(self.cli(*args, "--json"))

    def api(self, path):
        result = subprocess.run(["curl", "-sf", "--max-time", "10", "--unix-socket", str(self.endpoint),
                                 "http://localhost" + path], capture_output=True, text=True)
        if result.returncode:
            return None
        try:
            payload = json.loads(result.stdout)
        except ValueError:
            return None
        return payload.get("value", payload) if isinstance(payload, dict) else payload

    def pty(self, *args):
        return subprocess.run(["pty", *args], env={**self.env, "PTY_ROOT": str(self.root / "pty")},
                              capture_output=True, text=True)

    def seat_processes(self, with_environment=False):
        """Every process launched for a seat, by this daemon's private endpoint."""
        rows = []
        for proc in Path("/proc").glob("[0-9]*"):
            try:
                environ = (proc / "environ").read_bytes().split(b"\0")
                if f"ST3_ENDPOINT={self.endpoint}".encode() not in environ:
                    continue
                if not any(item.startswith(b"ST_AGENT=agent/") for item in environ):
                    continue
                argv = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode()
                row = (int(proc.name), argv)
                if with_environment:
                    row += ([value.decode(errors="replace") for value in environ],)
                rows.append(row)
            except (OSError, UnicodeError):
                pass
        return rows

    def stop(self):
        if self.daemon and self.daemon.poll() is None:
            os.killpg(self.daemon.pid, signal.SIGTERM)
            try:
                self.daemon.wait(15)
            except subprocess.TimeoutExpired:
                os.killpg(self.daemon.pid, signal.SIGKILL)
        listed = self.pty("list", "--json")
        try:
            for row in json.loads(listed.stdout or "[]"):
                self.pty("kill", row["name"])
        except (ValueError, KeyError):
            pass
        for sig in (signal.SIGTERM, signal.SIGKILL):
            for pid, _ in self.seat_processes():
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    pass
            time.sleep(0.3)


def seat_subject(letter):
    return IMPORTED_SUBJECT or f"agent/{RUN_ID}/seat-{letter}"


def mission_source(node, count, harness, hold=False):
    seats = ""
    # A step waiting on a gate that never passes keeps the run, and so its seats, alive after the
    # seats finish theirs.
    steps = """
  step "hold" {
    agentless
    title "Boot canary: the run stays open"
    gate "never" { exists "mission-run/${ST_MISSION_RUN}/never" }
  }""" if hold else ""
    for letter in LETTERS[:count]:
        if not IMPORTED_SUBJECT:
            seats += f'''
  agent "seat-{letter}" {{
    workspace "{node.root / 'ws'}"
    restart "always"
    harness "{harness}" {{}}
  }}'''
        steps += f'''
  step "work-{letter}" {{
    assigned-to "{IMPORTED_SUBJECT or ('agent/${ST_MISSION_RUN}/seat-' + letter)}"
    goal "Boot canary: claim this step."
  }}'''
    return f'''version 2
mission "{MISSION}" state="ready" {{
  goal "Boot canary."{seats}{steps}
}}
'''


def trace(node, subject):
    rows = []
    for line in node.cli("trace", "show", subject, "--json", "--limit", "500", check=False).splitlines():
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    return rows


def parked(node, subject):
    """The crash-loop guard's decision for this seat, if it parked it."""
    for row in trace(node, subject):
        body = row.get("body", row)
        fields = body.get("fields", body)
        if row.get("kind") == "runtime.reconcile-decision" and "crash-loop" in str(fields.get("key", "")):
            return fields
        if row.get("kind") == "runtime.action.failed" and fields.get("action") == "claude-channel-recovery":
            return fields
    return None


class Seats:
    """The seats of one run and what each must show to count as booted."""

    def __init__(self, node, letters, bound):
        self.node, self.letters, self.bound = node, letters, bound
        self.incarnations = {}
        self.timings = {}
        self.read_probes = set()

    def step(self, letter):
        listed = self.node.cli("work", "ls", "--all")
        for line in listed.splitlines():
            if line.startswith("step-run/") and line.split()[0].endswith(f"/work-{letter}"):
                return line.split()[0]
        return None

    def view(self, letter):
        """The seat and its step as the daemon shows them; empty until the run has created them."""
        try:
            agent = (self.node.json("agents", "show", seat_subject(letter)) or {}).get("value") or {}
            ref = self.step(letter)
            work = (self.node.json("work", "show", ref) or {}).get("value") if ref else {}
        except Failure:
            return {}, {}
        return agent, work or {}

    def prove(self, label, fresh_incarnation=True):
        """Each seat claims its step with a new incarnation and reads a message, in time."""
        started = time.monotonic()
        pending = set(self.letters)
        probes = {}
        deadline = started + self.bound
        while pending:
            self.node.daemon.poll() is None or fail("the daemon exited: " + self.node.tail("daemon.log"))
            for letter in sorted(pending):
                subject = seat_subject(letter)
                guard = parked(self.node, subject)
                if guard:
                    fail(f"{subject} parked in the crash-loop guard during {label}: {guard}")
                agent, work = self.view(letter)
                incarnation = work.get("claim_incarnation")
                if work.get("state") != "claimed" or not incarnation:
                    continue
                if fresh_incarnation and incarnation == self.incarnations.get(letter):
                    continue
                if incarnation != agent.get("incarnation_id"):
                    continue
                if letter not in probes:
                    sent = self.node.json("conversations", "send", subject, "--from", "person/eval",
                                          "--subject", f"probe {label}", "--body", f"boot canary {label}")
                    probes[letter] = sent["subject"]
                view = self.node.api("/v1/messages/read/" + probes[letter]) or {}
                if view.get("status") in ("read", "closed"):
                    self.read_probes.add(probes[letter])
                    self.incarnations[letter] = incarnation
                    self.timings[f"{label}:{letter}"] = round(time.monotonic() - started, 1)
                    pending.discard(letter)
            if pending and time.monotonic() > deadline:
                detail = {letter: {"agent": {k: self.view(letter)[0].get(k) for k in
                                             ("state", "harness_state", "incarnation_id", "fault", "reason")},
                                   "work": {k: self.view(letter)[1].get(k) for k in
                                            ("state", "claim_incarnation")},
                                   "probe": probes.get(letter)} for letter in sorted(pending)}
                fail(f"{label}: {sorted(pending)} did not claim a step and read a message within "
                     f"{self.bound:.0f}s: {json.dumps(detail)}")
            time.sleep(0.5)
        for letter in self.letters:
            if parked(self.node, seat_subject(letter)):
                fail(f"{seat_subject(letter)} parked after {label}")


def driver_processes(node):
    """The seat's long-lived st3 processes (driver and channels), by pid and the inode they execute."""
    rows = {}
    for pid, argv in node.seat_processes():
        if " driver-hook " in argv:
            continue
        try:
            exe = Path(f"/proc/{pid}/exe").resolve()
            if exe.name.startswith("st3"):
                rows[pid] = (argv, os.stat(f"/proc/{pid}/exe").st_ino)
        except OSError:
            pass
    return rows


def check_boundary(node, stopped=False, processes=None):
    """A fresh seat's processes stay inside st's boundary."""
    if processes is None:
        processes = node.seat_processes(with_environment=True)
    if stopped:
        if processes:
            fail("a parked seat still has live processes")
        violations = list(output_findings(node.root))
    else:
        violations = list(fresh_seat_findings(node.root, processes))
    if violations:
        fail("fresh seat boundary: " + "; ".join(violations))


def replacement_processes(node, subject, previous_incarnation):
    """One actual process sample containing the replacement seat's exact runtime fence."""
    agent = (node.json("agents", "show", subject) or {}).get("value") or {}
    incarnation = agent.get("incarnation_id")
    if not incarnation or incarnation == previous_incarnation:
        return None
    processes = node.seat_processes(with_environment=True)
    if not any(f"ST_AGENT={subject}" in environment
               and f"ST3_INCARNATION={incarnation}" in environment
               for _, _, environment in processes):
        return None
    # Inspect this entire sample, including any surviving old process: a generation barrier
    # must not discard arbitrary launch/environment findings or resample an empty handoff.
    return processes


def wait_drained(spools, bound):
    """Every observation a seat's driver committed to its spool is acknowledged in time."""
    import sqlite3

    def drained():
        for database in spools:
            with sqlite3.connect(database) as connection:
                if connection.execute("SELECT EXISTS(SELECT 1 FROM events)").fetchone()[0]:
                    return False
        return True
    until(drained, bound, "committed harness observations were not acknowledged")


def receipts(node, letter):
    path = node.root / "ws" / f"receipts-{seat_subject(letter).replace('/', '-')}.jsonl"
    rows = []
    for line in path.read_text().splitlines() if path.exists() else []:
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    return rows


def native_sessions(node, letter):
    """Each native session the stand-in ran, in order: (id, resumed)."""
    found = []
    for row in receipts(node, letter):
        if row.get("event") in ("session", "thread"):
            found.append((row.get("session_id") or row.get("sessionId") or row.get("id"),
                          bool(row.get("resumed"))))
    return found


def forget_native_session(node, harness, session):
    """Remove what the harness resumes `session` from, as a lost transcript would."""
    home = node.root / "home"
    if harness == "claude":
        paths = list((home / ".claude/projects").rglob(f"{session}.jsonl"))
    elif harness == "codex":
        paths = list((home / ".codex/sessions").rglob(f"rollout-*-{session}.jsonl"))
    elif harness in ("pi", "omp"):
        paths = list((node.root / "state").rglob(f"provider-sessions/*_{session}.jsonl"))
    else:
        import sqlite3
        with sqlite3.connect(home / ".local/share/opencode/opencode.db") as connection:
            removed = connection.execute("DELETE FROM session WHERE id=?", (session,)).rowcount
        paths = [] if removed else None
    if paths is None or (harness != "opencode" and not paths):
        fail(f"no {harness} transcript of {session} to remove")
    for path in paths:
        path.unlink()


def native_offer_count(node, reference):
    """Count provider handoffs, independently of idempotent graph receipt claims."""
    return sum((row.get("event") == "channel" and reference in row.get("content", ""))
               or (row.get("event") == "turn" and reference in row.get("text", ""))
               for row in receipts(node, "a"))


def age_mail_fixture(node, subject):
    """Backdate isolated mail while preserving the store's transactional row digest."""
    import hashlib
    import sqlite3

    def projection_change(accumulator, table, columns, old, new, version):
        # Matches smallclaims::store::projection_digest's version-one row accumulator.
        if version != 1:
            raise ValueError("unsupported fixture projection digest version")
        total = int.from_bytes(accumulator, "big")
        for row, sign in ((old, -1), (new, 1)):
            if row is None:
                continue
            digest = hashlib.sha512(b"st3-projection-row-v1\0")
            for value in (table, columns, row):
                data = value.encode()
                digest.update(len(data).to_bytes(8, "big"))
                digest.update(data)
            total += sign * int.from_bytes(digest.digest(), "big")
        return (total % (1 << 512)).to_bytes(64, "big")

    with sqlite3.connect(node.root / "state/claims.sqlite3", timeout=10) as connection:
        connection.execute("PRAGMA recursive_triggers=ON")
        connection.create_function("st_projection_change", 6, projection_change, deterministic=True)
        changed = connection.execute(
            "UPDATE claims SET accepted_at_unix_ms=? WHERE subject=? AND kind='message.sent'",
            (str(time.time_ns() // 1_000_000 - 3_600_001), subject),
        ).rowcount
        if changed != 1:
            fail("the hour-old fixture has no unique sent claim")


def suspend_and_resume(node, seats, harness):
    subject = seat_subject("a")
    step = seats.step("a")
    work = node.json("work", "show", step)["value"]
    node.cli("work", "complete", step, "--as", subject, "--incarnation", work["claim_incarnation"],
             "--summary", "boot canary step done")

    def suspend():
        # The harness settles after its last turn; until its driver reports it quiet, st refuses.
        result = node.cli("agents", "suspend", subject, "--as", "person/eval", "--timeout", "60s",
                          "--json", check=False)
        try:
            return json.loads(result)
        except ValueError:
            return None
    agent = until(suspend, seats.bound, "the seat never suspended: " + json.dumps(
        node.json("agents", "show", subject).get("value", {}).get("suspension")))
    suspension = agent.get("suspension") or {}
    native = suspension.get("native_session_id")
    if agent.get("state") != "suspended" or suspension.get("phase") != "suspended" or not native:
        fail(f"suspend did not leave a suspended seat with a native session: {json.dumps(agent)}")
    launched = native_sessions(node, "a")
    if not launched or launched[-1][0] != native:
        fail(f"the suspended session {native} is not the one the harness ran: {launched}")
    # The suspend scenario runs one seat, so every seat process this daemon launched is its.
    until(lambda: not node.seat_processes(), 60, "a suspended seat still has processes: "
          + json.dumps(node.seat_processes()))

    # Mail to a suspended seat waits, and its restart policy does not wake it.
    sent = node.json("conversations", "send", subject, "--from", "person/eval",
                     "--subject", "while suspended", "--body", "boot canary suspended")["subject"]
    # Old means the same one-hour age as the backlog; only this isolated fixture is changed.
    age_mail_fixture(node, sent)
    time.sleep(5)
    held = node.api("/v1/messages/read/" + sent) or {}
    if held.get("status") in ("read", "closed"):
        fail("a suspended seat read a message")
    if node.json("agents", "show", subject)["value"].get("state") != "suspended":
        fail("a suspended seat did not stay suspended")

    recent = node.json("conversations", "send", subject, "--from", "person/eval",
                       "--subject", "recent while suspended", "--body", "boot canary recent resume")["subject"]
    resumed = json.loads(node.cli("agents", "resume", subject, "--as", "person/eval",
                                  "--timeout", f"{seats.bound:.0f}s", "--json"))
    after = resumed.get("suspension") or {}
    if after.get("phase") != "resumed" or after.get("native_session_id") != native:
        fail(f"resume did not bring back session {native}: {json.dumps(resumed)}")
    latest = native_sessions(node, "a")[-1]
    if latest != (native, True):
        fail(f"the resumed harness ran {latest}, not session {native} resumed")
    # Recent never-offered mail survives the boot, while hour-old mail stays listable.
    until(lambda: (node.api("/v1/messages/read/" + recent) or {}).get("status") in ("read", "closed"),
          seats.bound, "the resumed seat did not recover recent unoffered mail")
    if native_offer_count(node, recent) != 1:
        fail("recent unoffered mail was not consumed exactly once after resume")
    # Resuming a native session is still a new seat boot. Its old mail remains listable,
    # and a fresh message proves that the resumed provider's delivery path works.
    until(lambda: (node.json("agents", "show", subject).get("value", {}).get("delivery") or {}).get("state") in ("current", "legacy"),
          seats.bound, "the resumed seat's channel did not become ready")
    fresh = node.json("conversations", "send", subject, "--from", "person/eval",
                      "--subject", "after resume", "--body", "boot canary fresh resume")["subject"]
    until(lambda: (node.api("/v1/messages/read/" + fresh) or {}).get("status") in ("read", "closed"),
          seats.bound, "the resumed seat did not read fresh mail")
    if (node.api("/v1/messages/read/" + sent) or {}).get("status") != held.get("status"):
        fail("resuming a seat automatically advanced its old mail")
    if native_offer_count(node, sent) != 0:
        fail("resuming a seat offered old mail to the provider")
    if native_offer_count(node, recent) != 1:
        fail("recovered recent mail reached the provider again")
    wait_drained(list((node.root / "state/drivers").rglob("st-harness-events.sqlite")), seats.bound)
    check_boundary(node)

    # A resume that cannot find its session says why, and the seat stays suspended.
    agent = until(suspend, seats.bound, "the resumed seat never suspended again")
    native = agent["suspension"]["native_session_id"]
    forget_native_session(node, harness, native)
    result = subprocess.run([str(node.binary), "--endpoint", str(node.endpoint), "agents", "resume", subject,
                             "--as", "person/eval", "--timeout", f"{seats.bound:.0f}s"],
                            env=node.env, capture_output=True, text=True, timeout=seats.bound + 30)
    if result.returncode == 0:
        fail("a resume without its transcript succeeded")
    shown = node.json("agents", "show", subject)["value"]
    code = (shown.get("suspension") or {}).get("code")
    if shown.get("state") != "suspended" or code not in (
            "transcript-missing", "harness-refused", "native-resume-unavailable"):
        fail(f"a failed resume left {json.dumps(shown.get('suspension'))} in state {shown.get('state')}: "
             f"{result.stderr.strip()}")
    seats.timings["suspend:failed-resume-code"] = code


def continued_session(node, label):
    """The relaunched harness continued the session its predecessor ran, as every restart does."""
    launched = native_sessions(node, "a")
    if len(launched) < 2:
        fail(f"{label}: the seat ran {launched}, not a session and its continuation")
    previous, latest = launched[-2][0], launched[-1]
    if latest != (previous, True):
        fail(f"{label}: the relaunched harness ran {latest}, not session {previous} continued")


def codex_transcript_recovery(node, seats):
    """Recover a bounded receipt, and survive failed discovery, in a private real daemon."""
    if node.harness != "codex":
        fail("the utf8 scenario needs Codex")
    import importlib.util
    spec = importlib.util.spec_from_file_location("canary_codex", HERE / "stub-codex.py")
    stub = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(stub)
    subject = seat_subject("a")
    native = native_sessions(node, "a")[-1][0]
    sessions = node.root / "home/.codex/sessions"
    rollout = next(sessions.rglob(f"rollout-*-{native}.jsonl"))
    stub.split_utf8_rollout(rollout, native)
    (node.root / "ws/codex-transcript-mode").write_text("utf8")

    def send(label):
        return node.json("conversations", "send", subject, "--from", "person/eval",
                         "--subject", label, "--body", "transcript regression €")["subject"]

    first = send("split UTF-8 receipt")
    until(lambda: any(row.get("event") == "transcript-steer" and first in row.get("text", "")
                      for row in receipts(node, "a")), seats.bound, "the first steer never reached Codex")
    second = send("while receipt recovery is needed")
    for message in (first, second):
        until(lambda: (node.api("/v1/messages/read/" + message) or {}).get("status") in ("read", "closed"),
              seats.bound, "split UTF-8 stopped receipt recovery or the next delivery")

    # Force a real discovery I/O error. A stale systemError asks auxiliary turn recovery to
    # run; the subsequent live idle status and receipt must still be processed on this socket.
    (node.root / "ws/codex-transcript-mode").write_text("failure")
    saved = sessions.with_name("sessions-saved")
    sessions.rename(saved)
    sessions.write_text("not a directory")
    try:
        third = send("during transcript discovery failure")
        until(lambda: (node.api("/v1/messages/read/" + third) or {}).get("status") in ("read", "closed"),
              seats.bound, "a discovery failure stopped live delivery/receipts")
        logs = list((node.root / "state/drivers").rglob("driver.log"))
        until(lambda: any("bounded transcript" in path.read_text() for path in logs), seats.bound,
              "the discovery warning never reached the private driver log")
        time.sleep(3)
        warnings = [json.loads(line) for path in logs for line in path.read_text().splitlines()
                    if "bounded transcript" in line]
        if len(warnings) > 2:
            fail(f"transcript warnings were not rate-limited: {len(warnings)}")
        terminal = node.pty("peek", "--plain", "--full", "c1.seat-a")
        if "bounded transcript" in terminal.stdout + terminal.stderr:
            fail("a driver warning reached the harness PTY")
    finally:
        sessions.unlink()
        saved.rename(sessions)
        (node.root / "ws/codex-transcript-mode").unlink()
    if node.json("agents", "show", subject)["value"].get("incarnation_id") != seats.incarnations["a"]:
        fail("transcript recovery replaced the seat instead of preserving delivery")


def claude_attachment(node, seats, mode):
    """Hooks can be idle with no usable MCP channel. Hold early mail, then recover once."""
    control = node.root / "ws/claude-channel-mode"
    control.write_text("missing-once" if mode == "missing" else mode)
    old = seats.incarnations["a"]
    node.cli("agents", "restart", seat_subject("a"), "--as", "person/eval", check=False)
    early = node.json("conversations", "send", seat_subject("a"), "--from", "person/eval",
                      "--subject", "early attachment probe", "--body", "mail immediately after restart")["subject"]

    def blocked():
        agent, _ = seats.view("a")
        return (agent.get("incarnation_id") != old and agent.get("harness_state") == "blocked"
                and agent.get("reason") == "claude-channel-unattached")

    until(blocked, 45, "idle hooks hid an unattached Claude channel")
    delivery = (node.api("/v1/messages/delivery/" + early) or {}).get("delivery")
    if not delivery or delivery.get("state") != "waiting" or "channel" not in delivery.get("reason", ""):
        fail(f"unattached channel did not visibly hold early mail: {delivery}")
    if native_offer_count(node, early) != 0:
        fail("an unattached channel offered early mail")
    blocked_incarnation = seats.view("a")[0].get("incarnation_id")
    if mode == "uninitialized":
        control.unlink()
    seats.prove("channel-recovered", fresh_incarnation=mode == "missing")
    recovered_incarnation = seats.view("a")[0].get("incarnation_id")
    recovery_claims = (node.api("/v1/claims?subject=" + seat_subject("a") + "&limit=100") or {}).get("claims", [])
    automatic = [row for row in recovery_claims if row.get("kind") == "runtime.action.requested"
                 and row.get("body", {}).get("fields", {}).get("operation") == "claude-channel-recovery"]
    if mode == "missing":
        if recovered_incarnation == blocked_incarnation or len(automatic) != 1:
            fail(f"the missing channel did not recover with one automatic restart: {automatic}")
        continued_session(node, "automatic channel recovery")
    elif recovered_incarnation != blocked_incarnation or automatic:
        fail("a channel initialized during recheck was unnecessarily restarted")
    until(lambda: (node.api("/v1/messages/read/" + early) or {}).get("status") in ("read", "closed"),
          seats.bound, "early mail did not recover after channel attachment")
    until(lambda: native_offer_count(node, early) == 1, seats.bound, "early mail was not offered once")
    def exact_receipts(reference):
        claims = (node.api("/v1/claims?subject=" + reference + "&limit=100") or {}).get("claims", [])
        phases = Counter(row.get("kind") for row in claims)
        for kind in ("message.staged", "message.delivered", "message.read"):
            if phases[kind] != 1:
                fail(f"{reference} has {phases[kind]} {kind} receipts, expected one")
    exact_receipts(early)
    for probe in seats.read_probes:
        if native_offer_count(node, probe) != 1:
            fail(f"channel recovery replayed a boot probe: {probe}")
    # Restart twice more and send within startup, while retaining the first probe's proof.
    for index in range(2):
        node.cli("agents", "restart", seat_subject("a"), "--as", "person/eval", check=False)
        fresh = node.json("conversations", "send", seat_subject("a"), "--from", "person/eval",
                          "--subject", f"immediate probe {index}", "--body", "early fresh mail")["subject"]
        seats.prove(f"channel-restart-{index}")
        until(lambda: (node.api("/v1/messages/read/" + fresh) or {}).get("status") in ("read", "closed"),
              seats.bound, "mail sent during startup was never read")
        until(lambda: native_offer_count(node, fresh) == 1, seats.bound, "startup mail was not offered once")
        exact_receipts(fresh)
    time.sleep(3)
    if native_offer_count(node, early) != 1:
        fail("a second restart replayed the recovered mail")
    exact_receipts(early)


def claude_channel_parked(node, seats):
    """A permanently missing channel exhausts a durable budget and keeps mail held."""
    (node.root / "ws/claude-channel-mode").write_text("missing")
    node.cli("agents", "restart", seat_subject("a"), "--as", "person/eval", check=False)
    early = node.json("conversations", "send", seat_subject("a"), "--from", "person/eval",
                      "--subject", "parked attachment probe", "--body", "mail while unattached")["subject"]
    processes = until(
        lambda: replacement_processes(node, seat_subject("a"), seats.incarnations["a"]),
        seats.bound, "the replacement generation never supplied fresh seat processes")
    check_boundary(node, processes=processes)
    until(lambda: parked(node, seat_subject("a")), 180, "permanent channel failure never parked")
    until(lambda: "claude-channel-unattached" in json.dumps(seats.view("a")[0]),
          10, "parked channel failure lost its visible reason")

    def attempts():
        claims = (node.api("/v1/claims?subject=" + seat_subject("a") + "&limit=500") or {}).get("claims", [])
        return [row for row in claims if row.get("kind") == "runtime.action.requested"
                and row.get("body", {}).get("fields", {}).get("operation") == "claude-channel-recovery"]

    if len(attempts()) != 3:
        fail(f"channel failure used {len(attempts())} recovery attempts, expected three")
    starts = len([row for row in receipts(node, "a") if row.get("event") == "started"])
    until(lambda: len([row for row in receipts(node, "a") if row.get("event") == "ended"]) == starts,
          20, "parked channel did not stop its provider")
    node.kill_daemon()
    node.start()
    time.sleep(30)
    if len(attempts()) != 3 or len([row for row in receipts(node, "a") if row.get("event") == "started"]) != starts:
        fail("parked channel restarted after the daemon lost its in-memory budget")
    if native_offer_count(node, early) != 0:
        fail("parked channel offered mail without attachment")
    delivery = (node.api("/v1/messages/delivery/" + early) or {}).get("delivery")
    if not delivery or delivery.get("state") != "waiting" or not delivery.get("reason"):
        fail(f"parked channel lost the mail hold: {delivery}")


def prepare_codex_import(node):
    """Discovery sees a symlinked home; the launch environment contains a stale copy."""
    global IMPORTED_SUBJECT
    native = "019fae17-c215-7882-a4d9-5f247168ffce"
    origin = node.root / "home/.codex-origin"
    stale = node.root / "home/.codex-stale"
    for home in (origin, stale):
        directory = home / "sessions/2026/09/21"
        directory.mkdir(parents=True)
        (directory / f"rollout-2026-09-21T08-00-00-{native}.jsonl").write_text(
            json.dumps({"type": "session_meta", "payload": {
                "id": native, "cwd": str(node.root / "ws"), "source": "test"}}) + "\n")
    (node.root / "home/.codex").symlink_to(origin)
    node.env["CODEX_HOME"] = str(stale)
    node.start()
    listed = node.json("import", "ls", "--all")
    items = listed.get("value", listed)["items"]
    external = next(item for item in items if item.get("native_session_id") == native)
    imported = node.json("import", "run", external["id"], "--as", "person/eval")
    IMPORTED_SUBJECT = next(subject for subject in imported.get("value", imported)["affected_ids"]
                            if subject.startswith("agent/import/"))
    return native, origin


def prove_codex_import(node, seats, native, origin):
    def exact_binding():
        view = node.json("agents", "show", seat_subject("a")).get("value", {})
        if view.get("incarnation_id") != seats.incarnations["a"]:
            return False
        for row in trace(node, seat_subject("a")):
            fields = row.get("body", {}).get("fields", {})
            if (row.get("kind") == "harness.session-file" and
                    fields.get("incarnation_id") == seats.incarnations["a"]):
                if fields.get("session_id") != native:
                    fail(f"the imported incarnation bound another native ID: {fields}")
                return True
        return False
    until(exact_binding, seats.bound, "the imported incarnation did not bind the selected native ID")
    sessions = native_sessions(node, "a")
    if not sessions or any(session != (native, True) for session in sessions):
        fail(f"the imported seat selected another session: {sessions}")
    providers = [environment for _, argv, environment in node.seat_processes(True)
                 if "stub-codex.py" in argv]
    if not providers or any(f"CODEX_HOME={origin}" not in env for env in providers):
        fail("an imported provider did not use the pinned originating CODEX_HOME")


def idle_delivery_control(node, seats):
    """Count real API calls for an idle minute, then prove hold/release/expiry on native mail."""
    if node.harness not in ("codex", "opencode"):
        fail("the idle hold canary requires Codex or OpenCode")
    subject = seat_subject("a")

    def read(reference):
        return (node.api("/v1/messages/read/" + reference) or {}).get("status") in ("read", "closed")

    def calls():
        result = subprocess.run(["curl", "-sf", "--max-time", "10", "--unix-socket", str(node.endpoint),
                                 "-H", "x-st3-person: person/eval",
                                 "http://localhost/v1/client/request-latency"],
                                capture_output=True, text=True, check=True)
        report = json.loads(result.stdout)["value"]
        return sum(row["count"] for row in report["routes"] if row["route"] == "/v1/delivery/hold")

    # Let the boot receipt settle before measuring. Its permit must expire without fresh mail.
    time.sleep(4)
    original = set(driver_processes(node))
    before = calls()
    start = time.monotonic()
    time.sleep(60)
    after = calls()
    measured = {"idle_seconds": round(time.monotonic() - start, 3),
                "hold_calls_before": before, "hold_calls_after": after,
                "calls_per_idle_minute": after - before}
    node.idle_delivery_control = measured
    if after != before:
        fail(f"idle provider polled delivery hold: {measured}")
    if not original or set(driver_processes(node)) != original:
        fail("the idle provider's driver exited or was replaced during measurement")

    def send(label):
        return node.json("conversations", "send", subject, "--from", "person/eval",
                         "--subject", label, "--body", label)["subject"]

    def finish(reference, label):
        start = time.monotonic()
        until(lambda: read(reference), 10, label + " did not reach consumption/read")
        measured[label + "_seconds"] = round(time.monotonic() - start, 3)
        until(lambda: sum(row.get("event") == "read" and row.get("reference") == reference
                          for row in receipts(node, "a")) == 1,
              10, label + " has no unique native read receipt")

    # First mail after the minute must obtain a fresh permit immediately, not wait for a poll.
    fresh = send("after-idle")
    finish(fresh, "after_idle")
    node.cli("agents", "hold", subject, "--for", "30s", "--reason", "fixture quiet interval",
             "--as", "person/eval")
    held = send("held-delivery")
    time.sleep(4)
    if read(held) or any(row.get("reference") == held for row in receipts(node, "a")):
        fail("a held message reached the native provider")
    node.cli("agents", "hold", subject, "--release", "--reason", "fixture release", "--as", "person/eval")
    finish(held, "released")
    node.cli("agents", "hold", subject, "--for", "4s", "--reason", "fixture expiry", "--as", "person/eval")
    expiry = send("expiry-delivery")
    time.sleep(1)
    if read(expiry) or any(row.get("reference") == expiry for row in receipts(node, "a")):
        fail("a message reached the native provider before hold expiry")
    finish(expiry, "expired")
    time.sleep(3)
    counts = Counter(row.get("reference") for row in receipts(node, "a") if row.get("event") == "read")
    for reference in seats.read_probes | {fresh, held, expiry}:
        if counts[reference] != 1:
            fail(f"hold/idle recovery replayed native input {reference}: {counts[reference]} reads")
    return measured


def scenario(node, seats, name, scratch, replacement_binary=None):
    if name in ("fresh", "concurrent"):
        return
    # Boot proved a durable read. Observe actual provider receipts too: idempotent graph
    # claims can hide a second model turn if a restart offers the same old message again.
    previous_probes = seats.read_probes.copy()
    def probe_reads():
        return Counter(row.get("reference") for letter in seats.letters
                       for row in receipts(node, letter) if row.get("event") == "read")
    until(lambda: all(probe_reads()[ref] >= 1 for ref in previous_probes), seats.bound,
          "the providers did not record their boot probe reads")
    if name == "idle-hold":
        idle_delivery_control(node, seats)
        return
    if name == "utf8":
        codex_transcript_recovery(node, seats)
        return
    if name == "suspend":
        suspend_and_resume(node, seats, node.harness)
        return
    if name == "channel-parked":
        claude_channel_parked(node, seats)
        return
    if name.startswith("channel-"):
        claude_attachment(node, seats, name.removeprefix("channel-"))
        return
    if name == "import":
        native, origin = node.import_selection
        prove_codex_import(node, seats, native, origin)
        node.cli("agents", "restart", seat_subject("a"), "--as", "person/eval")
        seats.prove("import-restart")
        prove_codex_import(node, seats, native, origin)
    elif name == "restart":
        node.cli("agents", "restart", seat_subject("a"), "--as", "person/eval", check=False)
        seats.prove("restart")
        continued_session(node, "restart")
    elif name == "daemon-restart":
        # The provider dies with the daemon, so the new daemon's latest observation of the seat is
        # still the running predecessor.
        node.kill_daemon()
        for row in json.loads(node.pty("list", "--json").stdout or "[]"):
            node.pty("kill", row["name"])
        node.start()
        seats.prove("daemon-restart")
        continued_session(node, "daemon-restart")
    elif name == "reexec":
        before = driver_processes(node)
        providers = {pid: argv for pid, argv in node.seat_processes() if "stub-" in argv}
        if not providers:
            fail("no provider process to preserve across reexec")
        if not before:
            fail("no seat driver process to re-exec")
        # A deploy installs the new binary, then restarts the daemon from it; the daemon re-points
        # the link every seat follows, and each driver and channel re-execs in place.
        replacement = scratch / "st3-replacement"
        shutil.copy2(replacement_binary or node.binary.resolve(), replacement)
        staging = node.root / "bin/st3.staged"
        staging.symlink_to(replacement)
        os.replace(staging, node.binary)
        new_inode = os.stat(replacement).st_ino
        node.daemon.terminate()
        node.daemon.wait(30)
        node.start()

        def swapped():
            alive = [pid for pid in before if Path(f"/proc/{pid}").exists()]
            return alive and all(os.stat(f"/proc/{pid}/exe").st_ino == new_inode for pid in alive)
        until(swapped, 60, "the seat's st processes did not re-exec into the replacement: "
                           + json.dumps({str(pid): argv[:80] for pid, (argv, _) in before.items()}))
        seats.prove("reexec", fresh_incarnation=False)
        if not all(Path(f"/proc/{pid}").exists() for pid in providers):
            fail("a provider process was replaced during driver reexec")
    else:
        fail(f"unknown scenario {name}")
    # Keep watching after the new mail succeeds, through several channel polls.
    time.sleep(3)
    if name == "import":
        prove_codex_import(node, seats, *node.import_selection)
    counts = probe_reads()
    repeated = {ref: counts[ref] for ref in previous_probes if counts[ref] != 1}
    if repeated:
        fail(f"{name}: already-read boot mail reached the provider again: {repeated}")


def run(args, root, evidence):
    node = Node(root, args.binary, args.harness)
    count = 5 if args.scenario == "concurrent" else 1
    letters = LETTERS[:count]
    seats = Seats(node, letters, args.bound)
    try:
        if args.scenario == "import":
            if args.harness != "codex":
                fail("the import regression uses Codex")
            node.import_selection = prepare_codex_import(node)
        else:
            node.start()
        source = root / "mission.kdl"
        source.write_text(mission_source(node, count, args.harness, hold=args.scenario == "suspend"))
        node.cli("missions", "publish", str(source), "--as", "person/eval")
        node.cli("missions", "start", MISSION, "--id", RUN_ID, "--workspace", str(root / "ws"),
                 "--as", "person/eval")
        seats.prove("boot")
        catalogs_before = {str(path): path.read_bytes() for pattern in ("catalog.kdl", "agent.kdl")
                           for path in (root / "state/drivers").rglob(pattern)}
        scenario(node, seats, args.scenario, args.scratch, args.replacement_binary)
        catalogs_after = {str(path): path.read_bytes() for pattern in ("catalog.kdl", "agent.kdl")
                          for path in (root / "state/drivers").rglob(pattern)}
        if catalogs_after != catalogs_before:
            fail("native startup/reexec fabricated or rewrote a catalog")
        if not args.replacement_binary and catalogs_after:
            fail("fresh native seats fabricated per-seat catalogs")
        records = [path for name in ("harness-state", "harness-context", "harness-timeline")
                   for path in (root / "state/drivers").rglob(name)]
        spools = list((root / "state/drivers").rglob("st-harness-events.sqlite"))
        if not args.replacement_binary:
            if records:
                fail("fresh native seats used polled harness records: " + str(records))
            if len(spools) != len(letters):
                fail("a fresh native seat has no durable observation spool")
            # Suspended and parked seats have no driver to acknowledge their final spool or
            # process to inspect; both scenarios check the launch boundary while still running.
            if args.scenario not in ("suspend", "channel-parked"):
                wait_drained(spools, args.bound)
                check_boundary(node)
            elif args.scenario == "channel-parked":
                check_boundary(node, stopped=True)
        return {"verdict": "pass", "harness": args.harness, "scenario": args.scenario,
                "seconds_to_boot": seats.timings,
                "idle_delivery_control": getattr(node, "idle_delivery_control", None),
                "catalog_files": len(catalogs_after),
                "harness_record_files": len(records), "observation_spools": len(spools)}
    except (Failure, subprocess.TimeoutExpired) as error:
        return {"verdict": "fail", "harness": args.harness, "scenario": args.scenario,
                "failure": str(error), "seconds_to_boot": seats.timings,
                "idle_delivery_control": getattr(node, "idle_delivery_control", None)}
    finally:
        try:
            for letter in letters:
                terminal = node.pty("peek", "--plain", "--full", seat_subject(letter).removeprefix("agent/").replace("/", "."))
                (evidence / f"terminal-{letter}.txt").write_text(terminal.stdout + terminal.stderr)
                if node.daemon is not None and node.daemon.poll() is None:
                    (evidence / f"trace-{letter}.jsonl").write_text(
                        node.cli("trace", "show", seat_subject(letter), "--json", "--limit", "500", check=False))
            for index, record in enumerate(sorted((root / "state").rglob("harness-state"))):
                (evidence / f"harness-state-{index}.json").write_text(record.read_text(errors="replace"))
            # The outbox and driver warnings explain a stalled observation without depending on
            # the temporary runtime surviving cleanup. Keep fixture evidence, never native content.
            import sqlite3
            summaries = []
            for database in (root / "state/drivers").rglob("st-harness-events.sqlite"):
                try:
                    with sqlite3.connect(database) as connection:
                        pending = connection.execute("SELECT sequence,kind FROM events ORDER BY sequence").fetchall()
                        metadata = connection.execute("SELECT key,value FROM metadata WHERE key='runtime' OR key LIKE 'provider-runtime:%'").fetchall()
                        snapshots = connection.execute("SELECT kind,body FROM snapshots WHERE kind='harness-state'").fetchall()
                        states = [{"kind": kind, "state": json.loads(body).get("state"), "incarnation": json.loads(body).get("incarnation")} for kind, body in snapshots]
                    summaries.append({"pending": pending, "metadata": metadata, "states": states})
                except sqlite3.Error as error:
                    summaries.append({"error": str(error)})
            (evidence / "observation-outboxes.json").write_text(json.dumps(summaries, indent=2) + "\n")
            for index, log in enumerate([*(root / "home/.local/state/st3").rglob("*.log"),
                                        *(root / "state/drivers").rglob("driver.log")]):
                (evidence / f"driver-{index}.log").write_text(log.read_text(errors="replace"))
        finally:
            node.stop()
        for path in [root / "daemon.log", *sorted((root / "ws").glob("receipts-*.jsonl"))]:
            if path.exists():
                (evidence / path.name).write_text(path.read_text(errors="replace"))


def private_root(make=tempfile.mkdtemp):
    """A short, private directory for one canary's daemon, sockets and seats.

    Short, because Unix socket paths are limited to about 100 bytes. And never named after st2: the
    fresh-seat boundary check rejects any launch path that mentions it, and a random name contains
    those three letters by chance (`/tmp/bc-0st2w5nz` did, and failed an unrelated PR's gate).
    """
    for _ in range(100):
        root = Path(make(prefix="bc-", dir="/tmp"))
        if "st2" not in root.name.lower():
            return root
        shutil.rmtree(root, ignore_errors=True)
    raise RuntimeError("could not make a private directory whose name avoids st2")


def self_test():
    """The root name is redrawn until it avoids st2, and the rejected directories are removed."""
    made = []
    names = iter(["bc-0st2w5nz", "bc-ST2abcde", "bc-xSt2yzzz", "bc-fine1234"])

    def make(prefix, dir):
        path = Path(tempfile.mkdtemp(prefix="bc-selftest-", dir=dir)).rename(Path(dir) / next(names))
        made.append(path)
        return str(path)
    try:
        root = private_root(make)
        assert root.name == "bc-fine1234", root
        assert [path.exists() for path in made] == [False, False, False, True], made
    finally:
        for path in made:
            shutil.rmtree(path, ignore_errors=True)
    # The parked canary may observe the gap after the predecessor exits. Its barrier must
    # wait for the replacement fence, while retaining every boundary finding in that sample.
    class BoundaryNode:
        incarnation = "old"
        processes = []
        def json(self, *args):
            return {"value": {"incarnation_id": self.incarnation}}
        def seat_processes(self, with_environment=False):
            assert with_environment
            return self.processes
    node = BoundaryNode()
    subject = "agent/fixture/seat"
    old = (1, "st3 driver", [f"ST_AGENT={subject}", "ST3_INCARNATION=old"])
    new = (2, "st3 driver", [f"ST_AGENT={subject}", "ST3_INCARNATION=new"])
    node.processes = [old]
    assert replacement_processes(node, subject, "old") is None
    node.incarnation = "new"
    node.processes = []
    assert replacement_processes(node, subject, "old") is None
    node.processes = [old]
    assert replacement_processes(node, subject, "old") is None
    foreign = (3, "st3 driver", ["ST_AGENT=agent/fixture/other", "ST3_INCARNATION=new"])
    node.processes = [foreign]
    assert replacement_processes(node, subject, "old") is None
    try:
        until(lambda: replacement_processes(node, subject, "old"), 0, "no replacement")
    except Failure as error:
        assert str(error) == "no replacement"
    else:
        raise AssertionError("missing replacement must fail within its finite bound")
    unsafe_old = (1, "st2 driver", old[2])
    node.processes = [unsafe_old, new]
    sample = replacement_processes(node, subject, "old")
    assert sample == node.processes
    with tempfile.TemporaryDirectory(prefix="boundary-test-") as directory:
        node.root = Path(directory)
        try:
            check_boundary(node, processes=sample)
        except Failure as error:
            assert "st2" in str(error)
        else:
            raise AssertionError("replacement must not erase another process boundary violation")
        try:
            check_boundary(node, processes=[])
        except Failure as error:
            assert "no fresh seat processes inspected" in str(error)
        else:
            raise AssertionError("empty inspection must remain a failure")
    print("ok")
    return 0


def main():
    if sys.argv[1:] == ["--self-test"]:
        return self_test()
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("binary", type=Path)
    parser.add_argument("evidence", type=Path)
    parser.add_argument("harness", choices=HARNESSES)
    parser.add_argument("scenario", choices=SCENARIOS)
    parser.add_argument("--replacement-binary", type=Path, default=None,
                        help="upgrade a predecessor binary to this build in the reexec scenario")
    parser.add_argument("--bound", type=float, default=90, help="seconds each phase may take")
    parser.add_argument("--scratch", type=Path, default=None,
                        help="a directory on a real disk for the replacement binary (reexec)")
    args = parser.parse_args()
    args.binary = args.binary.resolve()
    args.evidence.mkdir(parents=True, exist_ok=True)
    args.scratch = (args.scratch or args.evidence).resolve()
    args.scratch.mkdir(parents=True, exist_ok=True)
    root = private_root()
    try:
        result = run(args, root, args.evidence)
    finally:
        shutil.rmtree(root, ignore_errors=True)
    (args.evidence / "result.json").write_text(json.dumps(result, indent=2, default=str) + "\n")
    print(json.dumps(result, indent=2, default=str))
    return 0 if result["verdict"] == "pass" else 1


if __name__ == "__main__":
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    from st3_test_process import supervised_main
    raise SystemExit(supervised_main(main))
