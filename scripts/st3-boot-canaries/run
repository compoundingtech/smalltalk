#!/usr/bin/env python3
"""Boot canary: a real st3 daemon boots seats of one harness against a token-free stand-in provider.

    run BINARY EVIDENCE_DIR HARNESS SCENARIO

HARNESS is claude, codex, pi, omp or opencode. The stand-in provider (stub-*) speaks the real wire
contract of that harness and does what a model does when woken: reads the message and claims the
step it names. SCENARIO is one of

    fresh           a new seat boots
    restart         the seat is restarted and the new incarnation boots
    daemon-restart  the daemon dies with the seat's provider; the new daemon, whose latest
                    observation of the seat is still the dead predecessor, boots a replacement
    reexec          the st binary is replaced; the seat's driver re-execs into it and still
                    takes a message
    concurrent      five seats launch at once
    suspend         the booted seat finishes its step and is suspended: no process remains, a
                    message waits, and resume brings back the same native session, which reads
                    it. Then a resume whose transcript is gone fails with a typed reason and the
                    seat stays suspended.

Every seat must, within the time bound, claim its step with its current incarnation and read an
st message, and none may park in the crash-loop guard. The verdict is in EVIDENCE_DIR/result.json.
"""
import argparse
from collections import Counter
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
sys.dont_write_bytecode = True
from st_boundary import fresh_seat_findings

HARNESSES = ("claude", "codex", "pi", "omp", "opencode")
SCENARIOS = ("fresh", "restart", "daemon-restart", "reexec", "concurrent", "suspend")
RUN_ID = "c1"
MISSION = "canary/boot"
LETTERS = "abcde"


class Failure(Exception):
    pass


def fail(message):
    raise Failure(message)


def until(predicate, timeout, message, alive=lambda: None):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        alive()
        value = predicate()
        if value:
            return value
        time.sleep(0.25)
    fail(message)


def install_stub(bin_dir, harness):
    """Put the stand-in on PATH under the provider's own name, with absolute interpreters."""
    python, node = shutil.which("python3"), shutil.which("node")
    interpreter, script = {
        "claude": (python, "stub-claude.py"),
        "codex": (python, "stub-codex.py"),
        "opencode": (python, "stub-opencode.py"),
        "pi": (node, "stub-pi-family.mjs"),
        "omp": (node, "stub-pi-family.mjs"),
    }[harness]
    if not interpreter:
        raise SystemExit(f"{harness}'s stand-in needs {'node' if harness in ('pi', 'omp') else 'python3'} on PATH")
    wrapper = bin_dir / harness
    wrapper.write_text(f'#!/bin/sh\nexec env PYTHONDONTWRITEBYTECODE=1 STUB_HARNESS={harness} "{interpreter}" "{HERE / script}" "$@"\n')
    wrapper.chmod(0o755)


class Node:
    def __init__(self, root, binary, harness):
        self.root, self.harness = root, harness
        for sub in ("bin", "home", "run", "ws", "state"):
            (root / sub).mkdir(parents=True, exist_ok=True)
        # The seat's driver follows ST3_BIN, so re-pointing this link is how a deploy swaps the
        # binary. A link, because a debug st3 is hundreds of megabytes and /tmp is a small tmpfs.
        self.binary = root / "bin/st3"
        self.binary.symlink_to(binary)
        pty = shutil.which("pty")
        if not pty:
            raise SystemExit("pty must be on PATH")
        (root / "bin/pty").symlink_to(pty)
        install_stub(root / "bin", harness)
        self.path = f"{root / 'bin'}:/usr/bin:/bin"
        self.endpoint = root / "run/st.sock"
        self.env = {"PATH": self.path, "HOME": str(root / "home"), "SHELL": "/bin/bash",
                    "USER": os.environ.get("USER", "eval"), "LOGNAME": os.environ.get("USER", "eval"),
                    "LANG": "C.UTF-8", "XDG_STATE_HOME": str(root / "home/.local/state"),
                    "XDG_CONFIG_HOME": str(root / "home/.config"),
                    "XDG_DATA_HOME": str(root / "home/.local/share"),
                    "XDG_RUNTIME_DIR": str(root / "run"), "ST3_ENDPOINT": str(self.endpoint),
                    "ST3_DAEMON_WAIT": "0"}
        # The daemon rebuilds PATH from a login shell; pin it to the isolated one.
        profile = f"export PATH='{self.path}'\n"
        for name in (".profile", ".bash_profile", ".bashrc", ".zprofile", ".zshenv"):
            (root / "home" / name).write_text(profile)
        (root / "config.toml").write_text(f'''node = "canary"
person = "person/eval"
state_dir = "{root / 'state'}"
pty_root = "{root / 'pty'}"
socket = "{self.endpoint}"
client_gateway_socket = "{root / 'run/client.sock'}"
''')
        self.log = (root / "daemon.log").open("ab")
        self.daemon = None

    def start(self):
        self.daemon = subprocess.Popen([str(self.binary), "up", "--config", str(self.root / "config.toml")],
                                       env=self.env, cwd=self.root / "ws", stdin=subprocess.DEVNULL,
                                       stdout=self.log, stderr=self.log, start_new_session=True)
        until(lambda: self.api("/v1/health"), 60, "the daemon did not answer: " + self.tail("daemon.log"),
              lambda: self.daemon.poll() is None or fail("daemon exited: " + self.tail("daemon.log")))

    def kill_daemon(self):
        os.killpg(self.daemon.pid, signal.SIGKILL)
        self.daemon.wait()

    def tail(self, name):
        path = self.root / name
        return path.read_text(errors="replace")[-3000:] if path.exists() else ""

    def cli(self, *args, check=True):
        result = subprocess.run([str(self.binary), "--endpoint", str(self.endpoint), *args], env=self.env,
                                capture_output=True, text=True, timeout=120)
        if check and result.returncode:
            raise Failure(f"st {' '.join(args)}: {result.stderr.strip()} {result.stdout.strip()}")
        return result.stdout

    def json(self, *args):
        return json.loads(self.cli(*args, "--json"))

    def api(self, path):
        result = subprocess.run(["curl", "-sf", "--max-time", "10", "--unix-socket", str(self.endpoint),
                                 "http://localhost" + path], capture_output=True, text=True)
        if result.returncode:
            return None
        try:
            payload = json.loads(result.stdout)
        except ValueError:
            return None
        return payload.get("value", payload) if isinstance(payload, dict) else payload

    def pty(self, *args):
        return subprocess.run(["pty", *args], env={**self.env, "PTY_ROOT": str(self.root / "pty")},
                              capture_output=True, text=True)

    def seat_processes(self, with_environment=False):
        """Every process launched for a seat, by this daemon's private endpoint."""
        rows = []
        for proc in Path("/proc").glob("[0-9]*"):
            try:
                environ = (proc / "environ").read_bytes().split(b"\0")
                if f"ST3_ENDPOINT={self.endpoint}".encode() not in environ:
                    continue
                if not any(item.startswith(b"ST_AGENT=agent/") for item in environ):
                    continue
                argv = (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode()
                row = (int(proc.name), argv)
                if with_environment:
                    row += ([value.decode(errors="replace") for value in environ],)
                rows.append(row)
            except (OSError, UnicodeError):
                pass
        return rows

    def stop(self):
        if self.daemon and self.daemon.poll() is None:
            os.killpg(self.daemon.pid, signal.SIGTERM)
            try:
                self.daemon.wait(15)
            except subprocess.TimeoutExpired:
                os.killpg(self.daemon.pid, signal.SIGKILL)
        listed = self.pty("list", "--json")
        try:
            for row in json.loads(listed.stdout or "[]"):
                self.pty("kill", row["name"])
        except (ValueError, KeyError):
            pass
        for sig in (signal.SIGTERM, signal.SIGKILL):
            for pid, _ in self.seat_processes():
                try:
                    os.kill(pid, sig)
                except ProcessLookupError:
                    pass
            time.sleep(0.3)


def seat_subject(letter):
    return f"agent/{RUN_ID}/seat-{letter}"


def mission_source(node, count, harness, hold=False):
    seats = ""
    # A step waiting on a gate that never passes keeps the run, and so its seats, alive after the
    # seats finish theirs.
    steps = """
  step "hold" {
    agentless
    title "Boot canary: the run stays open"
    gate "never" { exists "mission-run/${ST_MISSION_RUN}/never" }
  }""" if hold else ""
    for letter in LETTERS[:count]:
        seats += f'''
  agent "seat-{letter}" {{
    workspace "{node.root / 'ws'}"
    restart "always"
    harness "{harness}" {{}}
  }}'''
        steps += f'''
  step "work-{letter}" {{
    assigned-to "agent/${{ST_MISSION_RUN}}/seat-{letter}"
    goal "Boot canary: claim this step."
  }}'''
    return f'''version 2
mission "{MISSION}" state="ready" {{
  goal "Boot canary."{seats}{steps}
}}
'''


def trace(node, subject):
    rows = []
    for line in node.cli("trace", "show", subject, "--json", "--limit", "500", check=False).splitlines():
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    return rows


def parked(node, subject):
    """The crash-loop guard's decision for this seat, if it parked it."""
    for row in trace(node, subject):
        body = row.get("body", row)
        fields = body.get("fields", body)
        if row.get("kind") == "runtime.reconcile-decision" and "crash-loop" in str(fields.get("key", "")):
            return fields
    return None


class Seats:
    """The seats of one run and what each must show to count as booted."""

    def __init__(self, node, letters, bound):
        self.node, self.letters, self.bound = node, letters, bound
        self.incarnations = {}
        self.timings = {}
        self.read_probes = set()

    def step(self, letter):
        listed = self.node.cli("work", "ls", "--all")
        for line in listed.splitlines():
            if line.startswith("step-run/") and line.split()[0].endswith(f"/work-{letter}"):
                return line.split()[0]
        return None

    def view(self, letter):
        """The seat and its step as the daemon shows them; empty until the run has created them."""
        try:
            agent = (self.node.json("agents", "show", seat_subject(letter)) or {}).get("value") or {}
            ref = self.step(letter)
            work = (self.node.json("work", "show", ref) or {}).get("value") if ref else {}
        except Failure:
            return {}, {}
        return agent, work or {}

    def prove(self, label, fresh_incarnation=True):
        """Each seat claims its step with a new incarnation and reads a message, in time."""
        started = time.monotonic()
        pending = set(self.letters)
        probes = {}
        deadline = started + self.bound
        while pending:
            self.node.daemon.poll() is None or fail("the daemon exited: " + self.node.tail("daemon.log"))
            for letter in sorted(pending):
                subject = seat_subject(letter)
                guard = parked(self.node, subject)
                if guard:
                    fail(f"{subject} parked in the crash-loop guard during {label}: {guard}")
                agent, work = self.view(letter)
                incarnation = work.get("claim_incarnation")
                if work.get("state") != "claimed" or not incarnation:
                    continue
                if fresh_incarnation and incarnation == self.incarnations.get(letter):
                    continue
                if incarnation != agent.get("incarnation_id"):
                    continue
                if letter not in probes:
                    sent = self.node.json("conversations", "send", subject, "--from", "person/eval",
                                          "--subject", f"probe {label}", "--body", f"boot canary {label}")
                    probes[letter] = sent["subject"]
                view = self.node.api("/v1/messages/read/" + probes[letter]) or {}
                if view.get("status") in ("read", "closed"):
                    self.read_probes.add(probes[letter])
                    self.incarnations[letter] = incarnation
                    self.timings[f"{label}:{letter}"] = round(time.monotonic() - started, 1)
                    pending.discard(letter)
            if pending and time.monotonic() > deadline:
                detail = {letter: {"agent": {k: self.view(letter)[0].get(k) for k in
                                             ("state", "harness_state", "incarnation_id", "fault", "reason")},
                                   "work": {k: self.view(letter)[1].get(k) for k in
                                            ("state", "claim_incarnation")},
                                   "probe": probes.get(letter)} for letter in sorted(pending)}
                fail(f"{label}: {sorted(pending)} did not claim a step and read a message within "
                     f"{self.bound:.0f}s: {json.dumps(detail)}")
            time.sleep(0.5)
        for letter in self.letters:
            if parked(self.node, seat_subject(letter)):
                fail(f"{seat_subject(letter)} parked after {label}")


def driver_processes(node):
    """The seat's long-lived st3 processes (driver and channels), by pid and the inode they execute."""
    rows = {}
    for pid, argv in node.seat_processes():
        if " driver-hook " in argv:
            continue
        try:
            exe = Path(f"/proc/{pid}/exe").resolve()
            if exe.name.startswith("st3"):
                rows[pid] = (argv, os.stat(f"/proc/{pid}/exe").st_ino)
        except OSError:
            pass
    return rows


def check_boundary(node):
    """A fresh seat's processes stay inside st's boundary."""
    processes = node.seat_processes(with_environment=True)
    violations = list(fresh_seat_findings(node.root, processes))
    if violations:
        fail("fresh seat boundary: " + "; ".join(violations))


def wait_drained(spools, bound):
    """Every observation a seat's driver committed to its spool is acknowledged in time."""
    import sqlite3

    def drained():
        for database in spools:
            with sqlite3.connect(database) as connection:
                if connection.execute("SELECT EXISTS(SELECT 1 FROM events)").fetchone()[0]:
                    return False
        return True
    until(drained, bound, "committed harness observations were not acknowledged")


def receipts(node, letter):
    path = node.root / "ws" / f"receipts-{seat_subject(letter).replace('/', '-')}.jsonl"
    rows = []
    for line in path.read_text().splitlines() if path.exists() else []:
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
    return rows


def native_sessions(node, letter):
    """Each native session the stand-in ran, in order: (id, resumed)."""
    found = []
    for row in receipts(node, letter):
        if row.get("event") in ("session", "thread"):
            found.append((row.get("session_id") or row.get("sessionId") or row.get("id"),
                          bool(row.get("resumed"))))
    return found


def forget_native_session(node, harness, session):
    """Remove what the harness resumes `session` from, as a lost transcript would."""
    home = node.root / "home"
    if harness == "claude":
        paths = list((home / ".claude/projects").rglob(f"{session}.jsonl"))
    elif harness == "codex":
        paths = list((home / ".codex/sessions").rglob(f"rollout-*-{session}.jsonl"))
    elif harness in ("pi", "omp"):
        paths = list((node.root / "state").rglob(f"provider-sessions/*_{session}.jsonl"))
    else:
        import sqlite3
        with sqlite3.connect(home / ".local/share/opencode/opencode.db") as connection:
            removed = connection.execute("DELETE FROM session WHERE id=?", (session,)).rowcount
        paths = [] if removed else None
    if paths is None or (harness != "opencode" and not paths):
        fail(f"no {harness} transcript of {session} to remove")
    for path in paths:
        path.unlink()


def suspend_and_resume(node, seats, harness):
    subject = seat_subject("a")
    step = seats.step("a")
    work = node.json("work", "show", step)["value"]
    node.cli("work", "complete", step, "--as", subject, "--incarnation", work["claim_incarnation"],
             "--summary", "boot canary step done")

    def suspend():
        # The harness settles after its last turn; until its driver reports it quiet, st refuses.
        result = node.cli("agents", "suspend", subject, "--as", "person/eval", "--timeout", "60s",
                          "--json", check=False)
        try:
            return json.loads(result)
        except ValueError:
            return None
    agent = until(suspend, seats.bound, "the seat never suspended: " + json.dumps(
        node.json("agents", "show", subject).get("value", {}).get("suspension")))
    suspension = agent.get("suspension") or {}
    native = suspension.get("native_session_id")
    if agent.get("state") != "suspended" or suspension.get("phase") != "suspended" or not native:
        fail(f"suspend did not leave a suspended seat with a native session: {json.dumps(agent)}")
    launched = native_sessions(node, "a")
    if not launched or launched[-1][0] != native:
        fail(f"the suspended session {native} is not the one the harness ran: {launched}")
    # The suspend scenario runs one seat, so every seat process this daemon launched is its.
    until(lambda: not node.seat_processes(), 60, "a suspended seat still has processes: "
          + json.dumps(node.seat_processes()))

    # Mail to a suspended seat waits, and its restart policy does not wake it.
    sent = node.json("conversations", "send", subject, "--from", "person/eval",
                     "--subject", "while suspended", "--body", "boot canary suspended")["subject"]
    time.sleep(5)
    held = node.api("/v1/messages/read/" + sent) or {}
    if held.get("status") in ("read", "closed"):
        fail("a suspended seat read a message")
    if node.json("agents", "show", subject)["value"].get("state") != "suspended":
        fail("a suspended seat did not stay suspended")

    resumed = json.loads(node.cli("agents", "resume", subject, "--as", "person/eval",
                                  "--timeout", f"{seats.bound:.0f}s", "--json"))
    after = resumed.get("suspension") or {}
    if after.get("phase") != "resumed" or after.get("native_session_id") != native:
        fail(f"resume did not bring back session {native}: {json.dumps(resumed)}")
    latest = native_sessions(node, "a")[-1]
    if latest != (native, True):
        fail(f"the resumed harness ran {latest}, not session {native} resumed")
    until(lambda: (node.api("/v1/messages/read/" + sent) or {}).get("status") in ("read", "closed"),
          seats.bound, "the resumed seat did not read the message that waited for it")
    wait_drained(list((node.root / "state/drivers").rglob("st-harness-events.sqlite")), seats.bound)
    check_boundary(node)

    # A resume that cannot find its session says why, and the seat stays suspended.
    agent = until(suspend, seats.bound, "the resumed seat never suspended again")
    native = agent["suspension"]["native_session_id"]
    forget_native_session(node, harness, native)
    result = subprocess.run([str(node.binary), "--endpoint", str(node.endpoint), "agents", "resume", subject,
                             "--as", "person/eval", "--timeout", f"{seats.bound:.0f}s"],
                            env=node.env, capture_output=True, text=True, timeout=seats.bound + 30)
    if result.returncode == 0:
        fail("a resume without its transcript succeeded")
    shown = node.json("agents", "show", subject)["value"]
    code = (shown.get("suspension") or {}).get("code")
    if shown.get("state") != "suspended" or code not in (
            "transcript-missing", "harness-refused", "native-resume-unavailable"):
        fail(f"a failed resume left {json.dumps(shown.get('suspension'))} in state {shown.get('state')}: "
             f"{result.stderr.strip()}")
    seats.timings["suspend:failed-resume-code"] = code


def continued_session(node, label):
    """The relaunched harness continued the session its predecessor ran, as every restart does."""
    launched = native_sessions(node, "a")
    if len(launched) < 2:
        fail(f"{label}: the seat ran {launched}, not a session and its continuation")
    previous, latest = launched[-2][0], launched[-1]
    if latest != (previous, True):
        fail(f"{label}: the relaunched harness ran {latest}, not session {previous} continued")


def scenario(node, seats, name, scratch, replacement_binary=None):
    if name in ("fresh", "concurrent"):
        return
    # Boot proved a durable read. Observe actual provider receipts too: idempotent graph
    # claims can hide a second model turn if a restart offers the same old message again.
    previous_probes = seats.read_probes.copy()
    def probe_reads():
        return Counter(row.get("reference") for letter in seats.letters
                       for row in receipts(node, letter) if row.get("event") == "read")
    until(lambda: all(probe_reads()[ref] >= 1 for ref in previous_probes), seats.bound,
          "the providers did not record their boot probe reads")
    if name == "suspend":
        suspend_and_resume(node, seats, node.harness)
        return
    if name == "restart":
        node.cli("agents", "restart", seat_subject("a"), "--as", "person/eval", check=False)
        seats.prove("restart")
        continued_session(node, "restart")
    elif name == "daemon-restart":
        # The provider dies with the daemon, so the new daemon's latest observation of the seat is
        # still the running predecessor.
        node.kill_daemon()
        for row in json.loads(node.pty("list", "--json").stdout or "[]"):
            node.pty("kill", row["name"])
        node.start()
        seats.prove("daemon-restart")
        continued_session(node, "daemon-restart")
    elif name == "reexec":
        before = driver_processes(node)
        providers = {pid: argv for pid, argv in node.seat_processes() if "stub-" in argv}
        if not providers:
            fail("no provider process to preserve across reexec")
        if not before:
            fail("no seat driver process to re-exec")
        # A deploy installs the new binary, then restarts the daemon from it; the daemon re-points
        # the link every seat follows, and each driver and channel re-execs in place.
        replacement = scratch / "st3-replacement"
        shutil.copy2(replacement_binary or node.binary.resolve(), replacement)
        staging = node.root / "bin/st3.staged"
        staging.symlink_to(replacement)
        os.replace(staging, node.binary)
        new_inode = os.stat(replacement).st_ino
        node.daemon.terminate()
        node.daemon.wait(30)
        node.start()

        def swapped():
            alive = [pid for pid in before if Path(f"/proc/{pid}").exists()]
            return alive and all(os.stat(f"/proc/{pid}/exe").st_ino == new_inode for pid in alive)
        until(swapped, 60, "the seat's st processes did not re-exec into the replacement: "
                           + json.dumps({str(pid): argv[:80] for pid, (argv, _) in before.items()}))
        seats.prove("reexec", fresh_incarnation=False)
        if not all(Path(f"/proc/{pid}").exists() for pid in providers):
            fail("a provider process was replaced during driver reexec")
    else:
        fail(f"unknown scenario {name}")
    # Keep watching after the new mail succeeds, through several channel polls.
    time.sleep(3)
    counts = probe_reads()
    repeated = {ref: counts[ref] for ref in previous_probes if counts[ref] != 1}
    if repeated:
        fail(f"{name}: already-read boot mail reached the provider again: {repeated}")


def run(args, root, evidence):
    node = Node(root, args.binary, args.harness)
    count = 5 if args.scenario == "concurrent" else 1
    letters = LETTERS[:count]
    seats = Seats(node, letters, args.bound)
    try:
        node.start()
        source = root / "mission.kdl"
        source.write_text(mission_source(node, count, args.harness, hold=args.scenario == "suspend"))
        node.cli("missions", "publish", str(source), "--as", "person/eval")
        node.cli("missions", "start", MISSION, "--id", RUN_ID, "--workspace", str(root / "ws"),
                 "--as", "person/eval")
        seats.prove("boot")
        catalogs_before = {str(path): path.read_bytes() for pattern in ("catalog.kdl", "agent.kdl")
                           for path in (root / "state/drivers").rglob(pattern)}
        scenario(node, seats, args.scenario, args.scratch, args.replacement_binary)
        catalogs_after = {str(path): path.read_bytes() for pattern in ("catalog.kdl", "agent.kdl")
                          for path in (root / "state/drivers").rglob(pattern)}
        if catalogs_after != catalogs_before:
            fail("native startup/reexec fabricated or rewrote a catalog")
        if not args.replacement_binary and catalogs_after:
            fail("fresh native seats fabricated per-seat catalogs")
        records = [path for name in ("harness-state", "harness-context", "harness-timeline")
                   for path in (root / "state/drivers").rglob(name)]
        spools = list((root / "state/drivers").rglob("st-harness-events.sqlite"))
        if not args.replacement_binary:
            if records:
                fail("fresh native seats used polled harness records: " + str(records))
            if len(spools) != len(letters):
                fail("a fresh native seat has no durable observation spool")
            # A suspended seat has no driver to acknowledge what its last one committed while it
            # stopped, and no process to inspect; `suspend` checks both while the resumed seat runs.
            if args.scenario != "suspend":
                wait_drained(spools, args.bound)
                check_boundary(node)
        return {"verdict": "pass", "harness": args.harness, "scenario": args.scenario,
                "seconds_to_boot": seats.timings, "catalog_files": len(catalogs_after),
                "harness_record_files": len(records), "observation_spools": len(spools)}
    except (Failure, subprocess.TimeoutExpired) as error:
        return {"verdict": "fail", "harness": args.harness, "scenario": args.scenario,
                "failure": str(error), "seconds_to_boot": seats.timings}
    finally:
        for letter in letters:
            terminal = node.pty("peek", "--plain", "--full", f"c1.seat-{letter}")
            (evidence / f"terminal-{letter}.txt").write_text(terminal.stdout + terminal.stderr)
            if node.daemon.poll() is None:
                (evidence / f"trace-{letter}.jsonl").write_text(
                    node.cli("trace", "show", seat_subject(letter), "--json", "--limit", "500", check=False))
        for index, record in enumerate(sorted((root / "state").rglob("harness-state"))):
            (evidence / f"harness-state-{index}.json").write_text(record.read_text(errors="replace"))
        # The outbox and driver warnings explain a stalled observation without depending on
        # the temporary runtime surviving cleanup. Keep fixture evidence, never native content.
        import sqlite3
        summaries = []
        for database in (root / "state/drivers").rglob("st-harness-events.sqlite"):
            try:
                with sqlite3.connect(database) as connection:
                    pending = connection.execute("SELECT sequence,kind FROM events ORDER BY sequence").fetchall()
                    metadata = connection.execute("SELECT key,value FROM metadata WHERE key='runtime' OR key LIKE 'provider-runtime:%'").fetchall()
                    snapshots = connection.execute("SELECT kind,body FROM snapshots WHERE kind='harness-state'").fetchall()
                    states = [{"kind": kind, "state": json.loads(body).get("state"), "incarnation": json.loads(body).get("incarnation")} for kind, body in snapshots]
                summaries.append({"pending": pending, "metadata": metadata, "states": states})
            except sqlite3.Error as error:
                summaries.append({"error": str(error)})
        (evidence / "observation-outboxes.json").write_text(json.dumps(summaries, indent=2) + "\n")
        for index, log in enumerate((root / "home/.local/state/st3").rglob("*.log")):
            (evidence / f"driver-{index}.log").write_text(log.read_text(errors="replace"))
        node.stop()
        for path in [root / "daemon.log", *sorted((root / "ws").glob("receipts-*.jsonl"))]:
            if path.exists():
                (evidence / path.name).write_text(path.read_text(errors="replace"))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("binary", type=Path)
    parser.add_argument("evidence", type=Path)
    parser.add_argument("harness", choices=HARNESSES)
    parser.add_argument("scenario", choices=SCENARIOS)
    parser.add_argument("--replacement-binary", type=Path, default=None,
                        help="upgrade a predecessor binary to this build in the reexec scenario")
    parser.add_argument("--bound", type=float, default=90, help="seconds each phase may take")
    parser.add_argument("--scratch", type=Path, default=None,
                        help="a directory on a real disk for the replacement binary (reexec)")
    args = parser.parse_args()
    args.binary = args.binary.resolve()
    args.evidence.mkdir(parents=True, exist_ok=True)
    args.scratch = (args.scratch or args.evidence).resolve()
    args.scratch.mkdir(parents=True, exist_ok=True)
    # Short, private paths: Unix socket paths are limited to about 100 bytes.
    root = Path(tempfile.mkdtemp(prefix="bc-", dir="/tmp"))
    try:
        result = run(args, root, args.evidence)
    finally:
        shutil.rmtree(root, ignore_errors=True)
    (args.evidence / "result.json").write_text(json.dumps(result, indent=2, default=str) + "\n")
    print(json.dumps(result, indent=2, default=str))
    return 0 if result["verdict"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
