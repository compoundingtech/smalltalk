#!/usr/bin/env python3
"""Decide, with a signed proof, whether the fractal-web checks need to run for a tree.

Plan-v2 B.4 and the selection design's record format: a skip is not a new artefact. It is a lookup of
an existing trusted, signed passing record whose input key (the tree reduced to the check's declared
inputs, `evidence-verify --project`) equals this tree's key. Key equality is the proof; this tool never
argues that a path does not matter. Per check it prints one line:

  check=<name> decision=skip|run key=<source_inputs|none> proof=<record|none> inputs_sha256=<sha256> reason=<...>

Checks: `fractal-web` (the whole web lane, the detector's relevant paths) and `fractal-web-kit` (the
kit plays, the detector's kit paths, whose coverage of the Storybook module graph CI checks). Inputs,
the detector, the verifier and its keys come from the BASE commit, never from the change. When the
base skip policy declares a check, its declared inputs and trust rules decide; otherwise the inputs are
the base detector's patterns over the tracked files of base and head, and with no declared policy no
record is trusted (reason=no-record), so the check runs. Any failure computes no key and runs.

  web-skip-proof [--base origin/main] [--head HEAD] [--repository OWNER/NAME] [--explain]
  web-skip-proof inputs <check> [--base REF]    print the derived literal input list
  web-skip-proof claims PATH... [--base REF]    owned:<checks> or not-mine, per path (the plugin's claims())

Fetch the evidence notes first (`git fetch origin '+refs/notes/evidence*:refs/notes/evidence*'`);
`--fetch` does it.
"""

import argparse
import hashlib
import json
import runpy
import subprocess
import sys
import tempfile
from pathlib import Path

CHECKS = {'fractal-web': 'relevant_paths', 'fractal-web-kit': 'kit_paths'}
PATTERN_SETS = {'fractal-web': ('PATTERNS', 'KIT_PATTERNS'), 'fractal-web-kit': ('KIT_PATTERNS',)}
DETECTOR = 'scripts/ci-fractal-web-changes'
VERIFIER = 'scripts/evidence-verify'
POLICY = '.st/evidence-skip-policy.json'


def git(*args, check=True):
    done = subprocess.run(['git', *args], capture_output=True, text=True)
    if check and done.returncode:
        raise RuntimeError(f"git {' '.join(args[:3])}: {done.stderr.strip()[:200]}")
    return done.stdout


def at_base(base, path, scratch):
    """A file as the base commit has it, written into scratch: the change cannot alter its own rules."""
    target = Path(scratch, Path(path).name)
    target.write_bytes(subprocess.run(['git', 'show', f'{base}:{path}'], capture_output=True, check=True).stdout)
    return target


def selectors(base, scratch):
    """Per check: the detector's path selector and its patterns compiled with the detector's own
    pattern semantics, as the base commit has them."""
    detector = runpy.run_path(str(at_base(base, DETECTOR, scratch)))
    return {name: (detector[function], [(pattern, detector['pattern_regex'](pattern)) for names in PATTERN_SETS[name] for pattern in detector[names]])
            for name, function in CHECKS.items()}


def declared(base):
    try:
        policy = json.loads(git('show', f'{base}:{POLICY}'))
    except (RuntimeError, ValueError):
        return {}
    return {name: entry['inputs'] for name, entry in policy.get('checks', {}).items()
            if name in CHECKS and isinstance(entry, dict) and isinstance(entry.get('inputs'), list)}


def derived_inputs(selector, base, head):
    """The check's declared inputs from the base detector: a `dir/**` pattern is its directory (the
    projection covers everything below it); any other pattern is the tracked files of base and head it
    matches (a deletion is an input too). Files under a declared directory are left out."""
    _, patterns = selector
    tracked = set()
    for revision in (base, head):
        tracked.update(path for path in git('ls-tree', '-r', '-z', '--name-only', revision).split('\0') if path)
    directories, files = set(), set()
    for pattern, matcher in patterns:
        if pattern.endswith('/**') and '*' not in pattern[:-3]:
            if any(path.startswith(pattern[:-2]) for path in tracked):
                directories.add(pattern[:-3])
        else:
            files.update(path for path in tracked if matcher.match(path))
    files = {path for path in files if not any(path.startswith(directory + '/') for directory in directories)}
    return sorted(directories | files)


def decide(name, selector, base, head, repository, policy_inputs, scratch):
    inputs = policy_inputs if policy_inputs is not None else derived_inputs(selector, base, head)
    digest = hashlib.sha256('\n'.join(inputs).encode()).hexdigest()
    line = {'check': name, 'decision': 'run', 'key': 'none', 'proof': 'none', 'inputs_sha256': digest, 'reason': 'no-key'}
    verifier = str(at_base(base, VERIFIER, scratch))
    project = [sys.executable, verifier, '--revision', head, '--check', name, '--project']
    project += ['--policy-from', base, '--repository', repository] if policy_inputs is not None else ['--paths', ','.join(inputs)]
    done = subprocess.run(project, capture_output=True, text=True)
    try:
        key = json.loads(done.stdout).get('source_inputs') if done.returncode == 0 else None
    except ValueError:
        key = None
    if not key:
        return line
    line['key'] = key
    if policy_inputs is None:
        line['reason'] = 'no-record'  # no declared policy: no record is trusted for this check yet
        return line
    lookup = [sys.executable, verifier, '--revision', head, '--check', name, '--keys-from', base, '--policy-from', base, '--repository', repository]
    done = subprocess.run(lookup, capture_output=True, text=True)
    try:
        result = json.loads(done.stdout)
    except ValueError:
        result = {}
    if done.returncode == 0 and result.get('satisfied') and result.get('record'):
        line.update(decision='skip', proof=result['record'], reason='match')
    else:
        line['reason'] = 'sampled' if result.get('reason') == 'sampled' else 'no-record'
    return line


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('command', nargs='?', default='decide', choices=('decide', 'inputs', 'claims'))
    parser.add_argument('arguments', nargs='*')
    parser.add_argument('--base', default='origin/main')
    parser.add_argument('--head', default='HEAD')
    parser.add_argument('--repository', default='compoundingtech/smalltalk')
    parser.add_argument('--explain', action='store_true', help='also list the changed paths each check owns')
    parser.add_argument('--fetch', action='store_true', help='fetch the evidence notes from origin first')
    args = parser.parse_args(argv[1:])
    if args.fetch:
        git('fetch', '-q', 'origin', '+refs/notes/evidence*:refs/notes/evidence*')
    base, head = git('rev-parse', '--verify', f'{args.base}^{{commit}}').strip(), git('rev-parse', '--verify', f'{args.head}^{{commit}}').strip()
    with tempfile.TemporaryDirectory() as scratch:
        select = selectors(base, scratch)
        if args.command == 'inputs':
            if len(args.arguments) != 1 or args.arguments[0] not in CHECKS:
                parser.error(f"inputs takes one of {', '.join(CHECKS)}")
            print('\n'.join(derived_inputs(select[args.arguments[0]], base, head)))
            return 0
        if args.command == 'claims':
            for path in args.arguments:
                owners = [name for name, (chooser, _) in select.items() if chooser([path])]
                print(f"{path}\t{'owned:' + ','.join(owners) if owners else 'not-mine'}")
            return 0
        policy = declared(base)
        changed = None
        if args.explain:
            start = git('merge-base', base, head).strip()
            changed = [path for path in git('diff', '--name-only', '--no-renames', '-z', start, head).split('\0') if path]
        for name, selector in select.items():
            line = decide(name, selector, base, head, args.repository, policy.get(name), scratch)
            print(' '.join(f'{key}={value}' for key, value in line.items()))
            if changed is not None:
                owned = selector[0](changed)
                print(f'#   {name} owns {len(owned)} of {len(changed)} changed path(s)' + ''.join(f'\n#     {path}' for path in owned[:20]))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f'web-skip-proof: {error}', file=sys.stderr)
        sys.exit(1)
