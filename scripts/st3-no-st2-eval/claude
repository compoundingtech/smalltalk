#!/usr/bin/env python3
"""A stand-in `claude` that drives the real Claude contracts st3 relies on, without a model.

It does what the interactive Claude TUI does at each boundary st3 observes:
- runs every hook command from the `--settings` JSON st3 passes (through `bash -c`, with the
  hook payload on stdin) for SessionStart, UserPromptSubmit, Stop;
- runs the `statusLine` command with a status-line payload, as Claude does every few seconds;
- starts the `st3` MCP server named in `--mcp-config` and speaks MCP over stdio, turning each
  `notifications/claude/channel` into a user turn (UserPromptSubmit with the channel text, a
  transcript entry, then Stop), and reads the message with `"$ST3_BIN" conversations read`,
  as a model following the ping would;
- writes a Claude-format transcript at ~/.claude/projects/<cwd>/<session_id>.jsonl.

It proves the wiring between st3 and Claude's hook, status-line, and channel contracts. It does
not prove anything about a real model or Claude's own TUI. Every step is appended to
receipts.jsonl in the workspace.
"""
import datetime
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import threading
import time
import uuid

RECEIPTS = Path.cwd() / "receipts.jsonl"


def receipt(event, **fields):
    with RECEIPTS.open("a") as stream:
        stream.write(json.dumps({"event": event, "at": time.time(), **fields}) + "\n")


def option(argv, name):
    for index, argument in enumerate(argv):
        if argument == name and index + 1 < len(argv):
            return argv[index + 1]
        if argument.startswith(name + "="):
            return argument.split("=", 1)[1]
    return None


def stamp():
    return datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")


argv = sys.argv[1:]
if argv[:1] in (["plugin"], ["mcp"]) or "--version" in argv:
    # The launcher asks nothing else of `claude`; an absent plugin selects the dev channel.
    sys.exit(1)
settings = json.loads(option(argv, "--settings") or "{}")
mcp = json.loads(option(argv, "--mcp-config") or "{}")
receipt("started", argv=argv)

session_id = str(uuid.uuid4())
cwd = str(Path.cwd())
projects = Path.home() / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)
projects.mkdir(parents=True, exist_ok=True)
transcript = projects / f"{session_id}.jsonl"


def append(role, text):
    content = text if role == "user" else [{"type": "text", "text": text}]
    with transcript.open("a") as stream:
        stream.write(json.dumps({
            "type": role, "uuid": str(uuid.uuid4()), "timestamp": stamp(), "sessionId": session_id,
            "cwd": cwd, "message": {"role": role, "content": content}}) + "\n")


def hooks(event, payload):
    base = {"session_id": session_id, "transcript_path": str(transcript), "cwd": cwd,
            "hook_event_name": event}
    for group in settings.get("hooks", {}).get(event, []):
        for hook in group.get("hooks", []):
            result = subprocess.run(["bash", "-c", hook["command"]], input=json.dumps({**base, **payload}),
                                    capture_output=True, text=True, timeout=60)
            receipt("hook", hook_event=event, command=hook["command"], exit=result.returncode,
                    stdout=result.stdout[-2000:], stderr=result.stderr[-2000:])


def status_line():
    command = settings.get("statusLine", {}).get("command")
    if not command:
        receipt("statusline", missing=True)
        return
    payload = {"session_id": session_id, "transcript_path": str(transcript), "cwd": cwd,
               "model": {"id": "claude-stub-model", "display_name": "Stub"},
               "workspace": {"current_dir": cwd},
               "context_window": {"context_window_size": 200000, "used_percentage": 7,
                                  "current_usage": {"input_tokens": 14000, "output_tokens": 0,
                                                    "cache_creation_input_tokens": 0,
                                                    "cache_read_input_tokens": 0}}}
    result = subprocess.run(["bash", "-c", command], input=json.dumps(payload), capture_output=True,
                            text=True, timeout=30)
    receipt("statusline", exit=result.returncode, stdout=result.stdout[-2000:], stderr=result.stderr[-2000:])


def turn(prompt, answer):
    hooks("UserPromptSubmit", {"prompt": prompt, "permission_mode": "default"})
    append("user", prompt)
    time.sleep(1.5)
    append("assistant", answer)
    hooks("Stop", {"stop_hook_active": False, "last_assistant_message": answer})


server = mcp.get("mcpServers", {}).get("st3")
channel = None
if server:
    channel = subprocess.Popen([server["command"], *server.get("args", [])], stdin=subprocess.PIPE,
                               stdout=subprocess.PIPE, text=True, bufsize=1,
                               env={**os.environ, **server.get("env", {})})
    channel.stdin.write(json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
        "protocolVersion": "2025-06-18", "capabilities": {"experimental": {"claude/channel": {}}},
        "clientInfo": {"name": "claude-stub", "version": "0"}}}) + "\n")
    channel.stdin.flush()
    receipt("mcp", initialize=json.loads(channel.stdout.readline()))
receipt("mcp-server", present=bool(server))

hooks("SessionStart", {"source": "startup", "model": "claude-stub-model"})
append("user", "no-st2 transcript probe")
append("assistant", "no-st2 transcript answer")
status_line()
if channel:
    channel.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
    channel.stdin.flush()
turn("no-st2 first turn", "no-st2 first answer")

notices = []
lock = threading.Lock()


def read_channel():
    for line in channel.stdout:
        try:
            frame = json.loads(line)
        except ValueError:
            continue
        if frame.get("method") == "notifications/claude/channel":
            with lock:
                notices.append(frame["params"])


if channel:
    threading.Thread(target=read_channel, daemon=True).start()

running = True


def stop(*_):
    global running
    running = False


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGHUP, stop)
next_status = time.monotonic() + 5
while running:
    with lock:
        pending, notices[:] = list(notices), []
    for notice in pending:
        content = notice.get("content", "")
        receipt("channel", content=content, meta=notice.get("meta"))
        reference = re.search(r"message/[0-9a-f]+", content)
        turn(content, "no-st2 read the message")
        if reference:
            result = subprocess.run([os.environ["ST3_BIN"], "conversations", "read", reference.group(0),
                                     "--as", os.environ["ST_AGENT"], "--json"],
                                    capture_output=True, text=True, timeout=60)
            receipt("read", reference=reference.group(0), exit=result.returncode,
                    stderr=result.stderr[-2000:])
    if time.monotonic() >= next_status:
        status_line()
        next_status = time.monotonic() + 5
    time.sleep(0.2)
if channel:
    channel.stdin.close()
    channel.wait(timeout=10)
receipt("ended")
