#!/usr/bin/env python3
"""Incomplete or overlapping test shards must fail rather than weaken the gate."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader("partitions", str(root / "scripts/ci-test-partitions"))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


def document(binary, matches, ignored=(), excluded=()):
    return json.dumps({"rust-suites": {binary: {"testcases": {
        **{name: {"ignored": False, "filter-match": {"status": "matches"}} for name in matches},
        **{name: {"ignored": True, "filter-match": {"status": "matches"}} for name in ignored},
        **{name: {"ignored": False, "filter-match": {"status": "mismatch"}} for name in excluded},
    }}}})


full = module.selected(document("workspace", ["same", "other"], ignored=["ignored"], excluded=["filtered"]) + "\n" + document("st2", ["same"]))
assert full == {("workspace", "same"), ("workspace", "other"), ("st2", "same")}
module.verify(full, {("workspace", "same")}, {("workspace", "other"), ("st2", "same")})
for first, second in [(full, full), (set(), full), ({("workspace", "same")}, {("st2", "same")}),
                       ({("workspace", "same")}, full - {("workspace", "same")} | {("new", "extra")})]:
    try:
        module.verify(full, first, second)
    except ValueError:
        pass
    else:
        raise AssertionError("a broken partition proof passed")

four = {("b", str(i)) for i in range(8)}
shards = [{("b", str(i)), ("b", str(i+4))} for i in range(4)]
module.verify(four, *shards)
for wrong in [shards[:3], shards+[set()], [set(),*shards[1:]],
              [*shards[:3],shards[3]|shards[0]],
              [*shards[:3],shards[3]-{("b","7")}],
              [*shards[:3],shards[3]|{("extra","x")}]]:
    try:
        module.verify(four,*wrong)
    except ValueError:
        pass
    else:
        raise AssertionError("four-shard omission/overlap/extra/count must fail")

with tempfile.TemporaryDirectory() as temp:
    scratch = Path(temp)
    cargo = scratch / "cargo"
    cargo.write_text('#!' + sys.executable + '\nimport json, os, sys\nif sys.argv[1:2] == ["metadata"]: print(json.dumps({"workspace_members": [], "packages": []})); sys.exit(0)\nwith open(os.environ["CALLS"], "a") as stream: stream.write(json.dumps(sys.argv[1:]) + "\\n")\nsys.exit(1 if "--workspace" in sys.argv else 0)\n')
    cargo.chmod(0o755)
    for action, extra, shard in [(action, extra, shard) for action,extra in [("run", []), ("run", ["--no-run"]), ("list", ["--message-format", "json"])] for shard in ("hash:2/2", "hash:1/4", "hash:2/4", "hash:3/4", "hash:4/4")]:
        calls = scratch / "calls"
        calls.unlink(missing_ok=True)
        env = {**os.environ, "PATH": f"{scratch}:{os.environ['PATH']}", "CALLS": str(calls), "CI_TEST_PARTITION": shard}
        result = subprocess.run(["bash", "scripts/ci-nextest", action, *extra], cwd=root, env=env, capture_output=True)
        assert result.returncode == 1, "unified workspace failure must be preserved"
        commands = [json.loads(line) for line in calls.read_text().splitlines() if json.loads(line)[0] == "nextest"]
        assert len(commands) == 1 and "-E" in commands[0], "run the selected workspace once"
        assert all(("--partition" in command) == ("--no-run" not in extra) for command in commands)
        calls.unlink()
        env["CI_TEST_PARTITION"] = "hash:1/3"
        result = subprocess.run(["bash", "scripts/ci-nextest", action, *extra], cwd=root, env=env, capture_output=True)
        assert result.returncode == 2 and not calls.exists(), "incomplete shard count must fail before Cargo"

    # Archive reuse runs the selected workspace once and propagates failure without compiling.
    calls.unlink(missing_ok=True)
    env.update(CI_TEST_EXTRACTED=str(scratch / 'extracted'), CI_TEST_WORKSPACE=str(root), CI_TEST_PARTITION='hash:2/2')
    metadata = scratch / 'extracted/workspace/target/nextest/cargo-metadata.json'
    metadata.parent.mkdir(parents=True)
    metadata.write_text(json.dumps({"workspace_members": [], "packages": []}))
    cargo.write_text('#!' + sys.executable + '\nimport json, os, sys\nif sys.argv[1:2] == ["metadata"]: print(json.dumps({"workspace_members": [], "packages": []})); sys.exit(0)\nwith open(os.environ["CALLS"], "a") as stream: stream.write(json.dumps(sys.argv[1:]) + "\\n")\nsys.exit(1 if "/workspace/" in " ".join(sys.argv) else 0)\n')
    result = subprocess.run(['bash', 'scripts/ci-nextest', 'run'], cwd=root, env=env, capture_output=True)
    commands = [json.loads(line) for line in calls.read_text().splitlines() if json.loads(line)[0] == "nextest"]
    assert result.returncode == 1 and len(commands) == 1
    assert all('--binaries-metadata' in command and '--cargo-metadata' in command and '--workspace' not in command for command in commands)
    assert all(command[command.index('--partition') + 1] == 'hash:2/2' for command in commands)
    calls.unlink()
    result = subprocess.run(['bash', 'scripts/ci-nextest', 'run', '--no-run'], cwd=root, env=env, capture_output=True)
    assert result.returncode == 2 and not calls.exists(), 'archive consumers cannot compile again'

print("Partition tests passed: full selection, duplicate names across binaries, ignored tests, missing/extra/overlapping shards, invalid partition, and failure propagation")
