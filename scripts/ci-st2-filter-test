#!/usr/bin/env python3
"""Exercise the PR skip boundary and the daily main lane."""
import runpy
import unittest
from pathlib import Path

FILTER = runpy.run_path(str(Path(__file__).with_name('ci-st2-filter')))


class St2Selection(unittest.TestCase):
    def test_st3_only_paths_skip_catalog_suite(self):
        for path in [
            'crates/st3/src/lib.rs', 'crates/st3/Cargo.toml',
            'clients/typescript/Client.ts', 'docs/st2/example.md',
            'src/driver.rs', 'src/driver_diagnostic.rs', 'src/pi_channel.rs',
            'src/codex_app_server/protocol.rs', 'src/hooks.rs',
            'src/message.rs', 'src/harness_state.rs', 'src/omp_session.rs',
            'tests/message_cli.rs', 'tests/driver_expansion.rs',
        ]:
            with self.subTest(path=path):
                self.assertTrue(FILTER['st3_only'](path))
                self.assertNotEqual(FILTER['selection']('pull_request', [path])[0], 'all()')

    def test_shared_and_catalog_changes_force_full_suite(self):
        for path in [
            'Cargo.toml', 'Cargo.lock', 'build.rs',
            'crates/agent-spec/src/lib.rs', 'crates/st-runtime/src/lib.rs',
            'src/agent_author/stream.rs', 'src/catalog.rs', 'src/eval_run.rs',
            'src/resync/read.rs', 'src/resource_profile_supervisor.rs',
            'tests/support/mod.rs', 'tests/integration.rs',
            'tests/catalog_apply.rs', 'tests/nomad_survival.rs',
            'tests/event_e2e.rs', 'tests/eval_run_e2e.rs', 'tests/resync.rs',
            'tests/supervisor_auto_archive.rs', 'tests/resource_profile_supervisor_e2e.rs',
        ]:
            with self.subTest(path=path):
                self.assertFalse(FILTER['st3_only'](path))
                # A safe path never masks a second shared-code change.
                self.assertEqual(FILTER['selection']('pull_request', ['docs/example.md', path])[0], 'all()')

    def test_daily_main_suite_is_not_path_filtered(self):
        self.assertEqual(FILTER['selection']('schedule', ['docs/example.md'])[0], 'all()')
        self.assertNotEqual(FILTER['selection']('push', ['Cargo.lock'])[0], 'all()')


if __name__ == '__main__':
    unittest.main()
