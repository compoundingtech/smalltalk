#!/usr/bin/env python3
"""Sign a wrapper's measurement as an evidence note. Runs where the signing key lives.

Install it root-owned and hash-pinned behind a narrow sekrets grant; the unprivileged
`evidence-wrap` pipes one JSON request to it. It signs nothing it can recompute wrongly:

  * the commit, its tree and `flake.lock` are read from the caller's checkout (the current
    directory, read-only), never taken from the request;
  * the observation time and the producer digest are its own;
  * the request may carry exactly the top-level keys below; `inputs` must include the required
    environment fingerprint and may carry more short string entries.

What it cannot check is that the command really ran and printed what the request says; the
record states that this machine's wrapper reported it. That is the cooperative v1 boundary
(doc/fleet/factory/gate-evidence/known-defects): an agent with the key's account can lie.

Configuration, outside any checkout: $HOME/.config/st/evidence-sign.json
  {"signer": "fleet/dev", "ssh_key": "/abs/key", "scratch_repo": "/abs/bare.git"}
git and ssh-keygen are looked up only in the signer's own path (the fixed system directories, or the
configuration's `path`), never through the caller's PATH, and run with that PATH. Each resolved tool FILE
must be a regular, executable file owned by root and closed to group and others, as well as its directory
(a Nix store file: no write bit; the store is immutable and its owner shows as nobody in a build sandbox).
The programs it starts get an explicit environment (PATH, LC_ALL, HOME, TMPDIR and the git settings it
sets itself) and nothing else; it refuses to start at all when the loader or the interpreter was told to
load code (LD_PRELOAD, LD_AUDIT, DYLD_INSERT_LIBRARIES, GCONV_PATH, NLSPATH, PYTHONPATH, PYTHONSTARTUP,
PYTHONHOME). That refusal is a tripwire, not a repair: by the time this script runs the interpreter has
already started, so scrubbing the environment and fixing the interpreter belong to whatever launches it.
There is no command-line argument, no --config and no environment variable that changes the key,
the configuration path or the clock (EVIDENCE_SIGN_NOW counts only when the configuration itself
says test_clock: true).

stdout: {"record": ID, "tier": "full", "object_pack_base64": ...} (the notes commit, the
source commit and its tree, as `git pack-objects` made them).
"""
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

sys.dont_write_bytecode = True

OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
SHA256 = re.compile(r'^[0-9a-f]{64}$')
CHECK = re.compile(r'^[a-z0-9][a-z0-9._-]{0,63}$')
REQUEST_KEYS = {'commit', 'check', 'command', 'exit_code', 'output_sha256', 'change_id', 'inputs'}
INPUT_KEYS = {'flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt'}
# The record's inputs grow over time (the repository policy names the ones a check must carry).
EXTRA_INPUT = re.compile(r'^[a-z][a-z0-9_]{0,39}$')


# The signer finds git and ssh-keygen only in these directories (or the operator's `path` in its
# configuration), never through the caller's PATH, and runs them with that PATH.
TRUSTED_PATH = ['/run/current-system/sw/bin', '/nix/var/nix/profiles/default/bin', '/usr/local/bin', '/usr/bin', '/bin']
TOOLS = {}


class Refused(Exception):
    pass


def unsafe_directory(directory):
    """Why a directory may not hold the tools the signer runs with the key in reach, or None.

    Absolute, no empty, `.` or `..` segment; an existing directory; not under the caller's checkout, HOME
    or a temporary directory (code under test writes there); and not writable by the user running the
    signer, unless it is in the immutable Nix store.
    """
    if not directory.startswith('/'):
        return 'not an absolute path'
    segments = directory.split('/')[1:]
    if segments and segments[-1] == '':
        segments = segments[:-1]
    if any(part in ('', '.', '..') for part in segments):
        return 'has an empty, . or .. segment'
    real = os.path.realpath(directory)
    if not os.path.isdir(real):
        return 'is not a directory'
    writable_by_workspace = [Path.cwd(), Path.home(), Path(tempfile.gettempdir()), Path('/tmp'), Path('/var/tmp'),
                             Path(os.environ.get('RUNNER_TEMP') or '/nonexistent'),
                             Path(os.environ.get('GITHUB_WORKSPACE') or '/nonexistent')]
    for root in writable_by_workspace:
        for base in {root, root.resolve()}:
            if real == str(base) or real.startswith(str(base).rstrip('/') + '/') or directory.startswith(str(base).rstrip('/') + '/'):
                return f'is under {base}, where code under test can write'
    if real.startswith('/nix/store/'):
        # Content-addressed and immutable: the store directory itself must have no write bit.
        return 'has a write bit in the Nix store' if os.stat(real).st_mode & 0o222 else None
    # Elsewhere the directory and every parent must belong to root and be closed to group and others.
    # Mode bits, not os.access: as root os.access is always true, and a directory that only looks
    # unwritable to this user is still one another user (or the job's own user) may replace.
    current = real
    while True:
        status = os.stat(current)
        if status.st_uid != 0:
            return f'or its parent {current} is not owned by root'
        if status.st_mode & 0o022:
            return f'or its parent {current} is writable by group or others'
        if current == '/':
            return None
        current = os.path.dirname(current)


def unsafe_file(real, status=None):
    """Why the resolved tool file itself may not be run with the key in reach, or None: not a regular
    executable file, not owned by root, or writable by group or others. (A closed directory does not make
    a file inside it safe.) A file in the Nix store is judged like the store directory is: content-addressed
    and immutable, so what matters is that it has no write bit; its owner is not asked for, because inside a
    Nix build sandbox root-owned store files show as owned by nobody. `status` is for tests."""
    status = os.stat(real) if status is None else status
    if not stat.S_ISREG(status.st_mode):
        return 'is not a regular file'
    if real.startswith('/nix/store/'):
        if status.st_mode & 0o222:
            return 'has a write bit in the Nix store'
    else:
        if status.st_uid != 0:
            return 'is not owned by root'
        if status.st_mode & 0o022:
            return 'is writable by group or others'
    if not status.st_mode & 0o100:
        return 'is not executable by its owner'
    return None


def checked_path(path, strict):
    """The directories of `path` that pass unsafe_directory. A configured path must pass entirely;
    the built-in default skips directories this host lacks or that are unsafe here."""
    kept = []
    for directory in path.split(':'):
        reason = unsafe_directory(directory)
        if reason is None:
            kept.append(directory)
        elif strict:
            raise Refused(f'tool path directory {directory!r} {reason}')
    if not kept:
        raise Refused('no usable directory in the signer\'s own path')
    return ':'.join(kept)


def trusted_tools(path, strict=False):
    path = checked_path(path, strict)
    for name in ('git', 'ssh-keygen'):
        found = shutil.which(name, path=path)
        if not found:
            raise Refused(f'{name} is not in the signer\'s own path ({path})')
        # The tool itself, after symlinks, must also live where the same rules hold. What is checked is what is
        # run: the resolved path, so a link cannot be repointed between the check and the exec. (A multi-call
        # binary that chooses its behaviour from the name it was started under would need its link name; git and
        # ssh-keygen are real programs, and a host where they are not is refused rather than guessed at.)
        real = os.path.realpath(found)
        reason = unsafe_directory(os.path.dirname(real))
        if reason:
            raise Refused(f'{name} resolves to {real}, whose directory {reason}')
        reason = unsafe_file(real)
        if reason:
            raise Refused(f'{name} resolves to {real}, which {reason}')
        TOOLS[name] = real
    TOOLS['PATH'] = path


# Variables that make the loader or the interpreter run code this script did not choose. Seeing one means the
# launcher did not scrub the environment, and this script cannot repair that, so it refuses.
REFUSED_ENVIRONMENT = ('LD_PRELOAD', 'LD_AUDIT', 'DYLD_INSERT_LIBRARIES', 'GCONV_PATH', 'NLSPATH',
                       'PYTHONPATH', 'PYTHONSTARTUP', 'PYTHONHOME')
# The only variables of the caller that reach git and ssh-keygen. Everything else (LD_LIBRARY_PATH, SSH_AUTH_SOCK,
# GIT_*, PYTHON*, proxies, ...) is dropped, not inherited. HOME and TMPDIR are passed through as given: for a
# privileged integration they must be supplied by the fixed trusted launcher or profile that starts the signer. Passing
# them is not evidence that an arbitrary inherited HOME or TMPDIR is safe, and this script does not check them.
PASSED_ENVIRONMENT = ('HOME', 'TMPDIR')


def refuse_loader_environment(environ=None):
    environ = os.environ if environ is None else environ
    found = sorted(name for name in REFUSED_ENVIRONMENT if name in environ)
    if found:
        raise Refused(f'refusing to run with {", ".join(found)} set: the launcher must scrub the environment '
                      '(this script cannot undo what the loader or interpreter already did)')


# GIT_CONFIG_GLOBAL needs Git 2.32 or newer; an older git ignores it and would read HOME's configuration. This script
# does not check the version: the fixed launcher or install manifest that supplies the pinned git is responsible for it.
def child_environment(extra=None, environ=None):
    """The complete environment of git and ssh-keygen: the signer's own PATH and locale, the two variables
    they need, git settings that remove ambient configuration, and whatever `extra` the caller passes."""
    environ = os.environ if environ is None else environ
    child = {name: environ[name] for name in PASSED_ENVIRONMENT if name in environ}
    child.update(PATH=TOOLS['PATH'], LC_ALL='C', GIT_NO_REPLACE_OBJECTS='1', GIT_TERMINAL_PROMPT='0',
                 GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL='/dev/null')
    child.update(extra or {})
    return child


def git(repo, *args, stdin=None, env=None):
    # Only the allowlisted environment reaches git, and the caller's repository cannot name programs
    # for it to run (fsmonitor, hooks, pager, external diff).
    done = subprocess.run([TOOLS['git'], '-c', 'core.fsmonitor=false', '-c', 'core.hooksPath=/dev/null', '-c', 'core.pager=cat',
                           '-c', f'gpg.ssh.program={TOOLS["ssh-keygen"]}', '-C', str(repo), *args], input=stdin,
                          capture_output=True, timeout=300,
                          env=child_environment(env))
    if done.returncode != 0:
        raise Refused(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-500:]}')
    return done.stdout


def validate(request):
    if not isinstance(request, dict) or set(request) != REQUEST_KEYS:
        raise Refused('request must have exactly: ' + ', '.join(sorted(REQUEST_KEYS)))
    if not OID.match(str(request['commit'])):
        raise Refused('commit must be a full object id')
    if not CHECK.match(str(request['check'])):
        raise Refused('check name must be lowercase letters, digits, dot, dash or underscore')
    command = request['command']
    if not (isinstance(command, list) and command and all(isinstance(a, str) for a in command) and command[0]):
        raise Refused('command must be a nonempty argument vector')
    if type(request['exit_code']) is not int:
        raise Refused('exit_code must be an integer')
    if not SHA256.match(str(request['output_sha256'])):
        raise Refused('output_sha256 must be 64 lowercase hex digits')
    if not (isinstance(request['change_id'], str) and request['change_id'].strip() and len(request['change_id']) < 200):
        raise Refused('change_id must be a short nonempty string')
    inputs = request['inputs']
    if not (isinstance(inputs, dict) and INPUT_KEYS <= set(inputs) and len(inputs) <= 40
            and all(isinstance(v, str) and 0 < len(v) <= 500 for v in inputs.values())):
        raise Refused('inputs must be short nonempty strings and include: ' + ', '.join(sorted(INPUT_KEYS)))
    for name in set(inputs) - INPUT_KEYS:
        if not EXTRA_INPUT.match(name):
            raise Refused(f'input name {name!r} must be lowercase letters, digits and underscore')
    for key in ('flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256'):
        if not SHA256.match(inputs[key]):
            raise Refused(f'{key} must be 64 lowercase hex digits')
    if not re.fullmatch(r'[1-9][0-9]{0,3}', inputs['attempt']):
        raise Refused('attempt must be a small positive integer')


def main():
    refuse_loader_environment()
    config = json.loads((Path.home() / '.config/st/evidence-sign.json').read_text())
    if not {'signer', 'ssh_key', 'scratch_repo'} <= set(config) or set(config) - {'signer', 'ssh_key', 'scratch_repo', 'test_clock', 'path'}:
        raise Refused('configuration must have signer, ssh_key, scratch_repo (optionally path; for tests only test_clock)')
    trusted_tools(config.get('path') or ':'.join(TRUSTED_PATH), strict=bool(config.get('path')))
    signer, key, scratch = config['signer'], Path(config['ssh_key']), Path(config['scratch_repo'])
    if not (re.fullmatch(r'\S+', signer) and key.is_absolute() and scratch.is_absolute()):
        raise Refused('invalid signer configuration')
    request = json.load(sys.stdin)
    validate(request)

    checkout = Path.cwd()
    commit = request['commit']
    if git(checkout, 'cat-file', '-t', commit).decode().strip() != 'commit':
        raise Refused('commit is not a commit in the caller\'s checkout')
    tree = git(checkout, 'rev-parse', f'{commit}^{{tree}}').decode().strip()
    lock = git(checkout, 'show', f'{commit}:flake.lock')
    if hashlib.sha256(lock).hexdigest() != request['inputs']['flake_lock_sha256']:
        raise Refused('flake_lock_sha256 does not match flake.lock in the commit')

    if not scratch.exists():
        subprocess.run([TOOLS['git'], 'init', '--quiet', '--bare', str(scratch)], check=True, env=child_environment())
    git(scratch, 'fetch', '--quiet', '--no-tags', str(checkout), commit)

    body = {
        '_type': 'https://in-toto.io/Statement/v1',
        'subject': [{'name': commit, 'digest': {'gitTree': tree}}],
        # LIVE-MIGRATION BRIDGE arn:lmig:smalltalk:2026-10-16-evidence-predicate-uri — DELETE at contraction — https://github.com/compoundingtech/smalltalk/issues/3032
        # Keep writing the old URI until the accepting verifier release is on main.
        'predicateType': 'https://smalltalk.dev/evidence/gate/v1',
        # LIVE-MIGRATION END arn:lmig:smalltalk:2026-10-16-evidence-predicate-uri
        'predicate': {
            'schema_version': 1, 'change_id': request['change_id'], 'signer': signer, 'tier': 'full',
            're_attests': None,
            'producer_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            # The clock is the signer's own. Only a test configuration (never a production one) may set it.
            'observed_at': (os.environ.get('EVIDENCE_SIGN_NOW') if config.get('test_clock') is True else None)
                           or datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
            'observed': {
                'kind': 'tests', 'runner': 'wrapper',
                'checks': {request['check']: {'command': request['command'], 'exit_code': request['exit_code'],
                                              'output_sha256': request['output_sha256']}},
                'inputs': dict(sorted(request['inputs'].items())),
            },
        },
    }
    blob = git(scratch, 'hash-object', '-w', '--stdin', stdin=json.dumps(body).encode()).decode().strip()
    notes = git(scratch, 'mktree', stdin=f'100644 blob {blob}\t{tree}\n'.encode()).decode().strip()
    record = git(scratch, '-c', 'user.name=Evidence signer', '-c', 'user.email=signer@example.invalid',
                 '-c', 'gpg.format=ssh', '-c', f'user.signingKey={key}',
                 'commit-tree', '-S', notes, '-p', commit, stdin=b'st gate observation v1\n').decode().strip()
    objects = f'{commit}\n'.encode() + git(scratch, 'rev-list', '--objects', '--no-object-names', tree)
    objects += f'{record}\n'.encode() + git(scratch, 'rev-list', '--objects', '--no-object-names', f'{record}^{{tree}}')
    pack = git(scratch, 'pack-objects', '--stdout', stdin=objects)
    print(json.dumps({'record': record, 'tier': 'full', 'tree': tree, 'commit': commit,
                      'object_pack_base64': base64.b64encode(pack).decode()}))


if __name__ == '__main__':
    try:
        main()
    except (Refused, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'evidence-sign refused: {error}', file=sys.stderr)
        sys.exit(1)
