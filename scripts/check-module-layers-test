#!/usr/bin/env python3
"""Mutation proofs for the module-graph check: each forbidden change must fail it."""
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True
import module_layers as ml

HERE = Path(__file__).resolve().parent
SCRIPT = HERE / "check-module-layers"


class ModuleLayers(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="module-layers-")
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        (self.root / ".st").mkdir()
        self.write("crates/st3/src/lib.rs", "pub mod a; pub mod b; pub mod c;\n")
        self.write("crates/st3/src/a.rs", "use crate::b::f;\npub fn g() { f() }\n")
        self.write("crates/st3/src/b.rs", "use crate::c;\npub fn f() { c::h() }\n")
        self.write("crates/st3/src/c.rs", "pub fn h() {}\n")
        self.allow([])

    def write(self, name, text):
        path = self.root / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)

    def allow(self, pairs):
        (self.root / ml.LAYERS_FILE).write_text(json.dumps({"version": 1, "allowed_upward": pairs}))

    def run_script(self, *args, stdin=None):
        return subprocess.run([sys.executable, str(SCRIPT), "--root", str(self.root), *args],
                              input=stdin, text=True, capture_output=True)

    def test_clean_graph_passes(self):
        result = self.run_script()
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("3 modules", result.stdout)

    def test_new_upward_edge_that_closes_a_cycle_fails(self):
        self.write("crates/st3/src/c.rs", "use crate::a;\npub fn h() { a::g() }\n")
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("module cycle outside the allowlist", result.stderr)
        self.assertIn("a -> b -> c -> a", result.stderr.replace("b -> c -> a -> b", "a -> b -> c -> a"))

    def test_allowlisted_pair_passes_and_stale_pair_fails(self):
        self.write("crates/st3/src/c.rs", "use crate::a;\npub fn h() { a::g() }\n")
        self.allow([["c", "a"]])
        self.assertEqual(self.run_script().returncode, 0)
        self.write("crates/st3/src/c.rs", "pub fn h() {}\n")
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("c -> a no longer exists; remove it", result.stderr)

    def test_allowlist_naming_a_missing_module_fails(self):
        self.allow([["a", "gone"]])
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("names a module that does not exist", result.stderr)

    def test_test_code_is_not_a_reference(self):
        self.write("crates/st3/src/c.rs", "pub fn h() {}\n#[cfg(test)]\nmod tests {\n    use crate::a;\n    #[test] fn t() { a::g() }\n}\n")
        self.write("crates/st3/src/b_tests.rs", "use crate::a;\n")
        self.assertEqual(self.run_script().returncode, 0)

    def test_comments_and_group_imports(self):
        self.write("crates/st3/src/c.rs", "// use crate::a;\n/* crate::a */\nuse crate::{b::f as ff, c::h};\npub fn h() {}\n")
        modules, edges = ml.production_graph(str(self.root))
        self.assertEqual(edges["c"], {"b": 1})

    def test_braces_in_literals_do_not_end_test_code(self):
        fixture = 'r#"mission "m" { step "s" }}"#'
        self.write("crates/st3/src/c.rs", "pub fn h() {}\n#[cfg(test)]\nmod tests {\n"
                   f"    const KDL: &str = {fixture};\n    const C: char = '}}';\n"
                   "    const S: &str = \"}} \\\" }}\";\n"
                   "    #[test] fn t() { crate::a::g() }\n}\n")
        modules, edges = ml.production_graph(str(self.root))
        self.assertEqual(edges["c"], {})

    def test_comment_markers_in_literals_are_not_comments(self):
        self.write("crates/st3/src/c.rs", "pub fn h() { let _ = \"http://x\"; crate::b::f() }\n"
                   "/* outer /* nested */ crate::a::g() */\n")
        modules, edges = ml.production_graph(str(self.root))
        self.assertEqual(edges["c"], {"b": 1})

    def test_reexports_count_toward_their_module(self):
        self.write("crates/st3/src/c.rs", "use crate::parse_intent;\npub fn h() {}\n")
        self.write("crates/st3-daemon/src/graph.rs", "pub fn parse_intent() {}\n")
        modules, edges = ml.production_graph(str(self.root))
        self.assertEqual(edges["c"], {"graph": 1})

    def test_binary_side_references_through_the_library_name(self):
        self.write("crates/st3/src/main.rs", "mod ui;\nfn main() {}\n")
        self.write("crates/st3/src/ui.rs", "use st3::a;\n")
        modules, edges = ml.production_graph(str(self.root))
        self.assertEqual(edges["ui"], {"a": 1})

    def test_split_source_directories_are_one_graph(self):
        self.write("crates/st3-daemon/src/d.rs", "use crate::c;\n")
        self.write("crates/st3-core/src/e.rs", "pub fn e() {}\n")
        modules, edges = ml.production_graph(str(self.root))
        self.assertEqual({"a", "b", "c", "d", "e"}, modules)
        self.assertEqual(edges["d"], {"c": 1})

    def test_affected_is_the_reverse_closure(self):
        result = self.run_script("--affected", "crates/st3/src/c.rs", "docs/x.md")
        self.assertEqual(result.returncode, 0, result.stderr)
        out = json.loads(result.stdout)
        self.assertEqual(out["modules"], ["a", "b", "c"])
        self.assertEqual(out["other_paths"], ["docs/x.md"])
        leaf = json.loads(self.run_script("--affected", "crates/st3/src/a.rs").stdout)
        self.assertEqual(leaf["modules"], ["a"])

    def test_metric_counts_sizes(self):
        sets = json.dumps([["crates/st3/src/c.rs"], ["crates/st3/src/a.rs"], ["docs/x.md"]])
        out = json.loads(self.run_script("--metric", stdin=sets).stdout)
        self.assertEqual((out["changes"], out["at_most_15"], out["of_modules"]), (2, 2, 3))

    def test_layers_are_longest_paths(self):
        out = self.run_script("--layers").stdout.splitlines()
        self.assertEqual([line.split()[1:] for line in out], [["c"], ["b"], ["a"]])

    # LIVE-MIGRATION BRIDGE arn:lmig:smalltalk:2026-10-16-state-dirs-fractal — DELETE at contraction — #3032
    def test_r11_allows_only_the_resolver_namespace_in_leaf_crates(self):
        for crate in ("st3-kernel", "st3-telemetry"):
            with self.subTest(crate=crate):
                self.write(f"crates/{crate}/src/instance.rs",
                           "use st3_client::product_dirs as dirs;\n"
                           "fn path() { st3_client :: product_dirs :: state_dir(); }\n"
                           "#[cfg(test)] mod tests { use st3_client::product_dirs::RECEIPT_FILE; }\n")
                self.assertEqual(ml.client_boundary_findings(str(self.root)), [])

    def test_r11_rejects_other_client_paths_and_root_aliases(self):
        for crate in ("st3-kernel", "st3-telemetry"):
            for source in [
                "use st3_client::device;",
                "use st3_client::product_dirs_extra;",
                "use st3_client as client;",
                "extern crate st3_client as client;",
                "use st3_client::{product_dirs, device};",
                "#[cfg(test)] mod tests { use st3_client::Client; }",
            ]:
                with self.subTest(crate=crate, source=source):
                    path = f"crates/{crate}/src/instance.rs"
                    self.write(path, source)
                    self.assertTrue(ml.client_boundary_findings(str(self.root)))
                    self.assertIn("forbidden st3_client reference", self.run_script().stderr)
                    self.write(path, "")

    def test_r11_boundary_ignores_comments_and_string_literals(self):
        self.write("crates/st3-kernel/src/instance.rs",
                   '// st3_client::device\n/* st3_client::Client */\n'
                   'const SOURCE: &str = r#"use st3_client::device;"#;\n'
                   'const TEXT: &str = "st3_client::Client";\n')
        self.assertEqual(ml.client_boundary_findings(str(self.root)), [])
    # LIVE-MIGRATION END arn:lmig:smalltalk:2026-10-16-state-dirs-fractal

    def test_leaf_crates_reject_client_dependency_aliases_in_every_table(self):
        sections = [
            "dependencies", "dev-dependencies", "build-dependencies",
            'target.\'cfg(unix)\'.dependencies',
            'target.\'cfg(unix)\'.dev-dependencies',
            'target.\'cfg(unix)\'.build-dependencies',
        ]
        for crate in ("st3-kernel", "st3-telemetry"):
            path = f"crates/{crate}/Cargo.toml"
            for section in sections:
                with self.subTest(crate=crate, section=section):
                    self.write(path, f'[{section}]\nclient = {{ package = "st3-client", path = "../st3-client" }}\n')
                    self.assertIn("aliases st3-client as client", self.run_script().stderr)
                    self.write(path, f'[{section}]\nst3-client = {{ path = "../st3-client" }}\n')
                    self.assertEqual(ml.client_boundary_findings(str(self.root)), [])
            self.write(path, "")

    def test_leaf_crates_resolve_inherited_client_aliases(self):
        for crate in ("st3-kernel", "st3-telemetry"):
            path = f"crates/{crate}/Cargo.toml"
            for section in ("dependencies", "target.'cfg(unix)'.dependencies"):
                with self.subTest(crate=crate, section=section):
                    self.write("Cargo.toml",
                               '[workspace.dependencies]\n'
                               'client = { package = "st3-client", path = "crates/st3-client" }\n')
                    self.write(path, f'[{section}]\nclient = {{ workspace = true }}\n')
                    result = self.run_script()
                    self.assertEqual(result.returncode, 1, result.stdout)
                    self.assertIn("aliases st3-client as client", result.stderr)
                    self.write("Cargo.toml",
                               '[workspace.dependencies]\n'
                               'st3-client = { path = "crates/st3-client" }\n')
                    self.write(path, f'[{section}]\nst3-client = {{ workspace = true }}\n')
                    self.assertEqual(ml.client_boundary_findings(str(self.root)), [])
            self.write(path, "")

    def test_leaf_crates_reject_client_api_in_all_cargo_target_directories(self):
        for crate in ("st3-kernel", "st3-telemetry"):
            for target in ("tests", "benches", "examples"):
                with self.subTest(crate=crate, target=target):
                    path = f"crates/{crate}/{target}/nested/client.rs"
                    self.write(path, "use st3_client::Client;\n")
                    result = self.run_script()
                    self.assertEqual(result.returncode, 1, result.stdout)
                    self.assertIn(path + ":1: forbidden st3_client reference", result.stderr)
                    self.write(path, "")

    def split_packages(self, daemon_version="0.1.0", daemon_deps="", build=True, binary_deps=""):
        self.write("crates/st3/Cargo.toml", f'[package]\nname = "st3"\nversion = "0.1.0"\n\n[dependencies]\nstui = "1"\n{binary_deps}')
        self.write("crates/st3-daemon/Cargo.toml",
                   f'[package]\nname = "st3-daemon"\nversion = "{daemon_version}"\n\n[dependencies]\n{daemon_deps}')
        self.write("crates/st3/build.rs", "fn main() {}\n")
        if build:
            self.write("crates/st3-daemon/build.rs", "fn main() {}\n")

    def test_split_packages_that_agree_pass(self):
        self.split_packages()
        self.assertEqual(self.run_script().returncode, 0)

    def test_the_library_and_the_binary_package_must_share_a_version(self):
        self.split_packages(daemon_version="0.2.0")
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("version 0.2.0 differs from crates/st3 version 0.1.0", result.stderr)

    def test_the_library_must_not_depend_on_a_binary_side_crate(self):
        self.split_packages(daemon_deps='stui = "1"\n')
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("depends on stui, which is binary-side", result.stderr)

    def test_a_renamed_binary_side_dependency_is_still_caught(self):
        self.split_packages(daemon_deps='ui = { package = "st3-conversation-ui", path = "../x" }\n')
        self.assertIn("depends on st3-conversation-ui, which is binary-side", self.run_script().stderr)

    def test_a_dependency_both_manifests_name_must_be_declared_the_same(self):
        self.split_packages(daemon_deps='pty = { git = "u", rev = "a" }\n', binary_deps='pty = { git = "u", rev = "a" }\n')
        self.assertEqual(self.run_script().returncode, 0)
        self.split_packages(daemon_deps='pty = { git = "u", rev = "a" }\n', binary_deps='pty = { git = "u", rev = "b" }\n')
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("pty in [dependencies] differs", result.stderr)

    def test_a_nextest_filter_naming_only_package_st3_is_caught(self):
        self.split_packages()
        self.write(".config/nextest.toml",
                   '[profile.ci]\ndefault-filter = "all()"\n[[profile.ci.overrides]]\n'
                   'filter = "package(=st3) and test(/^store::x$/)"\nretries = 0\n'
                   '[[profile.ci.overrides]]\nfilter = "package(=st3) and binary(=integration) and test(/^a::b$/)"\nretries = 0\n'
                   '[[profile.ci.overrides]]\nfilter = "(package(=st3) or package(=st3-daemon)) and test(/^c$/)"\nretries = 0\n')
        result = self.run_script()
        self.assertEqual(result.returncode, 1)
        self.assertIn("profile.ci.overrides[0] names package st3 but not st3-daemon", result.stderr)
        self.assertNotIn("overrides[1]", result.stderr)
        self.assertNotIn("overrides[2]", result.stderr)

    def test_the_two_build_scripts_must_be_the_same(self):
        self.split_packages(build=False)
        self.assertIn("build.rs", self.run_script().stderr)
        self.split_packages()
        self.write("crates/st3-daemon/build.rs", "fn main() { println!(); }\n")
        self.assertIn("differ", self.run_script().stderr)

    def test_repository_graph_passes(self):
        root = HERE.parent
        self.assertEqual(ml.findings(str(root)), [])


if __name__ == "__main__":
    unittest.main()
