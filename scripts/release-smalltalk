#!/usr/bin/env bash
# Build and verify a native Smalltalk archive. Never installs or restarts a service.
# Usage: scripts/release-smalltalk [--dry-run] TARGET OUTPUT_DIRECTORY
set -Eeuo pipefail

dry_run=false
if [[ ${1:-} == --dry-run ]]; then
  dry_run=true
  shift
fi
binaries=(st3)
runtime_binaries=("${binaries[@]}" pty)
target=${1:?expected Rust target}
out=${2:?expected output directory}
case "$target:$(uname -sm)" in
  x86_64-unknown-linux-gnu:Linux\ x86_64 | aarch64-apple-darwin:Darwin\ arm64) ;;
  *) echo "release-smalltalk: target does not match this native host" >&2; exit 1 ;;
esac
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"
if $dry_run; then
  printf 'cargo build --release --locked --target %s -p st3\n' "$target"
  printf 'stage bin/%s\n' "${runtime_binaries[@]}"
  printf 'link bin/st -> st3\narchive %s/smalltalk-%s.tar.gz\n' "$out" "$target"
  printf 'verify manifest, install in isolated destination, run st ui PTY smoke\n'
  exit 0
fi
test -z "$(git status --porcelain --untracked-files=no)"
mkdir -p "$out"
out=$(cd "$out" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
package="smalltalk-$target"
mkdir -p "$work/$package/bin"

# The runtime pin is the Nix package's PTY input, not the distinct pty-core library pin.
python3 - "$work/pin.json" <<'PY'
import json, re, sys
lock = json.load(open('flake.lock'))
pin = lock['nodes'][lock['nodes']['root']['inputs']['pty']]['locked']
assert pin['type'] == 'github' and re.fullmatch(r'[0-9a-f]{40}', pin['rev'])
json.dump(pin, open(sys.argv[1], 'w'))
PY
pty_rev=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["rev"])' "$work/pin.json")
pty_url=$(python3 -c 'import json,sys; p=json.load(open(sys.argv[1])); print("https://github.com/"+p["owner"]+"/"+p["repo"]+".git")' "$work/pin.json")
# Stamp the exact clean source, replacing any inherited stamp from a different checkout.
CLI_BUILD_STAMP=$(python3 scripts/release-build-stamp.py)
export CLI_BUILD_STAMP
# Ignore local mold flags. Linux links against the oldest supported glibc, including
# C dependencies and PTY, so optional newer Rust symbols stay unversioned weak imports.
export CARGO_ENCODED_RUSTFLAGS=
if [[ $target == *linux* ]]; then
  test "$(zig version)" = 0.15.2
  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$repo/scripts/linux-release-cc"
  export CC_x86_64_unknown_linux_gnu="$repo/scripts/linux-release-cc"
fi
cargo build --release --locked --target "$target" -p st3
build_dir=$(cargo metadata --no-deps --format-version 1 | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')
for binary in "${binaries[@]}"; do
  install -m 0755 "$build_dir/$target/release/$binary" "$work/$package/bin/$binary"
done

# Keep the immutable runtime source at a stable Cargo-home path. A random temporary
# checkout invalidates its fingerprints on every job even when the pin is unchanged.
pty_source="${CARGO_HOME:-$HOME/.cargo}/git/smalltalk-release-pty/$pty_rev"
if [ ! -d "$pty_source/.git" ]; then
  mkdir -p "$pty_source"
  git init -q "$pty_source"
  git -C "$pty_source" remote add origin "$pty_url"
  git -C "$pty_source" fetch --depth 1 origin "$pty_rev"
  git -C "$pty_source" checkout -q --detach FETCH_HEAD
fi
test "$(git -C "$pty_source" remote get-url origin)" = "$pty_url"
test "$(git -C "$pty_source" rev-parse HEAD)" = "$pty_rev"
test -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$pty_source" status --porcelain)"
# Path crates keep the same artifact names across pinned workspace revisions. A warm
# cache can consider an older crate fresh when restored source timestamps precede
# its dep-info. Give each runtime pin its own artifacts, still within the cache root.
pty_build_dir="$build_dir/pty-runtime/$pty_rev"
AGENT_SPEC_REVISION="$pty_rev" cargo build --release --locked --manifest-path "$pty_source/Cargo.toml" \
  --target-dir "$pty_build_dir" --target "$target" -p pty --bin pty
install -m 0755 "$pty_build_dir/$target/release/pty" "$work/$package/bin/pty"
if [[ $target == *apple* ]]; then
  # The terminal client's speech helper needs Swift with the macOS 26 SDK; without one the release ships without
  # voice in the terminal interface, and says so.
  speech="$build_dir/$target/release/StListen.app"
  if [ "${CI_BUILD_SNAPSHOT_HIT:-}" = 1 ] && [ -d "$speech" ]; then
    cp -R "$speech" "$work/$package/bin/StListen.app"
  elif apps/macos/listen/build.sh "$work/$package/bin" >/dev/null; then
    rm -rf "$speech"
    cp -R "$work/$package/bin/StListen.app" "$speech"
  else
    echo "release-smalltalk: the speech helper did not build here; this release has no voice in the terminal interface" >&2
    rm -rf "$work/$package/bin/StListen.app" "$speech"
  fi
fi
ln -s st3 "$work/$package/bin/st"
install -m 0755 scripts/install-release "$work/$package/install.sh"
install -m 0755 scripts/install-macos.py "$work/$package/install-macos.py"
cp docs/st3/binary-releases.md "$work/$package/README.md"
cp docs/st3/macos-installation.md "$work/$package/macos-installation.md"

for binary in "${runtime_binaries[@]}"; do
  path="$work/$package/bin/$binary"
  if command -v file >/dev/null 2>&1; then file "$path"; fi
  if [[ $target == *linux* ]]; then
    python3 scripts/check-linux-release.py "$path"
  else
    otool -L "$path" > "$work/links"
    # Standalone archives may link only Apple's system libraries.
    if tail -n +2 "$work/links" | grep -Ev '^[[:space:]]+(/usr/lib/|/System/Library/)'; then exit 1; fi
    codesign --force --sign - "$path"
    codesign --verify "$path"
  fi
done
python3 - "$work/$package/BUILD.json" "$target" "$pty_rev" <<'PY'
import json, os, subprocess, sys
json.dump({'source': subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
           'target': sys.argv[2], 'pty_revision': sys.argv[3],
           'tag': os.environ.get('RELEASE_TAG'),
           'build_stamp': json.loads(os.environ['CLI_BUILD_STAMP']),
           'glibc_baseline': '2.35' if sys.argv[2].endswith('linux-gnu') else None,
           'rustc': subprocess.check_output(['rustc', '--version'], text=True).strip()},
          open(sys.argv[1], 'w'), indent=2)
PY
archive="$out/$package.tar.gz"
tar -C "$work" -czf "$archive" "$package"
# Verify the delivered bytes, not just the pre-archive staging directory.
mkdir "$work/extracted"
tar -C "$work/extracted" -xzf "$archive"
mkdir -p "$work/install-home"
ST_MACOS_INSTALL_HOME="$work/install-home" ST_MACOS_APP_PATH="$work/installed/SmallTalk.app" \
  "$work/extracted/$package/install.sh" --bin-dir "$work/installed"
# Query outside the build checkout: installed tools must retain their baked source identity.
(cd "$work/extracted" && "$work/installed/st" --version --json) > "$work/version.json"
python3 - "$work/version.json" <<'PY_VERSION'
import json, subprocess, sys, tomllib
import os
stamp = json.loads(os.environ['CLI_BUILD_STAMP'])
expected = stamp['version'] + '+' + stamp['rev']
actual = json.load(open(sys.argv[1]))['machine_version']
assert actual == expected, f'installed version {actual!r}, expected {expected!r}'
PY_VERSION
"$work/installed/st3" --version
"$work/installed/st3" --help >/dev/null
"$work/installed/st" --help >/dev/null
"$work/installed/pty" --version
env -u ST_AGENT HOME="$work/install-home" XDG_CONFIG_HOME="$work/install-home/.config" \
  XDG_CACHE_HOME="$work/install-home/.cache" XDG_STATE_HOME="$work/install-home/.local/state" \
  ST3_PERSON=person/release-smoke ST3_ENDPOINT="$work/absent.sock" \
  python3 crates/stui/tests/pty_smoke.py "$work/installed/st" --ui --no-panic
python3 - "$archive" <<'PY'
import hashlib, pathlib, sys
p = pathlib.Path(sys.argv[1])
p.with_name(p.name + '.sha256').write_text(hashlib.sha256(p.read_bytes()).hexdigest() + '  ' + p.name + '\n')
PY
printf 'verified %s\n' "$archive"
