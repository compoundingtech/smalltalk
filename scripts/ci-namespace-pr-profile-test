#!/usr/bin/env python3
"""Offline queue-membership failures must not strand jobs on a capped label."""
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('pr_profile', str(ROOT / 'scripts/ci-namespace-pr-profile'))
spec = importlib.util.spec_from_loader(loader.name, loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)


class Profile(unittest.TestCase):
    def setUp(self):
        self.env = dict(EVENT='pull_request', PR_NAMESPACE_PROFILE='smalltalk-pr-linux-x86-64',
                        PR_NUMBER='12', RUN_ID='123', PR_HEAD_SHA='a' * 40,
                        REPOSITORY='example/project', GH_REPO_TOKEN='repo-read-fixture',
                        GH_TOKEN='org-runner-fixture')
        self.pr = dict(headRefOid='a' * 40, mergeQueueEntry=None)
        self.summary = io.StringIO()

    def invoke(self, data=None, error=None):
        if data is None:
            data = dict(data=dict(repository=dict(pullRequest=self.pr)))
        result = subprocess.CompletedProcess([], 0, json.dumps(data), '')
        with patch.object(m.subprocess, 'run', side_effect=error, return_value=result) as call:
            value = m.pr_namespace_profile(self.env, self.summary)
        return value, call

    def test_pr_without_queue_entry_uses_profile_and_inline_affinity(self):
        value, call = self.invoke()
        self.assertEqual(value, 'namespace-profile-smalltalk-pr-linux-x86-64;job.priority=2;github.run-id=123')
        self.assertEqual(call.call_args.kwargs['env']['GH_TOKEN'], 'repo-read-fixture')
        self.assertEqual(call.call_args.kwargs['timeout'], 10)
        self.assertIn('mergeQueueEntry', call.call_args.args[0][4])

    def test_merge_main_manual_and_schedule_do_not_query_or_cap(self):
        for event in ('merge_group', 'push', 'workflow_dispatch', 'schedule'):
            with self.subTest(event=event):
                self.env['EVENT'] = event
                value, call = self.invoke()
                self.assertIsNone(value)
                call.assert_not_called()

    def test_unconfigured_profile_does_not_query(self):
        self.env['PR_NAMESPACE_PROFILE'] = ''
        value, call = self.invoke()
        self.assertIsNone(value)
        call.assert_not_called()

    def test_invalid_config_and_identities_do_not_query(self):
        for key, bad in [('PR_NAMESPACE_PROFILE', 'bad\nlabel'), ('PR_NAMESPACE_PROFILE', '../other'),
                         ('PR_NUMBER', '0'), ('RUN_ID', '１２'), ('RUN_ID', ''),
                         ('PR_HEAD_SHA', 'old'), ('REPOSITORY', 'bad'), ('GH_REPO_TOKEN', '')]:
            with self.subTest(key=key, bad=bad):
                prior = self.env[key]
                self.env[key] = bad
                value, call = self.invoke()
                self.assertIsNone(value)
                call.assert_not_called()
                self.env[key] = prior

    def test_exact_queued_head_bypasses_profile(self):
        self.pr['mergeQueueEntry'] = {'id': 'QUEUE_fixture'}
        self.assertIsNone(self.invoke()[0])

    def test_changed_head_does_not_act_on_old_queue_snapshot(self):
        self.pr['headRefOid'] = 'b' * 40
        self.assertIsNone(self.invoke()[0])

    def test_missing_and_invalid_queue_entry_is_unknown(self):
        for entry in ({}, {'id': ''}, {'id': 42}, False, []):
            self.pr['mergeQueueEntry'] = entry
            self.assertIsNone(self.invoke()[0])
        del self.pr['mergeQueueEntry']
        self.assertIsNone(self.invoke()[0])

    def test_malformed_and_partial_graphql_responses_keep_existing_routing(self):
        for data in ([], {}, {'errors': [{'message': 'denied'}]},
                     {'data': None}, {'data': {'repository': None}},
                     {'data': {'repository': {'pullRequest': None}}}):
            self.assertIsNone(self.invoke(data=data)[0])

    def test_api_failure_timeout_and_invalid_json_are_fail_open_without_retry(self):
        for error in (subprocess.CalledProcessError(1, ['gh']),
                      subprocess.TimeoutExpired(['gh'], 10), ValueError('bad JSON')):
            value, call = self.invoke(error=error)
            self.assertIsNone(value)
            self.assertEqual(call.call_count, 1)

    def test_generated_namespace_step_matches_source_and_emits_both_priorities(self):
        workflow = (ROOT / '.github/workflows/fleet.yml').read_text()
        block = workflow.split('      - name: Select the provisioned PR profile', 1)[1].split('      - if:', 1)[0]
        import textwrap
        program = textwrap.dedent(block.split('        run: |\n', 1)[1])
        self.assertIn((ROOT / 'scripts/ci-namespace-pr-profile').read_text(), program)
        with tempfile.TemporaryDirectory() as scratch:
            tmp = Path(scratch)
            gh = tmp / 'gh'
            gh.write_text('#!/bin/sh\nprintf \'%s\' "$PROFILE_RESPONSE"\n')
            gh.chmod(0o755)
            env = {**os.environ, **self.env, 'PATH': str(tmp) + ':' + os.environ['PATH'],
                   'GITHUB_OUTPUT': str(tmp/'out'), 'GITHUB_STEP_SUMMARY': str(tmp/'summary'),
                   'PROFILE_RESPONSE': json.dumps(dict(data=dict(repository=dict(pullRequest=self.pr))))}
            result = subprocess.run(['bash', '-e', '-c', program], env=env, capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            values = dict(line.split('=', 1) for line in (tmp/'out').read_text().splitlines())
            self.assertIn(';job.priority=2;', json.loads(values['namespace_pr'])[0])
            self.assertIn(';job.priority=3;', json.loads(values['namespace_pr_optional'])[0])
            # Compare the emitted priorities with the existing policy constants,
            # so editing either side alone cannot silently split the queues.
            import re
            policy = (ROOT / '.github/workflows/workspace-ci.ts').read_text()
            required = re.search(r'const workspaceJobPriority = "[^\n]*pull_request\' && (\d+)', policy).group(1)
            optional = re.search(r'const linuxJobPriority = "[^\n]*\|\| (\d+) }}', policy).group(1)
            self.assertIn(f';job.priority={required};', json.loads(values['namespace_pr'])[0])
            self.assertIn(f';job.priority={optional};', json.loads(values['namespace_pr_optional'])[0])


if __name__ == '__main__':
    unittest.main()
