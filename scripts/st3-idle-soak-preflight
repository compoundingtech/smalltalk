#!/usr/bin/env bash
set -Eeuo pipefail

: "${ST3_IDLE_PREFLIGHT_START_UNIX:?set the first final-build sample epoch}"
[[ $ST3_IDLE_PREFLIGHT_START_UNIX =~ ^[0-9]+$ ]] || {
  echo 'invalid idle preflight start epoch' >&2
  exit 2
}
now=${ST3_IDLE_REPORT_NOW_UNIX:-$(/bin/date -u +%s)}
[[ $now =~ ^[0-9]+$ ]] || { echo 'invalid idle preflight now epoch' >&2; exit 2; }
(( now >= ST3_IDLE_PREFLIGHT_START_UNIX )) || {
  echo 'idle preflight start is in the future' >&2
  exit 2
}

report="$(/usr/bin/dirname "$0")/st3-idle-soak-report"
duration=$((now - ST3_IDLE_PREFLIGHT_START_UNIX))
(( duration > 0 )) || duration=1
# The release report is intentionally still allowed to fail for insufficient
# duration, quiet intervals, or CPU. This preflight checks only whether the
# retained post-rollout evidence is continuous and belongs to one healthy PID.
result=$(ST3_IDLE_REPORT_DURATION_SECONDS="$duration" \
  ST3_IDLE_REPORT_MIN_SAMPLES=1 ST3_IDLE_REPORT_MIN_QUIET=0 \
  "$report" 2>&1) || :
summary=$(/usr/bin/jq -cr '{hosts:[.hosts[]|{host,samples,errors,pid_count,
  first_at,last_at,max_sample_gap}]}' <<<"$result" 2>/dev/null) || summary=$result
if ! /usr/bin/jq -e --argjson now "$now" \
  --argjson start "$ST3_IDLE_PREFLIGHT_START_UNIX" '
    (.hosts | length) == 2 and
    all(.hosts[];
      .samples > 0 and .errors == 0 and .pid_count == 1 and
      .first_at != null and .first_at <= ($start + 180) and
      .last_at != null and .last_at >= ($now - 180) and
      (.max_sample_gap // 0) <= 180)
  ' <<<"$result" >/dev/null 2>&1; then
  /usr/bin/printf 'FAIL: post-rollout idle evidence is missing, stale, discontinuous, or unhealthy: %.600s\n' "$summary"
  exit 1
fi
/usr/bin/printf 'PASS: post-rollout idle evidence is continuous and healthy: %.600s\n' "$summary"
