#!/usr/bin/env bash
# A local Nix binary cache on the Namespace cache volume, for Nix-built outputs and downloads.
#
# /nix itself cannot be cached: a restored /nix carries the Nix installer's receipt but not its
# daemon, build users or nix.conf, so the installer skips setup and every Nix command then fails
# with "cannot connect to socket". Instead each run installs Nix normally, `use` makes the cache
# volume's file:// store a preferred substituter, and `save` copies what the run added back to it.
set -euo pipefail
cmd=${1:?usage: scripts/ci-nix-cache use|save}
dir=${CI_CACHE_DIR:?CI_CACHE_DIR is not set}
cache="$dir/nix-cache"
key="$dir/nix-cache-key"

case "$cmd" in
  use)
    mkdir -p "$cache"
    # The Nix daemon runs as root and creates the store's directories when it first queries a
    # substituter, which would leave `save` (the runner user) unable to write. Take ownership of
    # anything an earlier run left behind, and create the layout as the runner before the daemon does.
    sudo chown -R "$(id -un)" "$cache"
    nix store info --store "file://$cache" > /dev/null
    # One signing key per cache volume; the volume is private to this repository's runners.
    [ -s "$key.sec" ] || nix key generate-secret --key-name st-ci-cache-1 > "$key.sec"
    nix key convert-secret-to-public < "$key.sec" > "$key.pub"
    {
      echo "NIX_CONFIG<<ST_CI_NIX_CONFIG"
      echo "extra-substituters = file://$cache?priority=10"
      echo "extra-trusted-public-keys = $(cat "$key.pub")"
      echo "ST_CI_NIX_CONFIG"
    } >> "$GITHUB_ENV"
    printf 'Nix cache %s: %s store paths\n' "$cache" "$(find "$cache" -maxdepth 1 -name '*.narinfo' | wc -l)"
    ;;
  save)
    start=$SECONDS
    # Keep only what is expensive to obtain again: paths this run built or fetched itself (compiled
    # outputs, fixed-output downloads such as crate tarballs), which carry no upstream signature.
    # Anything cache.nixos.org or Cachix serves is quicker to fetch than a 4 GB cache is to restore.
    # Paths already in the cache are skipped.
    nix path-info --all --json |
      jq -r 'if type == "object"
             then to_entries | map(select((.value.signatures // []) | length == 0)) | map(.key)
             else map(select((.signatures // []) | length == 0)) | map(.path) end | .[]' > "$cache.paths"
    printf 'Nix cache: %s locally obtained store paths to save\n' "$(wc -l < "$cache.paths")"
    xargs -a "$cache.paths" -r nix copy --to "file://$cache?secret-key=$key.sec&compression=zstd" \
      --no-check-sigs --no-recursive
    printf 'Nix cache %s: %s store paths after saving (%ss)\n' "$cache" \
      "$(find "$cache" -maxdepth 1 -name '*.narinfo' | wc -l)" "$((SECONDS - start))"
    ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
