#!/usr/bin/env python3
"""Report exact, fallback and missing caches without turning misses into successes."""
import json
import os
from pathlib import Path


def coverage(entries):
    rows, warnings = [], []
    for entry in entries:
        name = entry['name']
        if entry.get('outcome') == 'skipped':
            state = ('SKIPPED (persistent runner store)' if os.environ.get('CI_LOCAL_CACHES') == '1' else
                     'SKIPPED (same-source snapshot HIT)' if os.environ.get('CI_BUILD_SNAPSHOT_HIT') == '1' else 'SKIPPED (step condition)')
        elif entry.get('outcome') != 'success':
            state = 'UNAVAILABLE'
            warnings.append(f'P0: {name} cache lookup/restore did not complete')
        elif entry.get('hit') == 'true':
            state = 'HIT (lookup only)' if entry.get('lookup') else 'HIT'
        else:
            state = ('FALLBACK; exact key MISS' if entry.get('matched') else
                     'exact key MISS (fallback status not exposed)' if entry.get('opaqueFallback') else 'MISS')
            if entry.get('sourceOnly') and entry.get('avoidable') != 'true':
                state = 'MISS (source needs a saved build)'
                warnings.append(f'{name} cache MISS; dependency caches remain available')
            else:
                warnings.append(f'P0: {name} cache {state}; check changed inputs, scope and eviction')
        rows.append(f'| {name} | {state} |')
    return rows, warnings


def main():
    rows, warnings = coverage(json.loads(os.environ['CACHE_ENTRIES']))
    with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as summary:
        summary.write('\nCache coverage\n\n| Cache | Result |\n| --- | --- |\n')
        summary.write('\n'.join(rows) + '\n')
        for warning in warnings:
            summary.write(f'\n⚠️ **{warning}**\n')
    for warning in warnings:
        print(f'::warning::{warning}', flush=True)


if __name__ == '__main__':
    main()
