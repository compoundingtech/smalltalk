for job in ("linux-tests", "linux-tests-shard-2", "linux-tests-shard-3", "linux-tests-shard-4"):
    assert 'CI_TEST_THREADS: "8"' in blocks[job], "bound each shard's test concurrency"
assert "vars.CI1_MIN_IDLE || '1'" in picker, "use an idle general slot without requiring the entire pool"

# Evaluate the generated runs-on expressions, not a second copy of the routing rule.
def route(job, event, profile='', picked='', merge_ci1='', merge_picked='', partial_primary='', partial_mail='', producer_mode='', producer_picked=''):
    expression = blocks[job].split('runs-on: ', 1)[1].splitlines()[0].strip().removeprefix('${{').removesuffix('}}').strip()
    expression = expression.replace('needs.pick-runner.outputs.ci1_build', repr(producer_picked))
    expression = expression.replace('vars.CI_MERGE_TEST_BUILD_OWNED', repr(producer_mode))
    expression = expression.replace('needs.pick-runner.outputs.merge_ci1', repr(merge_picked))
    expression = expression.replace('needs.pick-runner.outputs.merge_primary', repr(partial_primary))
    expression = expression.replace('needs.pick-runner.outputs.merge_mail', repr(partial_mail))
    expression = expression.replace('needs.pick-runner.outputs.ci1_profile', repr(merge_picked))
    expression = re.sub(r'needs\.pick-runner\.outputs\.ci1(?:_secondary|_mail)?', repr(picked), expression)
    expression = expression.replace('github.event_name', repr(event)).replace('github.run_id', '123').replace('vars.CI_MERGE_NAMESPACE_PROFILE', repr(profile)).replace('vars.CI_MERGE_CI1', repr(merge_ci1))
    return eval(expression.replace('&&', ' and ').replace('||', ' or '), {'__builtins__': {}}, {'fromJSON': json.loads, 'format': lambda template, *args: template.format(*args)})

for job in ('linux-test-build', 'linux-clippy', 'linux-fleet-compat', 'isolation-vm', 'linux-tests', 'linux-tests-shard-2', 'mail-redelivery-canaries'):
    for switch in ('', 'off', 'on'):
        for profile in ('', 'queue-reserved'):
            assert route(job, 'merge_group', profile, '["ci1-priority"]', merge_ci1=switch) == ['ci1-priority']
            assert route(job, 'merge_group', profile, '', merge_ci1=switch) == ['ci1-priority'], (job, 'merge must never overflow to Namespace')
    for event in ('pull_request', 'workflow_dispatch'):
        ordinary = route(job, event)
        assert ordinary == route(job, event, 'queue-reserved', merge_ci1='on'), (job, 'PRs cannot consume reserved profile')
        assert f"job.priority={2 if event == 'pull_request' else 3}" in ordinary[0], (job, 'ordinary fallback retains its queue class')
for n in (3,4):
    job = f'linux-tests-shard-{n}'
    assert f'CI_TEST_PARTITION: "hash:{n}/4"' in blocks[job]
    assert "github.event_name == 'merge_group'" in blocks[job]
    assert job in blocks['linux-gate']
    assert route(job,'merge_group',picked='["ci1-priority"]') == ['ci1-merge']
    assert route(job,'merge_group',picked='["namespace-profile-linux-x86-64;job.priority=1;github.run-id=123"]') == ['namespace-profile-linux-x86-64;job.priority=1;github.run-id=123']
# Execute the generated aggregate. Every merge shard must really pass; normal
# events must prove the two additional merge-only jobs were skipped.
gate_script = textwrap.dedent(blocks['linux-gate'].split('run: |\n',1)[1].split('\n      - ',1)[0])
# The per-stage skip flags the workflow computes when every covered stage's own rule says skip (build, tests, shard 2,
# clippy, fleet compat, then the two merge-only shards); scripts/ci-evidence-gate-test checks the flags against the rules.
COVERED_FLAGS='true false true true true true false true true'
def gate(event,base,extra,skip=None,flags=COVERED_FLAGS):
    env={**os.environ,'EVENT':event,'RESULTS':' '.join(base),'MERGE_RESULTS':' '.join(extra),'STAGE_SKIPS':flags}
    env.pop('GATE_SKIP',None)
    if skip is not None:
        env['GATE_SKIP']=skip
    return subprocess.run([bash,'-c',gate_script],env=env,capture_output=True).returncode
assert gate('merge_group',['success']*7,['success']*2) == 0
assert gate('pull_request',['success']*7,['skipped']*2) == 0
assert gate('workflow_dispatch',['success']*7,['skipped']*2) == 0
for i in range(9):
    for bad in ('failure','cancelled','skipped'):
        results=['success']*9;results[i]=bad
        assert gate('merge_group',results[:7],results[7:]) != 0,(i,bad)
assert gate('merge_group',['success']*6,['success']*2) != 0
assert gate('merge_group',['success']*7,['success']) != 0
assert gate('pull_request',['success']*7,['success']*2) != 0
print('passed: four merge shards preserve exact archive provenance, merge roles and strict event-qualified aggregation')

# Evidence skip: a stage the gate skipped at JOB level reports `skipped`. It is accepted only when this gate decided
# skip, only in the positions of those stages, and never for a failure or a cancellation. RESULTS is, in order:
# linux-test-build, upgrade-impact, linux-tests, linux-tests-shard-2, linux-clippy, linux-fleet-compat, canaries.
SKIPPABLE = (0, 2, 3, 4, 5)      # build, tests, shard 2, clippy, fleet compat (zero-based)
NEVER_SKIPPED = (1, 6)           # upgrade-impact and the canaries always run
covered = ['skipped', 'success', 'skipped', 'skipped', 'skipped', 'skipped', 'success']
for event in ('merge_group', 'pull_request', 'workflow_dispatch'):
    assert gate(event, covered, ['skipped'] * 2, skip='true') == 0, event
    assert gate(event, ['success'] * 7, ['skipped'] * 2, skip='true') == 0, event
    # Each stage on its own: skipped is accepted exactly where a job-level skip is possible.
    for i in range(7):
        results = ['success'] * 7
        results[i] = 'skipped'
        assert (gate(event, results, ['skipped'] * 2, skip='true') == 0) == (i in SKIPPABLE), (event, i)
        # ...and never without the gate's decision, whatever the value of the variable.
        for not_true in (None, '', 'false', 'True', '1', 'yes', 'true ', 'TRUE'):
            assert gate(event, results, ['skipped'] * 2, skip=not_true) != 0, (event, i, not_true)
    # Every uncovered-position skip is refused even when every other stage was legitimately skipped.
    for i in NEVER_SKIPPED:
        results = list(covered)
        results[i] = 'skipped'
        assert gate(event, results, ['skipped'] * 2, skip='true') != 0, (event, i)
for i in range(9):
    for bad in ('failure', 'cancelled'):
        results = ['skipped'] * 9
        results[i] = bad
        assert gate('merge_group', results[:7], results[7:], skip='true') != 0, (i, bad)
        results = ['success'] * 9
        results[i] = bad
        assert gate('merge_group', results[:7], results[7:], skip='true') != 0, (i, bad)
# The merge-only shards may be skipped under a skip (they are job-level skips too) but not otherwise.
assert gate('merge_group', covered, ['skipped', 'skipped'], skip='true') == 0
assert gate('merge_group', covered, ['skipped', 'skipped'], skip=None) != 0
assert gate('merge_group', ['skipped'] * 6, ['skipped'] * 2, skip='true') != 0   # a missing stage result still fails
assert gate('merge_group', covered, ['skipped'], skip='true') != 0
assert gate('pull_request', covered, ['success', 'skipped'], skip='true') != 0  # extra shards stay merge-only
print('passed: an evidence skip lets the aggregate accept skipped stages only when its own gate decided, never failures')

assert 'runs-on: ubuntu-latest' in (ROOT / '.github/workflows/public-repo.yml').read_text()
assert required_priority not in blocks['perf-cost'], 'optional cost must not join required PR priority'
assert "job.priority=${{ github.event_name == 'merge_group' && 1 || 3 }}" in blocks['perf-cost']
print('passed: release/merge precede PR checks, then optional/manual; reservations, shapes and affinity preserved')

# Exercise the actual generated step predicates, including restoring ordinary behavior.
cache_conditions = re.findall(
    r'name: (?:Keep valid same-source build outputs|Save Nix outputs[^\n]*)\n        if: ([^\n]+)', workflow)
assert cache_conditions, 'optional cache publication steps must remain present'
for raw in cache_conditions:
    condition = json.loads(raw) if raw.startswith('"') else raw
    assert 'vars.CI_OUTAGE_FAST_QUEUE' in condition, condition
    for event in ('merge_group', 'pull_request', 'push', 'schedule', 'workflow_dispatch'):
        for switch in ('', 'off', 'on'):
            for cancelled in (False, True):
                for succeeded in (False, True):
                    for local in ('', '1'):
                      # A check whose evidence gate decided to skip turns its cache steps off too; an ordinary
                      # run (no skip decision) must behave exactly as before.
                      for skip in ('', 'true'):
                        expression = condition
                        for token, value in {
                            '!cancelled()': not cancelled,
                            'success()': succeeded and not cancelled,
                            'github.event_name': event,
                            'vars.CI_OUTAGE_FAST_QUEUE': switch,
                            'env.CI_LOCAL_CACHES': local,
                            **{f'needs.evidence-gate-{gate}.outputs.skip': skip for gate in (
                                'genie-freshness', 'typescript-client', 'linux-gate', 'mail-redelivery-canaries', 'isolation-vm')},
                        }.items():
                            expression = expression.replace(token, repr(value))
                        expression = expression.replace('!(', 'not (')
                        actual = eval(expression.replace('&&', ' and ').replace('||', ' or '), {'__builtins__': {}})
                        expected = not cancelled and (event != 'merge_group' or switch != 'on')
                        if 'success()' in condition:
                            expected = expected and succeeded and local != '1'
                        if skip == 'true' and 'evidence-gate' in condition:
                            expected = False
                        assert actual == expected, (condition, event, switch, cancelled, succeeded, local, skip)
for job, block in blocks.items():
    assert 'CI_OUTAGE_FAST_QUEUE' not in block.split('    steps:', 1)[0], (job, 'outage switch must not skip jobs')
for step in ('Download this run attempt’s successful test build', 'Verify source, hashes and extract test archives',
             'Publish this run attempt’s exact-source test archives', 'Retain stage logs and timings', 'Report job cache coverage'):
    tails = workflow.split(f'name: {step}\n')[1:]
    assert tails, (step, 'artifact/evidence step must remain present')
    for tail in tails:
        assert 'CI_OUTAGE_FAST_QUEUE' not in tail.split('\n      - ', 1)[0], (step, 'required artifacts and evidence must remain available')
print('passed: outage merge-group cache saves skip only while enabled; ordinary events, guards and artifacts unchanged')
print("passed: bounded test shards, reserved primary lane, idle general slots, Namespace fallback, and required aggregation")

# A stage overflow must not route isolation-vm onto the non-KVM shape.
for job in ('linux-test-build','linux-clippy','linux-fleet-compat','linux-tests','linux-tests-shard-2','linux-tests-shard-3','linux-tests-shard-4','mail-redelivery-canaries'):
    assert route(job,'merge_group',picked=json.dumps(overflow_shape),merge_picked=json.dumps([overflow_profile])) == overflow_shape,job
assert route('isolation-vm','merge_group',picked=json.dumps(overflow_shape),merge_picked=json.dumps([overflow_profile])) == [overflow_profile]
nix=(ROOT/'.github/workflows/nix.yml').read_text()
assert '&& (false) }}' in nix and 'tags:' not in nix, 'optional Nix stays off merge-serving runners and release tags'
print('passed: stage overflow uses 8x16; only VM uses KVM profile; optional Nix off shared pool')

# Exercise the advisory reader's actual IO boundary with no network or credentials.
import runpy
from unittest.mock import patch
read_queues = runpy.run_path(str(ROOT / 'scripts/ci-pick-runner'))['queue_waits']
assert (ROOT/'scripts/ci-pick-runner').read_text() in script, 'generated picker must embed the exact reader source'
from datetime import datetime, timezone, timedelta
stamp = (datetime.now(timezone.utc)-timedelta(minutes=12)).isoformat()
run_row = dict(id=17,run_attempt=1,head_sha='current')
job_row = dict(id=18,run_attempt=1,head_sha='current',status='queued',created_at=stamp,labels=['ci1-priority'])
def queue_fixture(env=None, change=None, failure=None):
    calls=[]
    def io(argv, **kw):
        calls.append(argv[-1])
        assert kw['env']['GH_TOKEN']=='repo-reader', 'never use the org token to read repository queues'
        assert 0 < kw['timeout'] <= 8
        if failure: raise failure
        path=argv[-1]
        data=({'resources':{'core':{'remaining':900}}} if path=='rate_limit' else
              {'total_count':1,'workflow_runs':[run_row]} if 'status=queued' in path else
              {'total_count':0,'workflow_runs':[]} if 'status=in_progress' in path else
              {'total_count':1,'jobs':[dict(job_row)]})
        if change:data=change(path,data)
        return subprocess.CompletedProcess(argv,0,json.dumps(data),'')
    with patch('subprocess.run',side_effect=io):
        result=read_queues({'REPOSITORY':'example/project','GH_REPO_TOKEN':'repo-reader','GH_TOKEN':'org-reader',**(env or {})})
    return result,calls
result,calls=queue_fixture()
assert result[0]['owned']>=719 and result[0]['namespace']==0 and len(calls)==6
for error in (subprocess.TimeoutExpired('gh',1),OSError('unavailable'),ValueError('invalid')):
    assert queue_fixture(failure=error)[0][0] is None
for change in (
    lambda path,d: dict(d,total_count=2) if 'workflow_runs' in d else d,
    lambda path,d: dict(d,jobs=[dict(job_row,head_sha='changed')]) if 'jobs' in d else d,
    lambda path,d: dict(d,jobs=[dict(job_row,created_at='bad')]) if 'jobs' in d else d,
    lambda path,d: dict(d,jobs=[dict(job_row,labels=[None])]) if 'jobs' in d else d,
    lambda path,d: dict(d,total_count=25,workflow_runs=[dict(run_row,id=i) for i in range(25)]) if 'status=queued' in path else d,
):
    assert queue_fixture(change=change)[0][0] is None
for env in ({'GH_REPO_TOKEN':''},{'REPOSITORY':'../other'}):
    result,calls=queue_fixture(env=env);assert result[0] is None and calls==[]
result,calls=queue_fixture(change=lambda path,d:dict(d,jobs=[dict(job_row,labels=['namespace-profile-linux-x86-64;job.priority=2'])]) if 'jobs' in d else d)
assert result[0]['namespace']>=719 and result[0]['owned']==0
print('passed: advisory complete queue snapshot, provider waits, separate credential, timeout/malformed/changed/over-budget fail-open')

picker_main = runpy.run_path(str(ROOT/'scripts/ci-pick-runner'))['main']
def actual_admission(owned_age, namespace_age, event):
    with tempfile.TemporaryDirectory() as scratch:
        tmp=Path(scratch); out=tmp/'out'; summary=tmp/'summary'
        env={'EVENT':event,'REPOSITORY':'example/project','HEAD_REPOSITORY':'example/project',
             'OWNER':'example','GH_TOKEN':'org-reader','GH_REPO_TOKEN':'repo-reader',
             'GITHUB_OUTPUT':str(out),'GITHUB_STEP_SUMMARY':str(summary),'RUN_ID':'123',
             'MERGE_OVERFLOW':'on','MERGE_NEED':'3','NEED':'1','PR_LABELS':'[]'}
        now=datetime.now(timezone.utc)
        def io(argv,**kw):
            path=argv[-1]
            if path=='rate_limit':data={'resources':{'core':{'remaining':900}}}
            elif path.startswith('orgs/'):
                workers=[runner('ci1-priority') for _ in range(3)]+[runner('ci1')]
                data=[{'total_count':4,'runners':workers}]
            elif 'status=queued' in path:data={'total_count':1,'workflow_runs':[run_row]}
            elif 'status=in_progress' in path:data={'total_count':0,'workflow_runs':[]}
            else:
                jobs=[dict(job_row,id=i,created_at=(now-timedelta(seconds=age)).isoformat(),labels=[label])
                      for i,age,label in [(1,owned_age,'ci1-priority'),(2,namespace_age,'nscloud-ubuntu-24.04-amd64-8x16-with-features;job.priority=2')]]
                data={'total_count':2,'jobs':jobs}
            return subprocess.CompletedProcess(argv,0,json.dumps(data),'')
        with patch.dict(os.environ,env,clear=True),patch('subprocess.run',side_effect=io):picker_main()
        return {k:json.loads(v) for k,v in (line.split('=',1) for line in out.read_text().splitlines())}
assert actual_admission(1200,0,'merge_group')==overflow
assert actual_admission(0,1200,'merge_group')=={'ci1':['ci1-priority']}
assert actual_admission(1200,0,'pull_request')=={}
assert actual_admission(0,1200,'pull_request')=={'ci1':['ci1']}
print('passed: actual picker reverses merge/PR placement when measured queue direction flips, keeping reserved roles')

for quota in (299,0,None,True):
    result,calls=queue_fixture(change=lambda path,d: {'resources':{'core':{'remaining':quota}}} if path=='rate_limit' else d)
    assert result[0] is None and calls==['rate_limit'], 'low or invalid repo quota never spends queue requests'
seen_quota=[900,299]
def falling_quota(path,data):
    return {'resources':{'core':{'remaining':seen_quota.pop(0)}}} if path=='rate_limit' else data
result,calls=queue_fixture(change=falling_quota)
assert result[0] is None and len(calls)==3 and calls[-1]=='rate_limit', 'quota must be rechecked during the snapshot'
print('passed: reserve 300 repository requests; low/invalid/falling quota stops advisory reads without retry')

# Producer-only admission reads the SAME census, never adding a request or
# advertising a host without all six current records and an eligible idle role.
def producer_pages(ci1_busy=2, ci2_busy=4):
    rows = []
    for host, busy in [('ci1', ci1_busy), ('ci2', ci2_busy)]:
        for i in range(6):
            row = runner('ci1-priority', busy=i < busy)
            row['name'] = host+'-'+str(i+1) if i < 5 else host+'-merge-1'
            row['labels'].append({'name': 'ci-host-'+host})
            rows.append(row)
    return [{'total_count': len(rows), 'runners': rows}]

build_fallback = [overflow_profile]
def build_check(name, pages, build, **env):
    check(name, pages, {'ci1': ['ci1-priority'], 'ci1_build': build},
          EVENT='merge_group', MERGE_PRODUCER_OWNED='on', **env)

build_check('producer selects lightly loaded ci1 only', producer_pages(), ['ci-host-ci1', 'ci1-priority'])
build_check('producer selects eligible ci2 when ci1 busy', producer_pages(4, 2), ['ci-host-ci2', 'ci1-priority'])
build_check('producer admits exactly three busy', producer_pages(3, 4), ['ci-host-ci1', 'ci1-priority'])
build_check('producer does not admit four busy', producer_pages(4, 4), build_fallback)
for mutation in ('missing-member', 'offline-member', 'truncated', 'missing-host-label', 'invalid-busy', 'duplicate', 'no-idle-priority', 'one-idle-priority'):
    pages = producer_pages(2, 4); rows = pages[0]['runners']
    if mutation == 'missing-member': rows.pop(0); pages[0]['total_count'] -= 1
    elif mutation == 'offline-member': rows[0]['status'] = 'offline'
    elif mutation == 'truncated': pages[0]['total_count'] += 1
    elif mutation == 'missing-host-label':
        for row in rows[:6]: row['labels'] = [{'name': 'ci1-priority'}]
    elif mutation == 'invalid-busy': rows[0]['busy'] = None
    elif mutation == 'duplicate': rows.append(rows[0]); pages[0]['total_count'] += 1
    elif mutation in ('no-idle-priority', 'one-idle-priority'):
        start = 2 if mutation == 'no-idle-priority' else 3
        for row in rows[start:6]: row['labels'] = [{'name': 'ci-host-ci1'}]
    build_check('producer falls back on '+mutation, pages, build_fallback)
check('producer read failure falls back without changing other roles', [],
      {'ci1': ['ci1-priority'], 'ci1_build': build_fallback}, EVENT='merge_group', MERGE_PRODUCER_OWNED='on', API_EXIT='1')
check('producer missing token falls back without another request', [],
      {'ci1': ['ci1-priority'], 'ci1_build': build_fallback}, EVENT='merge_group', MERGE_PRODUCER_OWNED='on', GH_TOKEN='', api=False)
check('producer explicit off forces Namespace forward-only rollback', producer_pages(),
      {'ci1': ['ci1-priority'], 'ci1_build': build_fallback}, EVENT='merge_group', MERGE_PRODUCER_OWNED='off')
check('producer fallback preserves configured Namespace profile', producer_pages(4,4),
      {'ci1': ['ci1-priority'], 'ci1_build': ['namespace-profile-existing-custom;job.priority=1;github.run-id=123']}, EVENT='merge_group', MERGE_PRODUCER_OWNED='on', MERGE_NAMESPACE_PROFILE='existing-custom')
check('producer API failure preserves configured Namespace profile', [],
      {'ci1': ['ci1-priority'], 'ci1_build': ['namespace-profile-existing-custom;job.priority=1;github.run-id=123']}, EVENT='merge_group', MERGE_PRODUCER_OWNED='on', MERGE_NAMESPACE_PROFILE='existing-custom', API_EXIT='1')
check('producer off preserves configured Namespace profile', producer_pages(),
      {'ci1': ['ci1-priority'], 'ci1_build': ['namespace-profile-existing-custom;job.priority=1;github.run-id=123']}, EVENT='merge_group', MERGE_PRODUCER_OWNED='off', MERGE_NAMESPACE_PROFILE='existing-custom')
margin = producer_pages()
for row in margin[0]['runners'][4:6]: row['labels'] = [{'name': 'ci-host-ci1'}]
build_check('exactly two eligible idle workers meet margin', margin, ['ci-host-ci1', 'ci1-priority'])
check('producer flag unset is inert', producer_pages(), 'ci1-priority', EVENT='merge_group', MERGE_PRODUCER_OWNED='')
check('producer flag does not alter ordinary PRs', idle, 'ci1', MERGE_PRODUCER_OWNED='on')
check('producer flag does not alter releases', [], 'ci1-priority', EVENT='push', MODE='priority', MERGE_PRODUCER_OWNED='on')

