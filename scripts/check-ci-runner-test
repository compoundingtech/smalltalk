#!/usr/bin/env python3
"""Exercise the generated picker against a local GitHub API stand-in."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import textwrap
import itertools


ROOT = Path(__file__).resolve().parent.parent
workflow = (ROOT / ".github/workflows/fleet.yml").read_text()
picker = workflow.split("  pick-runner:\n", 1)[1].split("  namespace-capacity:\n", 1)[0]
assert "vars.CI1_RUNNERS == 'on'" in picker, "general PR picking remains opt-in"
# Read this generated YAML block scalar without adding a YAML dependency to the CI shell.
script = textwrap.dedent(picker.split("        run: |\n", 1)[1].split("\n      - ", 1)[0])
bash = shutil.which("bash")
assert bash, "runner selection tests require bash on PATH"


ids = itertools.count(1)

def runner(label="ci1", busy=False, status="online"):
    return {"id": next(ids), "status": status, "busy": busy, "labels": [{"name": label}]}


def check(name, pages, expected=None, api=True, **overrides):
    with tempfile.TemporaryDirectory() as scratch:
        tmp = Path(scratch)
        gh = tmp / "gh"
        gh.write_text(f"#!{bash}\necho called >> \"$API_CALLS\"\n"
                      "if [[ \"$*\" == *'/pulls/'* ]]; then printf '%s' \"$API_LABEL_RESPONSE\"; "
                      "else printf '%s' \"$API_RESPONSE\"; fi\nexit \"$API_EXIT\"\n")
        gh.chmod(0o755)
        output, summary, calls = (tmp / n for n in ("output", "summary", "calls"))
        output.touch()
        if isinstance(pages, list):
            total = sum(len(page.get('runners', [])) for page in pages if isinstance(page, dict))
            pages = [dict(page, total_count=total) if isinstance(page, dict) and 'total_count' not in page else page for page in pages]
        env = {
            **os.environ,
            "PATH": f"{tmp}:{os.environ['PATH']}",
            "GH_TOKEN": "stand-in",
            "EVENT": "pull_request",
            "REPOSITORY": "example/project",
            "HEAD_REPOSITORY": "example/project",
            "OWNER": "example",
            "PR_LABELS": "[]",
            "MERGE_LOCAL_ONLY": "on",
            "QUEUE_REF": "",
            "GH_REPO_TOKEN": "",
            "NEED": "1",
            "MERGE_OVERFLOW": "off",
            "MERGE_NEED": "3",
            "RUN_ID": "123",
            "GITHUB_OUTPUT": str(output),
            "GITHUB_STEP_SUMMARY": str(summary),
            "API_CALLS": str(calls),
            "API_RESPONSE": json.dumps(pages),
            "API_LABEL_RESPONSE": "[]",
            "API_EXIT": "0",
            **overrides,
        }
        result = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", script], env=env, capture_output=True, text=True)
        assert result.returncode == 0, (name, result.stdout, result.stderr)
        selected = {key: json.loads(value) for key, value in
                    (line.split('=', 1) for line in output.read_text().splitlines())}
        expected = expected if isinstance(expected, dict) else ({'ci1': [expected]} if expected else {})
        assert selected == expected, (name, selected, expected)
        if 'common pool group3:' in summary.read_text():
            assert 'common pool group3:' in result.stdout, (name, 'census must be retained in ordinary job logs')
        assert calls.exists() == api, (name, "unexpected API call")
        if api and overrides.get('MERGE_PRODUCER_OWNED'):
            assert len(calls.read_text().splitlines()) == 1, (name, 'producer must reuse one existing census read')
        assert (any("**" + label[0].split("-")[0] + "**" in summary.read_text() for label in expected.values()) if expected else "**Namespace**" in summary.read_text()), name
        print(f"passed: {name}")


idle = [{"runners": [runner()]}]
check("trusted PR with capacity", idle, "ci1")
check("main push with capacity", idle, "ci1", EVENT="push", HEAD_REPOSITORY="")
check("manual run with capacity", idle, "ci1", EVENT="workflow_dispatch")
check("fork with capacity cannot call the API", idle, api=False, HEAD_REPOSITORY="fork/project")
check("missing fork identity fails closed", idle, api=False, HEAD_REPOSITORY="")
check("missing token", idle, api=False, GH_TOKEN="")
check("busy and offline runners do not count", [{"runners": [runner(busy=True), runner(status="offline")]}])
check("three free slots serve both shards and canaries", [{"runners": [runner() for _ in range(3)] + [runner(busy=True), runner(status="offline")]}],
      {'ci1': ['ci1'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']})
check("merge-only runner excluded from PRs", [{"runners": [runner("ci1-merge")]}])
check("merge groups wait for their reserved pool", [], 'ci1-priority', EVENT='merge_group')
check("merge groups need no status token", [], 'ci1-priority', api=False, EVENT='merge_group', GH_TOKEN='')
check("runner list spans API pages", [{"runners": [runner(busy=True)]}, {"runners": [runner()]}], "ci1")
check("API failure falls back", idle, API_EXIT="1")
check("invalid API response falls back", idle, API_RESPONSE="not JSON")
check("zero minimum fails closed", idle, api=False, NEED="0")
check("invalid minimum fails closed", idle, api=False, NEED="invalid")

check("priority PR uses reserved capacity even while all ordinary runners are busy", [], "ci1-priority", PR_LABELS='["ci-priority"]')
check("priority PR needs no status token", [], "ci1-priority", PR_LABELS='["ci-priority"]', GH_TOKEN="", api=False)
check("priority cannot bypass the fork boundary", idle, PR_LABELS='["ci-priority"]', HEAD_REPOSITORY="fork/project", api=False)
check("unrelated labels preserve normal routing", idle, "ci1", PR_LABELS='["area:ci"]')
check("malformed labels preserve normal routing", idle, "ci1", PR_LABELS='invalid')

check("priority merge group cannot queue behind priority PRs", [], 'ci1-priority', EVENT='merge_group')
check("ordinary merge group retains reserved merge capacity", [], 'ci1-priority', EVENT='merge_group')
check("merge-label API failure retains reserved capacity", [], 'ci1-priority', EVENT='merge_group')
check("malformed queue ref never requests a PR", [], 'ci1-priority', EVENT='merge_group')

four = [{'runners': [runner() for _ in range(4)]}]
check("configured primary minimum permits all three jobs", four,
      {'ci1': ['ci1'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']}, NEED='4')
check("primary minimum does not strand three idle general runners", [{'runners': [runner() for _ in range(3)]}],
      {'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']}, NEED='4')
check("one extra slot serves second shard before canaries", idle, {'ci1_secondary': ['ci1']}, NEED='4')
check("one general slot cannot be promised to two jobs", [], 'ci1-priority', EVENT='merge_group')
check("two general slots let merge primary and secondary start", [], 'ci1-priority', EVENT='merge_group')
check("priority primary leaves general slots for extra tests", four,
      {'ci1': ['ci1-priority'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']}, PR_LABELS='["ci-priority"]', NEED='4')
check("reserved workers never count as extra general capacity", [{'runners': [runner('ci1-priority'), runner('ci1-merge')]}],
      'ci1-priority', PR_LABELS='["ci-priority"]')
check("status lookup failure preserves priority primary", four, 'ci1-priority', PR_LABELS='["ci-priority"]', API_EXIT='1')
check("invalid status response preserves merge primary", [], 'ci1-priority', EVENT='merge_group', API_RESPONSE='not JSON')

# A busy/missing/malformed census cannot spill merge work to Namespace.
for token, pages, response in [('', [], ''), ('fixture', [], 'not JSON'),
                               ('fixture', [{'runners': [runner(busy=True)]}], '')]:
    check('merge owns priority regardless of idle/API metadata', pages, 'ci1-priority',
          api=bool(token), EVENT='merge_group', GH_TOKEN=token, API_RESPONSE=response)

# Group 3 roles, not physical-host names, decide eligibility.
ci2_worker = runner('ci1'); ci2_worker['name'] = 'ci2-1'
check("idle ci2 uses common general role", [{'runners': [runner(busy=True), ci2_worker]}], 'ci1')
check("host-target label alone is not a pool role", [{'runners': [runner('ci-host-ci2')]}])
check("unmigrated ci2 labels do not pretend to be common capacity", [{'runners': [runner('ci2')]}])
check("both hosts supply distinct common slots", [{'runners': [runner(), ci2_worker, runner()]}],
      {'ci1': ['ci1'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']})
ci2_priority = runner('ci1-priority'); ci2_priority['name'] = 'ci2-5'
check("merge chooses the common priority role on either host", [{'runners': [ci2_priority]}],
      'ci1-priority', EVENT='merge_group')
check("release chooses the same common priority role", [{'runners': [ci2_priority]}],
      'ci1-priority', EVENT='push', MODE='priority')
overflow_profile = 'namespace-profile-linux-x86-64;job.priority=1;github.run-id=123'
overflow_shape = ['nscloud-ubuntu-24.04-amd64-8x16-with-features;job.priority=1', 'namespace-features:github.run-id=123']
overflow = {'ci1': overflow_shape, 'ci1_profile': [overflow_profile]}
check("saturated merge overflows on a positive census", [{'runners':[runner('ci1-priority',busy=True)]}],
      overflow, EVENT='merge_group',MERGE_OVERFLOW='on')
check("below initial three-job capacity overflows", [{'runners':[ci2_priority]}],
      overflow, EVENT='merge_group',MERGE_OVERFLOW='on')
check("three idle priority slots admit the owned merge", [{'runners':[runner('ci1-priority') for _ in range(3)]}],
      'ci1-priority',EVENT='merge_group',MERGE_OVERFLOW='on')
check("overflow requires a qualified census", [], 'ci1-priority',EVENT='merge_group',
      MERGE_OVERFLOW='on',API_RESPONSE='not JSON')
check("overflow cannot interpret missing token as saturation", [], 'ci1-priority',api=False,
      EVENT='merge_group',MERGE_OVERFLOW='on',GH_TOKEN='')
for field,value in [('busy',None),('busy',0),('status','unknown'),('id',0)]:
    row = runner('ci1-priority')
    row[field] = value
    check("unqualified fields cannot mean saturation", [{'runners':[row]}], 'ci1-priority',
          EVENT='merge_group',MERGE_OVERFLOW='on')
for values in [dict(MERGE_NEED='0'),dict(MERGE_NEED='x'),dict(RUN_ID=''),dict(RUN_ID='x')]:
    check("invalid overflow identity/minimum retains priority", [], 'ci1-priority',
          EVENT='merge_group',MERGE_OVERFLOW='on',**values)
check("overflow does not redirect a priority PR", [], 'ci1-priority',
      PR_LABELS='["ci-priority"]',MERGE_OVERFLOW='on')
check("overflow does not redirect a release", [], 'ci1-priority',
      EVENT='push',MODE='priority',MERGE_OVERFLOW='on')
dual = runner('ci1'); dual['labels'].append({'name': 'ci1-priority'})
check("priority dual-labelled worker cannot serve two jobs", [{'runners': [dual]}],
      'ci1-priority', PR_LABELS='["ci-priority"]')
check("duplicate pages do not create another slot", [{'runners': [dual]}, {'runners': [dual]}])
conflict = dict(dual, busy=True)
check("conflicting runner identity fails closed", [{'runners': [dual, conflict]}])
check("fork cannot use common pool metadata", [{'runners': [ci2_worker]}],
      api=False, HEAD_REPOSITORY='fork/project')

# Supporting PR jobs must never spend ordinary work on priority/merge capacity.
import re
blocks = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", workflow.split("\njobs:\n", 1)[1]))
required_priority = "github.event_name == 'merge_group' && 1 || github.event_name == 'pull_request' && 2 || 3"
for job in ("linux-clippy", "linux-fleet-compat", "isolation-vm", "perf-cost"):
    assert (job == "perf-cost" or "github.event_name == 'merge_group' && (needs.pick-runner.outputs.ci1" in blocks[job]), (job, "supporting merge job uses chosen priority pool")
    assert (required_priority if job != "perf-cost" else "github.event_name == 'merge_group' && 1 || 3") in blocks[job], (job, "merge precedes PR; optional cost stays separate")
    assert "github.run-id=" in blocks[job], (job, "prevent cross-run assignment")
    if job == 'isolation-vm':
        assert "namespace-profile-linux-x86-64;job.priority={1};github.run-id=" in blocks[job], (job, "profile controls must be inline")
        assert "namespace-features:" not in blocks[job], (job, "separate feature labels are unsupported with profiles")
    else:
        assert "namespace-features:github.run-id=" in blocks[job], (job, "shape labels need a separate features label")
for job in ('genie-freshness', 'typescript-client'):
    assert 'runs-on: ubuntu-latest' in blocks[job], (job, 'light checks must not consume reserved or Namespace capacity')
    assert 'namespace-profile-' not in blocks[job] and 'namespace-features:' not in blocks[job] and 'cargo-cache' not in blocks[job], job
    assert 'Keep valid same-source build outputs' not in blocks[job] and 'build-snapshot' not in blocks[job], job
for job, output in [('linux-tests-shard-2', 'ci1_secondary'), ('mail-redelivery-canaries', 'ci1_mail')]:
    assert f'outputs.{output}) ||' in blocks[job], (job, 'extra jobs need their own idle-slot output')
    assert "github.event_name != 'merge_group' && needs.pick-runner.outputs." + output in blocks[job], (job, 'PR extras must use their own distinct slot')
    assert 'job.priority={1}' in blocks[job] and 'github.run-id={0}' in blocks[job], (job, 'Namespace fallback must evaluate priority and run affinity')
    assert required_priority in blocks[job], job
assert "outputs.ci1" in blocks["linux-tests"], "primary shard must retain reserved routing"
canaries = blocks['mail-redelivery-canaries']
def needs_of(block):
    """Job names in `needs`, whatever layout the generator chose: one line, a list, or a bracketed block."""
    # Job-level keys sit at four spaces and may come before or after `steps` (a spread job puts them after).
    found = re.search(r'^    needs:(.*?)(?=^    \S|\Z)', block, re.M | re.S)
    return set(re.findall(r'[A-Za-z][A-Za-z0-9_-]*', found.group(1))) if found else set()
canary_needs = needs_of(canaries)
assert {'pick-runner', 'linux-test-build'} <= canary_needs and 'linux-tests' not in canary_needs, "canaries must run beside both test shards after the shared build"
assert 'scripts/ci-linux mail-redelivery-canaries' in canaries, "the required check must execute the canaries itself"
assert 'cargo-linux-tests-' in blocks['linux-test-build'], "producer must reuse protected-main test dependency caches"
for consumer in ('linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3', 'linux-tests-shard-4', 'mail-redelivery-canaries', 'isolation-vm'):
    assert 'cargo-cache' not in blocks[consumer] and 'Build selected test targets' not in blocks[consumer], (consumer, 'archive consumers must not restore/rebuild Cargo targets')
    assert 'needs.linux-test-build.outputs.artifact-id' in blocks[consumer], (consumer, 'artifact must come from its successful producer')
    assert 'needs.linux-test-build.outputs.manifest-sha256' in blocks[consumer], (consumer, 'manifest hash must come from its successful producer')
assert 'needs.linux-test-build.result' in blocks['linux-gate'], 'the gate must explicitly fail a failed producer'
for consumer in ('linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3', 'linux-tests-shard-4', 'mail-redelivery-canaries', 'isolation-vm'):
    assert 'Require the shared test producer to succeed' in blocks[consumer]
    assert 'PRODUCER_RESULT' in blocks[consumer] and 'shared test producer failed or was skipped' in blocks[consumer]
    assert 'CI_TEST_ARCHIVE_PRODUCER_ATTEMPT' in blocks[consumer]
    assert 'python3 scripts/ci-test-archive download' in blocks[consumer], 'consumers must wait for the complete verified producer ZIP'
    assert 'GH_TOKEN: ${{ github.token }}' in blocks[consumer], 'download uses the existing read-only job token'
    assert 'CI_TEST_ARCHIVE_ARTIFACT_ID' in blocks[consumer]
    assert 'actions/download-artifact@' not in blocks[consumer], 'do not stream unverified files into the consumer directory'
assert 'ST_ISOLATION_BUILD_WORKSPACE' in blocks['isolation-vm']
assert 'Keep valid same-source build outputs' in blocks['linux-test-build'], 'shared producer must retain its build snapshot'
assert 'CI_TEST_PARTITION' not in canaries, "every required canary must run"
assert 'mail_redelivery' not in blocks['linux-tests'] and 'scripts/ci-mail-redelivery-canaries' not in blocks['linux-tests'], "canaries cannot serialize the primary shard"
assert 'needs.mail-redelivery-canaries.result' in blocks['linux-gate'], "failures and skips must still fail the Linux gate"
assert "job.priority={1}" in blocks["linux-tests"] and "github.run-id={0}" in blocks["linux-tests"], "event priority and evaluated run id in Namespace fallback"
performance = (ROOT / ".github/workflows/perf.yml").read_text()
assert "nscloud-ubuntu-24.04-amd64-8x16-with-features;job.priority=3" in performance
assert "github.run-id=" in performance
for path in ("main-upkeep.yml",):
    generated = (ROOT / ".github/workflows" / path).read_text()
    assert ";job.priority=${{ github.event_name == 'merge_group' && 1 || 3 }}" in generated, (path, "non-merge Linux work keeps the second class")
    assert "github.run-id=" in generated, (path, "avoid nondeterministic runner pickup")
    assert ";job.priority=10" not in generated, path
for path in ("public-repo.yml", "release-daily.yml", "release-smalltalk.yml", "macos.yml"):
    generated = (ROOT / ".github/workflows" / path).read_text()
    assert all("namespace-features:" not in line for line in generated.splitlines() if line.lstrip().startswith(("runs-on:", "runner:"))), (path, "profile routing must use inline controls")
release = (ROOT / ".github/workflows/release-smalltalk.yml").read_text()
assert "github.event_name != 'pull_request' && (needs['pick-runner'].outputs.ci1" in release
assert 'runner: macos-15' in release and 'namespace-profile-linux-x86-64;job.priority=2;github.run-id=${{ github.run_id }}' in release
assert 'namespace-profile-macos' not in release, 'native Mac releases must not depend on saturated Namespace'
assert 'ubuntu-latest' in release, 'installer checks and assembly stay off compiler capacity'
release_blocks = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", release.split("\njobs:\n", 1)[1]))
for job in ('assemble', 'publish'):
    assert 'runs-on: ubuntu-latest' in release_blocks[job], (job, 'artifact verification must not wait for a compiler runner')
assert 'runs-on: ubuntu-latest' in (ROOT / '.github/workflows/release-daily.yml').read_text()
assert "linux-tests-shard-2" in blocks["linux-gate"], "both shards must be required"
