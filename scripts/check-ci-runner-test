#!/usr/bin/env python3
"""Exercise the generated picker against a local GitHub API stand-in."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import textwrap


ROOT = Path(__file__).resolve().parent.parent
workflow = (ROOT / ".github/workflows/fleet.yml").read_text()
picker = workflow.split("  pick-runner:\n", 1)[1].split("  namespace-capacity:\n", 1)[0]
assert "if: vars.CI1_RUNNERS == 'on'" in picker, "ci1 must ship disabled"
# Read this generated YAML block scalar without adding a YAML dependency to the CI shell.
script = textwrap.dedent(picker.split("        run: |\n", 1)[1].split("\n      - ", 1)[0])
bash = shutil.which("bash")
assert bash, "runner selection tests require bash on PATH"


def runner(label="ci1", busy=False, status="online"):
    return {"status": status, "busy": busy, "labels": [{"name": label}]}


def check(name, pages, expected=None, api=True, **overrides):
    with tempfile.TemporaryDirectory() as scratch:
        tmp = Path(scratch)
        gh = tmp / "gh"
        gh.write_text(f"#!{bash}\necho called >> \"$API_CALLS\"\n"
                      "if [[ \"$*\" == *'/pulls/'* ]]; then printf '%s' \"$API_LABEL_RESPONSE\"; "
                      "else printf '%s' \"$API_RESPONSE\"; fi\nexit \"$API_EXIT\"\n")
        gh.chmod(0o755)
        output, summary, calls = (tmp / n for n in ("output", "summary", "calls"))
        output.touch()
        env = {
            **os.environ,
            "PATH": f"{tmp}:{os.environ['PATH']}",
            "GH_TOKEN": "stand-in",
            "EVENT": "pull_request",
            "REPOSITORY": "example/project",
            "HEAD_REPOSITORY": "example/project",
            "OWNER": "example",
            "PR_LABELS": "[]",
            "QUEUE_REF": "",
            "GH_REPO_TOKEN": "",
            "NEED": "1",
            "GITHUB_OUTPUT": str(output),
            "GITHUB_STEP_SUMMARY": str(summary),
            "API_CALLS": str(calls),
            "API_RESPONSE": json.dumps(pages),
            "API_LABEL_RESPONSE": "[]",
            "API_EXIT": "0",
            **overrides,
        }
        result = subprocess.run(["bash", "-e", "-o", "pipefail", "-c", script], env=env, capture_output=True, text=True)
        assert result.returncode == 0, (name, result.stdout, result.stderr)
        selected = {key: json.loads(value) for key, value in
                    (line.split('=', 1) for line in output.read_text().splitlines())}
        expected = expected if isinstance(expected, dict) else ({'ci1': [expected]} if expected else {})
        assert selected == expected, (name, selected, expected)
        assert calls.exists() == api, (name, "unexpected API call")
        assert ("**ci1**" if expected else "**Namespace**") in summary.read_text(), name
        print(f"passed: {name}")


idle = [{"runners": [runner()]}]
check("trusted PR with capacity", idle, "ci1")
check("main push with capacity", idle, "ci1", EVENT="push", HEAD_REPOSITORY="")
check("manual run with capacity", idle, "ci1", EVENT="workflow_dispatch")
check("fork with capacity cannot call the API", idle, api=False, HEAD_REPOSITORY="fork/project")
check("missing fork identity fails closed", idle, api=False, HEAD_REPOSITORY="")
check("missing token", idle, api=False, GH_TOKEN="")
check("busy and offline runners do not count", [{"runners": [runner(busy=True), runner(status="offline")]}])
check("three free slots serve both shards and canaries", [{"runners": [runner() for _ in range(3)] + [runner(busy=True), runner(status="offline")]}],
      {'ci1': ['ci1'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']})
check("merge-only runner excluded from PRs", [{"runners": [runner("ci1-merge")]}])
check("merge groups wait for their reserved pool", [{"runners": [runner("ci1-merge", busy=True)]}], "ci1-merge", EVENT="merge_group")
check("merge groups need no status token", [], "ci1-merge", EVENT="merge_group", GH_TOKEN="", api=False)
check("runner list spans API pages", [{"runners": [runner(busy=True)]}, {"runners": [runner()]}], "ci1")
check("API failure falls back", idle, API_EXIT="1")
check("invalid API response falls back", idle, API_RESPONSE="not JSON")
check("zero minimum fails closed", idle, api=False, NEED="0")
check("invalid minimum fails closed", idle, api=False, NEED="invalid")

check("priority PR uses reserved capacity even while all ordinary runners are busy", [], "ci1-priority", PR_LABELS='["ci-priority"]')
check("priority PR needs no status token", [], "ci1-priority", PR_LABELS='["ci-priority"]', GH_TOKEN="", api=False)
check("priority cannot bypass the fork boundary", idle, PR_LABELS='["ci-priority"]', HEAD_REPOSITORY="fork/project", api=False)
check("unrelated labels preserve normal routing", idle, "ci1", PR_LABELS='["area:ci"]')
check("malformed labels preserve normal routing", idle, "ci1", PR_LABELS='invalid')

check("priority merge group cannot queue behind priority PRs", [], "ci1-merge", EVENT="merge_group", GH_REPO_TOKEN="stand-in", QUEUE_REF="refs/heads/gh-readonly-queue/main/pr-42-" + "a"*40, API_LABEL_RESPONSE='["ci-priority"]')
check("ordinary merge group retains reserved merge capacity", [], "ci1-merge", EVENT="merge_group", GH_REPO_TOKEN="stand-in", QUEUE_REF="refs/heads/gh-readonly-queue/main/pr-42-" + "a"*40, API_LABEL_RESPONSE='["area:ci"]')
check("merge-label API failure retains reserved capacity", [], "ci1-merge", EVENT="merge_group", GH_REPO_TOKEN="stand-in", QUEUE_REF="refs/heads/gh-readonly-queue/main/pr-42-" + "a"*40, API_EXIT="1")
check("malformed queue ref never requests a PR", [], "ci1-merge", EVENT="merge_group", GH_REPO_TOKEN="stand-in", QUEUE_REF="refs/heads/unrelated")

four = [{'runners': [runner() for _ in range(4)]}]
check("configured primary minimum permits all three jobs", four,
      {'ci1': ['ci1'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']}, NEED='4')
check("primary minimum does not strand three idle general runners", [{'runners': [runner() for _ in range(3)]}],
      {'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']}, NEED='4')
check("one extra slot serves second shard before canaries", idle, {'ci1_secondary': ['ci1']}, NEED='4')
check("one general slot cannot be promised to two jobs", idle, "ci1-merge", EVENT='merge_group', NEED='4')
check("two general slots let merge primary and secondary start", [{'runners': [runner(), runner()]}],
      {'ci1': ['ci1-merge'], 'ci1_secondary': ['ci1']}, EVENT='merge_group', NEED='4')
check("priority primary leaves general slots for extra tests", four,
      {'ci1': ['ci1-priority'], 'ci1_secondary': ['ci1'], 'ci1_mail': ['ci1']}, PR_LABELS='["ci-priority"]', NEED='4')
check("reserved workers never count as extra general capacity", [{'runners': [runner('ci1-priority'), runner('ci1-merge')]}],
      'ci1-priority', PR_LABELS='["ci-priority"]')
check("status lookup failure preserves priority primary", four, 'ci1-priority', PR_LABELS='["ci-priority"]', API_EXIT='1')
check("invalid status response preserves merge primary", four, 'ci1-merge', EVENT='merge_group', API_RESPONSE='not JSON')

# Supporting PR jobs must never spend ordinary work on priority/merge capacity.
import re
blocks = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", workflow.split("\njobs:\n", 1)[1]))
for job in ("linux-clippy", "linux-fleet-compat", "genie-freshness", "typescript-client", "isolation-vm", "perf-cost"):
    assert "outputs.ci1" not in blocks[job], (job, "supporting job consumes reserved cores")
    assert "github.event_name == 'merge_group' && 1 || 2" in blocks[job], (job, "merge groups must precede queued PRs")
    assert "github.run-id=" in blocks[job], (job, "prevent cross-run assignment")
    if job in ("genie-freshness", "typescript-client", "isolation-vm"):
        assert "namespace-profile-linux-x86-64;job.priority={1};github.run-id=" in blocks[job], (job, "profile controls must be inline")
        assert "namespace-features:" not in blocks[job], (job, "separate feature labels are unsupported with profiles")
    else:
        assert "namespace-features:github.run-id=" in blocks[job], (job, "shape labels need a separate features label")
for job, output in [('linux-tests-shard-2', 'ci1_secondary'), ('mail-redelivery-canaries', 'ci1_mail')]:
    assert f'outputs.{output} ||' in blocks[job], (job, 'extra jobs need their own idle-slot output')
    assert not re.search(r'outputs\.ci1\b', blocks[job]), (job, 'extra jobs must never take the primary reserved lane')
    assert 'job.priority={1}' in blocks[job] and 'github.run-id={0}' in blocks[job], (job, 'Namespace fallback must evaluate priority and run affinity')
    assert "github.event_name == 'merge_group' && 1 || 2" in blocks[job], job
assert "outputs.ci1" in blocks["linux-tests"], "primary shard must retain reserved routing"
canaries = blocks['mail-redelivery-canaries']
assert 'needs: [pick-runner, linux-test-build]' in canaries and 'needs: [linux-tests]' not in canaries, "canaries must run beside both test shards after the shared build"
assert 'scripts/ci-linux mail-redelivery-canaries' in canaries, "the required check must execute the canaries itself"
assert 'cargo-linux-tests-' in blocks['linux-test-build'], "producer must reuse protected-main test dependency caches"
for consumer in ('linux-tests', 'linux-tests-shard-2', 'mail-redelivery-canaries', 'isolation-vm'):
    assert 'cargo-cache' not in blocks[consumer] and 'Build selected test targets' not in blocks[consumer], (consumer, 'archive consumers must not restore/rebuild Cargo targets')
    assert 'needs.linux-test-build.outputs.artifact-id' in blocks[consumer], (consumer, 'artifact must come from its successful producer')
    assert 'needs.linux-test-build.outputs.manifest-sha256' in blocks[consumer], (consumer, 'manifest hash must come from its successful producer')
assert 'needs.linux-test-build.result' in blocks['linux-gate'], 'the gate must explicitly fail a failed producer'
for consumer in ('linux-tests', 'linux-tests-shard-2', 'mail-redelivery-canaries', 'isolation-vm'):
    assert 'Require the shared test producer to succeed' in blocks[consumer]
    assert 'PRODUCER_RESULT' in blocks[consumer] and 'shared test producer failed or was skipped' in blocks[consumer]
    assert 'CI_TEST_ARCHIVE_PRODUCER_ATTEMPT' in blocks[consumer]
    assert 'merge-multiple: true' in blocks[consumer], 'exact artifact ID must extract directly into the archive directory'
assert 'ST_ISOLATION_BUILD_WORKSPACE' in blocks['isolation-vm']
assert 'Keep valid same-source build outputs' in blocks['linux-test-build'], 'shared producer must retain its build snapshot'
assert 'CI_TEST_PARTITION' not in canaries, "every required canary must run"
assert 'mail_redelivery' not in blocks['linux-tests'] and 'scripts/ci-mail-redelivery-canaries' not in blocks['linux-tests'], "canaries cannot serialize the primary shard"
assert 'needs.mail-redelivery-canaries.result' in blocks['linux-gate'], "failures and skips must still fail the Linux gate"
assert "job.priority={1}" in blocks["linux-tests"] and "github.run-id={0}" in blocks["linux-tests"], "event priority and evaluated run id in Namespace fallback"
for path in ("perf.yml", "main-upkeep.yml", "public-repo.yml", "release-daily.yml", "release-portable.yml", "release-smalltalk.yml"):
    generated = (ROOT / ".github/workflows" / path).read_text()
    assert ";job.priority=${{ github.event_name == 'merge_group' && 1 || 2 }}" in generated, (path, "non-merge Linux work keeps the second class")
    assert "github.run-id=" in generated, (path, "avoid nondeterministic runner pickup")
    assert ";job.priority=10" not in generated, path
for path in ("public-repo.yml", "release-daily.yml", "release-portable.yml", "release-smalltalk.yml", "macos.yml"):
    generated = (ROOT / ".github/workflows" / path).read_text()
    assert "namespace-features:" not in generated, (path, "profile workflows must use inline controls")
release = (ROOT / ".github/workflows/release-smalltalk.yml").read_text()
assert "${{ matrix.runner }};github.run-id=${{ github.run_id }}" in release, "both release profile matrix entries need evaluated inline affinity"
assert "linux-tests-shard-2" in blocks["linux-gate"], "both shards must be required"
assert 'CI_TEST_PARTITION: "hash:1/2"' in blocks["linux-tests"]
assert 'CI_TEST_PARTITION: "hash:2/2"' in blocks["linux-tests-shard-2"]
for job in ("linux-tests", "linux-tests-shard-2"):
    assert 'CI_TEST_THREADS: "8"' in blocks[job], "bound each shard's test concurrency"
assert "vars.CI1_MIN_IDLE || '1'" in picker, "use an idle general slot without requiring the entire pool"

# Evaluate the generated runs-on expressions, not a second copy of the routing rule.
def route(job, event, profile='', picked='', merge_ci1=''):
    expression = blocks[job].split('runs-on: ', 1)[1].splitlines()[0].strip().removeprefix('${{').removesuffix('}}').strip()
    expression = re.sub(r'needs\.pick-runner\.outputs\.ci1(?:_secondary|_mail)?', repr(picked), expression)
    expression = expression.replace('github.event_name', repr(event)).replace('github.run_id', '123').replace('vars.CI_MERGE_NAMESPACE_PROFILE', repr(profile)).replace('vars.CI_MERGE_CI1', repr(merge_ci1))
    return eval(expression.replace('&&', ' and ').replace('||', ' or '), {'__builtins__': {}}, {'fromJSON': json.loads, 'format': lambda template, *args: template.format(*args)})

for job in ('linux-test-build', 'linux-clippy', 'linux-fleet-compat', 'genie-freshness', 'typescript-client', 'isolation-vm', 'linux-tests', 'linux-tests-shard-2', 'mail-redelivery-canaries'):
    assert route(job, 'merge_group', merge_ci1='on') == ['ci1-merge'], job
    assert route(job, 'merge_group', 'queue-reserved', '["ci1"]', merge_ci1='on') == ['ci1-merge'], (job, 'configured reservation overrides picked general slots')
    assert route(job, 'merge_group', 'queue-reserved') == ['namespace-profile-queue-reserved;job.priority=1;github.run-id=123'], job
    merge_fallback = route(job, 'merge_group')
    assert 'job.priority=1' in merge_fallback[0] and any('github.run-id=123' in label for label in merge_fallback), job
    for event in ('pull_request', 'workflow_dispatch'):
        ordinary = route(job, event)
        assert ordinary == route(job, event, 'queue-reserved', merge_ci1='on'), (job, 'PRs cannot consume reserved profile')
        assert 'job.priority=2' in ordinary[0], (job, 'queued PRs follow merge groups')
    if job in ('linux-test-build', 'linux-tests', 'linux-tests-shard-2', 'mail-redelivery-canaries'):
        assert route(job, 'merge_group', 'queue-reserved', '["ci1-merge"]') == ['ci1-merge'], (job, 'retain picked ci1 lane')
print('passed: all merge jobs use provisioned ci1 or Namespace reserve; PRs cannot; unset switches preserve shapes and affinity')

# Exercise the actual generated step predicates, including restoring ordinary behavior.
cache_conditions = re.findall(
    r'name: (?:Keep valid same-source build outputs|Save Nix outputs[^\n]*)\n        if: ([^\n]+)', workflow)
assert cache_conditions, 'optional cache publication steps must remain present'
for raw in cache_conditions:
    condition = json.loads(raw) if raw.startswith('"') else raw
    assert 'vars.CI_OUTAGE_FAST_QUEUE' in condition, condition
    for event in ('merge_group', 'pull_request', 'push', 'schedule', 'workflow_dispatch'):
        for switch in ('', 'off', 'on'):
            for cancelled in (False, True):
                for succeeded in (False, True):
                    for local in ('', '1'):
                        expression = condition
                        for token, value in {
                            '!cancelled()': not cancelled,
                            'success()': succeeded and not cancelled,
                            'github.event_name': event,
                            'vars.CI_OUTAGE_FAST_QUEUE': switch,
                            'env.CI_LOCAL_CACHES': local,
                        }.items():
                            expression = expression.replace(token, repr(value))
                        actual = eval(expression.replace('&&', ' and ').replace('||', ' or '), {'__builtins__': {}})
                        expected = not cancelled and (event != 'merge_group' or switch != 'on')
                        if 'success()' in condition:
                            expected = expected and succeeded and local != '1'
                        assert actual == expected, (condition, event, switch, cancelled, succeeded, local)
for job, block in blocks.items():
    assert 'CI_OUTAGE_FAST_QUEUE' not in block.split('    steps:', 1)[0], (job, 'outage switch must not skip jobs')
for step in ('Download this run attempt’s successful test build', 'Verify source, hashes and extract test archives',
             'Publish this run attempt’s exact-source test archives', 'Retain stage logs and timings', 'Report job cache coverage'):
    tails = workflow.split(f'name: {step}\n')[1:]
    assert tails, (step, 'artifact/evidence step must remain present')
    for tail in tails:
        assert 'CI_OUTAGE_FAST_QUEUE' not in tail.split('\n      - ', 1)[0], (step, 'required artifacts and evidence must remain available')
print('passed: outage merge-group cache saves skip only while enabled; ordinary events, guards and artifacts unchanged')
print("passed: bounded test shards, reserved primary lane, idle general slots, Namespace fallback, and required aggregation")
