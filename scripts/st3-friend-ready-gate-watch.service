[Unit]
Description=Check retained st3 friend-ready release gates
After=st3.service st3-idle-soak.service st3-message-soak.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/st3/message-soak.env
EnvironmentFile=%h/.config/st3/friend-ready-gates.env
ExecStart=/usr/bin/bash %h/.local/bin/st3-friend-ready-gate-watch
TimeoutStartSec=600
