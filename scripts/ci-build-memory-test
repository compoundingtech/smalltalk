#!/usr/bin/env python3
"""Synthetic cgroup counter controls; no host reads or compilation."""
import runpy
import contextlib
import io
import json
from pathlib import Path
import unittest
import tempfile
from unittest.mock import patch

module = runpy.run_path(str(Path(__file__).with_name('ci-build-memory')))
delta = module['delta']


def group(identity=(1, 2), events='oom 3\noom_kill 1\n'):
    return {'groups': [{'path': '/fixture', 'identity': list(identity),
                        'values': {'memory.events': events, 'memory.events.local': events}}]}


class Controls(unittest.TestCase):
    def test_success_after_preserves_observed_kill_and_unknown_baseline(self):
        main = module['main']
        for baseline in (group(), None):
            with self.subTest(baseline=baseline), tempfile.TemporaryDirectory() as temporary:
                directory = Path(temporary) / 'ci-build-memory'
                directory.mkdir()
                if baseline is not None:
                    (directory / 'before.json').write_text(json.dumps(baseline))
                after = group(events='oom 5\noom_kill 2\n')
                after['build_step_outcome'] = 'success'
                with patch('sys.argv', ['ci-build-memory', 'after']), \
                     patch.dict('os.environ', RUNNER_TEMP=temporary, BUILD_STEP_OUTCOME='success'), \
                     patch.dict(main.__globals__, snapshot=lambda: after), \
                     contextlib.redirect_stdout(io.StringIO()):
                    main()
                receipt = json.loads((directory / 'after.json').read_text())
                self.assertEqual(receipt['build_step_outcome'], 'success')
                if baseline is None:
                    self.assertEqual(receipt['deltas'], 'UNKNOWN: baseline unavailable')
                else:
                    self.assertEqual(receipt['deltas'][0]['events_delta']['memory.events']['oom_kill'], 1)

    def test_cumulative_oom_does_not_become_new_oom(self):
        self.assertEqual(delta(group(), group())[0]['events_delta']['memory.events']['oom_kill'], 0)

    def test_interval_delta(self):
        self.assertEqual(delta(group(), group(events='oom 5\noom_kill 2\n'))[0]['events_delta']['memory.events'],
                         {'oom': 2, 'oom_kill': 1})

    def test_recreated_cgroup_unknown(self):
        self.assertIsInstance(delta(group(), group(identity=(1, 3)))[0]['events_delta'], str)

    def test_reset_unknown(self):
        self.assertIsInstance(delta(group(), group(events='oom 1\noom_kill 0\n'))[0]['events_delta']['memory.events'], str)

    def test_missing_baseline_unknown(self):
        self.assertIsInstance(delta({}, group())[0]['events_delta'], str)

    def test_requester_and_visible_ancestor_mapping(self):
        snapshot = module['snapshot']
        with tempfile.TemporaryDirectory() as temporary:
            base = Path(temporary)
            (base / 'job').mkdir()
            original = module['read']
            def fixture_read(path, limit=8192):
                if str(path) == '/proc/self/cgroup':
                    return '0::/job\n'
                if str(path) == '/proc/self/mountinfo':
                    return f'1 0 0:1 / {base} rw - cgroup2 cgroup rw\n'
                return original(path, limit)
            with patch.dict(snapshot.__globals__, read=fixture_read):
                self.assertEqual([g['path'] for g in snapshot()['groups']], [str(base / 'job'), str(base)])

    def test_unreadable_counters_unknown(self):
        self.assertIsInstance(delta(group(), group(events='UNKNOWN: FileNotFoundError'))[0]['events_delta']['memory.events'], str)


if __name__ == '__main__':
    unittest.main()
