#!/usr/bin/env bash
set -Eeuo pipefail

: "${ST3_BIN:?set ST3_BIN to the installed st3 executable}"
: "${ST_AGENT:?set ST_AGENT to the standing st3 operator identity}"
: "${ST3_FRIEND_READY_AUDIT_WORKSPACE:?set the Hetz st3 checkout in the host-local gate environment}"
: "${ST3_FRIEND_READY_IDLE_START_UNIX:?set the idle window start}"
: "${ST3_FRIEND_READY_MESSAGE_START_UNIX:?set the delivery window start}"
for start in "$ST3_FRIEND_READY_IDLE_START_UNIX" "$ST3_FRIEND_READY_MESSAGE_START_UNIX"; do
  [[ $start =~ ^[0-9]+$ ]] || { echo 'invalid gate window start' >&2; exit 2; }
done

mission=mission/fleet/st3/friend-ready-final-audit-20260925
run_id="friend-ready-final-audit-$ST3_FRIEND_READY_IDLE_START_UNIX-$ST3_FRIEND_READY_MESSAGE_START_UNIX"
run="mission-run/$run_id"

[[ -d $ST3_FRIEND_READY_AUDIT_WORKSPACE ]] || {
  echo 'friend-ready audit workspace is unavailable' >&2
  exit 1
}

if /usr/bin/timeout -k 5s 30s "$ST3_BIN" missions show "$run" --json >/dev/null 2>&1; then
  /usr/bin/printf 'friend-ready audit run already exists: %s\n' "$run"
  exit 0
fi

if /usr/bin/timeout -k 5s 30s "$ST3_BIN" missions start "$mission" \
  --id "$run_id" --workspace "$ST3_FRIEND_READY_AUDIT_WORKSPACE" \
  --as "$ST_AGENT" --json >/dev/null; then
  if /usr/bin/timeout -k 5s 30s "$ST3_BIN" missions show "$run" --json >/dev/null 2>&1; then
    /usr/bin/printf 'friend-ready audit run started: %s\n' "$run"
    exit 0
  fi
fi

# A lost client response may follow a durable start. An exact read distinguishes
# that from a real failure; the next timer run retries only if the run is absent.
if /usr/bin/timeout -k 5s 30s "$ST3_BIN" missions show "$run" --json >/dev/null 2>&1; then
  /usr/bin/printf 'friend-ready audit run exists after ambiguous start: %s\n' "$run"
  exit 0
fi
echo 'friend-ready audit run could not be started' >&2
exit 1
