#!/usr/bin/env python3
"""Select the current workspace tests without requiring the retired runner package."""
import argparse
import json
from pathlib import Path
import subprocess


def selection(metadata):
    members = set(metadata['workspace_members'])
    legacy = [package for package in metadata['packages']
              if package['id'] in members and package['name'] == 'st2']
    if not legacy:
        return 'all()'
    if len(legacy) != 1:
        raise ValueError('one legacy runner workspace member is required')
    retained = ('integration', 'agent_resource', 'driver_expansion')
    targets = {target['name'] for target in legacy[0]['targets'] if target['kind'] == ['test']}
    if not set(retained) <= targets:
        raise ValueError('the legacy runner is missing a retained integration target')
    binaries = ' or '.join(f'binary(={name})' for name in retained)
    return f'not package(=st2) or (kind(test) and ({binaries}))'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--metadata', type=Path)
    args = parser.parse_args()
    if args.metadata:
        metadata = json.loads(args.metadata.read_text())
    else:
        metadata = json.loads(subprocess.check_output(
            ['cargo', 'metadata', '--locked', '--no-deps', '--format-version', '1'], text=True))
    print(selection(metadata))


if __name__ == '__main__':
    main()
