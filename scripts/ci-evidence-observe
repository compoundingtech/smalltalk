#!/usr/bin/env python3
"""Turn a finished Workspace CI run into signed evidence notes, then publish them.

Runs in the `Evidence observe` workflow on the signing runners, never on a pull request's
code. It does not run any check: it asks the protected observer (`st3 evidence observe-ci`,
behind a sekrets grant) to record what the run already did, imports the returned object
pack into a scratch repository, verifies every full-trust record with scripts/evidence-verify
against the accepted key list, and only then creates and pushes refs/notes/evidence/<id>.

  exit 0  every record was imported (full records verified; degraded ones labelled as such),
          or the run was cancelled/skipped and has nothing to attest
  exit 1  a produced record did not verify, or the observer, import or push failed
  exit 2  usage error
"""
import argparse
import base64
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True

NOTES = 'refs/notes/evidence/'
OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
DEFAULT_OBSERVER = ['st', 'sekrets', '--', 'st3', 'evidence', 'observe-ci']


class Failure(Exception):
    pass


def run(command, **kwargs):
    kwargs.setdefault('capture_output', True)
    kwargs.setdefault('timeout', 600)
    done = subprocess.run(command, **kwargs)
    if done.returncode != 0:
        text = (done.stderr or b'').decode(errors='replace').strip()
        raise Failure(f'{command[0]} {command[1] if len(command) > 1 else ""} failed ({done.returncode}): {text[-2000:]}')
    return done.stdout


def git(repo, *args, stdin=None, check=True):
    env = dict(os.environ, GIT_NO_REPLACE_OBJECTS='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C')
    done = subprocess.run(['git', '-C', str(repo), *args], input=stdin, capture_output=True, env=env, timeout=300)
    if check and done.returncode != 0:
        raise Failure(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-2000:]}')
    return done


def source_artifact(repository, run_id, attempt):
    """The one retained-source artifact of this attempt, from authenticated GitHub metadata."""
    listing = json.loads(run(['gh', 'api', f'repos/{repository}/actions/runs/{run_id}/artifacts?per_page=100']))
    name = f'ci-evidence-source-{attempt}'
    found = [a for a in listing.get('artifacts', []) if a.get('name') == name and not a.get('expired')]
    if len(found) != 1:
        raise Failure(f'expected exactly one live artifact {name}, found {len(found)}')
    return int(found[0]['id'])


class Cancelled(Exception):
    """The run was cancelled: it has no linux-gate result to attest, which is not a failure."""


def run_conclusion(repository, run_id, attempt):
    done = subprocess.run(['gh', 'api', f'repos/{repository}/actions/runs/{run_id}/attempts/{attempt}'],
                          capture_output=True, timeout=120)
    try:
        return json.loads(done.stdout).get('conclusion') if done.returncode == 0 else None
    except ValueError:
        return None


def observe(argv, repository, run_id, attempt, artifact):
    """Run the observer; its answer is about 20 MB (a base64 object pack), so it goes to a file."""
    command = [*argv, '--run', str(run_id), '--attempt', str(attempt), '--artifact', str(artifact)]
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        done = subprocess.run(command, stdout=out, stderr=err, timeout=600)
        if done.returncode != 0:
            err.seek(0)
            text = err.read().decode(errors='replace').strip()[-2000:]
            if run_conclusion(repository, run_id, attempt) in ('cancelled', 'skipped'):
                raise Cancelled(text)
            raise Failure(f'{command[0]} failed ({done.returncode}): {text}')
        out.seek(0)
        try:
            return json.load(out)
        except ValueError as error:
            raise Failure(f'observer printed no JSON document: {error}')


def statement(repo, record):
    tree = git(repo, 'ls-tree', '-r', record).stdout.decode().split()
    if len(tree) != 4 or tree[0] != '100644' or tree[1] != 'blob':
        raise Failure(f'record {record} is not a single-note commit')
    return json.loads(git(repo, 'cat-file', 'blob', tree[2]).stdout)


def import_pack(repo, encoded):
    git(repo, 'init', '--quiet', '--bare', '--object-format=sha1', check=False)
    pack = base64.b64decode(encoded, validate=True)
    git(repo, 'index-pack', '--stdin', stdin=pack)


def verify_full(verifier, repo, tree, check, keys):
    command = [sys.executable, verifier, '--repo', str(repo), '--tree', tree, '--check', check, *keys]
    done = subprocess.run(command, capture_output=True, timeout=120)
    try:
        answer = json.loads(done.stdout)
    except ValueError:
        answer = {'reason': 'unreadable verifier output'}
    if done.returncode != 0 or not answer.get('satisfied'):
        raise Failure(f'record for {check} on {tree} did not verify: {answer.get("reason", "unknown")}')
    return answer


def token_env(token):
    """git configuration for the token through the environment, so no process listing shows it."""
    if not token:
        return {}
    header = base64.b64encode(f'x-access-token:{token}'.encode()).decode()
    return {'GIT_CONFIG_COUNT': '1', 'GIT_CONFIG_KEY_0': 'http.extraheader', 'GIT_CONFIG_VALUE_0': f'Authorization: Basic {header}'}


def fetch_parents(repo, remote, token, sources):
    """Make the sources' missing parents available to the scratch repository.

    They are fetched into a sibling history repository that only ever holds fetched history, and
    the scratch repository borrows its objects (alternates). Fetching straight into the scratch
    repository fails once any ref there names a commit whose parents are absent: the fetch's
    connectivity check walks every ref. That is exactly the state a scratch repository is in after
    a run without --remote, or after any earlier import.
    """
    repo = Path(repo)
    history = repo.with_name(repo.name + '-history')
    parents = set()
    for source in sources:
        header = git(repo, 'cat-file', 'commit', source).stdout.decode().split('\n\n', 1)[0]
        wanted = [line.split()[1] for line in header.splitlines() if line.startswith('parent ')]
        parents.update(p for p in wanted if git(repo, 'cat-file', '-e', p, check=False).returncode != 0)
    if not parents:
        return
    if not history.exists():
        subprocess.run(['git', 'init', '--quiet', '--bare', str(history)], check=True)
    done = subprocess.run(['git', '-C', str(history), 'fetch', '--quiet', '--no-tags', remote, *sorted(parents)],
                          capture_output=True, timeout=1800, env=dict(os.environ, GIT_TERMINAL_PROMPT='0', **token_env(token)))
    if done.returncode != 0:
        text = done.stderr.decode(errors='replace')
        if token:
            text = text.replace(token, '***')
        raise Failure(f'fetching the source\'s history failed: {text.strip()[-2000:]}')
    alternates = repo / 'objects/info/alternates'
    line = str(history / 'objects') + '\n'
    existing = alternates.read_text() if alternates.exists() else ''
    if line not in existing:
        alternates.parent.mkdir(parents=True, exist_ok=True)
        alternates.write_text(existing + line)


def publish(repo, remote, token, refs):
    def remote_git(*args):
        done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, timeout=1800,
                              env=dict(os.environ, GIT_TERMINAL_PROMPT='0', **token_env(token)))
        if done.returncode != 0:
            text = done.stderr.decode(errors='replace')
            if token:
                text = text.replace(token, '***')
            raise Failure(f'git {args[0]} against the remote failed: {text.strip()[-2000:]}')

    remote_git('push', '--quiet', remote, *[f'{ref}:{ref}' for ref, _, _ in refs])


def push_token():
    """The workflow's token, else the operator's own GitHub login (never printed)."""
    token = os.environ.get('EVIDENCE_PUSH_TOKEN') or os.environ.get('GH_TOKEN')
    if token:
        return token
    done = subprocess.run(['gh', 'auth', 'token'], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ''


OBSERVED_WORKFLOW = 'Workspace CI'
SKIP_STEP = 'evidence skip taken'
COVERED_STEP = 'evidence covered by a trusted note'


def run_info(repository, run_id):
    done = subprocess.run(['gh', 'api', f'repos/{repository}/actions/runs/{run_id}'], capture_output=True, timeout=120)
    try:
        return json.loads(done.stdout)
    except ValueError:
        raise Failure(f'cannot read run {run_id} of {repository} from GitHub')


def latest_attempt(repository, run_id):
    try:
        return int(run_info(repository, run_id)['run_attempt'])
    except (KeyError, TypeError, ValueError, Failure):
        raise SystemExit(f'cannot read run {run_id} of {repository} from GitHub')


def skip_taken_checks(repository, run_id, attempt):
    """Checks whose evidence-gate job ended with the step `evidence skip taken`.

    Such a job concludes success without having run its check. A note for that check would let one
    real run refresh its own skips forever, so the controller never records it. If the jobs cannot
    be read, nothing is recorded (fail closed).
    """
    skipped, page = set(), 1
    while True:
        done = subprocess.run(['gh', 'api', f'repos/{repository}/actions/runs/{run_id}/attempts/{attempt}/jobs?per_page=100&page={page}'],
                              capture_output=True, timeout=120)
        try:
            jobs = json.loads(done.stdout)['jobs']
        except (ValueError, KeyError, TypeError):
            raise Failure(f'cannot read the jobs of run {run_id} attempt {attempt}, so skips cannot be ruled out')
        for job in jobs:
            name = job.get('name', '')
            ran = {step.get('name') for step in job.get('steps', []) if step.get('conclusion') == 'success'}
            # Two independent signals. The gate job's marker, and the check's own job, which ran the
            # `covered` step only when it skipped its work. Either one is enough.
            if name.startswith('evidence-gate-') and SKIP_STEP in ran:
                skipped.add(name[len('evidence-gate-'):])
            if COVERED_STEP in ran:
                skipped.add(name)
        if len(jobs) < 100:
            return skipped
        page += 1


MAX_TRIES = 3


def poll(args):
    """Observe each recent finished merge-group run once; a run that keeps failing is given up on.

    State is one JSON line per (run, attempt) in STATE_DIR/observed.jsonl: `done` after an exit
    of 0, `failed` otherwise; after MAX_TRIES failures it is `gave_up` and reported, never retried
    silently forever (loop protection, as for the CI producer).
    """
    ledger = Path(args.state_dir) / 'observed.jsonl'
    seen = {}
    if ledger.exists():
        for line in ledger.read_text().splitlines():
            entry = json.loads(line)
            key = (entry['run'], entry['attempt'])
            seen[key] = (entry['state'], entry.get('tries', 0))
    listing = subprocess.run(
        ['gh', 'run', 'list', '--repo', args.repository, '--workflow', 'Workspace CI', '--event', 'merge_group',
         '--status', 'completed', '--limit', str(args.limit), '--json', 'databaseId,conclusion,attempt'],
        capture_output=True, timeout=120)
    if listing.returncode != 0:
        print(json.dumps({'failures': ['cannot list runs: ' + listing.stderr.decode(errors='replace')[-300:]]}))
        return 1
    status = 0
    for item in sorted(json.loads(listing.stdout), key=lambda r: r['databaseId']):
        run_id, attempt = item['databaseId'], item.get('attempt') or 1
        state, tries = seen.get((run_id, attempt), ('new', 0))
        if state in ('done', 'gave_up') or item.get('conclusion') in ('cancelled', 'skipped'):
            continue
        summary = one_run(args, run_id, attempt)
        failed = bool(summary.get('failures'))
        new_state = 'done' if not failed else ('gave_up' if tries + 1 >= MAX_TRIES else 'failed')
        with ledger.open('a') as stream:
            stream.write(json.dumps({'run': run_id, 'attempt': attempt, 'state': new_state, 'tries': tries + (1 if failed else 0),
                                     'records': [r['record'] for r in summary['records']]}) + '\n')
        print(json.dumps({'run': run_id, 'attempt': attempt, 'state': new_state,
                          'records': len(summary['records']), 'failures': summary.get('failures', [])}))
        status |= 1 if failed else 0
    return status


def one_run(args, run, attempt):
    summary = {'repository': args.repository, 'run': run, 'attempt': attempt, 'records': []}
    try:
        observer = json.loads(args.observer)
        if not (isinstance(observer, list) and observer and all(isinstance(a, str) for a in observer)):
            raise Failure('--observer must be a JSON array of strings')
        info = run_info(args.repository, run)
        if info.get('name') != OBSERVED_WORKFLOW:
            raise Failure(f'run {run} is a run of {info.get("name")!r}, not {OBSERVED_WORKFLOW!r}: never acting on any other workflow, this one included')
        skipped = skip_taken_checks(args.repository, run, attempt)
        artifact = args.artifact or source_artifact(args.repository, run, attempt)
        response = observe(observer, args.repository, run, attempt, artifact)
        for key, expected in (('repository', args.repository), ('run', run), ('attempt', attempt)):
            if response.get(key) != expected:
                raise Failure(f'observer answered for {key} {response.get(key)!r}, not {expected!r}')
        scratch = Path(args.scratch or (Path(args.state_dir) / 'scratch.git'))
        scratch.mkdir(parents=True, exist_ok=True)
        import_pack(scratch, response['object_pack_base64'])
        if args.remote:
            fetch_parents(scratch, args.remote, push_token(),
                          {statement(scratch, r['record'])['subject'][0]['name'] for r in response['records']})
        keys_file = []

        def keys():
            # The accepted key list comes from the checkout's own history (the default branch),
            # never from the scratch repository or the change under test.
            if args.keys:
                return ['--keys', args.keys]
            if not keys_file:
                found = subprocess.run(['git', '-C', args.checkout, 'show', f'{args.keys_from}:.st/evidence-keys'], capture_output=True)
                if found.returncode != 0:
                    raise Failure(f'no key list: {args.keys_from}:.st/evidence-keys is missing, so full records cannot be verified')
                handle = tempfile.NamedTemporaryFile('wb', prefix='evidence-keys-', delete=False)
                handle.write(found.stdout)
                handle.close()
                keys_file.append(handle.name)
            return ['--keys', keys_file[0]]

        refs, failures = [], []
        for produced in response['records']:
            record = produced['record']
            if not OID.match(record):
                raise Failure('observer returned a malformed record id')
            tier = produced['tier']
            body = statement(scratch, record)
            tree = body['subject'][0]['digest']['gitTree']
            source = body['subject'][0]['name']
            checks = sorted(body['predicate']['observed'].get('checks', {}))
            if skipped & set(checks):
                summary.setdefault('skip_taken', []).append({'record': record, 'checks': sorted(skipped & set(checks))})
                continue
            entry = {'record': record, 'tier': tier, 'checks': checks, 'tree': tree,
                     'verified': False, 'newly_recorded': bool(produced.get('newly_recorded'))}
            summary['records'].append(entry)
            if tier == 'full':
                try:
                    for check in checks:
                        verify_full(args.verifier, scratch, tree, check, keys())
                    entry['verified'] = True
                except Failure as error:
                    entry['error'] = str(error)
                    failures.append(str(error))
                    continue
            elif tier != 'degraded':
                failures.append(f'record {record} has unexpected tier {tier!r}; not published')
                entry['error'] = failures[-1]
                continue
            ref = NOTES + record
            existing = git(scratch, 'for-each-ref', '--format=%(objectname)', ref).stdout.decode().strip()
            if existing and existing != record:
                failures.append(f'{ref} already names {existing}; evidence refs are never replaced')
                entry['error'] = failures[-1]
                continue
            if not existing:
                git(scratch, 'update-ref', ref, record, '0' * len(record))
            refs.append((ref, record, source))
        if args.remote and refs:
            publish(scratch, args.remote, push_token(), refs)
        summary['metrics'] = response.get('metrics', {})
        summary['full_trust_eligible'] = response.get('full_trust_eligible')
        summary['trust_limitation'] = response.get('trust_limitation')
        summary['published'] = len(refs) if args.remote else 0
        if failures:
            summary['failures'] = failures
    except Cancelled as note:
        summary['nothing_to_attest'] = f'run {run} attempt {attempt} was cancelled or skipped: {note}'
    except (Failure, KeyError, ValueError, OSError, subprocess.TimeoutExpired) as error:
        summary['failures'] = [str(error)]
    write_summary(summary)
    return summary




def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--repository', default=os.environ.get('GITHUB_REPOSITORY') or 'compoundingtech/smalltalk')
    parser.add_argument('--run', type=int, help='observe this one finished Workspace CI run')
    parser.add_argument('--attempt', type=int, help='default: the run\'s latest attempt')
    parser.add_argument('--poll', action='store_true',
                        help='observe every recently finished merge-group Workspace CI run not yet done (for a timer)')
    parser.add_argument('--limit', type=int, default=20, help='with --poll: how many recent runs to look at')
    parser.add_argument('--artifact', type=int, help='default: look up this attempt\'s source artifact')
    parser.add_argument('--observer', default=os.environ.get('EVIDENCE_OBSERVER') or json.dumps(DEFAULT_OBSERVER),
                        help='JSON argument vector of the observer (default: $EVIDENCE_OBSERVER, else sekrets)')
    parser.add_argument('--checkout', default='.', help='a checkout of the default branch holding .st/evidence-keys')
    parser.add_argument('--keys', help='allowed-signers file (default: --keys-from in --checkout)')
    parser.add_argument('--keys-from', default='HEAD', help='commit in --checkout holding .st/evidence-keys')
    parser.add_argument('--verifier', default=str(Path(__file__).resolve().parent / 'evidence-verify'))
    parser.add_argument('--state-dir', default=os.environ.get('EVIDENCE_OBSERVE_STATE')
                        or str(Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'evidence-observe'),
                        help='scratch repository and the list of runs already observed')
    parser.add_argument('--scratch', help='scratch repository (default: STATE_DIR/scratch.git)')
    parser.add_argument('--remote', help='push the verified refs here (default: none)')
    parser.add_argument('--publish', action='store_true', help='push to https://github.com/REPOSITORY.git')
    args = parser.parse_args(argv)
    if args.publish and not args.remote:
        args.remote = f'https://github.com/{args.repository}.git'
    if bool(args.run) == args.poll:
        parser.error('give exactly one of --run RUN or --poll')
    Path(args.state_dir).mkdir(parents=True, exist_ok=True)

    if args.run:
        attempt = args.attempt or latest_attempt(args.repository, args.run)
        summary = one_run(args, args.run, attempt)
        print(json.dumps(summary, indent=2))
        return 1 if summary.get('failures') else 0
    return poll(args)


def write_summary(summary):
    path = os.environ.get('GITHUB_STEP_SUMMARY')
    if not path:
        return
    lines = [f'### Evidence observation of run {summary["run"]} attempt {summary["attempt"]}']
    for entry in summary['records']:
        state = 'verified' if entry['verified'] else ('unsigned, not verified' if entry['tier'] == 'degraded' else 'NOT VERIFIED')
        lines.append(f'- `{", ".join(entry["checks"])}` {entry["tier"]} {state}: `{entry["record"]}`')
    metrics = summary.get('metrics', {})
    if metrics:
        lines.append(f'- fresh {metrics.get("fresh_records")}, full {metrics.get("full_records")}, '
                     f'signing latency {metrics.get("signing_latency_ms")} ms')
    if summary.get('trust_limitation'):
        lines.append(f'- trust limitation: {summary["trust_limitation"]}')
    for taken in summary.get('skip_taken', []):
        lines.append(f'- not recorded, the evidence gate skipped it in this run: `{", ".join(taken["checks"])}` (`{taken["record"]}`)')
    if summary.get('nothing_to_attest'):
        lines.append(f'- nothing to attest: {summary["nothing_to_attest"]}')
    for failure in summary.get('failures', []):
        lines.append(f'- **failure:** {failure}')
    with open(path, 'a') as stream:
        stream.write('\n'.join(lines) + '\n')


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
