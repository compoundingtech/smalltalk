#!/usr/bin/env python3
"""Name the risky classes a change belongs to (.st/risky-classes.json).

  classify-risk BASE HEAD     classes hit by git diff BASE...HEAD, with the paths or lines that hit

Prints JSON: {"full": true|false, "classes": [{"name", "forces", "paths": [...], "lines": [...]}]}.
"""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys
sys.dont_write_bytecode = True

RULES = ".st/risky-classes.json"


def glob_regex(glob):
    out, index = [], 0
    while index < len(glob):
        if glob.startswith("**/", index):
            out.append("(?:.*/)?")
            index += 3
        elif glob.startswith("**", index):
            out.append(".*")
            index += 2
        elif glob[index] == "*":
            out.append("[^/]*")
            index += 1
        elif glob[index] == "?":
            out.append("[^/]")
            index += 1
        else:
            out.append(re.escape(glob[index]))
            index += 1
    return re.compile("".join(out) + r"\Z")


def matches(globs, path):
    return any(glob_regex(glob).match(path) for glob in globs)


def classify(rules, paths, diff_lines):
    """diff_lines maps a path to its added and removed lines."""
    hits = []
    for rule in rules["classes"]:
        by_path = sorted(path for path in paths if matches(rule["globs"], path))
        by_line = []
        for content in rule.get("content", []):
            pattern = re.compile(content["pattern"])
            for path in sorted(paths):
                if matches(content["globs"], path):
                    by_line += [f"{path}: {line.strip()}" for line in diff_lines.get(path, []) if pattern.search(line)]
        if by_path or by_line:
            hits.append({"name": rule["name"], "forces": rule.get("forces", []), "paths": by_path, "lines": by_line[:20]})
    return hits


def read_diff(repo, base, head):
    names = subprocess.check_output(["git", "diff", "--name-only", f"{base}...{head}"], cwd=repo, text=True).split("\n")
    paths = [name for name in names if name]
    text = subprocess.check_output(["git", "diff", "-U0", "--no-color", f"{base}...{head}"], cwd=repo, text=True, errors="replace")
    lines, current = {}, None
    for line in text.split("\n"):
        if line.startswith("+++ b/"):
            current = line[6:]
        elif line.startswith("--- a/"):
            current = current or line[6:]
        elif current and line[:1] in "+-" and not line.startswith(("+++", "---")):
            lines.setdefault(current, []).append(line[1:])
    return paths, lines


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("base")
    parser.add_argument("head")
    parser.add_argument("--repo", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    rules = json.loads((args.repo / RULES).read_text())
    if rules.get("version") != 1:
        raise SystemExit(f"{RULES}: unsupported version")
    paths, lines = read_diff(args.repo, args.base, args.head)
    hits = classify(rules, paths, lines)
    print(json.dumps({"full": bool(hits), "classes": hits}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
