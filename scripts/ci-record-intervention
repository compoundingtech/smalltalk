#!/usr/bin/env python3
"""Measurement-only driver: unchanged load tests, three frozen binaries, one runner."""
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import time

HEADS = {'api': '566bb042188feb9d87c4f0c720b1bcc7dca858ea', 'existing': '55ce61bed9e84266b76591a1d3bec8dd10768b1a', 'candidate': '345416ca4d1ad7fe69cb71b2a15a03023d83409c'}
BASELINES = [37276978494, 37273736714, 37265290064, 37257137831, 37256435588]
MEASURED_TRIPLES = 6
ORDERS = [
    ['api', 'existing', 'candidate'],  # predeclared warmup triple
    ['api', 'existing', 'candidate'],
    ['candidate', 'existing', 'api'],
    ['existing', 'api', 'candidate'],
    ['candidate', 'api', 'existing'],
    ['api', 'candidate', 'existing'],
    ['existing', 'candidate', 'api'],
]
workspace = pathlib.Path(os.environ['GITHUB_WORKSPACE'])
temporary = pathlib.Path(os.environ['RUNNER_TEMP'])
output = temporary / 'perf'
output.mkdir(exist_ok=True)


def write(name, value):
    (output / name).write_text(json.dumps(value, indent=2) + '\n')


def digest(path):
    hasher = hashlib.sha256()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b''):
            hasher.update(chunk)
    return hasher.hexdigest()


def git(*arguments, cwd=workspace):
    return subprocess.check_output(['git', *arguments], cwd=cwd, text=True).strip()


def machine():
    return {
        'affinity': sorted(os.sched_getaffinity(0)),
        'loadavg': pathlib.Path('/proc/loadavg').read_text().strip(),
        'cpu_stat': pathlib.Path('/proc/stat').read_text().splitlines()[0],
        'monotonic': time.monotonic(),
    }


fixture = temporary / 'st-bench'
fixture_files = sorted(path for path in fixture.iterdir() if path.is_file())
assert (fixture / 'generated-1.sqlite3').exists()
assert (fixture / 'generated-1-peer.sqlite3').exists()
fixture_hashes = {path.name: digest(path) for path in fixture_files}
baseline = temporary / 'perf-baseline'
assert {path.name for path in baseline.glob('load-*.json')} == {
    f'load-{run}.json' for run in BASELINES
}
baseline_hashes = {path.name: digest(path) for path in sorted(baseline.glob('load-*.json'))}
assert not git('status', '--porcelain')
plan = {
    'runtime_heads': HEADS,
    'warmup_triples': 1,
    'measured_triples': MEASURED_TRIPLES,
    'order': ORDERS,
    'interventions': 'fresh exact API; API plus exact existing record patch; same parent plus single-pass generated claim spans',
    'fixture_run': 37281901496,
    'fixture_artifact': 11333545011,
    'fixture_sha256': 'e31918ae968d5f101a4ab317fabbb1909a516d13b0f85b2d3d7d4edd9c3b4489',
    'fixture_file_sha256': fixture_hashes,
    'baseline_runs': BASELINES,
    'baseline_file_sha256': baseline_hashes,
    'assertions_and_budgets_unchanged': True,
    'profiling_disabled': True,
    'candidate_core_tests_required_before_timing': True,
    'prior_cohorts_not_pooled': True,
    'workload_seconds': 120,
    'workload_scale': 1,
    'runner': machine(),
}
write('intervention-plan.json', plan)

# All three builds finish before timing starts. Shared dependency cache is only a build
# input; each executable is copied and hashed before the other source is built.
executables = {}
for side, head in HEADS.items():
    present = subprocess.run(['git', 'cat-file', '-e', head + '^{commit}'], cwd=workspace,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if present.returncode:
        subprocess.run(['git', 'fetch', '--no-tags', 'origin', head], cwd=workspace, check=True)
    source = temporary / ('record-paired-source-' + side)
    subprocess.run(['git', 'worktree', 'add', '--detach', str(source), head], cwd=workspace, check=True)
    assert git('rev-parse', 'HEAD', cwd=source) == head
    assert not git('status', '--porcelain', cwd=source)
    write(side + '-source.json', {
        'head': head,
        'tree': git('rev-parse', 'HEAD^{tree}', cwd=source),
        'tracked_files': git('ls-files', '-s', cwd=source).splitlines(),
        'daemon_load_sha256': digest(source / 'crates/st3/tests/daemon_load.rs'),
        'daemon_bench_sha256': digest(source / 'crates/st3/tests/daemon_bench.rs'),
    })
    environment = os.environ.copy()
    environment.update(CARGO_TARGET_DIR=str(workspace / 'target'), CARGO_BUILD_JOBS='3', AGENT_SPEC_REVISION=head)
    if side == 'candidate':
        # Correctness is a prerequisite. Failure retains the log and stops before timing.
        with (output / 'candidate-core-tests.log').open('w') as log:
            validation = subprocess.run(['cargo', 'test', '-p', 'smallclaims', '--locked',
                                         '--', '--nocapture'], cwd=source, env=environment,
                                        stdout=log, stderr=subprocess.STDOUT)
        write('candidate-core-validation.json', {
            'head': head, 'exit_code': validation.returncode,
            'test_log_sha256': digest(output / 'candidate-core-tests.log'),
            'required_before_any_timing': True,
        })
        if validation.returncode:
            raise RuntimeError('Candidate core/wire/span/raw tests failed; no timings accepted')
    command = ['cargo', 'test', '--release', '-p', 'st3', '--features', 'perf-load', '--test',
               'perf_load', '--locked', '--no-run', '--message-format=json']
    with (output / (side + '-build.jsonl')).open('w') as stdout, (output / (side + '-build.log')).open('w') as stderr:
        build = subprocess.run(command, cwd=source, env=environment, stdout=stdout, stderr=stderr)
    if build.returncode:
        raise RuntimeError(f'{side} build failed; see retained build log')
    artifacts = []
    for line in (output / (side + '-build.jsonl')).read_text().splitlines():
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if (message.get('reason') == 'compiler-artifact'
                and message.get('target', {}).get('name') == 'perf_load'
                and message.get('executable')):
            artifacts.append(pathlib.Path(message['executable']))
    assert len(artifacts) == 1, artifacts
    frozen = output / (side + '-perf-load')
    shutil.copy2(artifacts[0], frozen)
    linked = subprocess.run(['ldd', str(frozen)], capture_output=True, text=True)
    (output / (side + '-linked-libraries.txt')).write_text(linked.stdout + linked.stderr)
    if 'not found' in linked.stdout:
        raise RuntimeError(f'{side} frozen binary has an unavailable library')
    assert not git('status', '--porcelain', cwd=source)
    executables[side] = {'head': head, 'path': str(frozen), 'sha256': digest(frozen)}
    write('frozen-binaries.json', executables)
workload_hashes = {
    name: {json.loads((output / (side + '-source.json')).read_text())[name] for side in HEADS}
    for name in ['daemon_load_sha256', 'daemon_bench_sha256']
}
assert all(len(values) == 1 for values in workload_hashes.values())
for name, before, after in [('existing-record', HEADS['api'], HEADS['existing']),
                            ('single-pass', HEADS['existing'], HEADS['candidate'])]:
    (output / (name + '-source.diff')).write_text(git('diff', before, after))
assert set(git('diff', '--name-only', HEADS['existing'], HEADS['candidate']).splitlines()) == {
    'crates/smallclaims/src/store.rs', 'crates/smallclaims/src/store/record_offsets.rs',
    'crates/smallclaims/src/store/record_offsets/encoding.rs',
}
assert len({value['sha256'] for value in executables.values()}) == 3
subprocess.run(['sccache', '--stop-server'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

samples = []
for round_index, order in enumerate(ORDERS):
    for side in order:
        executable = executables[side]
        assert digest(pathlib.Path(executable['path'])) == executable['sha256']
        directory = output / f'round-{round_index}-{side}'
        directory.mkdir()
        report = directory / 'load.json'
        environment = os.environ.copy()
        for key in list(environment):
            if key.startswith('ST3_PROFILE_'):
                environment.pop(key)
        environment.update(ST_LOAD_GATE='1', ST_LOAD_SCALE='1', ST_LOAD_SECONDS='120',
                           ST_LOAD_REPORT=str(report), ST_LOAD_BASELINE=str(baseline),
                           ST_BENCH_DIR=str(fixture), TMPDIR=str(temporary))
        before = machine()
        with (directory / 'load.log').open('w') as log:
            trial = subprocess.run([executable['path'], 'daemon_load::', '--nocapture'],
                                   cwd=workspace, env=environment, stdout=log, stderr=subprocess.STDOUT)
        after = machine()
        if not report.exists():
            write('incomplete-trial.json', {'round': round_index, 'side': side, 'exit_code': trial.returncode})
            raise RuntimeError('No load report; stop and retain setup/workload failure')
        result = json.loads(report.read_text())
        assert result['scale'] == 1 and result['claims'] == 238794
        assert result['seconds'] >= 120 and result['long_poll_seats'] == 30
        row = {'round': round_index, 'side': side, 'warmup': round_index == 0, 'source_head': executable['head'],
               'binary_sha256': executable['sha256'], 'exit_code': trial.returncode,
               'before': before, 'after': after, 'report': result}
        samples.append(row)
        write('intervention-samples.json', samples)
        print(json.dumps({'round': round_index, 'side': side, 'warmup': round_index == 0,
                          'exit_code': trial.returncode, 'daemon_cores': result['daemon_cores'],
                          'claims': result['claims']}), flush=True)

assert {path.name: digest(path) for path in fixture_files} == fixture_hashes
assert {path.name: digest(path) for path in sorted(baseline.glob('load-*.json'))} == baseline_hashes
write('intervention-summary.json', {
    'plan': plan,
    'executables': executables,
    'samples': samples,
    'fixture_and_baseline_bytes_unchanged': True,
    'all_predeclared_samples_retained': True,
    'historical_gate_failures': sum(row['exit_code'] != 0 for row in samples),
})
with pathlib.Path(os.environ['GITHUB_STEP_SUMMARY']).open('a') as summary:
    summary.write('Single-runner controlled intervention: one warmup triple plus six balanced measured triples. Original historical gates and every outcome retained.\n\n')
    summary.write('All runs use unchanged historical assertions/budgets. Nonzero outcomes remain failures.\n\n')
    summary.write('| Round | Source | Warmup | Exit | CPU cores | Claim p99 ms | Wake p99 ms |\n')
    summary.write('|---|---|---|---:|---:|---:|---:|\n')
    for row in samples:
        report = row['report']
        summary.write(f"| {row['round']} | {row['side']} | {row['warmup']} | {row['exit_code']} | "
                      f"{report['daemon_cores']:.3f} | {report['paths']['claim']['p99_ms']:.2f} | "
                      f"{report['paths']['replication wake']['p99_ms']:.2f} |\n")
raise SystemExit(1 if any(row['exit_code'] for row in samples) else 0)
