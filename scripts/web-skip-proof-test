#!/usr/bin/env python3
"""Exercise web-skip-proof against a scratch repository with the real detector, verifier and policy."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
tool = root / "scripts/web-skip-proof"
clean = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}


def git(repo, *args):
    command = ["git", "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null", "-c", "user.name=t", "-c", "user.email=t@t", "-C", str(repo), *args]
    return subprocess.run(command, check=True, capture_output=True, text=True, env=clean).stdout.strip()


def commit(repo, message, files):
    for path, content in files.items():
        (repo / path).parent.mkdir(parents=True, exist_ok=True)
        (repo / path).write_text(content)
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "-m", message)
    return git(repo, "rev-parse", "HEAD")


def run(repo, *args):
    done = subprocess.run([str(tool), *args], cwd=repo, capture_output=True, text=True, env=clean)
    assert done.returncode == 0, done.stderr
    return done.stdout


def decisions(repo, base, head):
    lines = [line for line in run(repo, "--base", base, "--head", head).splitlines() if not line.startswith("#")]
    return {fields["check"]: fields for fields in (dict(part.split("=", 1) for part in line.split()) for line in lines)}


with tempfile.TemporaryDirectory() as scratch:
    repo = Path(scratch)
    git(repo, "init", "-q")
    for path in ("scripts/ci-fractal-web-changes", "scripts/evidence-verify", ".st/evidence-skip-policy.json"):
        (repo / path).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(root / path, repo / path)
    base = commit(repo, "base", {
        "packages/fractal-ui/src/Kit.tsx": "kit\n", "apps/fractal-web/src/App.tsx": "app\n",
        "apps/fractal-web/src/changelog/seen.ts": "seen\n", "crates/st3/src/lib.rs": "rust\n",
        "pnpm-lock.yaml": "lock\n", "package.json": "{}\n",
    })
    at_base = decisions(repo, base, base)
    assert set(at_base) == {"fractal-web", "fractal-web-kit"}
    for line in at_base.values():
        # The real policy declares no web check yet: a key, no trusted record, so the check runs.
        assert line["decision"] == "run" and line["reason"] == "no-record" and line["proof"] == "none", line
        assert len(line["key"]) == 40 and len(line["inputs_sha256"]) == 64, line

    rust = commit(repo, "rust only", {"crates/st3/src/lib.rs": "rust 2\n"})
    assert {name: line["key"] for name, line in decisions(repo, base, rust).items()} == {name: line["key"] for name, line in at_base.items()}
    app = commit(repo, "app only", {"apps/fractal-web/src/App.tsx": "app 2\n"})
    after_app = decisions(repo, base, app)
    assert after_app["fractal-web"]["key"] != at_base["fractal-web"]["key"]
    assert after_app["fractal-web-kit"]["key"] == at_base["fractal-web-kit"]["key"], "an app-only change keeps the kit key"
    kit = commit(repo, "kit", {"packages/fractal-ui/src/Kit.tsx": "kit 2\n"})
    after_kit = decisions(repo, base, kit)
    assert all(after_kit[name]["key"] != after_app[name]["key"] for name in after_kit)
    print("passed: input keys hold across changes outside a check's inputs and move with changes inside them")

    claims = dict(line.split("\t") for line in run(repo, "--base", base, "claims", "crates/st3/src/lib.rs", "apps/fractal-web/src/App.tsx", "pnpm-lock.yaml").splitlines())
    assert claims == {"crates/st3/src/lib.rs": "not-mine", "apps/fractal-web/src/App.tsx": "owned:fractal-web", "pnpm-lock.yaml": "owned:fractal-web,fractal-web-kit"}, claims
    kit_inputs = run(repo, "--base", base, "inputs", "fractal-web-kit").split()
    assert "packages/fractal-ui" in kit_inputs and "pnpm-lock.yaml" in kit_inputs and "apps/fractal-web" not in kit_inputs, kit_inputs
    assert not any(path.startswith("packages/fractal-ui/") for path in kit_inputs), "a declared directory stands for its files"
    print("passed: claims and directory-level inputs follow the base detector")

    # A change cannot narrow its own inputs: the detector is read from the base.
    detector = (repo / "scripts/ci-fractal-web-changes").read_text()
    narrowed = commit(repo, "narrow the detector", {"scripts/ci-fractal-web-changes": detector.replace('    "packages/fractal-ui/**",\n', "", 2)})
    assert "packages/fractal-ui" in run(repo, "--base", base, "--head", narrowed, "inputs", "fractal-web-kit").split()
    print("passed: inputs and rules come from the base, not from the change")

    # With a declared policy, the verifier's answer decides; a stub verifier at the base stands in for a signed record.
    policy = json.loads((repo / ".st/evidence-skip-policy.json").read_text())
    policy["checks"]["fractal-web-kit"] = {"trust_levels": ["fleet"], "enforce": False, "inputs": ["packages/fractal-ui", "pnpm-lock.yaml"]}
    stub = '#!/usr/bin/env python3\nimport json, sys\nargs = sys.argv[1:]\n' \
           'if "--project" in args: print(json.dumps({"source_inputs": "a" * 40}))\n' \
           'elif "fractal-web-kit" in args: print(json.dumps({"satisfied": True, "record": "b" * 40}))\n' \
           'else: print(json.dumps({"satisfied": False, "reason": "stale_tree"})); sys.exit(1)\n'
    declared = commit(repo, "declare the kit check", {".st/evidence-skip-policy.json": json.dumps(policy), "scripts/evidence-verify": stub})
    os.chmod(repo / "scripts/evidence-verify", 0o755)
    lines = decisions(repo, declared, declared)
    assert lines["fractal-web-kit"]["decision"] == "skip" and lines["fractal-web-kit"]["proof"] == "b" * 40 and lines["fractal-web-kit"]["reason"] == "match", lines
    assert lines["fractal-web"]["decision"] == "run" and lines["fractal-web"]["reason"] == "no-record", lines
    print("passed: a declared check skips only on the verifier's signed record; an undeclared one runs")
