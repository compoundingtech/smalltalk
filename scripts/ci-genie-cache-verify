#!/usr/bin/env bash
# Prove the complete shell can be obtained without public substituters or the warm global store.
# Cache and proof directory must share RUNNER_TEMP's filesystem for the hard-link negative control.
set -euo pipefail
cache=${1:?usage: ci-genie-cache-verify CACHE SHELL_ROOT PUBLIC_KEY_FILE}
shell_root=${2:?shell root required}
public_key=${3:?public key required}
proof=$(mktemp -d "${RUNNER_TEMP:?}/genie-cache-proof.XXXXXX")
cleanup() {
  result=$?
  trap - EXIT
  # Nix restores read-only directories. Only the two owned target stores need their
  # directory write bits restored; never chmod hard-linked cache inputs or follow symlinks.
  for proof_store in "$proof/complete-store" "$proof/incomplete-store"; do
    if [ -d "$proof_store" ] && ! find "$proof_store" -type d -exec chmod u+w {} +; then
      echo '::error::could not make temporary Genie store directories removable'
      [ "$result" -ne 0 ] || result=1
    fi
  done
  if ! rm -rf "$proof"; then
    echo '::error::could not remove temporary Genie cache proof'
    [ "$result" -ne 0 ] || result=1
  fi
  exit "$result"
}
trap cleanup EXIT
if [ "$(stat -c %d "$cache")" != "$(stat -c %d "$proof")" ]; then
  echo '::error::Genie cache and RUNNER_TEMP proof directory must be on the same filesystem'
  exit 1
fi
start=$SECONDS
nix path-info --recursive --json --json-format 1 "$shell_root" > "$proof/expected.json"
python3 - "$proof/expected.json" "$shell_root" > "$proof/missing-child" <<'PY'
import json, sys
info = json.load(open(sys.argv[1]))
paths = list(info) if isinstance(info, dict) else [item['path'] for item in info]
children = sorted(path for path in paths if path != sys.argv[2])
if not children:
    raise SystemExit('Genie shell must have a dependency closure')
print(children[0])
PY

# A missing dependency must fail, rather than silently consulting the runner's populated store
# or a public cache. Hard links keep the negative control cheap; only its directory entry is removed.
cp -al "$cache" "$proof/incomplete-cache"
missing=$(cat "$proof/missing-child")
hash=${missing##*/}
rm "$proof/incomplete-cache/${hash:0:32}.narinfo"
copy=(nix copy --option substituters '' --option extra-substituters ''
  --option builders '' --option max-jobs 0 --option trusted-public-keys "$(cat "$public_key")")
if "${copy[@]}" --from "file://$proof/incomplete-cache" --to "local?root=$proof/incomplete-store" "$shell_root" > "$proof/negative.log" 2>&1; then
  echo '::error::incomplete Genie cache unexpectedly supplied the full shell'
  exit 1
fi
# A failure for another reason (permissions, invalid store URL, etc.) is not a valid negative control.
grep -F "$missing" "$proof/negative.log"

"${copy[@]}" --from "file://$cache" --to "local?root=$proof/complete-store" "$shell_root"
nix path-info --store "local?root=$proof/complete-store" --recursive --json --json-format 1 "$shell_root" > "$proof/actual.json"
python3 - "$proof/expected.json" "$proof/actual.json" "$cache" "$shell_root" "$((SECONDS - start))" <<'PY'
import json, os, pathlib, sys
def paths(filename):
    data = json.load(open(filename))
    return data if isinstance(data, dict) else {item['path']: item for item in data}
expected, actual = paths(sys.argv[1]), paths(sys.argv[2])
if expected.keys() != actual.keys():
    raise SystemExit('isolated Genie store has a different closure')
for path in expected:
    if expected[path]['narHash'] != actual[path]['narHash']:
        raise SystemExit(f'isolated Genie path hash changed: {path}')
report = dict(shell_root=sys.argv[4], paths=len(actual),
              closure_nar_bytes=sum(item['narSize'] for item in actual.values()),
              cache_file_bytes=sum(p.stat().st_size for p in pathlib.Path(sys.argv[3]).rglob('*') if p.is_file()),
              verification_seconds=int(sys.argv[5]),
              missing_dependency_rejected=True, isolated_restore='success', public_substituters=[])
text = json.dumps(report, sort_keys=True)
print(text)
if os.environ.get('GITHUB_STEP_SUMMARY'):
    with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as summary:
        summary.write('\nGenie cache closure proof: `' + text + '`\n')
PY
