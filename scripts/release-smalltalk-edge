#!/usr/bin/env python3
"""Move the rolling `edge` pre-release to a main commit whose release archives are verified.

Usage: scripts/release-smalltalk-edge --source SHA --dist DIRECTORY [--run-url URL] [--dry-run]
Environment: GH_TOKEN and GH_REPO (as for gh). Run from a full-history checkout with tags.
Needs contents: write.

There is one release, tagged `edge`, never one per commit. Each call replaces its assets with the
archives, checksums and RELEASE.json of SOURCE, rewrites its notes with the commits since the
previous edge, and moves the tag to SOURCE. It is a pre-release, so `latest` and the daily
versioned release (which reads the latest release) ignore it. A run for a commit older than the
current edge changes nothing, so slow runs cannot move edge backwards.
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

TAG = 'edge'
SHA = re.compile(r'[0-9a-f]{40}')
LISTED = 30


def run(*cmd, cwd=None, check=True):
    done = subprocess.run(cmd, check=False, text=True, capture_output=True, cwd=cwd)
    if check and done.returncode != 0:
        raise SystemExit(f'release-smalltalk-edge: {" ".join(cmd[:3])} failed: {done.stderr.strip() or done.stdout.strip()}')
    return done


def say(message):
    print(f'release-smalltalk-edge: {message}', flush=True)


def current_edge(repo):
    done = run('git', 'rev-parse', '-q', '--verify', f'refs/tags/{TAG}^{{commit}}', cwd=repo, check=False)
    return done.stdout.strip() or None


def is_ancestor(repo, older, newer):
    return run('git', 'merge-base', '--is-ancestor', older, newer, cwd=repo, check=False).returncode == 0


def changelog(repo, previous, source):
    if previous is None:
        lines, heading = log(repo, source, '-n', str(LISTED + 1)), 'First edge release; the newest commits on main:'
    elif previous == source:
        return 'No change since the previous edge (a rerun of the same commit).'
    elif is_ancestor(repo, previous, source):
        lines, heading = log(repo, f'{previous}..{source}'), f'Changes since the previous edge (`{previous}`):'
    else:
        lines = log(repo, source, '-n', str(LISTED + 1))
        heading = f'The previous edge (`{previous}`) is not an ancestor of this commit; the newest commits on main:'
    extra = max(0, len(lines) - LISTED)
    body = '\n'.join(lines[:LISTED]) or '- (no commits)'
    return heading + '\n\n' + body + (f'\n- and {extra} more' if extra else '')


def log(repo, *revisions):
    out = run('git', 'log', '--first-parent', '--format=- %s (`%h`)', *revisions, cwd=repo).stdout
    return out.splitlines()


def notes(source, previous, repo, run_url):
    text = ['Rolling pre-release built from the newest green `main` commit. Each update replaces the',
            'assets below; use a `v` release for a fixed version. Install with `install.sh --edge`.', '',
            f'Exact source: `{source}`.' + (f' Built by {run_url}.' if run_url else ''), '',
            changelog(repo, previous, source), '']
    return '\n'.join(text)


def assets_in(dist):
    names = sorted(p.name for pattern in ('*.tar.gz', '*.sha256') for p in dist.glob(pattern))
    names += ['SHA256SUMS', 'RELEASE.json']
    missing = [n for n in names if not (dist / n).is_file()]
    if missing or not any(n.endswith('.tar.gz') for n in names):
        raise SystemExit(f'release-smalltalk-edge: {dist} lacks release files: {missing or ["*.tar.gz"]}')
    return names


def release_assets(repository):
    done = run('gh', 'release', 'view', TAG, '--repo', repository, '--json', 'assets', check=False)
    if done.returncode != 0:
        return None
    return {a['name'] for a in json.loads(done.stdout)['assets']}


def tag_commit(repository):
    done = run('gh', 'api', f'repos/{repository}/git/ref/tags/{TAG}', check=False)
    if done.returncode != 0:
        return None
    ref = json.loads(done.stdout)['object']
    if ref['type'] == 'commit':
        return ref['sha']
    return json.loads(run('gh', 'api', f'repos/{repository}/git/tags/{ref["sha"]}').stdout)['object']['sha']


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--source', required=True)
    parser.add_argument('--dist', required=True, type=pathlib.Path)
    parser.add_argument('--run-url', default='')
    parser.add_argument('--dry-run', action='store_true', help='verify and print the notes; publish nothing')
    args = parser.parse_args()
    repo = pathlib.Path(__file__).resolve().parent.parent
    repository = os.environ.get('GH_REPO', 'compoundingtech/smalltalk')
    if not SHA.fullmatch(args.source):
        raise SystemExit('release-smalltalk-edge: --source must be a full lowercase commit hash')

    dist = args.dist.resolve()
    names = assets_in(dist)
    # The checks the tag workflow makes, so edge carries only bytes that main already proved.
    run('sha256sum', '--check', 'SHA256SUMS', cwd=dist)
    say(run('python3', str(repo / 'scripts/release-smalltalk-manifest.py'), args.source, cwd=dist).stdout.strip())

    previous = current_edge(repo)
    if previous and previous != args.source and is_ancestor(repo, args.source, previous):
        say(f'edge already has the newer {previous}; leaving it unchanged')
        return 0
    body = notes(args.source, previous, repo, args.run_url)
    if args.dry_run:
        print(body)
        say(f'dry run: would publish {len(names)} assets as {TAG} at {args.source}')
        return 0

    notes_file = pathlib.Path(tempfile.mkdtemp(prefix='smalltalk-edge-')) / 'NOTES.md'
    notes_file.write_text(body)
    files = [str(dist / n) for n in names]
    title = f'Fractal edge ({args.source[:9]})'
    existing = release_assets(repository)
    if existing is None:
        run('gh', 'release', 'create', TAG, '--repo', repository, '--target', args.source, '--prerelease',
            '--latest=false', '--title', title, '--notes-file', str(notes_file), *files)
        say(f'created the {TAG} pre-release')
    else:
        # Same names replace in place; anything else is a leftover of an older build.
        run('gh', 'release', 'upload', TAG, '--repo', repository, '--clobber', *files)
        for stale in sorted(existing - set(names)):
            run('gh', 'release', 'delete-asset', TAG, stale, '--repo', repository, '--yes')
    if tag_commit(repository) != args.source:
        run('gh', 'api', '--method', 'PATCH', f'repos/{repository}/git/refs/tags/{TAG}',
            '-f', f'sha={args.source}', '-F', 'force=true')
    run('gh', 'release', 'edit', TAG, '--repo', repository, '--prerelease', '--latest=false', '--title', title,
        '--notes-file', str(notes_file))

    final = tag_commit(repository)
    published = release_assets(repository)
    if final != args.source or published != set(names):
        raise SystemExit(f'release-smalltalk-edge: {TAG} is at {final} with assets {sorted(published or [])}, '
                         f'expected {args.source} with {names}')
    say(f'{TAG} now at {args.source} with {len(names)} assets')
    return 0


if __name__ == '__main__':
    sys.exit(main())
