#!/usr/bin/env bash
# Install st3 and its tools from one source build. `st` is always a symlink to the installed `st3`,
# never a separate build, so the two names cannot drift apart.
#
# usage: scripts/install [--bin-dir DIR] [--from DIR] [--instance NAME]
#
#   --bin-dir DIR  install destination (default: $HOME/.local/bin)
#   --from DIR     install already-built binaries from DIR instead of running cargo
#   --instance NAME  install a second, separate copy below ~/.st-instance/NAME (its own
#                  command directory, macOS app, bundle identifier and launchd services)
set -Eeuo pipefail

bin_dir=""
instance="${ST_INSTANCE:-}"
from=""
while (($#)); do
  case $1 in
    --bin-dir) bin_dir=${2:?--bin-dir needs a directory}; shift 2 ;;
    --instance) instance=${2:?--instance needs a name}; shift 2 ;;
    --from) from=${2:?--from needs a directory}; shift 2 ;;
    -h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [[ -n $instance ]]; then
  [[ ${#instance} -le 24 && $instance =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
    echo "install: an instance name is lowercase letters, digits and single hyphens, at most 24 characters" >&2
    exit 2
  }
  export ST_INSTANCE=$instance
  # A named instance installs below its own directory unless told otherwise.
  [[ -n $bin_dir ]] || bin_dir=${ST_MACOS_BIN_DIR:-$HOME/.st-instance/$instance/bin}
fi
bin_dir=${bin_dir:-${ST_MACOS_BIN_DIR:-$HOME/.local/bin}}

binaries=(st3 st3-migrate)

if [[ -z $from ]]; then
  repo=$(cd "$(dirname "$0")/.." && pwd)
  cargo build --release --locked --manifest-path "$repo/Cargo.toml" \
    -p st3 -p st3-migrate
  from=${CARGO_TARGET_DIR:-$repo/target}/release
  # The terminal client's speech helper, on a Mac whose Swift has the macOS 26 SDK; SmallTalk.app takes it in.
  if [[ $(uname -s) == Darwin ]] && ! "$repo/apps/macos/listen/build.sh" "$from" >/dev/null; then
    echo "install: the speech helper did not build here; the terminal interface will have no voice" >&2
    rm -rf "$from/StListen.app"
  fi
fi

for binary in "${binaries[@]}"; do
  [[ -x $from/$binary && ! -d $from/$binary ]] || {
    echo "install: $from/$binary is not an executable file" >&2
    exit 1
  }
done
# `mv` onto a directory (or a link to one) would move the file inside it instead of replacing it.
for name in "${binaries[@]}" st stui; do
  [[ ! -d $bin_dir/$name ]] || {
    echo "install: $bin_dir/$name is a directory; refusing to replace it" >&2
    exit 1
  }
done

mkdir -p "$bin_dir"
bin_dir=$(cd "$bin_dir" && pwd)
macos=false
if [[ $(uname -s) == Darwin ]]; then
  python3 "$(cd "$(dirname "$0")" && pwd)/install-macos.py" --from "$from" --bin-dir "$bin_dir"
  macos=true
fi
# Each name is replaced by rename, so a running process keeps its old inode and a concurrent
# caller sees either the old or the new file, never a partial copy.
for binary in "${binaries[@]}"; do
  if [[ $macos == true && $binary == st3 ]]; then continue; fi
  staged=$(mktemp "$bin_dir/.$binary.install.XXXXXX")
  cp "$from/$binary" "$staged"
  chmod 0755 "$staged"
  mv -f "$staged" "$bin_dir/$binary"
done
# LIVE-MIGRATION BRIDGE arn:lmig:smalltalk:2026-10-16-fractal-binary-aliases — DELETE at contraction — https://github.com/compoundingtech/smalltalk/issues/3032
link=$(mktemp -u "$bin_dir/.st.install.XXXXXX")
ln -s st3 "$link"
mv -f "$link" "$bin_dir/st"

[[ $(readlink "$bin_dir/st") == st3 ]] || {
  echo "install: $bin_dir/st does not link to st3" >&2
  exit 1
}
# LIVE-MIGRATION END arn:lmig:smalltalk:2026-10-16-fractal-binary-aliases
# Retire the old executable; no alias or shim remains.
rm -f -- "$bin_dir/stui"
if ! $macos; then
  foreign_path=false
  IFS=: read -ra path_dirs <<< "${PATH:-}"
  for path_dir in "${path_dirs[@]}"; do
    path_dir=${path_dir:-.}
    [[ -d $path_dir ]] || continue
    path_dir=$(cd "$path_dir" && pwd)
    [[ $path_dir != "$bin_dir" ]] || continue
    if [[ -e $path_dir/fractal || -L $path_dir/fractal ]]; then
      [[ -L $path_dir/fractal && $(readlink "$path_dir/fractal") == "$bin_dir/st3" ]] || foreign_path=true
    fi
  done
  # Only these exact targets identify a link installed by Smalltalk.
  if [[ -L $bin_dir/fractal && ( $(readlink "$bin_dir/fractal") == st3 || $(readlink "$bin_dir/fractal") == "$bin_dir/st3" ) ]]; then
    link=$(mktemp -u "$bin_dir/.fractal.install.XXXXXX")
    ln -s st3 "$link"
    mv -f "$link" "$bin_dir/fractal"
  elif $foreign_path || [[ -e $bin_dir/fractal || -L $bin_dir/fractal ]] || ! ln -s st3 "$bin_dir/fractal" 2>/dev/null; then
    printf 'install: leaving fractal unchanged: destination %s/fractal or PATH contains a foreign command; use st, or move the foreign fractal and reinstall to enable the alias.\n' "$bin_dir" >&2
  fi
fi
printf 'installed %s and st -> st3 in %s\n' "${binaries[*]}" "$bin_dir"
