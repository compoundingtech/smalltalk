#!/usr/bin/env bash
set -Eeuo pipefail

JQ_BIN=${ST3_SOAK_JQ_BIN:-$(command -v jq)}
report="$(/usr/bin/dirname "$0")/st3-idle-soak-report"

fixture() {
  local host pid at cpu
  for host in hetz silber; do
    if [[ $host == hetz ]]; then pid=1; else pid=2; fi
    for at in 0 60 120; do
      if [[ $host == hetz ]]; then cpu=$((at / 20)); else cpu=$((at / 5)); fi
      "$JQ_BIN" -nc --arg host "$host" --argjson pid "$pid" --argjson at "$at" \
        --argjson cpu "$cpu" \
        '{at:$at,host:$host,pid:$pid,cpu_seconds:$cpu,rss_kib:(100000+$at),
          context_switches:$at,graph_index:1,material_index:1,pending:0,peer_status:"up",
          peer_error:false,peer_last_success_ms:($at*1000)}'
    done
  done
}

check() {
  local expected=$1 evidence=$2 result status
  if result=$(/usr/bin/printf '%s\n' "$evidence" | \
    ST3_IDLE_REPORT_LOG=/dev/stdin ST3_IDLE_REPORT_NOW_UNIX=120 \
    ST3_IDLE_REPORT_DURATION_SECONDS=120 ST3_IDLE_REPORT_MAX_GAP_SECONDS=60 \
    ST3_IDLE_REPORT_MIN_SAMPLES=3 ST3_IDLE_REPORT_MIN_QUIET=2 \
    "$report"); then status=0; else status=$?; fi
  [[ $status == "$expected" ]] || { /usr/bin/printf 'unexpected idle report status %s: %s\n' "$status" "$result" >&2; exit 1; }
}

base=$(fixture)
check 0 "$base"
check 1 "$("$JQ_BIN" -c 'if .host=="hetz" and .at==60 then .peer_error=true else . end' <<<"$base")"
check 1 "$("$JQ_BIN" -c 'if .host=="silber" and .at==120 then .pid=3 else . end' <<<"$base")"
check 1 "$("$JQ_BIN" -c 'if .at==60 then .at=10 else . end' <<<"$base")"
check 1 "$("$JQ_BIN" -c 'if .host=="silber" then .cpu_seconds=(.at*1.0) else . end' <<<"$base")"
check 1 "$("$JQ_BIN" -c 'if .host=="hetz" and .at==60 then .material_index=2 else . end' <<<"$base")"

# Extra manual samples seconds apart cannot manufacture the required quiet windows.
short_spaced=$(for host in hetz silber; do
  for at in 0 1 60 61 120; do
    "$JQ_BIN" -nc --arg host "$host" --argjson at "$at" \
      '{at:$at,host:$host,pid:(if $host=="hetz" then 1 else 2 end),
        cpu_seconds:($at / 20),rss_kib:100000,context_switches:$at,
        graph_index:1,material_index:1,pending:0,peer_status:"up",peer_error:false,
        peer_last_success_ms:($at*1000)}'
  done
done)
if /usr/bin/printf '%s\n' "$short_spaced" | \
  ST3_IDLE_REPORT_LOG=/dev/stdin ST3_IDLE_REPORT_NOW_UNIX=120 \
  ST3_IDLE_REPORT_DURATION_SECONDS=120 ST3_IDLE_REPORT_MAX_GAP_SECONDS=60 \
  ST3_IDLE_REPORT_MIN_SAMPLES=5 ST3_IDLE_REPORT_MIN_QUIET=4 "$report" >/dev/null; then
  echo 'short manual samples incorrectly passed the quiet-window gate' >&2
  exit 1
fi
/usr/bin/printf 'st3 idle soak report tests passed\n'
