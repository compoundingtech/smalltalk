#!/usr/bin/env python3
"""A pure directory move conflicts only for a branch that adds a file inside the moved directory,
and only when git is not told to apply directory renames."""
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True

SCRIPT = Path(__file__).resolve().parent / "forecast-conflicts"


class Forecast(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="forecast-")
        self.addCleanup(self.temporary.cleanup)
        self.repo = Path(self.temporary.name)
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "t@example.com")
        self.git("config", "user.name", "t")
        for name in ("a", "b", "c"):
            self.write(f"src/{name}.rs", "\n".join(f"{name}{i}" for i in range(20)) + "\n")
        self.commit("start")
        self.start = self.rev()

    def git(self, *args):
        return subprocess.run(["git", *args], cwd=self.repo, text=True, capture_output=True, check=True).stdout.strip()

    def write(self, name, text):
        path = self.repo / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)

    def commit(self, message):
        self.git("add", "-A")
        self.git("commit", "-q", "-m", message)

    def rev(self):
        return self.git("rev-parse", "HEAD")

    def branch(self, name, start, edit):
        self.git("checkout", "-q", "-b", name, start)
        edit()
        self.commit(name)
        self.git("checkout", "-q", "main")

    def test_move_conflicts_only_for_a_file_added_in_the_moved_directory(self):
        self.branch("edits", self.start, lambda: self.write("src/a.rs", "A0\n" + "\n".join(f"a{i}" for i in range(1, 20)) + "\n"))
        self.branch("adds", self.start, lambda: self.write("src/new.rs", "new\n"))
        self.branch("stale", self.start, lambda: self.write("src/b.rs", "B0\n" + "\n".join(f"b{i}" for i in range(1, 20)) + "\n"))
        # main moves on and now conflicts with "stale"
        self.write("src/b.rs", "main\n" + "\n".join(f"b{i}" for i in range(1, 20)) + "\n")
        self.commit("main edit")
        main = self.rev()
        self.git("checkout", "-q", "-b", "candidate", main)
        self.git("mv", "src", "lib")
        self.commit("move")
        candidate = self.rev()
        result = subprocess.run(
            [sys.executable, str(SCRIPT), candidate, "--base", main, "--repo", str(self.repo),
             "--refs", "refs/heads/edits", "refs/heads/adds", "refs/heads/stale"],
            text=True, capture_output=True, check=True)
        out = json.loads(result.stdout)
        self.assertEqual(out["pull_requests"], 3)
        self.assertEqual(out["conflict_with_base"], 1)
        self.assertEqual(out["newly_conflicting_default"], 1)
        self.assertEqual(out["newly_conflicting_with_renames"], 0)


if __name__ == "__main__":
    unittest.main()
