#!/usr/bin/env python3
"""Exercise the evidence gate against a real origin and a real depth-1 clone.

The aim is that no skip can be a false positive: every way a note can fail to cover a check
must end in `decision=run`, and every hostile or broken verifier must too.
"""
import importlib.machinery
import importlib.util
import itertools
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


gate = load('ci_evidence_gate', 'scripts/ci-evidence-gate')
fixtures = load('evidence_verify_test', 'scripts/evidence-verify-test')
REPOSITORY = 'org/repo'
CHECKS = ('linux-gate', 'typescript-client', 'isolation-vm', 'genie-freshness', 'mail-redelivery-canaries')
WEEK = 7 * 24 * 3600
# The wrapper notes' exact strings, as the note jobs record them (nix-evidence, #2795 / #2803), written out
# here independently of the policy file so a typo in either cannot make the test agree with itself.
GATE_ARGV = ['linux-gate', 'aggregate', 'genie-freshness', 'isolation-vm', 'linux-clippy', 'linux-fleet-compat',
             'linux-gate', 'linux-test-build', 'linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3',
             'linux-tests-shard-4', 'mail-redelivery-canaries', 'typescript-client', 'upgrade-impact']
CANARIES_ARGV = ['bash', 'scripts/ci-linux', 'mail-redelivery-canaries']
# The step-outcome notes of the other three checks (nix-evidence, agent/evidence-more-checks).
STEP_ARGV = {
    'genie-freshness': ['bash', 'scripts/ci-genie-freshness'],
    'typescript-client': ['bash', 'scripts/ci-typescript-client'],
    'isolation-vm': ['isolation-vm', 'nixos-test-driver', 'transport-isolation-vm', 'sekrets-vm'],
}
ARGV = {'linux-gate': GATE_ARGV, 'mail-redelivery-canaries': CANARIES_ARGV, **STEP_ARGV}
LOCK = 'fake flake.lock contents\n'
# Written out here, not read from the script, so removing a path from the script cannot hide it.
EXPECTED_PROTECTED = (
    'scripts/ci-evidence-gate', 'scripts/evidence-verify', '.st/evidence-skip-policy.json', '.st/evidence-keys',
    '.github/workflows/fleet.yml', '.github/workflows/fleet.yml.genie.ts', '.github/workflows/workspace-ci.ts',
    'scripts/ci-evidence-gate-test', 'scripts/evidence-verify-test',
    '.st/evidence-authors.json', 'scripts/ci-evidence-signing',
)


def command_for(check, repository=REPOSITORY):
    return ('github-actions', repository, '.github/workflows/fleet.yml', check)


RUNNER = f'github:{REPOSITORY}/actions/runs/7/attempts/1/jobs/9'


def skip_policy(**per_check):
    """The repository's skip policy as a base commit would carry it, for all five checks."""
    entry = {'trust_levels': ['fleet'], 'enforce': True,
             'kinds': {'observed': {'command': ['github-actions', '{repository}', '.github/workflows/fleet.yml', '{check}'],
                                    'runner_prefix': 'github:{repository}/'}}}
    entry.update(per_check)
    return json.dumps({'version': 1, 'checks': {check: entry for check in CHECKS}})


def enforcing(path):
    """The repository's real skip policy with skipping turned on for every check: the one-line change per check."""
    doc = json.loads(Path(path).read_text())
    for entry in doc['checks'].values():
        entry['enforce'] = True
        entry['sample_one_in'] = 1  # sampling is tested on its own; here a matching note must always skip
        entry.pop('inputs', None)  # these tests use exact-tree notes
    return json.dumps(doc)


def decision(text):
    """The decision line as a dict, asserting its format on the way."""
    match = [line for line in text.splitlines() if line.startswith('evidence-decision v1 ')]
    assert len(match) == 1, text
    fields = dict(part.split('=', 1) for part in match[0].split(' ')[2:])
    return fields


class Classify(unittest.TestCase):
    def test_each_verifier_answer_has_one_outcome(self):
        cases = [
            ((0, {'satisfied': True, 'tier': 'full'}), 'satisfied'),
            ((0, {'satisfied': True, 'tier': 'test'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'degraded'}), 'degraded'),
            ((1, {'satisfied': False, 'reason': 'no_record'}), 'no_note'),
            ((1, {'satisfied': False, 'reason': 'stale_tree'}), 'no_note'),
            ((1, {'satisfied': False, 'reason': 'wrong_check'}), 'no_note'),
            ((1, {'satisfied': False, 'reason': 'bad_signature'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'untrusted_signer'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'too_old'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'check_failed'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'error'}), 'unavailable'),
            ((2, None), 'unavailable'),
        ]
        for (code, result), outcome in cases:
            self.assertEqual(gate.classify(code, result), outcome, (code, result))


class Decide(unittest.TestCase):
    """The pure decision, with every condition removed one at a time."""

    def good(self):
        record = 'a' * 40
        now = gate.datetime.now(gate.timezone.utc).isoformat()
        context = {'check': 'linux-gate', 'fork': 'false', 'event': 'merge_group', 'protected_changed': []}
        result = {'satisfied': True, 'policy': True, 'enforce': True, 'tier': 'full', 'kind': 'observed', 'trust_level': 'fleet',
                  'tree': 'b' * 40, 'check': 'linux-gate', 'record': record, 'signer': 'fleet/ci', 'observed_at': now,
                  'sample_one_in': 1}
        return context, result, 'b' * 40

    def test_all_conditions_together_skip(self):
        context, result, tree = self.good()
        self.assertEqual(gate.decide(context, 'satisfied', result, tree)[0], 'skip')

    def test_a_result_without_the_sampling_rule_runs(self):
        context, result, tree = self.good()
        del result['sample_one_in']
        decision, reason = gate.decide(context, 'satisfied', result, tree)
        self.assertEqual(decision, 'run')
        self.assertTrue(reason.startswith('sampled:'), reason)

    def test_a_note_valid_only_for_some_events_does_not_skip_another_event(self):
        context, result, tree = self.good()
        result['events'] = ['pull_request']
        context['event'] = 'pull_request'
        self.assertEqual(gate.decide(context, 'satisfied', result, tree)[0], 'skip')
        context['event'] = 'merge_group'
        decision, reason = gate.decide(context, 'satisfied', result, tree)
        self.assertEqual(decision, 'run')
        self.assertIn('covers pull requests only', reason)
        result['events'] = None
        self.assertEqual(gate.decide(context, 'satisfied', result, tree)[0], 'skip')

    def test_removing_any_one_condition_runs(self):
        context, result, tree = self.good()
        cases = {
            'outcome': lambda c, r, t: (c, r, t, 'degraded'),
            'fork': lambda c, r, t: ({**c, 'fork': 'true'}, r, t, 'satisfied'),
            'event': lambda c, r, t: ({**c, 'event': 'workflow_dispatch'}, r, t, 'satisfied'),
            'unsatisfied': lambda c, r, t: (c, {**r, 'satisfied': 'yes'}, t, 'satisfied'),
            'tier': lambda c, r, t: (c, {**r, 'tier': 'test'}, t, 'satisfied'),
            'protected path changed': lambda c, r, t: ({**c, 'protected_changed': ['scripts/ci-evidence-gate']}, r, t, 'satisfied'),
            'comparison failed': lambda c, r, t: ({**c, 'protected_changed': ['<comparison failed>']}, r, t, 'satisfied'),
            'protected check absent': lambda c, r, t: ({k: v for k, v in c.items() if k != 'protected_changed'}, r, t, 'satisfied'),
            'policy not applied': lambda c, r, t: (c, {**r, 'policy': False}, t, 'satisfied'),
            'policy missing': lambda c, r, t: (c, {k: v for k, v in r.items() if k != 'policy'}, t, 'satisfied'),
            'no kind': lambda c, r, t: (c, {**r, 'kind': None}, t, 'satisfied'),
            'no trust level': lambda c, r, t: (c, {**r, 'trust_level': ''}, t, 'satisfied'),
            'tree': lambda c, r, t: (c, {**r, 'tree': 'c' * 40}, t, 'satisfied'),
            'run tree absent': lambda c, r, t: (c, r, None, 'satisfied'),
            'check': lambda c, r, t: (c, {**r, 'check': 'typescript-client'}, t, 'satisfied'),
            'record': lambda c, r, t: (c, {**r, 'record': 'xyz'}, t, 'satisfied'),
            'record missing': lambda c, r, t: (c, {k: v for k, v in r.items() if k != 'record'}, t, 'satisfied'),
            'signer': lambda c, r, t: (c, {**r, 'signer': 'two words'}, t, 'satisfied'),
            'future': lambda c, r, t: (c, {**r, 'observed_at': '2999-01-01T00:00:00+00:00'}, t, 'satisfied'),
            'naive time': lambda c, r, t: (c, {**r, 'observed_at': '2026-01-01T00:00:00'}, t, 'satisfied'),
            'no time': lambda c, r, t: (c, {k: v for k, v in r.items() if k != 'observed_at'}, t, 'satisfied'),
            'not a dict': lambda c, r, t: (c, 'satisfied', t, 'satisfied'),
        }
        for name, mutate in cases.items():
            with self.subTest(name):
                c, r, t, outcome = mutate(context, result, tree)
                self.assertEqual(gate.decide(c, outcome, r, t)[0], 'run', name)

    def test_the_fork_flag_needs_a_positively_identical_head_repository(self):
        for head, expected in (('org/repo', 'false'), ('', 'true'), ('org/repo-fork', 'true'), ('org/other', 'true')):
            self.assertEqual(gate.context_from({'REPOSITORY': 'org/repo', 'HEAD_REPOSITORY': head})['fork'], expected)
        self.assertEqual(gate.context_from({'HEAD_REPOSITORY': 'org/repo'})['fork'], 'true')


class ProtectedPaths(unittest.TestCase):
    def test_a_comparison_that_cannot_be_made_counts_as_a_change(self):
        with tempfile.TemporaryDirectory() as directory:
            subprocess.run(['git', 'init', '-q', directory], check=True)
            here = os.getcwd()
            os.chdir(directory)
            try:
                self.assertEqual(gate.protected_changes(''), ['<no base>'])
                self.assertEqual(gate.protected_changes('f' * 40), ['<comparison failed>'])
            finally:
                os.chdir(here)


class EndToEnd(unittest.TestCase):
    def setUp(self):
        self.f = fixtures.Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'fleet/ci')
        self.stranger = self.f.key('stranger')
        self.machine = self.f.key('machine', 'machine/box')
        self.work_dir = tempfile.TemporaryDirectory()
        self.addCleanup(self.work_dir.cleanup)

    def commit_base(self, script=None, with_keys=True, policy=None):
        repo = self.f.repo
        (repo / 'scripts').mkdir(exist_ok=True)
        shutil.copy(ROOT / 'scripts/ci-evidence-gate', repo / 'scripts/ci-evidence-gate')
        target = repo / 'scripts/evidence-verify'
        if script is None:
            shutil.copy(ROOT / 'scripts/evidence-verify', target)
        elif script is not False:
            target.write_text(script)
        (repo / '.st').mkdir(exist_ok=True)
        if with_keys:
            (repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        if policy is not False:
            (repo / '.st/evidence-skip-policy.json').write_text(policy or skip_policy())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '--allow-empty', '-m', 'base')
        return self.f.git('rev-parse', 'HEAD')

    def note(self, commit, tree, check='linux-gate', **kwargs):
        defaults = dict(check=check, command=command_for(check), runner=RUNNER, key=self.ci, signer='fleet/ci')
        defaults.update(kwargs)
        return self.f.note(commit, tree, **defaults)

    def run_gate(self, base, check='linux-gate', timeout='30', **overrides):
        work = Path(self.work_dir.name) / 'work'
        if work.exists():
            shutil.rmtree(work)
        subprocess.run(['git', 'clone', '-q', '--depth=1', 'file://' + str(self.f.repo), str(work)], check=True,
                       capture_output=True)
        output, summary = Path(self.work_dir.name) / 'output', Path(self.work_dir.name) / 'summary'
        output.write_text('')
        summary.write_text('')
        env = dict(os.environ, CHECK=check, REPOSITORY=REPOSITORY, HEAD_REPOSITORY=REPOSITORY,
                   BASE_SHA=base, EVENT_NAME='merge_group', HEAD_SHA=self.f.git('rev-parse', 'HEAD'), PR_NUMBER='',
                   RUN_ID='42', RUN_ATTEMPT='1', GITHUB_OUTPUT=str(output), GITHUB_STEP_SUMMARY=str(summary),
                   GATE_VERIFIER_TIMEOUT=timeout)
        env.update(overrides)
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/ci-evidence-gate')], cwd=work, env=env,
                              capture_output=True)
        self.assertEqual(done.returncode, 0, done.stderr.decode())  # the gate never fails the job
        fields = decision(done.stdout.decode())
        outputs = dict(line.split('=', 1) for line in output.read_text().split())
        self.assertEqual(fields['decision'] == 'skip', outputs['skip'] == 'true')
        self.assertIn('evidence-decision v1', summary.read_text())
        return fields, outputs

    def head(self):
        return self.f.commit('head')

    def assertRuns(self, base, why='', **kwargs):
        fields, outputs = self.run_gate(base, **kwargs)
        self.assertEqual((fields['decision'], outputs['skip'], outputs['record']), ('run', 'false', '-'), why)
        return fields

    # ---- the happy path and its progression -------------------------------------------------

    def test_no_note_then_degraded_then_a_trusted_note_skips_then_a_stranger_does_not(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.assertEqual(self.assertRuns(base)['outcome'], 'no_note')
        self.note(commit, tree, signer=None, tier='degraded', sign=False)
        self.assertEqual(self.assertRuns(base)['outcome'], 'degraded')
        record = self.note(commit, tree, seconds=1)
        fields, outputs = self.run_gate(base)
        self.assertEqual((fields['decision'], fields['outcome'], outputs['record']), ('skip', 'satisfied', record))
        self.assertEqual((fields['signer'], fields['trust_level'], fields['kind'], fields['tier'], fields['tree']),
                         ('fleet/ci', 'fleet', 'observed', 'full', tree))
        # A later record signed by a key that is not on the list is refused, not skipped over.
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.note(commit, tree, key=self.stranger, seconds=2)
        self.assertEqual(self.assertRuns(base)['outcome'], 'rejected')

    def test_the_subject_commit_is_absent_in_the_shallow_clone_and_the_skip_still_holds(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        fields, _ = self.run_gate(base)
        absent = subprocess.run(['git', '-C', str(Path(self.work_dir.name) / 'work'), 'cat-file', '-e', base + '^{commit}'])
        self.assertEqual(fields['decision'], 'skip')
        self.assertIsNotNone(absent)

    def test_each_of_the_five_required_checks_is_decided_on_its_own_note(self):
        base = self.commit_base()
        commit, tree = self.head()
        for covered in CHECKS:
            self.note(commit, tree, check=covered, seconds=CHECKS.index(covered))
        for check in CHECKS:
            with self.subTest(check):
                fields, _ = self.run_gate(base, check=check)
                self.assertEqual((fields['check'], fields['decision']), (check, 'skip'))
        # A note for one check never covers another.
        other = self.f.commit('other')
        self.note(other[0], other[1], check='linux-gate')
        for check in CHECKS[1:]:
            with self.subTest('uncovered ' + check):
                self.assertRuns(base, check=check)

    # ---- a pull request run asks about the PULL REQUEST HEAD tree, not the merge ref --------------------------

    AUTHORS = {'about': 'test', 'logins': ['alice', 'bob'], 'emails': ['fixture@example.invalid'], 'noreply_logins': [],
               'committers_also': []}

    def pull_request(self, main_moves=True, signing=True, head_files=None, main_files=None, head_email=None, policy=None,
                     base_files=None, authors_text=None):
        """Base B (with the gate, verifier, policy, keys, author list and signing script), a branch head H on it, and the
        merge M of H into a main that moved (B2), as GitHub's merge ref is. The repository's HEAD is M, as the checkout."""
        repo = self.f.repo
        (repo / 'scripts').mkdir(exist_ok=True)
        if signing:
            shutil.copy(ROOT / 'scripts/ci-evidence-signing', repo / 'scripts/ci-evidence-signing')
        (repo / '.st').mkdir(exist_ok=True)
        (repo / '.st/evidence-authors.json').write_text(authors_text if authors_text is not None else json.dumps(self.AUTHORS))
        for name, content in (base_files or {}).items():
            (repo / name).write_text(content)
        base = self.commit_base(policy=policy or skip_policy())
        self.f.git('config', 'uploadpack.allowAnySHA1InWant', 'true')
        self.f.git('config', 'uploadpack.allowFilter', 'true')
        for name, content in (head_files or {}).items():
            (repo / name).parent.mkdir(parents=True, exist_ok=True)
            (repo / name).write_text(content)
        if head_email:
            (repo / 'file.txt').write_text('head')
            self.f.git('add', '-A')
            self.f.git('-c', f'user.email={head_email}', 'commit', '-q', '-m', 'head', '--author', f'Other <{head_email}>')
            head, head_tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        else:
            head, head_tree = self.head()
        self.f.git('checkout', '-q', '--detach', base)
        for name, content in ((main_files or {'moved.txt': 'main moved'}) if main_moves else {}).items():
            (repo / name).parent.mkdir(parents=True, exist_ok=True)
            (repo / name).write_text(content)
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '--allow-empty', '-m', 'main moves')
        tip = self.f.git('rev-parse', 'HEAD')
        merged_tree = self.f.git('merge-tree', '--write-tree', '--no-messages', tip, head).splitlines()[0]
        merge = self.f.git('commit-tree', merged_tree, '-p', tip, '-p', head, '-m', 'merge ref')
        self.f.git('checkout', '-q', '--detach', merge)
        return dict(base=base, base_tree=self.f.git('rev-parse', base + '^{tree}'), head=head, head_tree=head_tree, tip=tip, merge=merge,
                    merge_tree=merged_tree)

    def pr_env(self, scenario, **overrides):
        env = dict(EVENT_NAME='pull_request', PR_HEAD_SHA=scenario['head'], PR_USER='alice', ACTOR='alice',
                   TRIGGERING_ACTOR='alice', PR_NUMBER='7', HEAD_SHA=scenario['merge'], PR_DRAFT='false')
        env.update(overrides)
        return env

    def test_a_pull_request_run_skips_on_the_note_for_its_head_tree_although_main_moved(self):
        s = self.pull_request()
        self.assertNotEqual(s['head_tree'], s['merge_tree'])
        record = self.note(s['head'], s['head_tree'], seconds=1)
        fields, outputs = self.run_gate(s['base'], **self.pr_env(s))
        self.assertEqual((fields['decision'], fields['tree_of'], fields['head_tree'], outputs['record']), ('skip', 'head', 'used', record))
        self.assertEqual((fields['tree'], fields['pr_head'], fields['merge_tree']), (s['head_tree'], s['head'], s['merge_tree']))
        # The runner's checkout is depth 1; the gate deepened it itself (the head commit and the merge's history are present now).
        shallow = Path(self.work_dir.name) / 'precondition'
        subprocess.run(['git', 'clone', '-q', '--depth=1', 'file://' + str(self.f.repo), str(shallow)], check=True, capture_output=True)
        self.assertEqual(subprocess.run(['git', '-C', str(shallow), 'rev-parse', '--is-shallow-repository'], capture_output=True, text=True).stdout.strip(), 'true')
        self.assertNotEqual(subprocess.run(['git', '-C', str(shallow), 'cat-file', '-e', s['head'] + '^{commit}'], capture_output=True).returncode, 0)
        work = Path(self.work_dir.name) / 'work'
        self.assertEqual(subprocess.run(['git', '-C', str(work), 'cat-file', '-e', s['head'] + '^{commit}'], capture_output=True).returncode, 0)
        self.assertGreater(int(subprocess.run(['git', '-C', str(work), 'rev-list', '--count', s['merge']], capture_output=True, text=True).stdout), 3)
        self.assertEqual(fields['notes_fetch'], 'ok')
        self.assertRegex(fields['policy_sha256'], r'^[0-9a-f]{16}$')
        self.assertRegex(fields['keys_sha256'], r'^[0-9a-f]{16}$')

    def test_a_note_for_the_merge_tree_alone_does_not_cover_a_pull_request_head(self):
        s = self.pull_request()
        self.note(s['merge'], s['merge_tree'], seconds=1)
        fields = self.assertRuns(s['base'], 'merge-tree note only', **self.pr_env(s))
        self.assertEqual((fields['tree_of'], fields['tree'], fields['outcome']), ('head', s['head_tree'], 'no_note'))

    def test_a_merge_group_run_never_uses_a_head_tree_note(self):
        s = self.pull_request()
        self.note(s['head'], s['head_tree'], seconds=1)
        fields = self.assertRuns(s['base'], 'merge group with a valid head-tree note', **self.pr_env(s, EVENT_NAME='merge_group'))
        self.assertEqual((fields['tree_of'], fields['tree'], fields['head_tree']), ('merge', s['merge_tree'], 'not-a-pull-request'))
        # And with a note for the merge group's own tree, only that may skip there.
        self.note(s['merge'], s['merge_tree'], seconds=2)
        fields, _ = self.run_gate(s['base'], **self.pr_env(s, EVENT_NAME='merge_group'))
        self.assertEqual((fields['decision'], fields['tree_of'], fields['tree']), ('skip', 'merge', s['merge_tree']))

    def test_every_failed_condition_falls_back_to_the_merge_tree_and_never_skips_on_the_head_note(self):
        s = self.pull_request()
        self.note(s['head'], s['head_tree'], seconds=1)
        other = self.f.git('rev-parse', s['tip'])
        cases = {
            'a fork': dict(HEAD_REPOSITORY='someone/fork'),
            'a draft': dict(PR_DRAFT='true'),
            'a draft flag that is not positively false': dict(PR_DRAFT=''),
            'pull_request_target': dict(EVENT_NAME='pull_request_target'),
            'a stale head (not the merge\'s second parent)': dict(PR_HEAD_SHA=other),
            'a short head sha': dict(PR_HEAD_SHA=s['head'][:12]),
            'a head object nobody has': dict(PR_HEAD_SHA='a' * 40),
            'no head sha': dict(PR_HEAD_SHA=''),
            'an author not on the list': dict(PR_USER='mallory'),
            'an actor not on the list': dict(ACTOR='mallory'),
            'a re-run by someone not on the list': dict(TRIGGERING_ACTOR='mallory'),
            'no actor at all': dict(ACTOR='', TRIGGERING_ACTOR=''),
            'no accepted base': dict(BASE_SHA=''),
        }
        for name, extra in cases.items():
            with self.subTest(name):
                env = self.pr_env(s, **extra)
                fields = self.assertRuns(env.pop('BASE_SHA', s['base']), name, **env)
                self.assertEqual(fields['tree_of'], 'merge', name)
                self.assertTrue(fields['head_tree'].startswith('fallback:') or fields['head_tree'] in ('-', 'not-a-pull-request'), (name, fields['head_tree']))
                self.assertEqual(fields['tree'], s['merge_tree'] if fields['tree'] != '-' else '-', name)

    def test_the_input_keyed_lookup_uses_the_head_trees_key_not_the_merge_trees(self):
        doc = json.loads(skip_policy())
        for entry in doc['checks'].values():
            entry['inputs'] = ['inputs.txt']
        s = self.pull_request(policy=json.dumps(doc), base_files={'inputs.txt': 'declared'}, main_files={'inputs.txt': 'main changed it'})
        key = fixtures.evidence_verify.project(str(self.f.repo), s['base_tree'], ('inputs.txt',))
        self.assertEqual(key, fixtures.evidence_verify.project(str(self.f.repo), s['head_tree'], ('inputs.txt',)))
        self.assertNotEqual(key, fixtures.evidence_verify.project(str(self.f.repo), s['merge_tree'], ('inputs.txt',)))  # main moved the input
        record = self.note(s['base'], s['base_tree'], inputs={'source_inputs': key}, seconds=1)
        self.f.git('update-ref', f'refs/notes/evidence-input/linux-gate/{key}/{record}', record)
        fields, outputs = self.run_gate(s['base'], **self.pr_env(s))
        self.assertEqual((fields['decision'], fields['tree_of'], fields['match'], fields['source_inputs'], outputs['record']),
                         ('skip', 'head', 'inputs', key, record))
        # The same run asking about the merge tree (a fork-like fallback) misses: its key moved with main.
        fields = self.assertRuns(s['base'], 'merge tree key', **self.pr_env(s, PR_USER='mallory'))
        self.assertEqual((fields['tree_of'], fields['outcome']), ('merge', 'no_note'))

    def test_a_repository_with_no_notes_yet_fetches_nothing_without_failing_and_the_check_runs(self):
        # Whether git calls a glob refspec that matches nothing a failure depends on its version and protocol (here: the one
        # in the test environment); either way the line says which, the outcome is no_note and the check runs.
        s = self.pull_request()
        fields = self.assertRuns(s['base'], 'no notes at all', **self.pr_env(s))
        self.assertIn(fields['notes_fetch'], ('ok', 'failed'))
        self.assertEqual((fields['outcome'], fields['tree_of']), ('no_note', 'head'))

    def test_the_notes_are_fetched_without_the_partial_clone_filter_so_their_blobs_arrive_at_once(self):
        """A pull request run deepens the history with a blob filter (a partial clone); a notes fetch that kept the filter would leave
        each note's blob to a lazy round trip when the verifier reads it (genie-freshness timed out at 30 s on a hosted runner)."""
        calls = []
        real_run = gate.run

        def fake(*command, **kwargs):
            calls.append(command)
            return real_run('true')
        context = gate.context_from({'CHECK': 'typescript-client', 'REPOSITORY': REPOSITORY, 'BASE_SHA': 'a' * 40, 'EVENT_NAME': 'pull_request'})
        gate.run = fake
        try:
            gate.observe(context, 'HEAD')
            gate.fetch_input_notes('/nonexistent-verifier', 'a' * 40, 'typescript-client', REPOSITORY, 'HEAD')
        finally:
            gate.run = real_run
        note_fetches = [c for c in calls if c[:2] == ('git', 'fetch') and any('refs/notes/evidence' in str(part) for part in c)]
        self.assertTrue(note_fetches)
        for command in note_fetches:
            self.assertIn('--no-filter', command)
        self.assertNotIn('--no-filter', [part for c in calls if c[:2] == ('git', 'fetch') and 'refs/notes' not in ' '.join(map(str, c)) for part in c])

    def test_a_notes_fetch_that_fails_is_logged_as_failed_not_as_no_note(self):
        calls = []
        real_run = gate.run

        def fake(*command, **kwargs):
            calls.append(command)
            done = real_run('true')
            if command[:2] == ('git', 'fetch') and any(str(part).startswith('refs/notes/evidence/*') for part in command):
                return real_run('false')
            return done
        context = gate.context_from({'CHECK': 'linux-gate', 'REPOSITORY': REPOSITORY, 'BASE_SHA': 'a' * 40, 'EVENT_NAME': 'pull_request'})
        gate.run = fake
        try:
            outcome, result, detail, sha = gate.observe(context, 'HEAD')
        finally:
            gate.run = real_run
        self.assertEqual(context['notes_fetch'], 'failed')
        self.assertTrue(any(str(part).startswith('refs/notes/evidence/*') for call in calls for part in call))
        self.assertEqual(outcome, 'unavailable')  # and the check runs

    def test_an_unreadable_policy_or_author_file_means_run(self):
        s = self.pull_request(policy='{ not json')
        self.note(s['head'], s['head_tree'], seconds=1)
        fields = self.assertRuns(s['base'], 'unparseable policy', **self.pr_env(s))
        self.assertEqual(fields['outcome'], 'unavailable')
        self.tmp_reset()
        s = self.pull_request(authors_text='{ not json')
        self.note(s['head'], s['head_tree'], seconds=1)
        fields = self.assertRuns(s['base'], 'unparseable author list', **self.pr_env(s))
        self.assertEqual(fields['tree_of'], 'merge')
        self.assertIn('authors', fields['head_tree'])

    def test_a_note_for_an_earlier_head_does_not_cover_a_force_pushed_head(self):
        s = self.pull_request()
        older = self.f.git('rev-parse', s['base'])
        self.note(older, s['base_tree'], seconds=1)  # signed for what the head was before the force-push
        fields = self.assertRuns(s['base'], 'older head signed', **self.pr_env(s))
        self.assertEqual((fields['tree_of'], fields['outcome']), ('head', 'no_note'))

    def test_the_same_head_can_run_and_then_skip_on_a_re_run_once_a_note_exists(self):
        s = self.pull_request()
        self.assertRuns(s['base'], 'before the agent signed', **self.pr_env(s))
        self.note(s['head'], s['head_tree'], seconds=1)
        fields, _ = self.run_gate(s['base'], **self.pr_env(s, RUN_ATTEMPT='2'))
        self.assertEqual((fields['decision'], fields['tree_of']), ('skip', 'head'))

    def test_the_base_copy_of_the_gate_runs_when_the_branch_rewrites_it(self):
        poison = ("import os\nopen(os.environ['GITHUB_OUTPUT'], 'a').write('outcome=satisfied\\nskip=true\\nrecord=" + 'a' * 40 +
                  "\\n')\nprint('POISON evidence-decision v1 decision=skip')\n")
        s = self.pull_request(head_files={'scripts/ci-evidence-gate': poison})
        self.note(s['head'], s['head_tree'], seconds=1)
        outputs, printed = self.run_step(s['base'], **self.pr_env(s))
        self.assertEqual(outputs['skip'], 'false')
        self.assertNotIn('POISON', printed)
        self.assertIn('evidence-decision v1', printed)

    def test_after_a_fallback_the_old_merge_tree_note_still_works_as_before(self):
        s = self.pull_request()
        self.note(s['merge'], s['merge_tree'], seconds=1)
        fields, _ = self.run_gate(s['base'], **self.pr_env(s, PR_USER='mallory'))
        self.assertEqual((fields['decision'], fields['tree_of'], fields['tree']), ('skip', 'merge', s['merge_tree']))

    def test_a_commit_by_an_unlisted_email_in_the_branch_falls_back(self):
        s = self.pull_request(head_email='stranger@example.invalid')
        self.note(s['head'], s['head_tree'], seconds=1)
        fields = self.assertRuns(s['base'], 'unlisted commit author', **self.pr_env(s))
        self.assertEqual(fields['tree_of'], 'merge')
        self.assertIn('authors', fields['head_tree'])

    def test_a_branch_that_edits_a_protected_file_falls_back_even_with_a_valid_head_note(self):
        for path in ('scripts/ci-evidence-gate', 'scripts/evidence-verify', '.st/evidence-skip-policy.json', '.st/evidence-keys',
                     '.github/workflows/fleet.yml'):
            with self.subTest(path):
                self.tmp_reset()
                s = self.pull_request(head_files={path: 'edited by the branch\n'})
                self.note(s['head'], s['head_tree'], seconds=1)
                fields = self.assertRuns(s['base'], path, **self.pr_env(s))
                self.assertEqual((fields['tree_of'], fields['head_tree']), ('merge', 'fallback:protected_files_differ_from_the_branch_point'))

    def test_main_changing_a_protected_file_after_the_branch_point_falls_back(self):
        s = self.pull_request(main_files={'.st/evidence-skip-policy.json': skip_policy(trust_levels=['fleet']) + '\n'})
