#!/usr/bin/env python3
"""One frozen hosted collections study. No baseline fallback, retry or adjusted CPU claim."""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

BASE = '352c4f8fc205c76d5a37cf1125dbab23bebe51e9'
BASE_TREE = 'beded621d3ef087c1a149797796e5dff6814a212'
CANDIDATE = '446c4f4c4a83a3fd47d2ee2a93d61deeeea2c177'
CANDIDATE_TREE = 'b3d7b11a6b3cdf8312b9088afc16e5e1dec96b4d'
ASSIGNMENT = 'doc/fleet/smalltalk/speed/2026-10-09/shared-collections-v1-pair-assignment@2d25669da2d9b694cf702f61654abdfb2e11404b8c9ee74ef93b23a7cf6da60a'
COMPOSITION = 'doc/fleet/smalltalk/ivm-lists/2026-10-09/collections-v1-composition@d7e9397acbaf1a53322fdfa4e7a9ae7bba7778448328312c44df5fb695f8231b'
TRACKING_RUN = 'mission-run/fleet/smalltalk/ci-speed/shared-collections-v1-study-2026-10-09/1'
ORDER = ('B1', 'C1', 'C2', 'B2')
TEST = 'daemon_load::the_daemon_keeps_its_budgets_under_a_busy_hosts_load'
COLLECTIONS = ('missions', 'work', 'attention', 'summary', 'glasses', 'arrangements')
LOAD = 'crates/st3/tests/daemon_load.rs'
REFRESHER_LINES = ('        // And the attention, summary, glasses and arrangements views.\n',
                   '        st3::api::start_attention_list(&state);\n',
                   '        st3::api::start_published_lists(&state);\n')
RECIPE = ('Cargo.lock', 'flake.lock', 'flake.nix', 'Cargo.toml', '.cargo/config.toml',
          'crates/st3/Cargo.toml', 'crates/st3/tests/daemon_bench.rs', 'docs/st3/schema.md',
          'scripts/ci-perf', '.github/workflows/perf.yml')


def digest(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()


def write(path, data):
    Path(path).write_text(json.dumps(data, indent=2, allow_nan=False) + '\n')


def git(work, *args):
    return subprocess.check_output(['git', '-C', str(work), *args], text=True).strip()


def normalize_harness(source):
    for line in REFRESHER_LINES:
        source = source.replace(line, '')
    return source


def inputs(directory):
    result = {}
    for stem in ('generated-1.sqlite3', 'generated-1-peer.sqlite3'):
        path = Path(directory) / stem
        if not path.is_file():
            raise ValueError('missing standard generated source: ' + stem)
        for suffix in ('', '-wal'):
            item = Path(str(path) + suffix)
            result[stem + suffix] = digest(item) if item.is_file() else None
    return result


def logged(argv, cwd, env, log):
    started = time.monotonic_ns()
    with Path(log).open('wb') as stream:
        completed = subprocess.run(argv, cwd=cwd, env=env, stdout=stream, stderr=subprocess.STDOUT)
    return dict(argv=[str(x) for x in argv], cwd=str(cwd), returncode=completed.returncode,
                start_monotonic_ns=started, terminal_monotonic_ns=time.monotonic_ns(),
                log_sha256=digest(log))


def number(value):
    return type(value) in (float, int) and math.isfinite(value) and value >= 0


def validate_report(report, regime, source):
    if (report.get('profile') != 'collections-v1' or report.get('scale') != 1
            or not number(report.get('seconds')) or report['seconds'] < 120
            or type(report.get('claims')) is not int or report['claims'] <= 0
            or report.get('regime') != regime or report.get('actual_ci_checkout') != source
            or not number(report.get('daemon_cores')) or not isinstance(report.get('failed'), dict)
            or not isinstance(report.get('collection_subscribers'), dict)):
        raise ValueError('unsupported/partial report profile, scale, time, source or regime')
    cpu = report.get('study_cpu_observation')
    if not isinstance(cpu, dict) or cpu.get('reconcile_adjustment_qualified') is not False:
        raise ValueError('missing raw CPU observation / unsupported adjusted CPU qualification')
    for field in ('process_start_seconds', 'process_end_seconds', 'excluded_threads_start_seconds',
                  'excluded_threads_end_seconds', 'daemon_cpu_seconds', 'denominator_seconds'):
        if not number(cpu.get(field)):
            raise ValueError('missing/nonfinite raw CPU component: ' + field)
    if cpu['denominator_seconds'] != report['seconds'] or cpu['denominator_seconds'] <= 0:
        raise ValueError('unsupported raw CPU denominator')
    for prefix in ('process', 'excluded_threads'):
        if cpu[prefix + '_end_seconds'] < cpu[prefix + '_start_seconds']:
            raise ValueError('CPU counter moved backwards')
    raw = cpu['process_end_seconds'] - cpu['process_start_seconds'] - (
        cpu['excluded_threads_end_seconds'] - cpu['excluded_threads_start_seconds'])
    if not math.isclose(raw, cpu['daemon_cpu_seconds'], abs_tol=1e-9):
        raise ValueError('raw CPU components do not agree')
    if not math.isclose(cpu['daemon_cpu_seconds'] / cpu['denominator_seconds'], report['daemon_cores'], abs_tol=1e-9):
        raise ValueError('raw CPU denominator does not agree')
    clocks = ('before_sample_begin_ns', 'before_sample_end_ns', 'workload_start_ns',
              'workload_stop_ns', 'drain_end_ns', 'after_sample_begin_ns', 'after_sample_end_ns')
    stamps = [cpu.get(field) for field in clocks]
    if any(type(x) is not int or x < 0 for x in stamps) or stamps != sorted(stamps):
        raise ValueError('missing/reversed monotonic CPU/workload/drain bounds')
    for collection in ('agents roster',) + COLLECTIONS:
        for suffix in (' snapshot', ' connect+snapshot'):
            path = report.get('paths', {}).get(collection + suffix)
            if not isinstance(path, dict) or any(not number(path.get(key)) for key in ('count', 'p99_ms', 'p50_ms', 'max_ms', 'budget_ms')):
                raise ValueError('missing/invalid collection samples: ' + collection + suffix)
    # Correctness failures/counts are retained, never changed into a pass here.
    return report


def selection(log, status):
    text = Path(log).read_text(errors='replace')
    starts = re.findall(r'^running \d+ tests?$', text, re.M)
    results = re.findall(r'^test result: .*$', text, re.M)
    expected = r'test result: (ok\. 1 passed; 0 failed|FAILED\. 0 passed; 1 failed); 0 ignored; 0 measured; \d+ filtered out; finished in \d+(?:\.\d+)?s'
    if starts != ['running 1 test'] or len(results) != 1 or not re.fullmatch(expected, results[0]):
        raise ValueError('not exactly one nonignored release workload execution')
    if status not in (0, 101) or (status == 0) != results[0].startswith('test result: ok.'):
        raise ValueError('interrupted/setup/indeterminate or inconsistent workload status')


def aggregate(executions):
    output = {'reconcile_mode_rule': 'UNKNOWN in every regime: no qualified in-window reconcile seam; no favorable mode selection',
              'within_mode_comparison': 'UNKNOWN', 'adjusted_cores': None,
              'raw_no_worse_observations': [], 'collections': {}}
    by_label = {row['label']: row for row in executions}
    if set(by_label) != set(ORDER):
        output['partial'] = True
        return output
    for regime in ('upgrade-under-load', 'steady-after-migration'):
        pairs = [(by_label[b]['reports'][regime], by_label[c]['reports'][regime])
                 for b, c in (('B1', 'C1'), ('B2', 'C2'))]
        output['raw_no_worse_observations'].append(dict(regime=regime, comparisons=[
            dict(baseline=b['daemon_cores'], candidate=c['daemon_cores'], no_worse=c['daemon_cores'] <= b['daemon_cores']) for b, c in pairs]))
        paths = {}
        for collection, prefix in [('agents', 'agents roster')] + [(c, c) for c in COLLECTIONS]:
            for suffix in (' snapshot', ' connect+snapshot'):
                name = prefix + suffix
                bvalues = [b['paths'][name]['p99_ms'] for b, _ in pairs]
                cvalues = [c['paths'][name]['p99_ms'] for _, c in pairs]
                paths[name] = dict(baseline_p99_ms=bvalues, candidate_p99_ms=cvalues,
                    paired_delta_ms=[c - b for b, c in zip(bvalues, cvalues)],
                    baseline_mean_ms=sum(bvalues) / 2, candidate_mean_ms=sum(cvalues) / 2,
                    baseline_spread_ms=max(bvalues) - min(bvalues), candidate_spread_ms=max(cvalues) - min(cvalues),
                    requested_candidate_strict_under_300_ms=all(c < 300 for c in cvalues),
                    counts=[dict(baseline=b['paths'][name]['count'], candidate=c['paths'][name]['count']) for b, c in pairs],
                    correctness=[dict(baseline=(b.get('roster_subscribers') if collection == 'agents' else b['collection_subscribers'].get(collection)) == 22 and b['paths'][name]['count'] == 22 and not any(b['failed'].values()),
                                      candidate=(c.get('roster_subscribers') if collection == 'agents' else c['collection_subscribers'].get(collection)) == 22 and c['paths'][name]['count'] == 22 and not any(c['failed'].values()),
                                      baseline_failures=b['failed'], candidate_failures=c['failed']) for b, c in pairs])
        output['collections'][regime] = paths
    output['partial'] = False
    output['qualified_combined_cpu_conclusion'] = 'UNKNOWN; raw observations cannot be rescued by adjusted/historical 2x policy'
    return output


def prepare(work, out):
    if os.environ.get('GITHUB_ACTIONS') != 'true' or os.environ.get('GITHUB_RUN_ATTEMPT') != '1':
        raise ValueError('hosted first-attempt study only; no local execution or workflow retry')
    if os.environ.get('COLLECTIONS_STUDY_RUN') != TRACKING_RUN:
        raise ValueError('missing exact study run created before dispatch')
    out.mkdir()  # fresh owned allocation, never resume an earlier execution
    state = dict(tracking_run=TRACKING_RUN, runner_class='nscloud-ubuntu-24.04-amd64-8x16-with-features; existing manual Performance priority2', assignment=ASSIGNMENT, composition=COMPOSITION, order=ORDER,
                 stalled_after_seconds=3600,
                 control_source=git(work, 'rev-parse', 'HEAD'), runner={key: os.environ.get(key) for key in
                 ('GITHUB_REPOSITORY', 'GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'GITHUB_JOB', 'RUNNER_NAME', 'RUNNER_OS', 'RUNNER_ARCH')}, arms={})
    write(out / 'manifest.json', state)
    patch = work / 'scripts/collections-v1-observation.patch'
    state['measurement_patch_sha256'] = digest(patch)
    for arm, source, tree in [('B', BASE, BASE_TREE), ('C', CANDIDATE, CANDIDATE_TREE)]:
        subprocess.run(['git', '-C', str(work), 'fetch', 'origin', source], check=True)
        dest = out / arm
        subprocess.run(['git', '-C', str(work), 'worktree', 'add', '--detach', str(dest), source], check=True)
        if git(dest, 'rev-parse', 'HEAD^{tree}') != tree or git(dest, 'status', '--porcelain'):
            raise ValueError('source/tree/cleanliness mismatch for ' + arm)
        subprocess.run(['git', '-C', str(dest), 'apply', '--check', str(patch)], check=True)
        subprocess.run(['git', '-C', str(dest), 'apply', str(patch)], check=True)
        state['arms'][arm] = dict(source=source, tree=tree, path=str(dest),
            harness_sha256=digest(dest / LOAD), recipes={p: digest(dest / p) for p in set(RECIPE) | set(git(dest, 'ls-files', '**/Cargo.toml').splitlines())})
        evidence = out / 'source' / arm
        evidence.mkdir(parents=True)
        shutil.copyfile(dest / LOAD, evidence / 'daemon_load.rs')
        (evidence / 'measurement-overlay.diff').write_text(git(dest, 'diff', '--', LOAD) + '\n')
    b, c = state['arms']['B'], state['arms']['C']
    if b['recipes'] != c['recipes'] or normalize_harness((Path(b['path']) / LOAD).read_text()) != normalize_harness((Path(c['path']) / LOAD).read_text()):
        raise ValueError('incompatible generator/lock/Nix/config/harness pairing')
    state['phase'] = 'prepared; no build or workload'
    write(out / 'manifest.json', state)


def run(work, out):
    state = json.loads((out / 'manifest.json').read_text())
    builds, executions = {}, []
    result = dict(manifest=state, builds=builds, executions=executions, complete=False, errors=[],
                  toolchain={name: dict(path=shutil.which(name), sha256=digest(shutil.which(name)))
                             for name in ('cargo', 'rustc') if shutil.which(name)},
                  compiler_environment={key: os.environ.get(key) for key in ('CARGO_BUILD_JOBS', 'CARGO_INCREMENTAL',
                      'CARGO_PROFILE_DEV_DEBUG', 'CARGO_PROFILE_TEST_DEBUG', 'RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS',
                      'RUSTC_WRAPPER', 'CARGO_HOME', 'SCCACHE_DIR', 'PATH')})
    try:
        # Both complete release artifacts are built before any fixture executes.
        for arm in ('B', 'C'):
            source = state['arms'][arm]
            cwd = Path(source['path'])
            env = dict(os.environ, CARGO_TARGET_DIR=str(out / ('target-' + arm)), GITHUB_SHA=source['source'], AGENT_SPEC_REVISION=source['source'])
            argv = ['cargo', 'test', '--release', '-p', 'st3', '--features', 'perf-load', '--test', 'perf_load', '--locked', '--no-run', '--message-format=json']
            build = logged(argv, cwd, env, out / ('build-' + arm + '.log'))
            builds[arm] = build
            if build['returncode'] == 0:
                artifacts = []
                for line in (out / ('build-' + arm + '.log')).read_text().splitlines():
                    try:
                        row = json.loads(line)
                    except ValueError:
                        continue
                    if row.get('reason') == 'compiler-artifact' and row.get('target', {}).get('name') == 'perf_load' and row.get('executable'):
                        if row.get('profile', {}).get('debug_assertions'):
                            raise ValueError('debug artifact cannot qualify')
                        artifacts.append(row['executable'])
                if len(artifacts) != 1:
                    raise ValueError('missing/ambiguous release artifact')
                binary = out / 'binaries' / arm
                binary.parent.mkdir(exist_ok=True)
                shutil.copy2(artifacts[0], binary)
                build['original_binary'] = artifacts[0]
                build['binary'] = str(binary)
                build['binary_sha256'] = digest(binary)
            write(out / 'result.json', result)
        if any(row['returncode'] for row in builds.values()):
            raise ValueError('source build failure; no measured execution')
        fixture = out / 'standard-generated-inputs'
        fixture.mkdir()
        frozen_inputs = None
        for label in ORDER:
            arm = label[0]
            source, build = state['arms'][arm], builds[arm]
            if digest(build['binary']) != build['binary_sha256']:
                raise ValueError('release binary changed')
            if frozen_inputs is not None and inputs(fixture) != frozen_inputs:
                raise ValueError('immutable input changed before ' + label)
            directory = out / label
            directory.mkdir()
            env = dict(os.environ)
            for key in ('ST_LOAD_BASELINE', 'ST_BENCH_STORE', 'ST_BENCH_SCALE', 'ST_BENCH_GATE', 'ST_LOAD_PROFILE', 'ST_LOAD_SCALE', 'ST_LOAD_SECONDS', 'ST_LOAD_GATE', 'ST_BENCH_DIR', 'ST_LOAD_REPORT'):
                env.pop(key, None)
            env.update(ST_LOAD_PROFILE='collections-v1', ST_LOAD_SCALE='1', ST_LOAD_SECONDS='120', ST_LOAD_GATE='1',
                       ST_BENCH_DIR=str(fixture), ST_LOAD_REPORT=str(directory / 'load.json'), GITHUB_SHA=source['source'])
            argv = [build['binary'], TEST, '--exact', '--nocapture', '--test-threads', '1']
            row = dict(label=label, source=source['source'], tree=source['tree'], binary_sha256=build['binary_sha256'],
                       env={key: env[key] for key in ('ST_LOAD_PROFILE', 'ST_LOAD_SCALE', 'ST_LOAD_SECONDS', 'ST_LOAD_GATE', 'ST_BENCH_DIR', 'ST_LOAD_REPORT', 'GITHUB_SHA')},
                       historical_baseline=None, inputs_before=frozen_inputs, reports={})
            executions.append(row)
            row.update(logged(argv, source['path'], env, directory / 'load.log'))
            row['validation_errors'] = []
            try:
                selection(directory / 'load.log', row['returncode'])
            except ValueError as exc:
                row['validation_errors'].append(str(exc))
            if row['returncode'] not in (0, 101):
                raise ValueError('interrupted/indeterminate workload; no automatic continuation')
            for regime, path in [('upgrade-under-load', directory / 'upgrade/load.json'), ('steady-after-migration', directory / 'load.json')]:
                try:
                    report = json.loads(path.read_text())
                    row['reports'][regime] = report
                    validate_report(report, regime, source['source'])
                except (ValueError, OSError, KeyError) as exc:
                    row['validation_errors'].append(regime + ': ' + str(exc))
            current = inputs(fixture)
            if frozen_inputs is None:
                frozen_inputs = current
                write(out / 'immutable-inputs.json', dict(hashes=current, recipe=state['arms']['B']['recipes'], generation_source=BASE))
            if current != frozen_inputs:
                raise ValueError('immutable input changed during ' + label)
            row['inputs_after'] = current
            write(out / 'result.json', result)
        result['complete'] = True
    except (ValueError, OSError, KeyError, subprocess.SubprocessError) as exc:
        result['errors'].append(str(exc))
    result['data_complete'] = result['complete'] and all(not row['validation_errors'] for row in executions)
    result['comparison'] = aggregate(executions) if result['data_complete'] else {'partial': True, 'within_mode_comparison': 'UNKNOWN', 'adjusted_cores': None}
    result['all_absolute_workloads_passed'] = result['data_complete'] and all(row['returncode'] == 0 for row in executions)
    result['overall_qualification'] = 'UNKNOWN: unqualified reconcile attribution/mode; all observed failures retained'
    write(out / 'result.json', result)
    return 0 if result['all_absolute_workloads_passed'] else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('phase', choices=('prepare', 'run'))
    parser.add_argument('--out', required=True, type=Path)
    args = parser.parse_args()
    work = Path(__file__).resolve().parent.parent
    if args.phase == 'prepare':
        prepare(work, args.out)
        return 0
    return run(work, args.out)


if __name__ == '__main__':
    sys.exit(main())
