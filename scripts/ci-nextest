#!/usr/bin/env bash
# Select Cargo targets before building; nextest's ci filter only selects tests after the build.
set -euo pipefail
action=${1:?usage: scripts/ci-nextest run|list [nextest options]}
shift
case "$action" in
  run|list) ;;
  *) echo "unknown nextest action: $action" >&2; exit 2 ;;
esac

partition=()
if [[ -n "${CI_TEST_PARTITION:-}" ]]; then
  [[ "$CI_TEST_PARTITION" =~ ^hash:[12]/2$ ]] || { echo 'invalid CI_TEST_PARTITION' >&2; exit 2; }
  if [[ " $* " != *" --no-run "* ]]; then partition=(--partition "$CI_TEST_PARTITION"); fi
fi

# ci1's zpty completion phase is temporarily gated; all other shell assertions remain active.
if [[ "$action" == run && " $* " != *" --no-run "* && "${GITHUB_ACTIONS:-}" == true && -n "${CI_LOCAL_CARGO_HOME:-}" ]]; then
  reason='ci1 zsh completion phase temporarily gated; Bash/Fish and Namespace zsh remain checked. https://github.com/compoundingtech/smalltalk/issues/1344'
  printf '::warning::%s\n' "$reason"
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    printf '### Temporary test gate\n\n%s\n' "$reason" >> "$GITHUB_STEP_SUMMARY"
  fi
fi

# Use the same selections for --no-run and execution, on Linux and macOS. Keep both groups
# running after a test failure, as the ci profile does with fail-fast = false.
status=0
if [[ -n "${CI_TEST_EXTRACTED:-}" ]]; then
  [[ " $* " != *" --no-run "* ]] || { echo 'archive consumers must not rebuild' >&2; exit 2; }
  for group in workspace st2; do
    target="$CI_TEST_EXTRACTED/$group/target"
    cargo nextest "$action" --binaries-metadata "$target/nextest/binaries-metadata.json" \
      --cargo-metadata "$target/nextest/cargo-metadata.json" --target-dir-remap "$target" \
      --workspace-remap "$CI_TEST_WORKSPACE" --profile ci "${partition[@]}" "$@" || status=$?
  done
else
  cargo nextest "$action" --workspace --exclude st2 --locked --profile ci "${partition[@]}" "$@" || status=$?
  # Keep the original st2 target selection for local and macOS runs.
  cargo nextest "$action" -p st2 --test integration --test agent_resource --test driver_expansion \
    --locked --profile ci "${partition[@]}" "$@" || status=$?
fi
exit "$status"
