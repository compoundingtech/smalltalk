#!/usr/bin/env bash
# Compile the workspace and preserve the selected test binaries with nextest filters.
set -euo pipefail
action=${1:?usage: scripts/ci-nextest run|list [nextest options]}
shift
case "$action" in
  run|list) ;;
  *) echo "unknown nextest action: $action" >&2; exit 2 ;;
esac

partition=()
if [[ -n "${CI_TEST_PARTITION:-}" ]]; then
  [[ "$CI_TEST_PARTITION" =~ ^hash:([12]/2|[1234]/4)$ ]] || { echo 'invalid CI_TEST_PARTITION' >&2; exit 2; }
  if [[ " $* " != *" --no-run "* ]]; then partition=(--partition "$CI_TEST_PARTITION"); fi
fi

# ci1's zpty completion phase is temporarily gated; all other shell assertions remain active.
if [[ "$action" == run && " $* " != *" --no-run "* && "${GITHUB_ACTIONS:-}" == true && -n "${CI_LOCAL_CARGO_HOME:-}" ]]; then
  reason='ci1 zsh completion phase temporarily gated; Bash/Fish and Namespace zsh remain checked. https://github.com/compoundingtech/smalltalk/issues/1344'
  printf '::warning::%s\n' "$reason"
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    printf '### Temporary test gate\n\n%s\n' "$reason" >> "$GITHUB_STEP_SUMMARY"
  fi
fi

# Keep the former workspace and three legacy integration targets in one invocation.
# Intersect caller filtersets with this binary selection, including when callers ignore
# the profile's default test filter. Multiple caller filtersets retain nextest's union.
if [[ -n "${CI_TEST_EXTRACTED:-}" ]]; then
  target="$CI_TEST_EXTRACTED/workspace/target"
  selection=$(python3 scripts/ci-nextest-targets --metadata "$target/nextest/cargo-metadata.json")
else
  selection=$(python3 scripts/ci-nextest-targets)
fi
# Wait-bound tests take one slot and every other test takes SLOT_RATIO (.config/nextest-slots.toml),
# so the caller's --test-threads N still means N CPU-sized tests at once.
SLOT_RATIO=3
arguments=()
filters=()
test_threads=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -j|--test-threads)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || { echo 'invalid --test-threads' >&2; exit 2; }
      test_threads=$2; shift 2 ;;
    --test-threads=*)
      test_threads=${1#*=}
      [[ "$test_threads" =~ ^[1-9][0-9]*$ ]] || { echo 'invalid --test-threads' >&2; exit 2; }
      shift ;;
    -E|--filterset|--filter-expr)
      [[ $# -ge 2 && -n "$2" ]] || { echo 'missing nextest filterset' >&2; exit 2; }
      filters+=("$2"); shift 2 ;;
    --filterset=*|--filter-expr=*) filters+=("${1#*=}"); shift ;;
    -E?*) filters+=("${1#-E}"); shift ;;
    *) arguments+=("$1"); shift ;;
  esac
done
if [[ ${#filters[@]} -gt 0 ]]; then
  requested=""
  for filter in "${filters[@]}"; do
    if [[ -n "$requested" ]]; then requested+=" or "; fi
    requested+="($filter)"
  done
  selection="($selection) and ($requested)"
fi
# Without a thread count there is nothing to scale: keep the profile's own count and slots.
slots=()
if [[ "$action" == run && -n "$test_threads" && " ${arguments[*]} " != *" --no-run "* ]]; then
  slots=(--test-threads "$((test_threads * SLOT_RATIO))" --tool-config-file "slots:$PWD/.config/nextest-slots.toml")
fi
if [[ -n "${CI_TEST_EXTRACTED:-}" ]]; then
  [[ " ${arguments[*]} " != *" --no-run "* ]] || { echo 'archive consumers must not rebuild' >&2; exit 2; }
  target="$CI_TEST_EXTRACTED/workspace/target"
  exec cargo nextest "$action" --binaries-metadata "$target/nextest/binaries-metadata.json" \
    --cargo-metadata "$target/nextest/cargo-metadata.json" --target-dir-remap "$target" \
    --workspace-remap "$CI_TEST_WORKSPACE" --profile ci -E "$selection" "${partition[@]}" "${slots[@]}" "${arguments[@]}"
else
  exec cargo nextest "$action" --workspace --locked --profile ci -E "$selection" "${partition[@]}" "${slots[@]}" "${arguments[@]}"
fi
