#!/usr/bin/env bash
# Compile the workspace and preserve the selected test binaries with nextest filters.
set -euo pipefail
action=${1:?usage: scripts/ci-nextest run|list [nextest options]}
shift
case "$action" in
  run|list) ;;
  *) echo "unknown nextest action: $action" >&2; exit 2 ;;
esac

partition=()
if [[ -n "${CI_TEST_PARTITION:-}" ]]; then
  [[ "$CI_TEST_PARTITION" =~ ^hash:([12]/2|[1234]/4)$ ]] || { echo 'invalid CI_TEST_PARTITION' >&2; exit 2; }
  if [[ " $* " != *" --no-run "* ]]; then partition=(--partition "$CI_TEST_PARTITION"); fi
fi

# ci1's zpty completion phase is temporarily gated; all other shell assertions remain active.
if [[ "$action" == run && " $* " != *" --no-run "* && "${GITHUB_ACTIONS:-}" == true && -n "${CI_LOCAL_CARGO_HOME:-}" ]]; then
  reason='ci1 zsh completion phase temporarily gated; Bash/Fish and Namespace zsh remain checked. https://github.com/compoundingtech/smalltalk/issues/1344'
  printf '::warning::%s\n' "$reason"
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    printf '### Temporary test gate\n\n%s\n' "$reason" >> "$GITHUB_STEP_SUMMARY"
  fi
fi

launch=(exec)
# Local runs on Linux keep the tests' temporary files in tmpfs. Their SQLite stores sync every WAL commit to
# disk, and that wait, not CPU, is most of the wall time of the file-store tests (the st3 library set: 251 s
# on /dev/shm against 407 s on disk with the same CPU, scratch peak about 0.5 GiB either way; four convergence
# seeds: 48 s against 160 s). CI never takes this branch, so the hosted runs keep real disks and every test that
# syncs to one. It applies only when TMPDIR is unset or one of the two ordinary directories, and when /dev/shm
# has 4 GiB free (a check at start, not a reservation: concurrent local runs share that RAM); ST_NEXTEST_TMPDIR=disk turns it off, and a TMPDIR you set yourself is kept.
if [[ "$action" == run && -z "${GITHUB_ACTIONS:-}" && "$(uname -s)" == Linux && "${ST_NEXTEST_TMPDIR:-}" != disk ]]; then
  case "${TMPDIR:-}" in
    ''|/tmp|/tmp/|/var/tmp|/var/tmp/)
      if [[ -d /dev/shm && -w /dev/shm ]] && [[ "$(df -Pk /dev/shm | awk 'NR==2 {print $4}')" -ge $((4 * 1024 * 1024)) ]]; then
        # One directory per run, removed when the run ends. A run killed with SIGKILL leaves it behind in RAM:
        # sweep with `find /dev/shm -maxdepth 1 -name 'st-nextest.*' -mmin +1440 -exec rm -rf {} +`.
        nextest_scratch=$(mktemp -d /dev/shm/st-nextest.XXXXXX) && {
          export TMPDIR=$nextest_scratch
          trap 'rm -rf "$nextest_scratch"' EXIT
          trap 'exit 143' TERM INT HUP
          launch=()
          echo "ci-nextest: test temporary files in $nextest_scratch (ST_NEXTEST_TMPDIR=disk to use the disk)" >&2
        }
      fi ;;
  esac
fi

# Keep the former workspace and three legacy integration targets in one invocation.
# Intersect caller filtersets with this binary selection, including when callers ignore
# the profile's default test filter. Multiple caller filtersets retain nextest's union.
if [[ -n "${CI_TEST_EXTRACTED:-}" ]]; then
  target="$CI_TEST_EXTRACTED/workspace/target"
  selection=$(python3 scripts/ci-nextest-targets --metadata "$target/nextest/cargo-metadata.json")
else
  selection=$(python3 scripts/ci-nextest-targets)
fi
arguments=()
filters=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -E|--filterset|--filter-expr)
      [[ $# -ge 2 && -n "$2" ]] || { echo 'missing nextest filterset' >&2; exit 2; }
      filters+=("$2"); shift 2 ;;
    --filterset=*|--filter-expr=*) filters+=("${1#*=}"); shift ;;
    -E?*) filters+=("${1#-E}"); shift ;;
    *) arguments+=("$1"); shift ;;
  esac
done
if [[ ${#filters[@]} -gt 0 ]]; then
  requested=""
  for filter in "${filters[@]}"; do
    if [[ -n "$requested" ]]; then requested+=" or "; fi
    requested+="($filter)"
  done
  selection="($selection) and ($requested)"
fi
if [[ -n "${CI_TEST_EXTRACTED:-}" ]]; then
  [[ " ${arguments[*]} " != *" --no-run "* ]] || { echo 'archive consumers must not rebuild' >&2; exit 2; }
  target="$CI_TEST_EXTRACTED/workspace/target"
  "${launch[@]}" cargo nextest "$action" --binaries-metadata "$target/nextest/binaries-metadata.json" \
    --cargo-metadata "$target/nextest/cargo-metadata.json" --target-dir-remap "$target" \
    --workspace-remap "$CI_TEST_WORKSPACE" --profile ci -E "$selection" "${partition[@]}" "${arguments[@]}"
else
  "${launch[@]}" cargo nextest "$action" --workspace --locked --profile ci -E "$selection" "${partition[@]}" "${arguments[@]}"
fi
