#!/usr/bin/env bash
# Run one performance stage inside the pinned devShell: the cost check or the load test.
# Each is its own GitHub Actions job; neither is part of the required linux-gate (docs/ci.md).
set -euo pipefail
stage=${1:?usage: scripts/ci-perf cost|load}
# Logs and reports stay outside the checkout: the public-content test scans untracked files.
out="$RUNNER_TEMP/perf"
mkdir -p "$out"
# Generated stores live outside target/, which the Cargo cache saves: a store generated by an
# older generator must never be reused.
export ST_BENCH_DIR="$RUNNER_TEMP/st-bench" TMPDIR="$RUNNER_TEMP"
mkdir -p "$ST_BENCH_DIR"

summarize_cost() {
  local report=$1
  {
    printf '\n%s claims and %s claims. A request fails when its work grows more than %sx faster than its answer.\n\n' \
      "$(jq -r '.claims[0]' "$report")" "$(jq -r '.claims[1]' "$report")" "$(jq -r '.growth_limit' "$report")"
    printf '| Request | VM steps | at 10x | Full-scan steps | at 10x |\n| --- | ---: | ---: | ---: | ---: |\n'
    jq -r '.small as $s | .large | to_entries[] |
      "| \(.key) | \($s[.key].vm_steps) | \(.value.vm_steps) | \($s[.key].fullscan_steps) | \(.value.fullscan_steps) |"' "$report"
    jq -r 'if (.failures | length) > 0 then "\n**Failures**\n\n" + (.failures | map("- " + .) | join("\n")) else "" end' "$report"
  } >> "$GITHUB_STEP_SUMMARY"
}

summarize_load() {
  local report=$1
  {
    printf '\nScale %s, %s claims, %.0f s, daemon %.2f cores.\n\n' \
      "$(jq -r '.scale' "$report")" "$(jq -r '.claims' "$report")" "$(jq -r '.seconds' "$report")" \
      "$(jq -r '.daemon_cores' "$report")"
    printf '| Request | n | p50 ms | p99 ms | max ms | budget ms |\n| --- | ---: | ---: | ---: | ---: | ---: |\n'
    jq -r '.paths | to_entries[] |
      "| \(.key) | \(.value.count) | \(.value.p50_ms | floor) | \(.value.p99_ms | floor) | \(.value.max_ms | floor) | \(.value.budget_ms | floor) |"' "$report"
  } >> "$GITHUB_STEP_SUMMARY"
}

start=$SECONDS status=0
case "$stage" in
  cost)
    # One cargo invocation builds and runs: a second one reruns a vendored build script and
    # recompiles st3. The counts do not depend on the build's speed, so the job's lightly
    # optimized build only makes the stores generate faster. The counts are the whole
    # process's, so nothing else may run beside the check.
    ST_COST_REPORT="$out/cost.json" cargo test -p st3 --test integration --locked daemon_cost:: \
      -- --nocapture --test-threads 1 2>&1 | tee "$out/cost.log" || status=$?
    [ -f "$out/cost.json" ] && summarize_cost "$out/cost.json"
    ;;
  load)
    # Main's last reports, newest first; the test compares with the worst of them.
    ST_LOAD_GATE=1 ST_LOAD_REPORT="$out/load.json" ST_LOAD_BASELINE="$RUNNER_TEMP/perf-baseline" \
      cargo test --release -p st3 --test integration --locked daemon_load:: -- --nocapture \
      2>&1 | tee "$out/load.log" || status=$?
    [ -f "$out/load.json" ] && summarize_load "$out/load.json"
    ;;
  *) echo "unknown stage: $stage" >&2; exit 2 ;;
esac
result=passed
[ "$status" -eq 0 ] || result=failed
printf '%s %s\n' "$((SECONDS - start))" "$status" > "$out/$stage.time"
printf '| %s | %s | %ss | %s |\n' "$stage" "$result" "$((SECONDS - start))" "$status" >> "$GITHUB_STEP_SUMMARY"
exit "$status"
