#!/usr/bin/env bash
# Run one performance stage inside the pinned devShell: the cost check or the load test.
# Each is its own GitHub Actions job; neither is part of the required linux-gate (docs/ci.md).
set -euo pipefail
stage=${1:?usage: scripts/ci-perf cost|load}
# Logs and reports stay outside the checkout: the public-content test scans untracked files.
out="$RUNNER_TEMP/perf"
mkdir -p "$out"
# Generated stores live outside target/, which the Cargo cache saves: a store generated by an
# older generator must never be reused.
export ST_BENCH_DIR="$RUNNER_TEMP/st-bench" TMPDIR="$RUNNER_TEMP"
mkdir -p "$ST_BENCH_DIR"

summarize_cost() {
  local report=$1
  {
    printf '\n%s claims and %s claims. A request fails when its work grows more than %sx faster than its answer.\n\n' \
      "$(jq -r '.claims[0]' "$report")" "$(jq -r '.claims[1]' "$report")" "$(jq -r '.growth_limit' "$report")"
    printf '| Request | VM steps | at 10x | Full-scan steps | at 10x |\n| --- | ---: | ---: | ---: | ---: |\n'
    jq -r '.small as $s | .large | to_entries[] |
      "| \(.key) | \($s[.key].vm_steps) | \(.value.vm_steps) | \($s[.key].fullscan_steps) | \(.value.fullscan_steps) |"' "$report"
    jq -r 'if (.failures | length) > 0 then "\n**Failures**\n\n" + (.failures | map("- " + .) | join("\n")) else "" end' "$report"
  } >> "$GITHUB_STEP_SUMMARY"
}

summarize_load() {
  local report=$1
  {
    printf '\nScale %s, %s claims, %.0f s, daemon %.2f cores.\n\n' \
      "$(jq -r '.scale' "$report")" "$(jq -r '.claims' "$report")" "$(jq -r '.seconds' "$report")" \
      "$(jq -r '.daemon_cores' "$report")"
    printf '| Request | n | p50 ms | p99 ms | max ms | budget ms |\n| --- | ---: | ---: | ---: | ---: | ---: |\n'
    jq -r '.paths | to_entries[] |
      "| \(.key) | \(.value.count) | \(.value.p50_ms | floor) | \(.value.p99_ms | floor) | \(.value.max_ms | floor) | \(.value.budget_ms | floor) |"' "$report"
  } >> "$GITHUB_STEP_SUMMARY"
}

start=$SECONDS status=0
case "$stage" in
  cost)
    # Owned quarantine (merge-queue-flakes): retain the complete link-minutes oracle,
    # run once without retries, and report its failure independently of cost results.
    # Finish the isolated native case before process-wide cost measurements start.
    link_start=$SECONDS link_status=0
    cargo test -p st3 --features test-support --test integration --locked messaging_faults::link_minutes \
      -- --exact --nocapture --test-threads 1 2>&1 | tee "$out/link-minutes.log" || link_status=$?
    if [ "$link_status" -eq 0 ]; then
      python3 - "$out/link-minutes.log" <<'PY' || link_status=$?
from pathlib import Path
import re
import sys

lines = Path(sys.argv[1]).read_text().splitlines()
selections = [line for line in lines if re.fullmatch(r"running \d+ tests?", line)]
summaries = [line for line in lines if line.startswith("test result:")]
passing = r"test result: ok\. 1 passed; 0 failed; 0 ignored; 0 measured; \d+ filtered out; finished in \d+(?:\.\d+)?s"
# supervise_test reexecutes this one test under its guardian; the outer test only
# checks the child's exit. Both harnesses must select and pass exactly one test.
if selections != ["running 1 test", "running 1 test"] or len(summaries) != 2 or not all(re.fullmatch(passing, row) for row in summaries):
    sys.exit("::error::link-minutes quarantine did not pass exactly one supervised case")
PY
    fi
    link_result=passed
    [ "$link_status" -eq 0 ] || link_result=failed
    printf '%s %s\n' "$((SECONDS - link_start))" "$link_status" > "$out/link-minutes.time"
    printf '| link-minutes quarantine (owner: merge-queue-flakes) | %s | %ss | %s |\n' "$link_result" "$((SECONDS - link_start))" "$link_status" >> "$GITHUB_STEP_SUMMARY"
    status=$link_status
    rm -f "$out/cost.json"
    # One st3 cargo invocation builds and runs. Counts do not depend on build speed, so
    # the job's lightly optimized build only makes the stores generate faster. Counts are the whole
    # process's, so nothing else may run beside the check.
    ST_COST_REPORT="$out/cost.json" cargo test -p st3 --test integration --locked daemon_cost:: \
      -- --nocapture --test-threads 1 2>&1 | tee "$out/cost.log" || status=$?
    if [ -s "$out/cost.json" ]; then
      summarize_cost "$out/cost.json"
    else
      echo "::error::cost check produced no measurement report"
      status=1
    fi
    # Keep real-network timing separate from the required deterministic retry controls.
    # Run after cost measurement: no other test may contaminate its process-wide counts.
    outbound_start=$SECONDS outbound_status=0
    cargo test -p smallclaims --lib --locked \
      sync::worker::tests::retry_tests::isolated_outbound_only_node_converges_after_two_minutes_and_four_hours \
      -- --exact --nocapture --test-threads 1 2>&1 | tee "$out/outbound-only.log" || outbound_status=$?
    if [ "$outbound_status" -eq 0 ]; then
      python3 - "$out/outbound-only.log" <<'PY' || outbound_status=$?
from pathlib import Path
import re
import sys

lines = Path(sys.argv[1]).read_text().splitlines()
selections = [line for line in lines if re.fullmatch(r"running \d+ tests?", line)]
summaries = [line for line in lines if line.startswith("test result:")]
passing = r"test result: ok\. 1 passed; 0 failed; 0 ignored; 0 measured; \d+ filtered out; finished in \d+(?:\.\d+)?s"
if selections != ["running 1 test"] or len(summaries) != 1 or not re.fullmatch(passing, summaries[0]):
    sys.exit("::error::outbound-only timing check did not run exactly one passing test")
PY
    fi
    outbound_result=passed
    [ "$outbound_status" -eq 0 ] || outbound_result=failed
    printf '%s %s\n' "$((SECONDS - outbound_start))" "$outbound_status" > "$out/outbound-only.time"
    printf '| outbound-only timing | %s | %ss | %s |\n' "$outbound_result" "$((SECONDS - outbound_start))" "$outbound_status" >> "$GITHUB_STEP_SUMMARY"
    if [ "$status" -eq 0 ]; then status=$outbound_status; fi
    ;;
  load)
    rm -f "$out/load.json"
    # Record the inputs before Cargo runs. Only an exact clean source SHA may restore
    # these timestamps, avoiding needless rebuilds after a fresh checkout on retries.
    python3 scripts/ci-perf-cache remember-sources
    unset AGENT_SPEC_REVISION
    if [ -s "$RUNNER_TEMP/perf-source-state.json" ]; then
      # The checkpoint exists only for a clean checkout. Use its actual full source SHA,
      # so index/refs timestamps do not invalidate an unchanged build on retries.
      export AGENT_SPEC_REVISION="$(git rev-parse HEAD)"
    fi
    # Main's last reports, newest first; the test compares with the worst of them.
    ST_LOAD_NATIVE_ADMISSION_CONTROL=1 ST_LOAD_GATE=1 ST_LOAD_REPORT="$out/load.json" ST_LOAD_BASELINE="$RUNNER_TEMP/perf-baseline" \
      cargo test --release -p st3 --features perf-load --test perf_load --locked daemon_load:: -- --nocapture \
      2>&1 | tee "$out/load.log" || status=$?
    if [ -s "$out/load.json" ]; then
      summarize_load "$out/load.json"
    else
      echo "::error::load test produced no measurement report"
      status=1
    fi
    ;;
  *) echo "unknown stage: $stage" >&2; exit 2 ;;
esac
result=passed
[ "$status" -eq 0 ] || result=failed
printf '%s %s\n' "$((SECONDS - start))" "$status" > "$out/$stage.time"
printf '| %s | %s | %ss | %s |\n' "$stage" "$result" "$((SECONDS - start))" "$status" >> "$GITHUB_STEP_SUMMARY"
exit "$status"
