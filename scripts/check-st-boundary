#!/usr/bin/env python3
"""Fail CI if st and its UI library import or depend on the independently maintained st2 crate."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode = True
from st_boundary import dependency_findings, source_findings


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    metadata = json.loads(subprocess.check_output(
        ["cargo", "metadata", "--format-version", "1", "--no-deps", "--locked"], cwd=args.root))
    findings = [*source_findings(args.root), *dependency_findings(metadata)]
    for finding in findings:
        print(finding, file=sys.stderr)
    if findings:
        return 1
    print("st and UI library source and dependency boundary passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
