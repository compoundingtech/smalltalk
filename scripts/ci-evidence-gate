#!/usr/bin/env python3
"""Evidence gate for one required check: may CI skip it because a trusted note already covers it?

Asks the verifier from the accepted base whether a trusted note exists for this run's tree
and check, and prints one decision line. It fails toward running: every doubt, error,
timeout or inconsistency is `decision=run`. It never fails the job.

Outcomes (each has a fixed step name in the workflow so a collector can count them):
  satisfied    a trusted full-tier note from the central observer exists
  degraded     only an unsigned degraded note exists (the observer's signer was unreachable)
  no_note      nothing usable was found for this tree and check
  rejected     a note exists but was refused (bad signature, untrusted signer, failed check ...)
  unavailable  the verifier or the notes could not be obtained
`decision=skip` additionally needs every condition in `decide` to hold.

Which tree: a `pull_request` run checks out GitHub's merge of the head into the CURRENT base, which is a new tree
whenever main moved. For such a run the gate asks about the tree of the PULL REQUEST HEAD commit instead (the tree an
agent built and signed; GitHub attaches the required checks to that sha), but only when every condition in
`choose_tree` holds; otherwise it asks about the merge tree, as before. A merge_group run always uses its own tree.
"""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

sys.dont_write_bytecode = True

# What may be skipped is decided by the repository's skip policy (.st/evidence-skip-policy.json,
# read from the accepted base by the verifier): kinds, commands, required inputs, trust levels and
# any maximum age. This script only adds what no policy can say: who may skip and when.
SKIP_EVENTS = ('pull_request', 'merge_group')
VERIFIER_TIMEOUT = int(os.environ.get('GATE_VERIFIER_TIMEOUT', '30'))
# A change that touches anything that decides a skip is never skipped: those files are what
# a forged skip would have to edit. Compared between the accepted base and this run's tree.
PROTECTED = (
    'scripts/ci-evidence-gate', 'scripts/evidence-verify', '.st/evidence-skip-policy.json', '.st/evidence-keys',
    '.github/workflows/fleet.yml', '.github/workflows/fleet.yml.genie.ts', '.github/workflows/workspace-ci.ts',
    'scripts/ci-evidence-gate-test', 'scripts/evidence-verify-test',
    # What decides who may have a head tree used: the author list and the rule that reads it.
    '.st/evidence-authors.json', 'scripts/ci-evidence-signing',
)

NOTES = 'refs/notes/evidence/*:refs/notes/evidence/*'
CHECK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,99}')
VERIFIER = 'scripts/evidence-verify'
KEYS = '.st/evidence-keys'
POLICY = '.st/evidence-skip-policy.json'
MISSING = ('no_record', 'stale_tree', 'wrong_check')
UNAVAILABLE = ('error', 'no_policy')
OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
TOKEN = re.compile(r'^[A-Za-z0-9._:/@+=-]+$')


def classify(code, result):
    """Outcome name for a verifier exit code and JSON document."""
    if not isinstance(result, dict):
        return 'unavailable'
    if code == 0 and result.get('satisfied') is True:
        return 'satisfied' if result.get('tier') == 'full' else 'rejected'
    reason = result.get('reason')
    if reason == 'degraded':
        return 'degraded'
    if reason in MISSING:
        return 'no_note'
    if reason in UNAVAILABLE or reason is None:
        return 'unavailable'
    return 'rejected'


def run(*command, stdin=None, timeout=120):
    return subprocess.run(command, input=stdin, capture_output=True, timeout=timeout, check=False)


def decide(context, outcome, result, tree):
    """(decision, why). Skip only if every single condition holds."""
    if outcome != 'satisfied' or not isinstance(result, dict):
        return 'run', 'no trusted note'
    if context['fork'] != 'false':
        return 'run', 'fork or unknown head repository'
    if context['event'] not in SKIP_EVENTS:
        return 'run', 'event does not allow skipping'
    if context.get('tree_of') == 'head' and context['event'] != 'pull_request':
        return 'run', 'a head-tree note covers pull request runs only'
    if context.get('protected_changed') != []:
        return 'run', 'a file that decides skipping changed, or could not be compared'
    checks = [
        (not sampled(context, result, tree), 'sampled: the real job runs anyway, to compare it with the note'),
        (result.get('enforce') is True, 'shadow: the note would cover this check, but the skip policy has not turned skipping on for it'),
        (result.get('events') is None or context['event'] in result['events'],
         'the policy does not let this signer level cover this event (a host key covers pull requests only)'),
        (result.get('satisfied') is True, 'verifier did not report satisfied'),
        (result.get('policy') is True, 'the skip policy was not applied'),
        (result.get('tier') == 'full', 'tier is not full'),
        (isinstance(result.get('kind'), str) and TOKEN.match(result['kind']) is not None, 'no kind'),
        (isinstance(result.get('trust_level'), str) and TOKEN.match(result['trust_level']) is not None,
         'no trust level'),
        (result.get('tree') == tree and OID.match(tree or '') is not None, 'tree differs from this run'),
        (result.get('check') == context['check'], 'check differs from this job'),
        (isinstance(result.get('record'), str) and OID.match(result['record']) is not None, 'no record id'),
        (isinstance(result.get('signer'), str) and TOKEN.match(result['signer']) is not None, 'no signer'),
        (age_of(result) is not None and age_of(result) >= -120, 'time out of order'),
    ]
    for ok, why in checks:
        if not ok:
            return 'run', why
    return 'skip', 'covered by a trusted full-tier note'


def sampled(context, result, tree):
    """True when this run is one the policy keeps running for real although a note matches (one in `sample_one_in`).
    Deterministic in (check, input key, head), so a retry of the same run behaves the same.
    The head is in the seed, so on a pull request an author can re-push to change whether a run is sampled
    (about five tries at one in five); in a merge group the head is fixed. It is a comparison sample, not a security control."""
    every = result.get('sample_one_in')
    if isinstance(every, bool) or not isinstance(every, int) or every < 1:
        return True  # a missing or unreadable sampling rule samples: the verifier always reports it, so its absence is a fault
    if every == 1:
        return False
    seed = f"{context['check']}:{result.get('source_inputs') or tree}:{context.get('head', '')}"
    return int(hashlib.sha256(seed.encode()).hexdigest()[:8], 16) % every == 0


def age_of(result):
    try:
        moment = datetime.fromisoformat(str(result['observed_at']).replace('Z', '+00:00'))
        if moment.tzinfo is None:
            return None
        return int((datetime.now(timezone.utc) - moment).total_seconds())
    except (KeyError, ValueError):
        return None


def protected_changes(base):
    """Protected paths that differ between the accepted base and this run's tree; fails closed."""
    if not base:
        return ['<no base>']
    # --no-renames: with rename detection a moved file is reported only by its new name, which would
    # hide moving a protected file away.
    done = run('git', 'diff', '--no-renames', '--name-only', '-z', base, 'HEAD')
    if done.returncode != 0:
        return ['<comparison failed>']
    paths = [p for p in done.stdout.decode(errors='replace').split('\0') if p]
    return [p for p in paths if p in PROTECTED]


def observe(context, revision='HEAD'):
    """(outcome, result dict or None, detail, verifier sha256) without ever raising."""
    base, check, repository = context['base'], context['check'], context['repository']
    if not base:
        return 'unavailable', None, 'no accepted base commit for this event', None
    if run('git', 'fetch', '--no-tags', '--depth=1', '-q', 'origin', base).returncode != 0:
        return 'unavailable', None, 'could not fetch the accepted base', None
    # --no-filter: choose_tree may have made this a partial clone (history without blobs); the notes' blobs must arrive in this one fetch,
    # not one lazy round trip each when the verifier reads them (that took more than the verifier's 30 seconds on a runner).
    context['notes_fetch'] = 'ok' if run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', NOTES).returncode == 0 else 'failed'
    for name, path in (('policy_sha256', POLICY), ('keys_sha256', KEYS)):
        shown = run('git', 'show', f'{base}:{path}')
        context[name] = hashlib.sha256(shown.stdout).hexdigest()[:16] if shown.returncode == 0 else 'none'
    script = run('git', 'show', f'{base}:{VERIFIER}')
    if script.returncode != 0:
        return 'unavailable', None, 'the accepted base has no verifier yet', None
    digest = hashlib.sha256(script.stdout).hexdigest()
    with tempfile.TemporaryDirectory() as scratch:
        path = os.path.join(scratch, 'evidence-verify')
        with open(path, 'wb') as handle:
            handle.write(script.stdout)
        if run('git', 'cat-file', '-e', f'{base}:{KEYS}').returncode == 0:
            keys = ['--keys-from', base]
        else:
            # No trusted keys yet: nothing signed can be trusted, but a degraded note can still be counted.
            empty = os.path.join(scratch, 'empty-keys')
            open(empty, 'w').close()
            keys = ['--keys', empty]
        fetch_input_notes(path, base, check, repository, revision)
        done = run(sys.executable, path, '--repo', '.', '--revision', revision, '--check', check,
                   '--policy-from', base, '--repository', repository, *keys, timeout=VERIFIER_TIMEOUT)
    try:
        result = json.loads(done.stdout)
    except ValueError:  # includes output that is not valid UTF-8
        return 'unavailable', None, f'verifier exit {done.returncode} without a JSON result', digest
    return classify(done.returncode, result), result, result.get('reason') or 'satisfied', digest


def fetch_input_notes(verifier, base, check, repository, revision='HEAD'):
    """For a check that declares inputs: fetch only the records indexed under this tree's input key.
    Best effort: a failure here just means no input-keyed record is seen, and the check runs."""
    if not CHECK_NAME.fullmatch(check):
        return
    try:
        done = run(sys.executable, verifier, '--repo', '.', '--revision', revision, '--check', check, '--project',
                   '--policy-from', base, '--repository', repository, timeout=VERIFIER_TIMEOUT)
        key = json.loads(done.stdout).get('source_inputs') if done.returncode == 0 else None
    except (ValueError, AttributeError, subprocess.TimeoutExpired, OSError):
        return
    if isinstance(key, str) and OID.match(key):
        prefix = f'refs/notes/evidence-input/{check}/{key}'
        run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', f'{prefix}/*:{prefix}/*')


def field(value):
    """One token for the decision line: no spaces, '-' for none."""
    text = '-' if value is None or value == '' else str(value)
    return text if TOKEN.match(text) else re.sub(r'[^A-Za-z0-9._:/@+=-]', '_', text)


def line(context, decision, outcome, result, detail, tree, verifier_sha, gate_sha):
    result = result if isinstance(result, dict) else {}
    age = age_of(result) if result.get('satisfied') is True else None
    fields = [
        ('check', context['check']), ('decision', decision), ('outcome', outcome), ('reason', detail),
        ('record', result.get('record')), ('signer', result.get('signer')),
        ('trust_level', result.get('trust_level')), ('kind', result.get('kind')), ('tier', result.get('tier')),
        ('observed_at', result.get('observed_at')), ('age_s', age), ('max_age_s', result.get('max_age_s')),
        ('attempts', result.get('attempts')), ('enforce', result.get('enforce')), ('match', result.get('match')),
        ('source_inputs', result.get('source_inputs')), ('tree', tree), ('tree_of', context.get('tree_of')),
        ('pr_head', context.get('pr_head')), ('merge_tree', context.get('merge_tree')), ('head_tree', context.get('head_tree')),
        ('notes_fetch', context.get('notes_fetch')), ('policy_sha256', context.get('policy_sha256')), ('keys_sha256', context.get('keys_sha256')),
        ('head', context['head']),
        ('base', context['base']), ('event', context['event']), ('pr', context['pr']),
        ('repo', context['repository']), ('run', context['run']), ('attempt', context['attempt']),
        ('fork', context['fork']), ('verifier_sha256', verifier_sha), ('gate_sha256', gate_sha),
    ]
    return 'evidence-decision v1 ' + ' '.join(f'{key}={field(value)}' for key, value in fields)


def context_from(environ):
    repository = environ.get('REPOSITORY', '')
    head_repository = environ.get('HEAD_REPOSITORY', '')
    # Anything but a positively identical head repository is treated as a fork.
    fork = 'false' if repository and head_repository == repository else 'true'
    return {
        'check': environ.get('CHECK', ''), 'repository': repository, 'base': environ.get('BASE_SHA', ''),
        'head': environ.get('HEAD_SHA', ''), 'event': environ.get('EVENT_NAME', ''),
        'pr': environ.get('PR_NUMBER', ''), 'run': environ.get('RUN_ID', ''),
        'attempt': environ.get('RUN_ATTEMPT', ''), 'fork': fork,
        'pr_head': environ.get('PR_HEAD_SHA', ''), 'pr_user': environ.get('PR_USER', ''), 'actor': environ.get('ACTOR', ''),
        'triggering_actor': environ.get('TRIGGERING_ACTOR', ''), 'draft': environ.get('PR_DRAFT', ''),
        'tree_of': 'merge', 'merge_tree': None, 'head_tree': '-', 'notes_fetch': '-', 'policy_sha256': '-', 'keys_sha256': '-',
    }


class Fallback(Exception):
    """A condition for using the pull request head's tree failed: ask about the merge tree instead."""


def git_out(*args, check=True):
    done = run('git', *args)
    if check and done.returncode != 0:
        raise Fallback(f'git {args[0]} failed')
    return done.stdout.decode(errors='replace').strip()


def base_signing_module(base):
    """scripts/ci-evidence-signing as it is at the accepted base: its check_authors is the rule that decides who
    may have a pull request run signed, and the pull request cannot change it."""
    shown = run('git', 'show', f'{base}:scripts/ci-evidence-signing')
    if shown.returncode != 0:
        raise Fallback('the accepted base has no ci-evidence-signing')
    with tempfile.TemporaryDirectory() as scratch:
        path = os.path.join(scratch, 'ci_evidence_signing')
        with open(path, 'wb') as handle:
            handle.write(shown.stdout)
        loader = importlib.machinery.SourceFileLoader('base_ci_evidence_signing', path)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
    return module


def choose_tree(context):
    """The revision whose tree this run asks about, and why not the pull request head when it is the merge.

    Uses the pull request head only for a same-repository pull_request run, and only when all of these hold:
    the payload head is a full object id that is present or fetchable; the checked-out commit is the merge whose
    second parent IS that head (or the head itself); the PR author, the actor and the triggering actor are on the
    author list at the BASE and every non-merge commit in the branch has a listed author and committer (the signing
    guard's own check, taken from the base); and no protected file differs between the branch point and the head, nor
    between the branch point and the base (main's protected files moved since the branch). Any failure is a Fallback."""
    merge_tree = git_out('rev-parse', '--verify', 'HEAD^{tree}', check=False) or None
    context['merge_tree'] = merge_tree
    if context['event'] != 'pull_request':
        context['head_tree'] = 'not-a-pull-request'
        return 'HEAD', None
    try:
        if context['fork'] != 'false':
            raise Fallback('not from this repository')
        if context['draft'] != 'false':
            raise Fallback('not positively a non-draft pull request')
        head, base = context['pr_head'], context['base']
        if not OID.match(head or '') or not OID.match(base or ''):
            raise Fallback('no full head or base object id')
        if not (context['pr_user'] and context['actor'] and context['triggering_actor']):
            raise Fallback('the opener, actor or triggering actor is not known')
        # History work first, and all of it before the depth-1 fetch of the base in observe() would cut it.
        if git_out('rev-parse', '--is-shallow-repository') == 'true' and \
                run('git', 'fetch', '--no-tags', '-q', '--filter=blob:none', '--unshallow', 'origin').returncode != 0:
            raise Fallback('could not deepen the history')
        if run('git', 'cat-file', '-e', f'{head}^{{commit}}').returncode != 0 and \
                run('git', 'fetch', '--no-tags', '-q', 'origin', head).returncode != 0:
            raise Fallback('the head commit is not available')
        checked_out = git_out('rev-parse', 'HEAD')
        second_parent = git_out('rev-parse', '--verify', '-q', 'HEAD^2', check=False)
        if checked_out != head and second_parent != head:
            raise Fallback('the checked-out commit is not the merge of this head')
        if run('git', 'cat-file', '-e', f'{base}^{{commit}}').returncode != 0 and \
                run('git', 'fetch', '--no-tags', '-q', '--filter=blob:none', 'origin', base).returncode != 0:
            raise Fallback('the accepted base is not available')
        try:
            base_signing_module(base).check_authors(base, head, context['pr_user'], context['actor'], context['triggering_actor'])
        except Fallback:
            raise
        except BaseException as error:  # Refused, or anything the base's script raises
            raise Fallback(f'authors: {str(error)[:120]}')
        branch_point = git_out('merge-base', base, head)
        current = git_out('rev-parse', '--verify', '-q', 'HEAD^1', check=False) if checked_out != head else base
        changed = []
        for first, second in ((branch_point, head), (branch_point, base), (branch_point, current or base)):
            diff = run('git', 'diff', '--no-renames', '--name-only', '-z', first, second)
            if diff.returncode != 0:
                raise Fallback('could not compare protected files')
            changed += [p for p in diff.stdout.decode(errors='replace').split('\0') if p in PROTECTED]
        if changed:
            raise Fallback('protected files differ from the branch point')
        context['tree_of'], context['head_tree'] = 'head', 'used'
        return head, []
    except Fallback as reason:
        context['head_tree'] = 'fallback:' + str(reason).replace(' ', '_')
    except Exception as error:
        context['head_tree'] = f'fallback:{type(error).__name__}'
    context['tree_of'] = 'merge'
    return 'HEAD', None


def main():
    context = context_from(os.environ)
    outcome, result, detail, verifier_sha, tree = 'unavailable', None, 'not run', None, None
    revision, protected = 'HEAD', None
    try:
        context['merge_tree'] = git_out('rev-parse', '--verify', 'HEAD^{tree}', check=False) or None
    except Exception:
        pass
    try:
        revision, protected = choose_tree(context)
    except Exception as error:  # never raise out of the gate
        context['head_tree'] = f'fallback:{type(error).__name__}'
        context['tree_of'] = 'merge'
    try:
        if not context['check']:
            detail = 'no check named'
        else:
            done = run('git', 'rev-parse', '--verify', f'{revision}^{{tree}}')
            tree = done.stdout.decode().strip() if done.returncode == 0 else None
            if tree is None:
                detail = 'could not read this run\'s tree'
            else:
                outcome, result, detail, verifier_sha = observe(context, revision)
    except Exception as error:  # the gate must never fail the job
        outcome, result, detail = 'unavailable', None, f'{type(error).__name__}: {error}'
    try:
        # In head-tree mode the branch point decides (choose_tree compared it); otherwise the base against this run's tree.
        context['protected_changed'] = protected if protected is not None else protected_changes(context['base'])
    except Exception:
        context['protected_changed'] = ['<comparison failed>']
    try:
        decision, why = decide(context, outcome, result, tree)
    except Exception:
        decision, why = 'run', 'decision error'
    if decision == 'run' and outcome == 'satisfied' and why != 'no trusted note':
        detail = f'satisfied but not skipped: {why}'
    with open(__file__, 'rb') as handle:
        gate_sha = hashlib.sha256(handle.read()).hexdigest()
    text = line(context, decision, outcome, result, detail, tree, verifier_sha, gate_sha)
    print(text)
    record = (result or {}).get('record') if decision == 'skip' else None
    for variable, body in (('GITHUB_OUTPUT', f'outcome={outcome}\nskip={"true" if decision == "skip" else "false"}\n'
                                             f'record={field(record)}\n'),
                           ('GITHUB_STEP_SUMMARY', text + '\n')):
        target = os.environ.get(variable)
        if target:
            with open(target, 'a') as handle:
                handle.write(body)
    return 0


if __name__ == '__main__':
    sys.exit(main())
