#!/usr/bin/env python3
"""Rank the files that make open pull requests conflict with main.

For every open pull request this runs `git merge-tree --write-tree` of its head against
origin/main (no working tree is touched) and counts each conflicted file and conflict hunk.
A file is "generated" when .gitattributes marks it `linguist-generated=true`; those must
never conflict, because regenerating them from merged source gives the same bytes.

    scripts/conflict-census            # text report
    scripts/conflict-census --json     # machine-readable, for the before/after table
    scripts/conflict-census --top 40   # rows to print (default 25)

Needs `gh` for the open-PR list and git 2.38+ for merge-tree.

Run it in a throwaway clone or worktree, not a shared checkout, and not on a loaded host: it
updates origin/main, force-writes one ref per open PR under refs/census/ (refs of PRs that are no
longer open are deleted first) and, because merge-tree --write-tree writes tree objects, leaves
loose objects in the repository for `git gc` to collect. A failed gh, fetch or git command stops
it with that command's error; only merge-tree's exit status 1 means "conflicts". It reads which
files are generated from .gitattributes at the base ref, so it can run from any directory of the
clone.
"""
import argparse
import collections
import json
import re
import subprocess
import sys


def run(*args, ok=(0,)):
    done = subprocess.run(args, capture_output=True, text=True)
    if done.returncode not in ok:
        sys.exit(f"{' '.join(args)}: {done.stderr.strip()}")
    return done


def repository():
    """OWNER/REPO of origin, so gh does not depend on the directory it runs in."""
    url = run("git", "remote", "get-url", "origin").stdout.strip()
    match = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", url)
    if not match:
        sys.exit(f"cannot read OWNER/REPO from origin url {url}")
    return match.group(1)


def open_prs():
    listing = run("gh", "pr", "list", "-R", repository(), "--state", "open", "--limit", "1000",
                  "--json", "number,mergeable,isDraft").stdout
    return {pr["number"]: pr for pr in json.loads(listing)}


def generated_patterns(base):
    patterns = []
    shown = run("git", "show", f"{base}:.gitattributes", ok=(0, 128))
    for line in shown.stdout.splitlines():
        parts = line.split()
        if parts and not parts[0].startswith("#") and "linguist-generated=true" in parts[1:]:
            patterns.append(parts[0])
    return patterns


def glob_regex(pattern):
    out = ""
    index = 0
    while index < len(pattern):
        if pattern.startswith("**/", index):
            out += "(?:.*/)?"
            index += 3
        elif pattern.startswith("**", index):
            out += ".*"
            index += 2
        elif pattern[index] == "*":
            out += "[^/]*"
            index += 1
        else:
            out += re.escape(pattern[index])
            index += 1
    # A pattern without a slash matches at any depth, as in .gitattributes.
    prefix = "" if "/" in pattern else "(?:.*/)?"
    return re.compile("^" + prefix + out + "$")


def conflicts(base, refs):
    """Merge each ref into base without touching a work tree; return who conflicts and where.

    refs maps a label to a git ref. Returns (label -> conflicted paths, path -> labels, path -> hunks).
    """
    files = collections.Counter()
    hunks = collections.Counter()
    conflicted = {}
    for label in sorted(refs):
        done = run("git", "merge-tree", "--write-tree", "--name-only", "--no-messages", "-z",
                   base, refs[label], ok=(0, 1))
        if done.returncode == 0:
            continue
        # -z: the tree id, then NUL-separated paths, then a NUL and any informational messages.
        tree, _, rest = done.stdout.partition("\0")
        tree = tree.strip()
        paths = sorted({path for path in rest.split("\0\0")[0].split("\0") if path})
        conflicted[label] = paths
        for path in paths:
            files[path] += 1
            text = run("git", "show", f"{tree}:{path}", ok=(0, 128)).stdout
            hunks[path] += len(re.findall(r"^<<<<<<< ", text, re.M))
    return conflicted, files, hunks


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--top", type=int, default=25)
    parser.add_argument("--base", default="origin/main")
    args = parser.parse_args()

    run("git", "fetch", "-q", "origin", "main")
    prs = open_prs()
    stale = run("git", "for-each-ref", "--format=%(refname)", "refs/census/").stdout.split()
    for ref in stale:
        run("git", "update-ref", "-d", ref)
    refspecs = [f"+refs/pull/{n}/head:refs/census/{n}" for n in prs]
    for start in range(0, len(refspecs), 100):
        run("git", "fetch", "-q", "origin", *refspecs[start:start + 100])
    generated = [glob_regex(p) for p in generated_patterns(args.base)]

    def is_generated(path):
        return any(rx.match(path) for rx in generated)

    conflicted, files, hunks = conflicts(args.base, {n: f"refs/census/{n}" for n in prs})

    only_generated = [n for n, paths in conflicted.items() if all(is_generated(p) for p in paths)]
    any_generated = [n for n, paths in conflicted.items() if any(is_generated(p) for p in paths)]
    github = collections.Counter(pr["mergeable"] for pr in prs.values())
    report = {
        "base": run("git", "rev-parse", "--short", args.base).stdout.strip(),
        "open_prs": len(prs),
        "github_mergeable": dict(github),
        "merge_tree_conflicting_prs": len(conflicted),
        "conflicting_prs_touching_generated_files": len(any_generated),
        "conflicting_prs_with_only_generated_files": len(only_generated),
        "files": [
            {"file": f, "prs": n, "hunks": hunks[f], "generated": is_generated(f)}
            for f, n in files.most_common()
        ],
    }
    if args.json:
        json.dump(report, sys.stdout, indent=2)
        print()
        return
    print(f"base {report['base']}: {len(prs)} open PRs, GitHub says {dict(github)}")
    print(f"merge-tree: {len(conflicted)} conflict; {len(any_generated)} touch a generated file; "
          f"{len(only_generated)} conflict only in generated files")
    print(f"{'PRs':>4} {'hunks':>5}  file")
    for row in report["files"][:args.top]:
        print(f"{row['prs']:>4} {row['hunks']:>5}  {row['file']}{'  [generated]' if row['generated'] else ''}")


if __name__ == "__main__":
    main()
