#!/usr/bin/env python3
"""Select st2's catalog/supervisor suite without skipping shared-code changes."""

import argparse
import re
import subprocess


ST2_REST = re.compile(
    r"^(?:agent_author|catalog[^:]*|eval_run|resync|resource_profile_supervisor)::"
    r"|^(?:catalog_[^:]*|nomad_survival|event_e2e|eval_run_e2e|resync[^:]*|"
    r"supervisor_auto_archive|resource_profile_supervisor_e2e)::"
)
ST2_USED = re.compile(
    r"^src/(?:driver[^/]*|[^/]*channel[^/]*|hooks|message[^/]*|harness_state|"
    r"[^/]*session[^/]*|codex_app_server)(?:\.rs|/.*)$"
)
ST2_REST_FILE = re.compile(
    r"^tests/(?:catalog_[^/]*|nomad_survival|event_e2e|eval_run_e2e|resync[^/]*|"
    r"supervisor_auto_archive|resource_profile_supervisor_e2e)\.rs$"
)


def st3_only(path):
    if path.startswith((
        "crates/st3/", "crates/st3-client/", "crates/st3-client-codegen/",
        "crates/st3-schema/", "crates/st3-migrate/", "clients/", "docs/",
        "examples/st3/", "evals/st3/", "st3-claude-channel/", "hooks/",
    )):
        return True
    if path.startswith("scripts/st3-") or ST2_USED.fullmatch(path):
        return True
    # Shared support and the module manifest are not individual test files.
    if re.fullmatch(r"tests/[^/]+\.rs", path):
        return path != "tests/integration.rs" and not ST2_REST_FILE.fullmatch(path)
    return False


def selection(event, paths):
    # Scheduled main runs cover the complete suite every day. Main pushes retain
    # the st3/common suite; PRs use the complete diff, including deletions/renames.
    if event == "schedule" or (event == "pull_request" and not all(map(st3_only, paths))):
        return "all()", "st2 catalog and supervisor tests enabled"
    return (
        "not (package(=st2) and (test(/" + ST2_REST.pattern + "/) or "
        "binary(=event_e2e) or binary(=resource_profile_supervisor_e2e)))",
        "st2 catalog and supervisor tests not needed",
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--event", choices=("pull_request", "push", "schedule", "workflow_dispatch"), required=True)
    parser.add_argument("--base")
    parser.add_argument("--head")
    parser.add_argument("--github-output")
    args = parser.parse_args()
    paths = []
    if args.event == "pull_request":
        if not args.base or not args.head:
            parser.error("pull_request requires --base and --head")
        diff = subprocess.check_output([
            "git", "diff", "--name-only", "--no-renames", "-z",
            f"{args.base}...{args.head}", "--",
        ])
        paths = [path.decode() for path in diff.split(b"\0") if path]
    event = "schedule" if args.event == "workflow_dispatch" else args.event
    expression, reason = selection(event, paths)
    print(reason)
    if args.github_output:
        with open(args.github_output, "a", encoding="utf-8") as output:
            output.write(f"filter={expression}\nreason={reason}\n")
    else:
        print(expression)


if __name__ == "__main__":
    main()
