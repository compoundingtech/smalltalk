#!/usr/bin/env python3
"""Require a disjoint, complete union of every real nextest shard selection."""
import json
import os
from pathlib import Path
import subprocess


def selected(output):
    decoder = json.JSONDecoder()
    tests = set()
    while output.strip():
        document, end = decoder.raw_decode(output.lstrip())
        output = output.lstrip()[end:]
        for binary, suite in document["rust-suites"].items():
            for name, test in suite["testcases"].items():
                if not test["ignored"] and test["filter-match"]["status"] == "matches":
                    key = (binary, name)
                    if key in tests:
                        raise ValueError(f"duplicate selected test: {key}")
                    tests.add(key)
    return tests


def verify(full, *shards):
    if not full or len(shards) not in (2, 4) or not all(shards):
        raise ValueError("full inventory and every shard must be nonempty; count must be two or four")
    union = set()
    for shard in shards:
        if union & shard:
            raise ValueError(f"shards overlap: {sorted(union & shard)}")
        union |= shard
    if union != full:
        raise ValueError(f"incomplete shards: missing={sorted(full - union)}; extra={sorted(union - full)}")


def verify_tiers(full, fast, heavy):
    """FAST and HEAVY are disjoint and together are the whole selection; neither is empty (a misspelled heavy module would make
    HEAVY empty and FAST everything, which looks like success)."""
    if not full or not fast or not heavy:
        raise ValueError("the full selection, the fast tier and the heavy tier must all be nonempty")
    if fast & heavy:
        raise ValueError(f"a test is in both tiers: {sorted(fast & heavy)[:5]}")
    if fast | heavy != full:
        raise ValueError(f"the tiers do not cover the selection: missing={sorted(full - (fast | heavy))[:5]}; extra={sorted((fast | heavy) - full)[:5]}")


def listing(partition, tier="all"):
    output = subprocess.check_output(
        ["bash", "scripts/ci-nextest", "list", "--message-format", "json"],
        env={**os.environ, "CI_TEST_PARTITION": partition, "CI_TEST_TIER": tier}, text=True)
    return selected(output)


def main():
    partition = os.environ.get("CI_TEST_PARTITION", "hash:1/2")
    if partition not in ("hash:1/2", "hash:1/4"):
        raise ValueError("inventory proof must run on the first of two or four shards")
    count = int(partition.rsplit("/", 1)[1])
    partitions = [""] + [f"hash:{i}/{count}" for i in range(1, count+1)]
    inventories = [listing(partition) for partition in partitions]
    verify(*inventories)
    # The tiers: fast and heavy partition the whole selection, and the shards of the fast tier (what a pull request runs)
    # partition the fast tier, so nothing a tier or a shard is meant to run can go missing.
    fast, heavy = listing("", "fast"), listing("", "heavy")
    verify_tiers(inventories[0], fast, heavy)
    verify(fast, *[listing(partition, "fast") for partition in partitions[1:]])
    proof = {"revision": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
             "full": sorted(inventories[0]), "fast": sorted(fast), "heavy": sorted(heavy),
             **{key:sorted(tests) for key,tests in zip(partitions[1:],inventories[1:])}}
    logs = Path(os.environ["RUNNER_TEMP"]) / "ci-logs"
    logs.mkdir(parents=True, exist_ok=True)
    (logs / "test-partitions.json").write_text(json.dumps(proof, indent=2) + "\n")
    message = (f"Shard inventory verified: {len(inventories[0])} selected tests = {' + '.join(str(len(s)) for s in inventories[1:])}; no overlap or omissions. "
               f"Tiers verified: {len(fast)} fast + {len(heavy)} heavy = {len(inventories[0])}; the fast shards cover the fast tier.")
    print(message, flush=True)
    with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as stream:
        stream.write(message + "\n")


if __name__ == "__main__":
    main()
