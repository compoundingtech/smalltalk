#!/usr/bin/env python3
"""Key handling for a job that signs its own result, and the workflow rules that keep it loop-free."""
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from evidence_test_support import clean_loader_environment, tool_path  # noqa: E402
clean_loader_environment()
ROOT = Path(__file__).resolve().parent.parent
HELPER = ROOT / 'scripts/ci-evidence-signing'
WRAP, SIGN = ROOT / 'scripts/evidence-wrap', ROOT / 'scripts/evidence-sign'
BASE = {k: v for k, v in os.environ.items() if not k.startswith(('GITHUB_', 'PR_', 'EVIDENCE_', 'RUNNER_'))}
GENV = dict(BASE, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
            GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')


def helper(*args, env=None, check=None, cwd=None):
    done = subprocess.run([sys.executable, str(HELPER), *args], capture_output=True, text=True, env=dict(BASE, **(env or {})), cwd=cwd)
    return done


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, env=GENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


def mode(path):
    return stat.S_IMODE(os.stat(path).st_mode)


# --- guard: which events and refs may use the key
QUEUE = 'refs/heads/gh-readonly-queue/main/pr-5-0123456789abcdef'
cases = [
    ('merge group on a queue ref', dict(GITHUB_EVENT_NAME='merge_group', GITHUB_REF=QUEUE), True),
    ('merge group on some other ref', dict(GITHUB_EVENT_NAME='merge_group', GITHUB_REF='refs/heads/feature'), False),
    ('push to main', dict(GITHUB_EVENT_NAME='push', GITHUB_REF='refs/heads/main'), True),
    ('push to another branch', dict(GITHUB_EVENT_NAME='push', GITHUB_REF='refs/heads/other'), False),
    ('manual run on main', dict(GITHUB_EVENT_NAME='workflow_dispatch', GITHUB_REF='refs/heads/main'), True),
    ('manual run on a branch', dict(GITHUB_EVENT_NAME='workflow_dispatch', GITHUB_REF='refs/heads/topic'), False),
    # Allowed only with a base, a head and the opener and actor on the author list: see the author cases below.
    ('same-repository pull request with no base or head commit', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge',
                                          GITHUB_REPOSITORY='example/repo', PR_HEAD_REPOSITORY='example/repo'), False),
    ('same-repository pull request on a branch ref', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/heads/topic',
                                                          GITHUB_REPOSITORY='example/repo', PR_HEAD_REPOSITORY='example/repo'), False),
    ('fork pull request', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge',
                               GITHUB_REPOSITORY='example/repo', PR_HEAD_REPOSITORY='someone/repo'), False),
    ('pull request with no head repository', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge',
                                                  GITHUB_REPOSITORY='example/repo'), False),
    ('pull request_target', dict(GITHUB_EVENT_NAME='pull_request_target', GITHUB_REF='refs/heads/main'), False),
    ('scheduled run', dict(GITHUB_EVENT_NAME='schedule', GITHUB_REF='refs/heads/main'), False),
    ('workflow_run', dict(GITHUB_EVENT_NAME='workflow_run', GITHUB_REF='refs/heads/main'), False),
]
for label, env, allowed in cases:
    done = helper('guard', env=env)
    assert (done.returncode == 0) == allowed, (label, done.stdout, done.stderr)
print('passed: the key is for merge-queue refs, main and same-repository pull requests; a fork pull request and every other event is refused')

# --- guard: a same-repository pull request signs only when its authors are on the list at the BASE commit
with tempfile.TemporaryDirectory() as directory:
    repo = Path(directory) / 'repo'
    repo.mkdir()
    git(repo, 'init', '-q', '-b', 'main')
    (repo / '.st').mkdir()
    (repo / '.st/evidence-authors.json').write_text((ROOT / '.st/evidence-authors.json').read_text())

    def commit(message, email, files=None, committer='me@nathanherald.com'):
        for name, text in (files or {'f.txt': message}).items():
            (repo / name).parent.mkdir(parents=True, exist_ok=True)
            (repo / name).write_text(text)
        git(repo, 'add', '-A')
        env = dict(GENV, GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_EMAIL=committer)
        done = subprocess.run(['git', '-C', str(repo), 'commit', '-q', '-m', message], capture_output=True, env=env)
        assert done.returncode == 0, done.stderr.decode()
        return git(repo, 'rev-parse', 'HEAD')

    base = commit('base', 'me@nathanherald.com')
    git(repo, 'checkout', '-q', '-b', 'ours')
    ours = commit('ours', 'me@nathanherald.com')
    git(repo, 'checkout', '-q', '-b', 'agent', base)
    agent = commit('agent', 'ci-builder@users.noreply.github.com')
    git(repo, 'checkout', '-q', '-b', 'outsider', base)
    first = commit('theirs', 'someone@elsewhere.example')
    git(repo, 'checkout', '-q', '-b', 'mixed', 'ours')
    mixed = commit('theirs on top', 'someone@elsewhere.example')
    git(repo, 'checkout', '-q', '-b', 'noreply-ok', base)
    noreply_ok = commit('numbered noreply of a listed login', '179+myobie@users.noreply.github.com', committer='noreply@github.com')
    git(repo, 'checkout', '-q', '-b', 'noreply-evil', base)
    noreply_evil = commit('look-alike builder', '99+evil-builder@users.noreply.github.com')
    git(repo, 'checkout', '-q', '-b', 'invalid-any', base)
    invalid_any = commit('any invented address', 'whoever@example.invalid')
    git(repo, 'checkout', '-q', '-b', 'committer-out', base)
    committer_out = commit('their committer', 'me@nathanherald.com', committer='someone@elsewhere.example')
    git(repo, 'checkout', '-q', '-b', 'widens', base)
    (repo / '.st/evidence-authors.json').write_text(json.dumps({'logins': ['mallory'], 'emails': ['*']}))
    widens = commit('widen the list in the same pull request', 'someone@elsewhere.example', {'.st/evidence-authors.json': json.dumps({'logins': ['mallory'], 'emails': ['*']})})
    git(repo, 'checkout', '-q', '-b', 'nolist')
    git(repo, 'rm', '-q', '-r', '.st')
    nolist_base = commit('base without a list', 'me@nathanherald.com', {'g.txt': 'x'})
    git(repo, 'checkout', '-q', 'ours')
    nolist_head = commit('head', 'me@nathanherald.com', {'h.txt': 'x'})

    def pr(base_sha, head_sha, opener='myobie', actor='myobie', head_repo='example/repo', rerun=None):
        env = dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge', GITHUB_REPOSITORY='example/repo',
                   PR_HEAD_REPOSITORY=head_repo, PR_BASE_SHA=base_sha, PR_HEAD_SHA=head_sha, PR_USER=opener, GITHUB_ACTOR=actor)
        # GitHub always sets both; a run without the re-run actor is refused, not waved through
        env['GITHUB_TRIGGERING_ACTOR'] = rerun if rerun is not None else actor
        if rerun == '':
            del env['GITHUB_TRIGGERING_ACTOR']
        return helper('guard', cwd=repo, env=env)

    assert pr(base, ours).returncode == 0, pr(base, ours).stdout + pr(base, ours).stderr
    assert pr(base, agent).returncode == 0, 'an agent builder identity on the list signs'
    assert pr(base, ours, opener='schickling-assistant').returncode == 0
    refused = pr(base, first)
    assert refused.returncode == 1 and 'someone@elsewhere.example' in refused.stdout, refused.stdout
    assert pr(base, mixed).returncode == 1, 'one outsider commit on top of ours is enough to refuse'
    assert pr(base, ours, opener='mallory').returncode == 1, 'an opener outside the list is refused'
    assert pr(base, ours, actor='mallory').returncode == 1, 'an original actor outside the list is refused'
    assert pr(base, ours, rerun='myobie').returncode == 0
    assert pr(base, ours, rerun='mallory').returncode == 1, 'someone outside the list re-running a listed account\'s run is refused (GITHUB_TRIGGERING_ACTOR)'
    unset = pr(base, ours, rerun='')
    assert unset.returncode == 1 and 'unknown account' in unset.stdout, 'an unset re-run actor is refused, not skipped'
    assert pr(base, noreply_ok).returncode == 0, 'a numbered noreply address of a listed login, committed by GitHub itself, signs'
    for label, head_sha in (('a look-alike noreply builder', noreply_evil), ('any invented .invalid address', invalid_any)):
        refused = pr(base, head_sha)
        assert refused.returncode == 1 and 'not in the author list' in refused.stdout, (label, refused.stdout)
    refused = pr(base, committer_out)
    assert refused.returncode == 1 and 'committed by' in refused.stdout, refused.stdout
    assert pr(base, ours, opener='').returncode == 1
    assert pr(base, ours, head_repo='someone/repo').returncode == 1, 'a fork is refused whatever its authors'
    assert pr(base, widens).returncode == 1, 'a pull request cannot widen the list it is judged by'
    assert pr(nolist_base, nolist_head).returncode == 1, 'no list at the base commit: nothing signs'
    assert pr('0' * 40, ours).returncode == 1, 'commits that cannot be found refuse'
    # a list with the wrong types refuses cleanly, with no traceback
    git(repo, 'checkout', '-q', '-b', 'badlist', base)
    badlist_base = commit('list with a number in it', 'me@nathanherald.com',
                          {'.st/evidence-authors.json': json.dumps({'logins': ['myobie', 7], 'emails': ['me@nathanherald.com'], 'noreply_logins': [], 'committers_also': []})})
    badlist_head = commit('on top', 'me@nathanherald.com', {'z.txt': 'z'})
    refused = pr(badlist_base, badlist_head)
    assert refused.returncode == 1 and 'Traceback' not in refused.stderr + refused.stdout and 'nonempty strings' in refused.stdout, refused.stdout + refused.stderr
# the address matcher itself, on forms a commit cannot carry or that look close to a listed one
import importlib.machinery  # noqa: E402
signing = importlib.machinery.SourceFileLoader('ci_evidence_signing', str(HELPER)).load_module()
import re as _re  # noqa: E402
_noreply = [_re.compile(r'(?:[0-9]+\+)?myobie@users\.noreply\.github\.com', _re.IGNORECASE)]
_emails = {'me@nathanherald.com'}
for address, expected in (('179+myobie@users.noreply.github.com', True), ('myobie@users.noreply.github.com', True), ('ME@NATHANHERALD.COM', True),
                          ('x+myobie@users.noreply.github.com', False), ('179+myobie@users.noreply.github.com.evil', False),
                          ('179+myobie@users.noreply.github.com\n', False), ('179+evil-myobie@users.noreply.github.com', False),
                          ('1+9+myobie@users.noreply.github.com', False), ('me@nathanherald.com.evil', False), ('', False)):
    assert signing.email_known(address, _emails, _noreply) is expected, address
print('passed: noreply addresses need a numeric ID and match whole; look-alikes, suffixes and a trailing newline are refused')
print('passed: a same-repository pull request signs only when its opener, the accounts that started and re-ran the run, and every commit author and committer are on the list at the base commit; an outsider\'s commit on a same-repository branch gets no note')

with tempfile.TemporaryDirectory() as directory:
    tmp = Path(directory)
    subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'fleet/ci', '-f', str(tmp / 'k')], check=True)
    key = (tmp / 'k').read_text()
    pub = (tmp / 'k.pub').read_text().split()

    # --- configure: mode, masking, nothing printed but mask commands
    runner = tmp / 'runner'
    runner.mkdir()
    done = helper('configure', env=dict(RUNNER_TEMP=str(runner), EVIDENCE_SIGNING_KEY=key, EVIDENCE_TOOL_PATH=tool_path()))
    assert done.returncode == 0, done.stderr
    home = Path(done.stdout.strip().splitlines()[-1])
    assert mode(home / 'signing-key') == 0o600 and mode(home / '.config/st/evidence-sign.json') == 0o600
    assert mode(home) == 0o700 and mode(home / '.config/st') == 0o700
    assert (home / 'signing-key').read_text() == key
    masks = [line for line in done.stdout.splitlines() if line.startswith('::add-mask::')]
    assert masks == [f'::add-mask::{line}' for line in key.splitlines() if line.strip()], 'every key line is masked'
    leaked = [line for line in (done.stdout + done.stderr).splitlines() if not line.startswith('::add-mask::') and any(k in line for k in key.splitlines() if len(k) > 20)]
    assert not leaked, 'the key appears outside mask commands'
    config = json.loads((home / '.config/st/evidence-sign.json').read_text())
    assert config['signer'] == 'fleet/ci' and config['ssh_key'] == str(home / 'signing-key') and config['path'] == tool_path()
    assert helper('configure', env=dict(RUNNER_TEMP=str(tmp / 'rel'), EVIDENCE_SIGNING_KEY=key, EVIDENCE_TOOL_PATH='relative/bin')).returncode == 1, 'a relative tool path is refused'
    again = helper('configure', env=dict(RUNNER_TEMP=str(runner), EVIDENCE_SIGNING_KEY=key))
    assert again.returncode == 1, 'configure never overwrites an existing key file'
    empty = helper('configure', env=dict(RUNNER_TEMP=str(tmp / 'other'), EVIDENCE_SIGNING_KEY='  \n'))
    assert empty.returncode == 1 and 'not available' in empty.stdout
    print('passed: the key file and configuration are 0600 in a 0700 directory, every key line is masked, an empty key is refused')

    # --- the configured signer really signs a note that git verifies
    repo = tmp / 'repo'
    subprocess.run(['git', 'init', '-q', str(repo)], check=True, env=GENV)
    (repo / 'flake.lock').write_text('{}\n')
    git(repo, 'add', '.')
    git(repo, 'commit', '-q', '-m', 'one')
    signers = tmp / 'allowed'
    signers.write_text(f'fleet/ci namespaces="git" {pub[0]} {pub[1]}\n')
    done = subprocess.run([sys.executable, str(WRAP), '--check', 'linux-gate', '--toolchain-sha256', '1' * 64,
                           '--signer', json.dumps([sys.executable, str(SIGN)]), '--', 'true'],
                          cwd=repo, capture_output=True, env=dict(GENV, HOME=str(home), EVIDENCE_SIGN_NOW='2026-10-14T12:00:00Z'))
    assert done.returncode == 0, done.stderr.decode()
    record = json.loads(done.stderr.decode()[done.stderr.decode().index('{'):])['record']
    verified = subprocess.run(['git', '-C', str(repo), '-c', 'gpg.format=ssh', '-c', f'gpg.ssh.allowedSignersFile={signers}',
                               'verify-commit', record], capture_output=True, env=GENV)
    assert verified.returncode == 0 and b'fleet/ci' in verified.stderr, verified.stderr
    print('passed: the configured signer produces a note that verifies against the public half of the key')

    # --- once: one signature per check per job
    assert helper('once', 'linux-gate', env=dict(RUNNER_TEMP=str(runner))).returncode == 0
    second = helper('once', 'linux-gate', env=dict(RUNNER_TEMP=str(runner)))
    assert second.returncode == 1 and 'already signed' in second.stdout
    assert helper('once', 'another-check', env=dict(RUNNER_TEMP=str(runner))).returncode == 0
    print('passed: a job cannot sign the same check twice')

    # --- aggregate: the facts come from the needs context, the verdict is the gate job's own result
    needs = {'linux-gate': {'result': 'success'}, 'linux-tests': {'result': 'success'}, 'linux-clippy': {'result': 'failure'}}
    out = tmp / 'facts.json'
    done = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(needs), GITHUB_RUN_ID='7', GITHUB_RUN_ATTEMPT='2',
                                                  GITHUB_EVENT_NAME='merge_group', GITHUB_REF=QUEUE, RUN_STARTED_AT='2026-10-14T12:00:00Z',
                                                  GITHUB_WORKFLOW='Workspace CI'))
    facts = json.loads(out.read_text())
    assert done.returncode == 0 and facts['exit_code'] == 0, 'the gate job succeeded, so the verdict is success even though a sibling reports failure'
    assert facts['command'] == ['linux-gate', 'aggregate', 'linux-clippy', 'linux-gate', 'linux-tests']
    assert facts['output']['needs']['linux-clippy'] == 'failure' and facts['inputs']['stage_results'] == 'linux-clippy=failure,linux-gate=success,linux-tests=success'
    assert facts['inputs']['run_id'] == '7' and 'unset' not in json.dumps(facts)
    needs['linux-gate']['result'] = 'failure'
    helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(needs)))
    assert json.loads(out.read_text())['exit_code'] == 1
    needs['linux-gate']['result'] = 'success'
    with_gates = {**needs, 'evidence-gate-mail-redelivery-canaries': {'result': 'success', 'outputs': {'skip': 'false'}},
                  'evidence-gate-isolation-vm': {'result': 'success', 'outputs': {'skip': 'false'}}}
    assert helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(with_gates), GITHUB_EVENT_NAME='merge_group')).returncode == 0, 'gates that did not skip do not block'
    assert json.loads(out.read_text())['command'] == ['linux-gate', 'aggregate', 'linux-clippy', 'linux-gate', 'linux-tests'], 'the recorded command does not change when gate jobs are needed'
    with_gates['evidence-gate-isolation-vm']['outputs']['skip'] = 'true'
    stopped = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(with_gates), GITHUB_EVENT_NAME='merge_group'))
    assert stopped.returncode == 1 and 'evidence-gate-isolation-vm' in stopped.stdout, 'every needed job succeeded but one gate said skip: no note'
    skipped = {**needs, 'linux-tests': {'result': 'skipped'}}
    refused = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(skipped), GITHUB_EVENT_NAME='merge_group'))
    assert refused.returncode == 1 and 'did not run' in refused.stdout, 'a skipped stage means this run did not test the tree itself'
    shards = {**needs, 'linux-tests-shard-3': {'result': 'skipped'}}
    assert helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(shards), GITHUB_EVENT_NAME='pull_request')).returncode == 0, 'merge-only shards may be skipped outside merge groups'
    assert helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(shards), GITHUB_EVENT_NAME='merge_group')).returncode == 1
    missing = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps({'linux-tests': {'result': 'success'}})))
    assert missing.returncode == 1 and 'no verdict' in missing.stdout
    print('passed: the aggregate note records the needed jobs and the gate job\'s own verdict, and refuses to invent one')

    # --- stage-facts: the log digest and status of a stage that already ran
    logs = tmp / 'stage-runner/ci-logs'
    logs.mkdir(parents=True)
    (logs / 'tests.log').write_bytes(b'ok test a\nok test b\n')
    (logs / 'tests.time').write_text('412 0\n')
    (logs / 'clippy.log').write_bytes(b'warning: x\n')
    (logs / 'clippy.time').write_text('55 101\n')
    (logs / 'fleet-compat.time').write_text('garbage')
    stage_env = dict(RUNNER_TEMP=str(tmp / 'stage-runner'), STAGE_JOB='linux-tests-shard-2', CI_TEST_PARTITION='hash:2/4',
                     GITHUB_RUN_ID='7', RUNNER_NAME='ci1-3', RUNNER_OS='Linux')
    helper('stage-facts', str(out), env=dict(stage_env, STAGE='tests'))
    got = json.loads(out.read_text())
    assert got['exit_code'] == 0 and got['output_sha256'] == hashlib.sha256(b'ok test a\nok test b\n').hexdigest()
    assert got['command'] == ['bash', 'scripts/ci-linux', 'tests'] and got['inputs']['partition'] == 'hash:2/4' and got['inputs']['elapsed_seconds'] == '412'
    helper('stage-facts', str(out), env=dict(stage_env, STAGE='clippy'))
    assert json.loads(out.read_text())['exit_code'] == 101, 'the stage exit status is recorded as it was'
    helper('stage-facts', str(out), env=dict(stage_env, STAGE='fleet-compat'))
    unfinished = json.loads(out.read_text())
    assert unfinished['exit_code'] == 1 and unfinished['inputs']['log_present'] == 'false', 'an unreadable timing file is a failure, never a success'
    never = helper('stage-facts', str(out), env=dict(stage_env, STAGE='canaries'))
    assert never.returncode == 1 and 'did not run' in never.stdout, 'a stage that left nothing never ran: no note, not even a failure'
    assert helper('stage-facts', str(out), env=dict(stage_env, STAGE='../x')).returncode == 1
    print('passed: a stage note carries the stage command, its real exit status and the digest of its exact log; a missing or garbled timing is a failure')

    # --- step-facts: jobs with no stage log record the outcomes of the steps that ran
    base_env = dict(STEP_CHECK='isolation-vm', STEP_COMMAND=json.dumps(['isolation-vm', 'nixos-test-driver']), GITHUB_RUN_ID='7',
                    RUNNER_OS='Linux')
    ok = helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success', 'vmtest': 'success'})))
    got = json.loads(out.read_text())
    assert ok.returncode == 0 and got['exit_code'] == 0 and got['output'] == {'steps': {'driver': 'success', 'vmtest': 'success'}}
    assert got['command'] == ['isolation-vm', 'nixos-test-driver'] and got['inputs']['step_outcomes'] == 'driver=success,vmtest=success'
    helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success', 'vmtest': 'failure'})))
    assert json.loads(out.read_text())['exit_code'] == 1, 'one failed step makes the note a failure, never a success'
    for outcome in ('skipped', 'cancelled', ''):
        refused = helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success', 'vmtest': outcome})))
        assert refused.returncode == 1 and 'did not run' in refused.stdout, (outcome, refused.stdout)
    assert helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES='not json')).returncode == 1
    assert helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES='{}')).returncode == 1
    print('passed: a step-based job note records each step outcome; a skipped, cancelled or missing step means no note, a failed one a failure')

    # --- source_inputs: recorded only when the BASE evidence-verify projects the check's declared inputs
    stub_dir = tmp / 'stub-scripts'
    stub_dir.mkdir()
    shutil_copy = __import__('shutil').copy
    shutil_copy(HELPER, stub_dir / 'ci-evidence-signing')
    KEY = 'a' * 40

    def with_verify(body):
        (stub_dir / 'evidence-verify').write_text(body)

    def project_run(extra=None):
        env_ = dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success'}), PROJECT_BASE_SHA='b' * 40, GITHUB_REPOSITORY='example/repo')
        env_.update(extra or {})
        done = subprocess.run([sys.executable, str(stub_dir / 'ci-evidence-signing'), 'step-facts', str(out)], capture_output=True, text=True,
                              env=dict(BASE, **env_))
        return done, json.loads(out.read_text()) if done.returncode == 0 else None

    seen = tmp / 'verify-argv.json'
    with_verify(f'import json,sys\njson.dump(sys.argv[1:], open({str(seen)!r}, "w"))\nprint(json.dumps({{"source_inputs": {KEY!r}}}))\n')
    done, facts = project_run()
    assert done.returncode == 0 and facts['inputs']['source_inputs'] == KEY, done.stdout
    assert json.loads(seen.read_text()) == ['--project', '--check', 'isolation-vm', '--revision', 'HEAD', '--policy-from', 'b' * 40, '--repository', 'example/repo']
    with_verify('print(\'{"source_inputs": null}\')\n')
    assert 'source_inputs' not in project_run()[1]['inputs'], 'a check without declared inputs stays an exact-tree note'
    with_verify('import sys\nsys.exit(2)\n')
    done, facts = project_run()
    assert done.returncode == 0 and 'source_inputs' not in facts['inputs'], 'a base whose evidence-verify has no --project signs an exact-tree note'
    with_verify('print(\'{"source_inputs": "not-a-tree"}\')\n')
    assert 'source_inputs' not in project_run()[1]['inputs'], 'a malformed key is dropped, never signed'
    with_verify(f'print(\'{{"source_inputs": "{KEY}\\\\n"}}\')\n')
    assert 'source_inputs' not in project_run()[1]['inputs'], 'a key with a trailing newline is dropped'
    with_verify(f'import json\nprint(json.dumps({{"source_inputs": {KEY!r}}}))\n')
    assert 'source_inputs' not in project_run(dict(PROJECT_BASE_SHA=''))[1]['inputs'], 'no base commit, no key'
    print('passed: source_inputs is signed only when the base evidence-verify projects a well-formed key; every other case is an exact-tree note')

    # --- a job whose gate said skip makes no note even if its logs and steps look like a success
    assert helper('stage-facts', str(out), env=dict(stage_env, STAGE='tests', GATE_SKIP='false')).returncode == 0
    gated = helper('stage-facts', str(out), env=dict(stage_env, STAGE='tests', GATE_SKIP='true'))
    assert gated.returncode == 1 and 'evidence gate skipped' in gated.stdout
    gated = helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success'}), GATE_SKIP='true'))
    assert gated.returncode == 1 and 'evidence gate skipped' in gated.stdout
    print('passed: a job whose own evidence gate said skip makes no note, whatever its logs or steps show')

    # --- cleanup: key overwritten and removed
    alias = tmp / 'alias'
    os.link(home / 'signing-key', alias)
    assert helper('cleanup', env=dict(RUNNER_TEMP=str(runner))).returncode == 0
    assert not home.exists() and alias.read_bytes().strip(b'\0') == b'', 'the key bytes are overwritten, not just unlinked'
    assert helper('cleanup', env=dict(RUNNER_TEMP=str(runner))).returncode == 0, 'cleanup is safe to repeat'
    print('passed: cleanup overwrites and removes the key, and is safe to run twice')

# --- lint: pushing refs/notes/evidence/* must not start any workflow
pushes = 0
for workflow in sorted((ROOT / '.github/workflows').glob('*.yml')):
    lines = workflow.read_text().splitlines()
    for number, line in enumerate(lines):
        if re.fullmatch(r'  push:\s*', line):
            block = []
            for follower in lines[number + 1:]:
                if follower.strip() and not follower.startswith('   '):
                    break
                block.append(follower.strip())
            filters = [b for b in block if re.match(r'(branches|tags)(-ignore)?:', b)]
            assert filters, f'{workflow.name}: a push trigger without a branches or tags filter would fire on refs/notes pushes'
            pushes += 1
assert pushes >= 1, 'the lint found no push trigger at all, so it checked nothing'
print(f'passed: all {pushes} push triggers in the generated workflows are filtered to branches or tags')

# --- lint: every job that reaches the evidence-signing environment does so only for the merge queue and main
text = (ROOT / '.github/workflows/fleet.yml').read_text()
expression = "${{ (github.event_name == 'merge_group' || (github.event_name == 'push' && github.ref == 'refs/heads/main') || (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main') || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)) && 'evidence-signing' || '' }}"
environments = [line.strip() for line in text.splitlines() if re.match(r'\s+environment:', line)]
assert environments, 'no job names an environment, so the lint checked nothing'
assert all(line == f'environment: {expression}' for line in environments), [l for l in environments if l != f'environment: {expression}']
assert "'evidence-signing'" not in text.replace(expression, ''), 'the environment name must appear only inside the conditional expression'
assert 'environment: evidence-signing' not in text, 'an unconditional environment would block every required check if it gains reviewers'
note = re.search(r'  evidence-note-linux-gate:\n(?:    .*\n)*?    if: (.*)\n', text)
assert note and "(always() && (github.event_name == 'merge_group' || (github.event_name == 'push' && github.ref == 'refs/heads/main') || (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main') || (github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository)))" in note.group(1), 'the aggregate note job must run only for the merge queue, main and same-repository pull requests (the generator adds its own draft guard in front)'
print(f'passed: all {len(environments)} jobs reach the signing environment only for merge_group, push to main, manual runs on main and same-repository pull requests; the aggregate note job skips forks')
