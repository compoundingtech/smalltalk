#!/usr/bin/env python3
"""Read-only cgroup-v2 evidence for the test-build requester, not OOM attribution."""
import argparse
import json
import os
from pathlib import Path
import time

FILES = ('memory.events', 'memory.events.local', 'memory.current', 'memory.max', 'memory.peak')


def read(path, limit=8192):
    try:
        with path.open('r') as stream:
            value = stream.read(limit + 1)
        return value if len(value) <= limit else 'UNKNOWN: oversized file'
    except OSError as error:
        return 'UNKNOWN: ' + type(error).__name__


def snapshot():
    membership = read(Path('/proc/self/cgroup'))
    mounts = read(Path('/proc/self/mountinfo'), limit=262144)
    result = {'time_ns': time.time_ns(), 'requester_pid': os.getpid(),
              'membership': membership, 'cgroup2_mounts': [x for x in mounts.splitlines() if ' - cgroup2 ' in x],
              'scope': 'requester and visible ancestors; rustc/sccache membership and termination UNKNOWN',
              'groups': [], 'build_step_outcome': os.environ.get('BUILD_STEP_OUTCOME', 'UNKNOWN'),
              'build_environment': {key: os.environ.get(key, 'UNSET') for key in
                  ('GITHUB_SHA', 'GITHUB_RUN_ID', 'GITHUB_RUN_ATTEMPT', 'RUNNER_NAME', 'CARGO_BUILD_JOBS',
                   'CARGO_PROFILE_TEST_DEBUG', 'CARGO_INCREMENTAL', 'RUSTC_WRAPPER', 'SCCACHE_BIN')}}
    entries = [x[3:] for x in membership.splitlines() if x.startswith('0::')]
    # Resolve the visible cgroup-v2 mount. Refuse ambiguous namespace/path mappings.
    for line in result['cgroup2_mounts']:
        fields = line.split()
        root, mount = fields[3:5]
        if len(entries) != 1 or '\\' in root + mount + entries[0]:
            continue
        member = Path(entries[0])
        try:
            relative = member.relative_to(root)
        except ValueError:
            continue
        base = Path(mount)
        current = base / relative
        if '..' in relative.parts:
            continue
        for _ in range(64):
            try:
                identity = current.stat()
                row = {'path': str(current), 'identity': [identity.st_dev, identity.st_ino],
                       'values': {name: read(current / name) for name in FILES}}
            except OSError as error:
                row = {'path': str(current), 'error': type(error).__name__}
            result['groups'].append(row)
            if current == base:
                break
            current = current.parent
        else:
            result['mapping'] = 'UNKNOWN: ancestor depth exceeds 64; partial visible chain retained'
        break
    if not result['groups']:
        result['mapping'] = 'UNKNOWN: no unambiguous visible v2 mapping'
    return result


def counters(value):
    try:
        return {key: int(number) for key, number in (line.split() for line in value.splitlines())}
    except (ValueError, TypeError):
        return None


def delta(before, after):
    previous = {g['path']: g for g in before.get('groups', [])}
    result = []
    for group in after['groups']:
        old = previous.get(group['path'], {})
        row = {'path': group['path'], 'events_delta': 'UNKNOWN: missing or changed cgroup identity'}
        if group.get('identity') is not None and old.get('identity') == group['identity']:
            row['events_delta'] = {}
            for name in ('memory.events', 'memory.events.local'):
                a = counters(old.get('values', {}).get(name, ''))
                b = counters(group.get('values', {}).get(name, ''))
                row['events_delta'][name] = ({key: b[key] - a[key] for key in b}
                    if a and b and a.keys() == b.keys() and all(b[key] >= a[key] for key in b)
                    else 'UNKNOWN: unavailable or reset counters')
        result.append(row)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('phase', choices=('before', 'after', 'failure'))
    args = parser.parse_args()
    directory = Path(os.environ['RUNNER_TEMP']) / 'ci-build-memory'
    directory.mkdir(exist_ok=True)
    value = snapshot()
    if args.phase != 'before':
        try:
            before = json.loads((directory / 'before.json').read_text())
            value['deltas'] = delta(before, value)
        except (OSError, ValueError, TypeError, KeyError):
            value['deltas'] = 'UNKNOWN: baseline unavailable'
        value['interpretation'] = ('Nonzero cumulative counters/peak alone do not prove this build OOMed. '
            'Even positive deltas can include other processes in a shared ancestor; memory.peak is not reset. '
            'An external sccache server can compile in a different cgroup; kernel/termination evidence is still required.')
    encoded = json.dumps(value, indent=2) + '\n'
    (directory / (args.phase + '.json')).write_text(encoded)
    print(encoded, end='')


if __name__ == '__main__':
    main()
