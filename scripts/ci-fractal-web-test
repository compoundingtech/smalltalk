#!/usr/bin/env python3
"""Exercise fractal-web change detection, its fail-closed paths, the gate and the generated jobs."""

import os
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
detector = root / "scripts/ci-fractal-web-changes"
verdict = runpy.run_path(str(root / "scripts/ci-fractal-web-gate"))["verdict"]


def git(repo, *args):
    command = ["git", "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null", "-C", str(repo), *args]
    return subprocess.run(command, check=True, capture_output=True, text=True).stdout.strip()


def commit(repo, message, write=(), remove=(), move=()):
    for path in write:
        (repo / path).parent.mkdir(parents=True, exist_ok=True)
        (repo / path).write_text(f"{message} {path}\n")
    for path in remove:
        git(repo, "rm", "--quiet", path)
    for source, destination in move:
        (repo / destination).parent.mkdir(parents=True, exist_ok=True)
        git(repo, "mv", source, destination)
    git(repo, "add", "--all")
    git(repo, "commit", "--quiet", "--allow-empty", "-m", message)
    return git(repo, "rev-parse", "HEAD")


def detect(remote, event, base="", head="", kit=False):
    with tempfile.TemporaryDirectory() as scratch:
        output, summary = Path(scratch, "output"), Path(scratch, "summary")
        env = {**os.environ, "EVENT": event, "REMOTE": str(remote), "BASE_SHA": base, "HEAD_SHA": head,
               "GITHUB_OUTPUT": str(output), "GITHUB_STEP_SUMMARY": str(summary)}
        result = subprocess.run(["python3", str(detector)], env=env, capture_output=True, text=True)
        outputs = dict(line.split("=", 1) for line in output.read_text().splitlines()) if output.exists() else {}
        key = "kit-inputs" if kit else "relevant"
        relevant = f"{key}={outputs[key]}" if key in outputs else ""
        return result.returncode, relevant, result.stderr


def check(name, outcome, expected):
    assert outcome[:2] == expected, (name, outcome)
    print("passed:", name)

# Match the generated client export graph and web lane inputs, not their Rust generators.
detector_contract = runpy.run_path(str(detector))
web_inputs = (
    "clients/typescript/st3-client/index.ts",
    "clients/typescript/st3-client/Models.generated.ts",
    "clients/typescript/st3-client/Client.generated.ts",
    "clients/typescript/st3-client/Schema.generated.ts",
    "clients/typescript/st3-client/errors.ts",
    "clients/typescript/st3-client/package.json",
    "clients/typescript/st3-client/tsconfig.json",
    "clients/typescript/st3-client/tsconfig.schema.json",
    "clients/typescript/st3-client/types.test.ts",
    "clients/typescript/st3-client/BUCK",
    "fixtures/clients/device-signing-v1.json",
    "fixtures/clients/transcripts/example.json",
    "fixtures/scenarios/example.json",
    "flake.nix",
    "megarepo.kdl",
    "megarepo.lock",
    "flake.lock",
)
non_web_inputs = (
    "crates/st3-client/src/lib.rs",
    "crates/st3-client-codegen/src/main.rs",
    "crates/st3-schema/x.rs",
    "docs/st3/client-v0/x.md",
    "docs/st3/client-v0/schemas/client-v0.schema.json",
    "nested/megarepo.kdl",
    "nested/megarepo.lock",
    "nested/flake.lock",
)
unexpected = []
for paths, expected in ((web_inputs, True), (non_web_inputs, False)):
    for path in paths:
        actual = bool(detector_contract["relevant_paths"]([path]))
        print(f"path: {path}: relevant={actual}, expected={expected}")
        if actual != expected:
            unexpected.append(path)
assert not unexpected, f"incorrect web input classification: {unexpected}"

# Static kit scope must cover every declared workspace dependency, including transitive ones.
package_paths = subprocess.run(["git", "ls-files", "--", "package.json", "*/package.json"],
                               cwd=root, check=True, capture_output=True, text=True).stdout.splitlines()
packages = {}
for path in package_paths:
    manifest = json.loads((root / path).read_text())
    if "name" in manifest:
        packages[manifest["name"]] = (str(Path(path).parent), manifest)


def guard_workspace_dependencies(manifest, seen=None):
    seen = set() if seen is None else seen
    for field in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies"):
        for name, version in manifest.get(field, {}).items():
            if not version.startswith("workspace:") or name in seen:
                continue
            seen.add(name)
            assert name in packages, f"unknown kit workspace dependency: {name}"
            directory, dependency = packages[name]
            assert f"{directory}/**" in detector_contract["KIT_PATTERNS"], (
                f"kit workspace dependency {name} needs {directory}/** in KIT_PATTERNS")
            guard_workspace_dependencies(dependency, seen)


guard_workspace_dependencies(json.loads((root / "packages/fractal-ui/package.json").read_text()))
workspace_fixture = json.loads('{"devDependencies":{"@smalltalk/st3-scenarios":"workspace:*"}}')
guard_workspace_dependencies(workspace_fixture)
assert detector_contract["kit_paths"](["clients/typescript/st3-scenarios/src/index.ts"])
assert detector_contract["kit_paths"](["clients/typescript/st3-client/index.ts"])
packages["@fixture/uncovered"] = ("packages/uncovered-fixture", {})
try:
    guard_workspace_dependencies({"dependencies": {"@fixture/uncovered": "workspace:*"}})
except AssertionError:
    pass
else:
    raise AssertionError("uncovered workspace dependency must fail the kit scope guard")
del packages["@fixture/uncovered"]
print("passed: workspace dependency fixture runs kit lanes; uncovered dependencies fail the scope guard")


with tempfile.TemporaryDirectory() as scratch:
    repo = Path(scratch)
    git(repo, "init", "--quiet", "--initial-branch=main")
    git(repo, "config", "user.email", "ci@example.invalid")
    git(repo, "config", "user.name", "ci")
    base = commit(repo, "base", write=["src/main.rs", "clients/typescript/st3-client/index.ts", "docs/guide.md"])
    rust = commit(repo, "rust", write=["src/main.rs", "crates/st3-daemon/src/lib.rs"])
    git(repo, "checkout", "--quiet", "-b", "web", base)
    client = commit(repo, "client", write=["clients/typescript/st3-client/index.ts"])
    git(repo, "checkout", "--quiet", "-b", "schema", base)
    schema = commit(repo, "schema", write=["crates/st3-schema/src/lib.rs"])
    git(repo, "checkout", "--quiet", "-b", "lock", base)
    lock = commit(repo, "lock", write=["pnpm-lock.yaml"])
    git(repo, "checkout", "--quiet", "-b", "rename-out", base)
    renamed_out = commit(repo, "rename out", move=[("clients/typescript/st3-client/index.ts", "archive/index.ts")])
    git(repo, "checkout", "--quiet", "-b", "rename-in", base)
    renamed_in = commit(repo, "rename in", move=[("docs/guide.md", "apps/fractal-web/README.md")])
    git(repo, "checkout", "--quiet", "-b", "delete", base)
    deleted = commit(repo, "delete", remove=["clients/typescript/st3-client/index.ts"])
    git(repo, "checkout", "--quiet", "-b", "nested", base)
    nested = commit(repo, "nested lookalike", write=["crates/st3/package.json", "docs/BUCK.md"])
    git(repo, "checkout", "--quiet", "-b", "newline", base)
    newline = commit(repo, "newline path", write=["apps/fractal-web/component\nname.ts"])
    git(repo, "checkout", "--quiet", "-b", "app", base)
    app = commit(repo, "app only", write=["apps/fractal-web/src/app.ts"])
    git(repo, "checkout", "--quiet", "-b", "kit", base)
    kit = commit(repo, "kit", write=["packages/fractal-ui/src/button.tsx"])
    # A strings-only app commit after a kit change must not inherit that kit input.
    strings = commit(repo, "app strings", write=["apps/fractal-web/src/strings.ts"])
    trailing_rust = commit(repo, "trailing Rust", write=["src/main.rs"])
    git(repo, "checkout", "--quiet", "-b", "flake", base)
    flake = commit(repo, "Chromium lock", write=["flake.lock"])
    git(repo, "checkout", "--quiet", "-b", "workflow", base)
    workflow_change = commit(repo, "workflow", write=[".github/workflows/workspace-ci.ts"])
    git(repo, "checkout", "--quiet", "-b", "workspace-dependency", base)
    dependency_change = commit(repo, "workspace dependency", write=["clients/typescript/st3-scenarios/src/index.ts"])
    # main moved on with a web change; a Rust-only PR based on the older main stays Rust-only.
    git(repo, "checkout", "--quiet", "main")
    advanced = commit(repo, "main web", write=["pnpm-workspace.yaml"])
    for index, path in enumerate(("megarepo.kdl", "megarepo.lock", "flake.lock")):
        git(repo, "checkout", "--quiet", "-b", f"dependency-pin-{index}", base)
        pin = commit(repo, f"dependency pin {path}", write=[path])
        for event in ("pull_request", "merge_group"):
            check(f"{event}: {path} change executes", detect(repo, event, base, pin), (0, "relevant=true"))

    check("Rust-only pull request schedules no web execution", detect(repo, "pull_request", base, rust), (0, "relevant=false"))
    check("pull requests diff from the merge base", detect(repo, "pull_request", advanced, rust), (0, "relevant=false"))
    check("client change executes", detect(repo, "pull_request", base, client), (0, "relevant=true"))
    check("Rust schema changes alone do not execute web lanes", detect(repo, "pull_request", base, schema), (0, "relevant=false"))
    check("lock change executes", detect(repo, "pull_request", base, lock), (0, "relevant=true"))
    check("rename out of a web path executes", detect(repo, "pull_request", base, renamed_out), (0, "relevant=true"))
    check("rename into a web path executes", detect(repo, "pull_request", base, renamed_in), (0, "relevant=true"))
    check("deletion executes", detect(repo, "pull_request", base, deleted), (0, "relevant=true"))
    check("root-only patterns do not match nested files", detect(repo, "pull_request", base, nested), (0, "relevant=false"))
    check("a web path containing a newline executes", detect(repo, "pull_request", base, newline), (0, "relevant=true"))
    check("Rust-only merge group schedules no web execution", detect(repo, "merge_group", base, rust), (0, "relevant=false"))
    check("merge group covers the whole queued range", detect(repo, "merge_group", base, advanced), (0, "relevant=true"))
    check("manual runs force execution", detect(repo, "workflow_dispatch"), (0, "relevant=true"))
    for event in ("pull_request", "merge_group", "push"):
        for name, head, expected in (("app only", app, False), ("kit", kit, True),
                                     ("flake.lock", flake, True), ("workflow", workflow_change, True)):
            check(f"{event}: {name} kit input control", detect(repo, event, base, head, kit=True),
                  (0, f"kit-inputs={str(expected).lower()}"))
        check(f"{event}: pnpm lock runs kit lanes", detect(repo, event, base, lock, kit=True),
              (0, "kit-inputs=true"))
        check(f"{event}: fixture workspace dependency change runs kit lanes",
              detect(repo, event, base, dependency_change, kit=True), (0, "kit-inputs=true"))
        check(f"{event}: strings-only app diff executes app lanes",
              detect(repo, event, kit, strings), (0, "relevant=true"))
        check(f"{event}: strings-only app diff skips kit plays",
              detect(repo, event, kit, strings, kit=True), (0, "kit-inputs=false"))
    for event in ("merge_group", "push"):
        check(f"{event}: exact base excludes earlier kit inputs",
              detect(repo, event, kit, trailing_rust, kit=True), (0, "kit-inputs=false"))
        check(f"{event}: multi-commit range includes app change before final Rust commit",
              detect(repo, event, kit, trailing_rust), (0, "relevant=true"))
    for event in ("pull_request", "merge_group", "push"):
        for name, remote, before, after in (
            ("missing head", repo, base, ""),
            ("missing base", repo, "", app),
            ("malformed base", repo, "main", rust),
            ("zero push base", repo, "0" * 40, app),
            ("unknown base", repo, "f" * 40, app),
            ("unknown head", repo, base, "f" * 40),
            ("unreachable remote", Path(scratch, "missing"), base, rust),
        ):
            for kit_output in (False, True):
                key = "kit-inputs" if kit_output else "relevant"
                check(f"{event}: {name} runs all lanes ({key})",
                      detect(remote, event, before, after, kit=kit_output), (0, f"{key}=true"))
    check("unknown event fails closed", detect(repo, "unknown", base, rust), (1, ""))

gate = [
    (("success", "true", "success"), True, "relevant change that executed"),
    (("success", "false", "skipped"), True, "deliberate skip"),
    (("success", "true", "skipped"), False, "relevant change whose execution was skipped"),
    (("success", "true", "failure"), False, "relevant change whose execution failed"),
    (("success", "true", "cancelled"), False, "relevant change whose execution was cancelled or timed out"),
    (("success", "false", "success"), False, "execution without a relevant change"),
    (("failure", "", "skipped"), False, "failed detection"),
    (("cancelled", "", "skipped"), False, "cancelled detection"),
    (("success", "", "skipped"), False, "detection without a decision"),
]
for args, passes, name in gate:
    assert (verdict(*args) is None) == passes, (name, verdict(*args))
    print("passed: gate,", name)

workflow = (root / ".github/workflows/fleet.yml").read_text()
header, jobs = workflow.split("\njobs:\n", 1)
assert "paths" not in header, "required checks need no workflow-level path filter"
for event in ("pull_request", "merge_group", "workflow_dispatch"):
    assert f"  {event}:" in header, event
blocks = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", jobs))
changes, execution, gate_job = blocks["fractal-web-changes"], blocks["fractal-web-execution"], blocks["fractal-web"]
for pattern in detector_contract["PATTERNS"]:
    assert f'"{pattern}"' in changes, f"generated detector omits {pattern}"
for pattern in ("crates/st3-client*/**", "crates/st3-schema/**", "docs/st3/client-v0/**"):
    assert f'"{pattern}"' not in changes, f"generated detector retains broad input {pattern}"
for block in (changes, execution, gate_job):
    assert "runs-on: ubuntu-latest" in block
assert "timeout-minutes: 1" in changes and "timeout-minutes: 1" in gate_job and "timeout-minutes: 25" in execution
assert "github.event.pull_request.base.sha || github.event.merge_group.base_sha" in changes
assert "github.event.pull_request.head.sha || github.event.merge_group.head_sha" in changes
assert "github.event.merge_group.base_sha || github.event.before" in changes
assert "github.event.merge_group.head_sha || github.sha" in changes
assert "KIT_INPUTS: ${{ needs.fractal-web-changes.outputs.kit-inputs }}" in execution
assert "github.event.pull_request.draft == false" in changes and "(success())" in changes and "actions/checkout" not in changes, "ready PR detection runs on embedded source"
assert "needs: [fractal-web-changes, genie-freshness]" in execution
assert "needs.fractal-web-changes.outputs.relevant == 'true'" in execution
assert "needs.genie-freshness.result == 'success'" in execution
assert "nix develop '.#web' -c bash scripts/ci-fractal-web" in execution
assert "actions/cache/restore@" in execution and "actions/cache/save@" not in execution, "only main upkeep publishes caches"
assert "(always())" in gate_job and "needs: [fractal-web-changes, fractal-web-execution]" in gate_job
assert "fractal-web" not in blocks["linux-gate"], "Rust-only gates never wait for web execution"
settings = (root / ".github/repo-settings.json").read_text()
assert '"fractal-web"' not in settings, "fractal-web becomes required only after PR and queue runs emit it"
print("passed: generated jobs are unfiltered, hosted, bounded and fail closed")

freshness = blocks["genie-freshness"]
assert "scripts/ci-genie-freshness" in freshness
guard = (root / "scripts/ci-genie-freshness").read_text()
assert "python3 scripts/ci-fractal-web-licenses --check-lockfile" in guard
assert "python3 scripts/ci-fractal-web-licenses-test" in guard
assert "ci-fractal-web-test" in guard and "genie --check" in guard
lanes = (root / "scripts/ci-fractal-web").read_text()
assert lanes.index("pnpm install --frozen-lockfile") < lanes.index("python3 scripts/ci-fractal-web-licenses --check") < lanes.index("buck2 build //:typecheck")
print("passed: license coverage and manifest guards are wired into the generated CI lanes")
assert 'lane "SDK unit tests" pnpm --dir apps/fractal-web/packages/st3-sdk exec vitest run --config vitest.config.ts' in lanes
assert 'lane "SDK frame CPU budgets" pnpm --dir apps/fractal-web/packages/st3-sdk exec vitest run --config vitest.perf.config.ts' in lanes
sdk = root / "apps/fractal-web/packages/st3-sdk"
assert "'src/**/*.perf.test.ts'" in (sdk / "vitest.config.ts").read_text()
assert "include: ['src/**/*.perf.test.ts']" in (sdk / "vitest.perf.config.ts").read_text()
print("passed: deterministic SDK tests and isolated frame CPU budgets have separate lanes")
assert lanes.index('lane "CSS asset guard" node --test apps/fractal-web/scripts/vite-css-assets.node-test.mjs') < lanes.index('lane "App production build" production_build')
assert "fractalCssAssets()" in (root / "apps/fractal-web/vite.config.ts").read_text()
print("passed: the CSS asset guard proves its negatives before guarding the app production build")

# Exercise the actual conditional lane wiring without launching browsers or installing dependencies.
kit_lanes = lanes[lanes.index('case "${KIT_INPUTS:-true}" in'):]
for required in (False, True):
    with tempfile.TemporaryDirectory() as scratch:
        summary = Path(scratch, "summary")
        harness = 'set -eu\nlane() { printf "%s\\n" "$1"; }\nsummary=$GITHUB_STEP_SUMMARY\n' + kit_lanes
        result = subprocess.run(["bash", "-c", harness], check=True, capture_output=True, text=True,
                                env={**os.environ, "KIT_INPUTS": str(required).lower(),
                                     "BASE_SHA": "base", "HEAD_SHA": "head", "GITHUB_STEP_SUMMARY": str(summary)})
        for name in ("UI kit play index contracts", "UI kit context isolation controls", "UI kit gate set, a11y and budget controls", "UI kit Storybook and module graph", "UI kit strict plays"):
            assert (name in result.stdout) == required, result.stdout
        if not required:
            assert "skipped: no kit inputs changed (base..head)" in summary.read_text()
        print(f"passed: kit lanes {'run' if required else 'skip explicitly'}")

# The kit module graph check: every bundled repository file must be a declared kit input.
graph_check = root / "scripts/ci-fractal-web-kit-graph"
detector_kit_paths = runpy.run_path(str(detector))["kit_paths"]
assert detector_kit_paths(["apps/fractal-web/src/changelog/seen.ts"]), "changelog files the kit renders select kit plays"
assert not detector_kit_paths(["apps/fractal-web/src/alerts/AlertsPopover.tsx"]), "other app-only changes still skip kit plays"
with tempfile.TemporaryDirectory() as scratch:
    def graph(*ids):
        path = Path(scratch, "preview-stats.json")
        path.write_text(json.dumps({"modules": [{"id": identifier} for identifier in ids]}))
        return subprocess.run([str(graph_check), str(path)], capture_output=True, text=True)
    covered = graph("./src/Composer.stories.tsx", "./.storybook/preview.ts?v=1", "./../../node_modules/react/index.js",
                    "/virtual:/@storybook/builder-vite/vite-app.js", "./../../apps/fractal-web/src/changelog/ChangelogView.tsx")
    assert covered.returncode == 0 and "3 repository files, 0 outside" in covered.stdout, covered
    outside = graph("./src/Composer.stories.tsx", "./../../apps/fractal-web/src/alerts/AlertsPopover.tsx")
    assert outside.returncode == 1 and "apps/fractal-web/src/alerts/AlertsPopover.tsx" in outside.stderr, outside
    for ids in ((), ("./../../node_modules/react/index.js",), ("/virtual:/x",)):
        empty = graph(*ids)
        assert empty.returncode == 1 and "unreadable" in empty.stderr, empty
    escaped = graph("./../../../outside-the-repository.ts")
    assert escaped.returncode == 1 and "outside the repository" in escaped.stderr, escaped
    Path(scratch, "preview-stats.json").write_text("{")
    assert subprocess.run([str(graph_check), str(Path(scratch, "preview-stats.json"))], capture_output=True).returncode == 1
print("passed: the kit module graph check accepts declared inputs and rejects files outside them, empty and malformed graphs")
