#!/usr/bin/env bash
# Prove scripts/install leaves `st` as a symlink to the installed `st3` in every starting state.
set -Eeuo pipefail

install="$(cd "$(dirname "$0")" && pwd)/install"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# These fixtures test regular-file installation; native macOS app transactions
# are covered separately by install-macos-test.
mkdir -p "$work/platform-bin"
printf '#!/bin/sh\necho Linux\n' > "$work/platform-bin/uname"
chmod +x "$work/platform-bin/uname"
export PATH="$work/platform-bin:$PATH"

fail() {
  echo "install-test: $*" >&2
  exit 1
}

build() {
  local dir=$1 version=$2 binary
  mkdir -p "$dir"
  for binary in st3 st3-migrate; do
    printf '#!/bin/sh\necho "%s %s"\n' "$binary" "$version" > "$dir/$binary"
    chmod 0755 "$dir/$binary"
  done
}

check() {
  local bin=$1 version=$2 binary
  [[ -L $bin/st && $(readlink "$bin/st") == st3 ]] || fail "$bin/st is not a symlink to st3"
  [[ $("$bin/st") == "st3 $version" ]] || fail "st does not run st3 $version"
  for binary in st3 st3-migrate; do
    [[ -f $bin/$binary && ! -L $bin/$binary ]] || fail "$bin/$binary is not a regular file"
    [[ $("$bin/$binary") == "$binary $version" ]] || fail "$bin/$binary is not version $version"
  done
  [[ ! -e $bin/stui && ! -L $bin/stui ]] || fail "retired UI executable survived installation"
  [[ -z $(find "$bin" -name '.*.install.*') ]] || fail "staged files were left in $bin"
}

build "$work/one" 1
build "$work/two" 2

# A fresh destination.
bash "$install" --from "$work/one" --bin-dir "$work/fresh" > /dev/null
check "$work/fresh" 1

# A stale `st` copied from an older st3 build is replaced by the link.
mkdir -p "$work/stale"
cp "$work/one/st3" "$work/stale/st"
cp "$work/one/st3" "$work/stale/stui"
bash "$install" --from "$work/two" --bin-dir "$work/stale" > /dev/null
check "$work/stale" 2

# A reinstall over a previous install, and over a link to a foreign binary.
ln -sfn "$work/one/st3" "$work/stale/st"
bash "$install" --from "$work/one" --bin-dir "$work/stale" > /dev/null
check "$work/stale" 1

# A directory in the way is refused before anything is replaced.
mkdir -p "$work/blocked/st"
if bash "$install" --from "$work/two" --bin-dir "$work/blocked" 2> /dev/null; then
  fail "installing over a directory named st succeeded"
fi
[[ ! -e $work/blocked/st3 ]] || fail "a refused install still replaced st3"

# Missing binaries are refused.
rm "$work/two/st3-migrate"
if bash "$install" --from "$work/two" --bin-dir "$work/fresh" 2> /dev/null; then
  fail "installing without st3-migrate succeeded"
fi
check "$work/fresh" 1

# A named instance installs below its own directory and leaves the default bin directory alone.
mkdir -p "$work/home/.local/bin"
printf 'default\n' > "$work/home/.local/bin/st3"
HOME="$work/home" bash "$install" --from "$work/one" --instance try > /dev/null
check "$work/home/.st-instance/try/bin" 1
[[ $(cat "$work/home/.local/bin/st3") == default ]] || fail "an instance install replaced the default st3"
[[ $(ls "$work/home/.local/bin") == st3 ]] || fail "an instance install added files to the default bin directory"
# The environment variable names the instance too, and an explicit --bin-dir still wins.
build "$work/three" 3
HOME="$work/home" ST_INSTANCE=other bash "$install" --from "$work/three" > /dev/null
check "$work/home/.st-instance/other/bin" 3
HOME="$work/home" bash "$install" --from "$work/one" --instance third --bin-dir "$work/chosen" > /dev/null
check "$work/chosen" 1
[[ ! -e $work/home/.st-instance/third ]] || fail "an explicit --bin-dir still created the instance bin directory"
# Names that are not plain are refused before anything is written.
for bad in Try a_b ../x -a a--b abcdefghijklmnopqrstuvwxy; do
  if HOME="$work/home" bash "$install" --from "$work/one" --instance "$bad" 2> /dev/null; then
    fail "instance name '$bad' was accepted"
  fi
done
[[ $(ls "$work/home/.st-instance" | sort | tr '\n' ' ') == "other try " ]] || fail "a refused name left a directory"

echo 'install tests passed'
