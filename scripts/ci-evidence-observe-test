#!/usr/bin/env python3
"""ci-evidence-observe imports only what the observer returned, verifies full records, never replaces a ref."""
import base64
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / 'scripts/ci-evidence-observe'
ENV = dict(os.environ, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
           GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t',
           GIT_COMMITTER_EMAIL='t@example.invalid')


def git(repo, *args, stdin=None):
    done = subprocess.run(['git', '-C', str(repo), *args], input=stdin.encode() if stdin is not None else None,
                          capture_output=True, env=ENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


def gitb(repo, *args, stdin=None):
    done = subprocess.run(['git', '-C', str(repo), *args], input=stdin.encode() if isinstance(stdin, str) else stdin,
                          capture_output=True, env=ENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout


with tempfile.TemporaryDirectory() as directory:
    tmp = Path(directory)
    key = tmp / 'key'
    subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(key)], check=True)
    pub = key.with_suffix('.pub').read_text().split()
    signers = tmp / 'allowed'
    signers.write_text(f'machine/ci-test namespaces="git" {pub[0]} {pub[1]}\n')

    # A source with a parent that the exported pack will not carry, as a merge-queue commit has.
    source = tmp / 'source'
    git(tmp, 'init', '-q', str(source))
    (source / 'a').write_text('one\n')
    git(source, 'add', 'a')
    git(source, 'commit', '-q', '-m', 'one')
    (source / 'a').write_text('two\n')
    git(source, 'commit', '-q', '-am', 'two')
    commit = git(source, 'rev-parse', 'HEAD')
    tree = git(source, 'rev-parse', 'HEAD^{tree}')

    def record(tier, check='linux-gate', signed=True):
        body = {'_type': 'https://in-toto.io/Statement/v1',
                'subject': [{'name': commit, 'digest': {'gitTree': tree}}],
                'predicateType': 'https://smalltalk.dev/evidence/gate/v1',
                'predicate': {'schema_version': 1, 'change_id': 'github:example/repo#1',
                              'signer': 'machine/ci-test' if signed else None, 'tier': tier, 're_attests': None,
                              'producer_sha256': '0' * 64, 'observed_at': '2026-10-14T10:00:00Z',
                              'observed': {'kind': 'tests', 'runner': 'ci', 'inputs': {},
                                           'checks': {check: {'command': ['gh', 'job'], 'exit_code': 0,
                                                              'output_sha256': '1' * 64}}}}}
        blob = git(source, 'hash-object', '-w', '--stdin', stdin=json.dumps(body))
        notes = git(source, 'mktree', stdin=f'100644 blob {blob}\t{tree}\n')
        args = ['-c', 'gpg.format=ssh', '-c', f'user.signingKey={key}', 'commit-tree']
        if signed:
            args.append('-S')
        return git(source, *args, notes, '-p', commit, stdin='st gate observation v1\n')

    def pack(*records):
        objects = f'{commit}\n' + gitb(source, 'rev-list', '--objects', '--no-object-names', tree).decode()
        for item in records:
            objects += f'{item}\n' + gitb(source, 'rev-list', '--objects', '--no-object-names', f'{item}^{{tree}}').decode()
        return gitb(source, 'pack-objects', '--stdout', stdin=objects)

    calls = tmp / 'verifier-calls'
    verifier = tmp / 'verifier'
    verifier.write_text(f"""import json, os, sys
open({str(calls)!r}, 'a').write(json.dumps(sys.argv[1:]) + '\\n')
ok = os.environ.get('VERIFIER_OK') == '1'
print(json.dumps({{'satisfied': ok, 'reason': 'no_record'}}))
sys.exit(0 if ok else 1)
""")
    response_file = tmp / 'response.json'
    observer = tmp / 'observer'
    observer.write_text(f"""import os, sys
if sys.argv[sys.argv.index('--run') + 1] == '8':
    print('observer cannot read run 8', file=sys.stderr)
    sys.exit(1)
if os.environ.get('OBSERVER_EXIT'):
    print('missing or ambiguous CI job: linux-gate', file=sys.stderr)
    sys.exit(int(os.environ['OBSERVER_EXIT']))
print(open({str(response_file)!r}).read())
""")
    bin_dir = tmp / 'bin'
    bin_dir.mkdir()
    gh = bin_dir / 'gh'
    gh.write_text(f"""#!{sys.executable}
import json, os, sys
args = sys.argv[1:]
if args[0] == 'run':
    print(os.environ.get('GH_RUNS', '[]'))
elif args[1].endswith('/artifacts?per_page=100'):
    print(json.dumps({{'artifacts': [{{'name': 'ci-evidence-source-1', 'id': 9, 'expired': False}}]}}))
elif '/jobs' in args[1]:
    page = int(args[1].rsplit('page=', 1)[1])
    print(os.environ.get('GH_JOBS', '{{"jobs": []}}') if page == 1 else '{{"jobs": []}}')
elif '/attempts/' in args[1]:
    print(json.dumps({{'conclusion': os.environ.get('GH_CONCLUSION', 'success')}}))
else:
    print(json.dumps({{'run_attempt': 1, 'name': os.environ.get('GH_RUN_NAME', 'Workspace CI')}}))
""")
    gh.chmod(0o755)

    def execute(response, ok='1', remote=None, scratch=None, keys=True, env=None):
        response_file.write_text(json.dumps(response))
        calls.write_text('')
        command = [sys.executable, str(SCRIPT), '--repository', 'example/repo', '--run', '7', '--attempt', '1',
                   '--artifact', '9', '--observer', json.dumps([sys.executable, str(observer)]),
                   '--verifier', str(verifier), '--scratch', str(scratch or tmp / f'scratch-{len(os.listdir(tmp))}')]
        if keys:
            command += ['--keys', str(signers)]
        if remote:
            command += ['--remote', str(remote)]
        done = subprocess.run(command, capture_output=True, env=dict(ENV, VERIFIER_OK=ok, PATH=f'{bin_dir}:{ENV["PATH"]}', **(env or {})))
        return done, json.loads(done.stdout)

    def answer(items, pack_bytes, run=7):
        return {'repository': 'example/repo', 'run': run, 'attempt': 1, 'source': commit, 'tree': tree,
                'full_trust_eligible': True, 'trust_limitation': None,
                'records': [{'record': r, 'tier': t, 'signing_unavailable': False, 'signing_latency_ms': 3,
                             'newly_recorded': True} for r, t in items],
                'object_pack_base64': base64.b64encode(pack_bytes).decode(),
                'metrics': {'fresh_records': len(items), 'full_records': 1}}

    full = record('full')
    degraded = record('degraded', check='typescript-client', signed=False)

    scratch = tmp / 'ok'
    done, out = execute(answer([(full, 'full'), (degraded, 'degraded')], pack(full, degraded)), scratch=scratch)
    assert done.returncode == 0, done.stdout
    assert git(scratch, 'for-each-ref', '--format=%(refname) %(objectname)') == '\n'.join(sorted(
        [f'refs/notes/evidence/{full} {full}', f'refs/notes/evidence/{degraded} {degraded}']))
    verified = [json.loads(line) for line in calls.read_text().splitlines()]
    assert len(verified) == 1 and verified[0][verified[0].index('--check') + 1] == 'linux-gate' and tree in verified[0], verified
    assert [e['verified'] for e in out['records']] == [True, False]
    print('passed: a full record is verified against its tree and check, a degraded one is imported labelled, not verified')

    done, out = execute(answer([(full, 'full')], pack(full)), ok='0', scratch=tmp / 'refused')
    assert done.returncode == 1 and 'did not verify' in out['failures'][0]
    assert git(tmp / 'refused', 'for-each-ref') == '', 'an unverified full record must never become a ref'
    print('passed: a full record the verifier refuses fails the run and creates no ref')

    done, out = execute(answer([(full, 'full')], pack(full), run=8), scratch=tmp / 'wrongrun')
    assert done.returncode == 1 and 'not 7' in out['failures'][0]
    done, out = execute(answer([(full, 'full')], b'not a pack'), scratch=tmp / 'garbage')
    assert done.returncode == 1 and out['failures']
    done, out = execute(answer([(full, 'bogus')], pack(full)), scratch=tmp / 'tier')
    assert done.returncode == 1 and 'unexpected tier' in out['failures'][0]
    print('passed: an answer for another run, a malformed pack and an unknown tier are refused')

    # A cancelled run has no linux-gate job: the observer exits 2 and there is nothing to attest.
    done, out = execute(answer([], b''), scratch=tmp / 'cancelled', env={'OBSERVER_EXIT': '2', 'GH_CONCLUSION': 'cancelled'})
    assert done.returncode == 0 and 'cancelled' in out['nothing_to_attest'] and not out.get('failures'), done.stdout
    done, out = execute(answer([], b''), scratch=tmp / 'broken', env={'OBSERVER_EXIT': '2', 'GH_CONCLUSION': 'success'})
    assert done.returncode == 1 and 'linux-gate' in out['failures'][0], 'the same exit on a finished run is a failure'
    print('passed: a cancelled run is nothing to attest; the same observer failure on a finished run still fails')

    remote = tmp / 'remote.git'
    git(tmp, 'init', '-q', '--bare', str(remote))
    git(remote, 'config', 'uploadpack.allowAnySHA1InWant', 'true')
    git(source, 'push', '-q', str(remote), 'HEAD~1:refs/heads/main')  # the source's parent exists upstream
    done, out = execute(answer([(full, 'full')], pack(full)), remote=remote, scratch=tmp / 'pushed')
    assert done.returncode == 0 and out['published'] == 1, done.stdout
    assert git(remote, 'for-each-ref', '--format=%(refname)', 'refs/notes/') == f'refs/notes/evidence/{full}'
    print('passed: verified refs are pushed; the source\'s missing parent is fetched first, never pushed shallow')

    # A scratch repository that already holds refs whose parents are absent (an earlier run without
    # --remote) must still be able to fetch them and publish.
    stale = tmp / 'stale'
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=stale)
    assert done.returncode == 0 and git(stale, 'for-each-ref', '--format=%(refname)') == f'refs/notes/evidence/{full}'
    other_remote = tmp / 'other-remote.git'
    git(tmp, 'init', '-q', '--bare', str(other_remote))
    git(other_remote, 'config', 'uploadpack.allowAnySHA1InWant', 'true')
    git(source, 'push', '-q', str(other_remote), 'HEAD~1:refs/heads/main')
    done, out = execute(answer([(full, 'full')], pack(full)), remote=other_remote, scratch=stale)
    assert done.returncode == 0 and out['published'] == 1, done.stdout
    assert git(other_remote, 'for-each-ref', '--format=%(refname)', 'refs/notes/') == f'refs/notes/evidence/{full}'
    print('passed: a scratch repository with older refs still fetches missing history and publishes')

    # Replaying the same run is idempotent; a ref that names something else is never replaced.
    done, out = execute(answer([(full, 'full')], pack(full)), remote=remote, scratch=tmp / 'pushed')
    assert done.returncode == 0, done.stdout
    other = record('full', check='another')
    git(tmp / 'pushed', 'update-ref', f'refs/notes/evidence/{other}', full)
    done, out = execute(answer([(other, 'full')], pack(other)), scratch=tmp / 'pushed')
    assert done.returncode == 1 and 'never replaced' in out['failures'][0], out
    print('passed: replays are idempotent and an existing evidence ref is never replaced')

    # Without --keys the accepted list is read from the checkout the script runs in.
    checkout = tmp / 'checkout'
    git(tmp, 'init', '-q', str(checkout))
    (checkout / '.st').mkdir()
    (checkout / '.st/evidence-keys').write_text(signers.read_text())
    git(checkout, 'add', '.')
    git(checkout, 'commit', '-q', '-m', 'keys')
    response_file.write_text(json.dumps(answer([(full, 'full')], pack(full))))
    base = [sys.executable, str(SCRIPT), '--repository', 'example/repo', '--run', '7', '--attempt', '1', '--artifact', '9',
            '--observer', json.dumps([sys.executable, str(observer)]), '--verifier', str(verifier)]
    calls.write_text('')
    done = subprocess.run([*base, '--scratch', str(tmp / 'viakeys')], cwd=checkout, capture_output=True, env=dict(ENV, VERIFIER_OK='1', PATH=f'{bin_dir}:{ENV["PATH"]}'))
    assert done.returncode == 0, done.stdout
    argv = json.loads(calls.read_text().splitlines()[0])
    assert argv[argv.index('--keys') + 1] != str(signers) and '--keys-from' not in argv
    empty = tmp / 'nokeys'
    git(tmp, 'init', '-q', str(empty))
    git(empty, 'commit', '-q', '--allow-empty', '-m', 'none')
    done = subprocess.run([*base, '--scratch', str(tmp / 'nokeys-scratch')], cwd=empty, capture_output=True, env=dict(ENV, VERIFIER_OK='1', PATH=f'{bin_dir}:{ENV["PATH"]}'))
    assert done.returncode == 1 and 'no key list' in json.loads(done.stdout)['failures'][0]
    print('passed: the key list comes from the checkout; a missing list fails full records closed')

    # Poll mode: what a timer runs. One state directory, runs observed once, failures capped.
    state = tmp / 'state'
    runs = json.dumps([{'databaseId': 7, 'attempt': 1, 'conclusion': 'success'},
                       {'databaseId': 8, 'attempt': 1, 'conclusion': 'failure'},
                       {'databaseId': 9, 'attempt': 1, 'conclusion': 'cancelled'}])
    response_file.write_text(json.dumps(answer([(full, 'full')], pack(full))))

    def timer():
        done = subprocess.run([sys.executable, str(SCRIPT), '--poll', '--repository', 'example/repo',
                               '--observer', json.dumps([sys.executable, str(observer)]), '--verifier', str(verifier),
                               '--keys', str(signers), '--state-dir', str(state), '--remote', str(remote)],
                              capture_output=True, env=dict(ENV, VERIFIER_OK='1', GH_RUNS=runs, PATH=f'{bin_dir}:{ENV["PATH"]}'))
        return done, [json.loads(line) for line in done.stdout.decode().splitlines() if line.startswith('{"run"')]

    done, lines = timer()
    assert done.returncode == 1, done.stderr
    assert {(l['run'], l['state']) for l in lines} == {(7, 'done'), (8, 'failed')}, lines
    assert git(remote, 'for-each-ref', '--format=%(refname)', 'refs/notes/') == f'refs/notes/evidence/{full}'
    done, lines = timer()
    assert [(l['run'], l['state']) for l in lines] == [(8, 'failed')], 'a done run is never observed again, a cancelled one never'
    done, lines = timer()
    assert [(l['run'], l['state']) for l in lines] == [(8, 'gave_up')]
    done, lines = timer()
    assert lines == [] and done.returncode == 0, 'a run given up on stays given up, and the timer goes quiet'
    ledger = [json.loads(l) for l in (state / 'observed.jsonl').read_text().splitlines()]
    assert sum(1 for e in ledger if e['run'] == 8) == 3 and not any(e['run'] == 9 for e in ledger)
    print('passed: poll observes each finished run once, skips cancelled ones, and gives up on a run after three failures')

    # The evidence gate's skip contract: a check whose evidence-gate job ran `evidence skip taken` is
    # never recorded, and no other workflow (this one included) is ever acted on.
    def jobs(*entries):
        return json.dumps({'jobs': [{'name': name, 'steps': [{'name': step, 'conclusion': conclusion} for step, conclusion in steps]}
                                    for name, steps in entries]})

    response_file.write_text(json.dumps(answer([(full, 'full')], pack(full))))
    taken = jobs(('evidence-gate-linux-gate', [('Verify', 'success'), ('evidence skip taken', 'success')]),
                 ('linux-tests', [('evidence skip taken', 'success')]))
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=tmp / 'skip-taken', remote=remote, env={'GH_JOBS': taken})
    assert done.returncode == 0, done.stdout
    assert out['records'] == [] and out['skip_taken'][0]['checks'] == ['linux-gate'] and out['published'] == 0
    assert git(tmp / 'skip-taken', 'for-each-ref', 'refs/notes/evidence/') == '', 'no ref for a skipped check'
    # Second, independent signal: the check's own job ran the covered step although its gate job shows no marker.
    covered = jobs(('evidence-gate-linux-gate', [('Verify', 'success')]),
                   ('linux-gate', [('Run', 'success'), ('evidence covered by a trusted note', 'success')]))
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=tmp / 'covered', remote=remote, env={'GH_JOBS': covered})
    assert done.returncode == 0 and out['records'] == [] and out['skip_taken'][0]['checks'] == ['linux-gate'] and out['published'] == 0
    assert git(tmp / 'covered', 'for-each-ref', 'refs/notes/evidence/') == '', 'no ref when the check job itself was covered'
    not_covered = jobs(('linux-gate', [('evidence covered by a trusted note', 'skipped')]))
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=tmp / 'not-covered', env={'GH_JOBS': not_covered})
    assert done.returncode == 0 and len(out['records']) == 1, 'a covered step that did not run does not count'
    ran = jobs(('evidence-gate-linux-gate', [('Verify', 'success'), ('evidence skip taken', 'skipped')]))
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=tmp / 'skip-not-taken', env={'GH_JOBS': ran})
    assert done.returncode == 0 and len(out['records']) == 1 and 'skip_taken' not in out, 'a gate that did not skip is recorded as before'
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=tmp / 'wrong-workflow', env={'GH_RUN_NAME': 'Evidence observe'})
    assert done.returncode == 1 and 'never acting on any other workflow' in out['failures'][0]
    done, out = execute(answer([(full, 'full')], pack(full)), scratch=tmp / 'unreadable-jobs', env={'GH_JOBS': 'not json'})
    assert done.returncode == 1 and 'skips cannot be ruled out' in out['failures'][0], 'unreadable jobs fail closed'
    print('passed: a check whose gate job ran "evidence skip taken" is not recorded; other workflows and unreadable jobs are refused')
