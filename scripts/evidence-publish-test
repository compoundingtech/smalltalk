#!/usr/bin/env python3
"""evidence-publish accepts only signed full notes for this commit and tree, and never replaces a ref."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from evidence_test_support import clean_loader_environment, tool_path  # noqa: E402
clean_loader_environment()
ROOT = Path(__file__).resolve().parent.parent
PUBLISH, WRAP, SIGN = ROOT / 'scripts/evidence-publish', ROOT / 'scripts/evidence-wrap', ROOT / 'scripts/evidence-sign'
ENV = dict(os.environ, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
           GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, env=ENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


def keygen(path, comment):
    subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', comment, '-f', str(path)], check=True)
    return path.with_suffix('.pub').read_text().split()


with tempfile.TemporaryDirectory() as directory:
    tmp = Path(directory)
    good_key, rogue_key = tmp / 'good', tmp / 'rogue'
    pub = keygen(good_key, 'fleet/ci')
    keygen(rogue_key, 'fleet/ci')
    keys = tmp / 'allowed'
    keys.write_text(f'fleet/ci namespaces="git" {pub[0]} {pub[1]}\n')

    def home(name, key):
        h = tmp / name
        (h / '.config/st').mkdir(parents=True)
        (h / '.config/st/evidence-sign.json').write_text(json.dumps(
            {'signer': 'fleet/ci', 'ssh_key': str(key), 'scratch_repo': str(h / 'scratch.git'), 'path': tool_path()}))
        return h

    homes = {'good': home('h-good', good_key), 'rogue': home('h-rogue', rogue_key)}

    # The producing job: a shallow-ish clone of the tested commit.
    upstream = tmp / 'upstream'
    subprocess.run(['git', 'init', '-q', str(upstream)], check=True, env=ENV)
    (upstream / 'flake.lock').write_text('{}\n')
    git(upstream, 'add', '.')
    git(upstream, 'commit', '-q', '-m', 'one')
    (upstream / 'f').write_text('two\n')
    git(upstream, 'add', '.')
    git(upstream, 'commit', '-q', '-m', 'two')
    commit, tree = git(upstream, 'rev-parse', 'HEAD'), git(upstream, 'rev-parse', 'HEAD^{tree}')
    job = tmp / 'job'
    subprocess.run(['git', 'clone', '-q', '--depth=1', f'file://{upstream}', str(job)], check=True, env=ENV)

    def note(check, who='good', cwd=job, out=None, exit_code=0, more=None, tag=''):
        facts = tmp / f'facts-{check}-{who}{tag}.json'
        facts.write_text(json.dumps({'command': ['bash', 'scripts/ci-linux', 'tests'], 'exit_code': exit_code,
                                     'output_sha256': '3' * 64, 'inputs': {'stage': check, **(more or {})}}))
        out = out or tmp / 'notes' / who
        done = subprocess.run([sys.executable, str(WRAP), '--check', check, '--toolchain-sha256', '1' * 64, '--signer',
                               json.dumps([sys.executable, str(SIGN)]), '--aggregate', str(facts), '--out', str(out)],
                              cwd=cwd, capture_output=True, env=dict(ENV, HOME=str(homes[who])))
        assert done.returncode == exit_code, done.stderr.decode()
        return out

    note('linux-tests')
    note('linux-clippy', exit_code=1)       # a failing stage is a note too
    note('linux-fleet-compat', who='rogue')  # signed by a key that is not on the list
    note('not-allowed')

    # The publishing job: the full-history checkout of the same commit, and a remote.
    publisher = tmp / 'publisher'
    subprocess.run(['git', 'clone', '-q', f'file://{upstream}', str(publisher)], check=True, env=ENV)
    remote = tmp / 'remote.git'
    subprocess.run(['git', 'init', '-q', '--bare', str(remote)], check=True, env=ENV)
    git(publisher, 'remote', 'add', 'sink', str(remote))

    def publish(*extra, cwd=publisher, notes=tmp / 'notes'):
        done = subprocess.run([sys.executable, str(PUBLISH), '--notes', str(notes), '--keys', str(keys),
                               '--checks', 'linux-tests,linux-clippy,linux-fleet-compat', *extra],
                              cwd=cwd, capture_output=True, env=ENV)
        return done, json.loads(done.stdout)

    done, out = publish('--remote', 'sink')
    accepted = {a['check'] for a in out['accepted']}
    assert accepted == {'linux-tests', 'linux-clippy'}, out
    reasons = ' '.join(r['reason'] for r in out['refused'])
    assert 'does not verify' in reasons and 'not one of the allowed checks' in reasons, reasons
    assert done.returncode == 1 and out['pushed'], 'refusals fail the run but the good notes still go out'
    assert len(git(remote, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence/').splitlines()) == 2
    print('passed: signed full notes (a failing stage too) are published; a rogue signer and an unlisted check are refused by name')

    # The push token travels in the environment, never in an argument.
    import base64
    log = tmp / 'argv.log'
    real_git = next(str(Path(d) / 'git') for d in ENV['PATH'].split(':') if 'recorder' not in d and (Path(d) / 'git').exists())
    shim_dir = tmp / 'shim'
    shim_dir.mkdir()
    (shim_dir / 'git').write_text(f'#!/bin/sh\nprintf "%s\\n" "$*" >> {log}\nprintf "ENV %s\\n" "$GIT_CONFIG_VALUE_0" >> {log}\nexec {real_git} "$@"\n')
    (shim_dir / 'git').chmod(0o755)
    token_run = subprocess.run([sys.executable, str(PUBLISH), '--notes', str(tmp / 'notes'), '--keys', str(keys),
                                '--checks', 'linux-tests,linux-clippy', '--remote', 'sink'], cwd=publisher, capture_output=True,
                               env=dict(ENV, EVIDENCE_PUSH_TOKEN='secret-token-xyz', PATH=f'{shim_dir}:{ENV["PATH"]}'))
    header = base64.b64encode(b'x-access-token:secret-token-xyz').decode()
    lines = log.read_text().splitlines()
    assert 'secret-token-xyz' not in token_run.stdout.decode() + token_run.stderr.decode()
    assert not any('secret-token-xyz' in l or header in l for l in lines if not l.startswith('ENV ')), 'token in an argument'
    assert any(header in l for l in lines if l.startswith('ENV ')), 'token reaches git through the environment'
    print('passed: the push token reaches git through the environment, not through an argument')

    again, again_out = publish('--remote', 'sink')
    assert again_out['pushed'] and len(git(remote, 'for-each-ref', 'refs/notes/evidence/').splitlines()) == 2, 'a replay publishes nothing new'
    print('passed: publishing the same notes again is idempotent')

    # A note about another commit is refused.
    (upstream / 'f').write_text('three\n')
    git(upstream, 'commit', '-q', '-am', 'three')
    other = tmp / 'other'
    subprocess.run(['git', 'clone', '-q', '--depth=1', f'file://{upstream}', str(other)], check=True, env=ENV)
    stray = note('linux-tests', cwd=other, out=tmp / 'stray')
    done, out = publish(notes=stray)
    assert done.returncode == 1 and 'another commit or tree' in out['refused'][0]['reason'] and not out['accepted']
    print('passed: a note about another commit or tree is refused')

    # A shallow publisher cannot push; refused with the reason instead of a server error.
    done, out = publish('--remote', 'sink', cwd=job)
    assert done.returncode == 1 and 'shallow' in out['refused'][0]['reason']
    print('passed: a shallow checkout is refused before any push')

    # An input key: a record that carries source_inputs is also indexed under its check and key, one ref per record.
    key = git(upstream, 'rev-parse', 'HEAD~1^{tree}')  # any tree id stands for the projection
    keyed = tmp / 'keyed'
    for tag, code in (('pass', 0), ('fail', 1)):
        note('linux-tests', out=keyed, exit_code=code, more={'source_inputs': key, 'attempt_tag': tag}, tag=tag)
    plain = tmp / 'plain-only'
    note('linux-tests', out=plain, exit_code=0, tag='plain')
    publisher2 = tmp / 'publisher2'
    # a publisher on the commit the keyed notes were made for is the first one; `three` moved upstream since
    subprocess.run(['git', 'clone', '-q', f'file://{upstream}', str(publisher2)], check=True, env=ENV)
    remote2 = tmp / 'remote2.git'
    subprocess.run(['git', 'init', '-q', '--bare', str(remote2)], check=True, env=ENV)
    git(publisher2, 'remote', 'add', 'sink', str(remote2))
    keyed_notes = tmp / 'keyed-notes'
    keyed_notes.mkdir()
    # the keyed notes were signed in `job`, whose commit is `two`; publish them from a checkout of `two`
    git(publisher2, 'checkout', '-q', commit)
    done, out = publish('--remote', 'sink', cwd=publisher2, notes=keyed)
    assert done.returncode == 0 and len(out['accepted']) == 2, out
    refs = git(remote2, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence-input/').splitlines()
    records = [a['record'] for a in out['accepted']]
    assert sorted(refs) == sorted(f'refs/notes/evidence-input/linux-tests/{key}/{r}' for r in records), refs
    for ref in refs:
        assert git(remote2, 'rev-parse', ref) == ref.rsplit('/', 1)[1], 'each index ref points at the record it is named for'
    print('passed: a record with source_inputs is indexed under its check and key, one ref per record, pass and fail alike')
    done, out = publish('--remote', 'sink', cwd=publisher2, notes=plain)
    assert done.returncode == 0 and 'input_ref' not in out['accepted'][0]
    assert len(git(remote2, 'for-each-ref', 'refs/notes/evidence-input/').splitlines()) == 2, 'a record without a key adds no index ref'
    print('passed: a record without source_inputs is published under refs/notes/evidence only')
    bad = tmp / 'badkey'
    note('linux-tests', out=bad, more={'source_inputs': 'not-a-tree-id'}, tag='bad')
    done, out = publish('--remote', 'sink', cwd=publisher2, notes=bad)
    assert done.returncode == 1 and 'git tree id' in out['refused'][0]['reason'] and not out['accepted'], out
    print('passed: a malformed source_inputs is refused, nothing is indexed')
