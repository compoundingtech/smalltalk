#!/usr/bin/env bash
# Prove, with a live Codex seat, that a saved thread resumes under the managed minimal profile and
# keeps its access: after an `agents restart` the same thread still reaches the st daemon socket and
# the network, and is still refused a write outside its workspace.
#
# The remote TUI refuses permission config on a resume ("Permission overrides are not supported when
# resuming a remote task"), and the driver then silently starts a new thread, so the check compares
# thread ids and requires the restart not to produce a new one.
#
# Usage: resume-check BIN_DIR OUT [MODEL]
#
# BIN_DIR holds the st3 binary under test. OUT receives verdict.txt, the seat's transcript and
# provider argv. Paid: two small Codex turns. Run by hand on the build host.
set -Eeuo pipefail

# A seat running this must not act as itself against the throwaway daemon.
unset ST_AGENT ST3_INCARNATION ST_MISSION_RUN ST3_ENDPOINT ST_HOOKS

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
source "$repo/scripts/st3-seat-queue-perf/daemon.sh"
bin_dir="$(readlink -f "$1")"
mkdir -p "$2"
out="$(cd "$2" && pwd)"
model="${3:-gpt-6-luna}"

root="$(mktemp -d /tmp/cmr.XXXXXX)"
# shellcheck disable=SC2064
trap "perf_stop_daemon '$root' >/dev/null 2>&1 || true; rm -rf '$root'" EXIT
mkdir -p "$root/bin" "$root/state" "$root/pty" "$root/work"
cp "$bin_dir/st3" "$root/bin/"
[[ -x $bin_dir/st2 ]] && cp "$bin_dir/st2" "$root/bin/"
git init -q "$root/work"
cat >"$root/config.toml" <<TOML
node = "evalnode"
person = "person/eval-operator"
state_dir = "$root/state"
socket = "$root/st3.sock"
client_gateway_socket = "$root/client.sock"
access_mode = "auto"
TOML
env -i HOME="$HOME" USER="$USER" LOGNAME="$USER" SHELL="$SHELL" LANG="${LANG:-C.UTF-8}" \
  PATH="$root/bin:$(perf_login_path)" \
  setsid "$root/bin/st3" up --config "$root/config.toml" --pty-root "$root/pty" \
  >"$root/daemon.log" 2>&1 </dev/null &
echo $! >"$root/daemon.pid"
for _ in $(seq 1 150); do
  [[ -S "$root/st3.sock" ]] && break
  sleep 0.2
done
[[ -S "$root/st3.sock" ]] || { echo "the daemon did not open its socket" >&2; exit 1; }
export ST3_ENDPOINT="$root/st3.sock"
st="$root/bin/st3"
operator=person/eval-operator
seat=agent/resume-check/worker

cat >"$root/seat.kdl" <<KDL
version 2

agent "resume-check/worker" {
  description "Resumes a saved thread under the default profile."
  workspace "$root/work"
  harness "codex" {
    model "$model"
  }
  restart "never"
}
KDL
"$st" apply "$root/seat.kdl" --as "$operator" >"$out/apply.txt" 2>&1

wait_state() { # wait_state PATTERN SECONDS
  local deadline=$((SECONDS + $2))
  while ((SECONDS < deadline)); do
    "$st" agents ls 2>/dev/null | grep -q "resume-check/worker.*$1" && return 0
    sleep 3
  done
  return 1
}
turn() { # turn KEY BODY FILE: send, then wait for the seat to write FILE (or give up after 5 minutes)
  "$st" conversations send "$seat" --from "$operator" --kind wake --subject "$1" \
    --idempotency-key "$1" --body "$2" >/dev/null
  local deadline=$((SECONDS + 300))
  while ((SECONDS < deadline)) && [[ ! -e $root/work/$3 ]]; do sleep 3; done
  sleep 10 # let the turn finish and the seat go idle before the next step
}
wait_state running 120 || { echo "the seat did not start" >&2; exit 1; }
turn first "Using a shell command, create a file named first.txt in your workspace that contains the word first. Then reply with the single word done and nothing else." first.txt
"$st" agents restart "$seat" --now --as "$operator" >"$out/restart.txt" 2>&1 || true
wait_state running 180 || true
turn second "Do these in order, once each, and then reply with the single word done. (1) Run: git ls-remote https://github.com/compoundingtech/smalltalk HEAD > network.txt (2) Run: \"\$ST3_BIN\" conversations ls --as \"\$ST_AGENT\" > st.txt (3) Run exactly this once and do not retry it: bash -c 'echo outside > \$HOME/st-resume-outside.txt' 2> outside.txt . Do not request an escalation for any of them and do not change any setting." outside.txt

diagnostics="$("$st" trace show agent/resume-check/worker 2>/dev/null | grep -c 'started a new session' || true)"
"$st" trace show agent/resume-check/worker >"$out/trace.txt" 2>&1 || true
file="$(grep -l -r -F "$root/work" "$HOME/.codex/sessions" 2>/dev/null | xargs -r ls -t | head -1)"
[[ -n $file ]] && cp "$file" "$out/transcript.jsonl"
cp "$root/daemon.log" "$out/"
{
  echo "new-session fallbacks: $diagnostics"
  echo "sessions for this workspace: $(grep -l -r -F "$root/work" "$HOME/.codex/sessions" 2>/dev/null | wc -l)"
  [[ -s $root/work/first.txt ]] && echo "first turn wrote: yes" || echo "first turn wrote: NO"
  [[ $(cut -c1-40 "$root/work/network.txt" 2>/dev/null | grep -cE '^[0-9a-f]{40}') -ge 1 ]] && echo "resumed network: yes" || echo "resumed network: NO"
  [[ -s $root/work/st.txt ]] && echo "resumed st call: yes" || echo "resumed st call: NO"
  grep -q 'Read-only file system' "$root/work/outside.txt" 2>/dev/null && echo "resumed outside write refused: yes" || echo "resumed outside write refused: NO"
  [[ ! -e $HOME/st-resume-outside.txt ]] && echo "outside file absent: yes" || echo "outside file absent: NO"
} | tee "$out/verdict.txt"
if grep -q ': NO$' "$out/verdict.txt" || ! grep -qx 'new-session fallbacks: 0' "$out/verdict.txt" ||
  ! grep -qx 'sessions for this workspace: 1' "$out/verdict.txt"; then
  echo "resume check failed: see $out/verdict.txt" >&2
  exit 1
fi
