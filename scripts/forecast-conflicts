#!/usr/bin/env python3
"""Forecast which open pull requests a candidate commit would newly conflict with.

For each pull request head, run git merge-tree between the candidate and the head, with git's
default and with merge.directoryRenames=true, and compare with the same merge against the base.
Only pull requests that merge cleanly into the base but not into the candidate are "newly
conflicting". merge-main merges with directory renames; the merge queue does not.

  forecast-conflicts CANDIDATE --open-prs        fetch every open pull request head with gh
  forecast-conflicts CANDIDATE --refs REF...     use these refs (tests, or heads you fetched)
"""
import argparse
import json
from pathlib import Path
import subprocess
import sys
sys.dont_write_bytecode = True


def git(repo, *args, check=True):
    return subprocess.run(["git", *args], cwd=repo, text=True, capture_output=True, check=check)


def conflicts(repo, target, ref, renames):
    command = ["git"]
    if renames:
        command += ["-c", "merge.directoryRenames=true"]
    command += ["merge-tree", "--write-tree", "--no-messages", target, ref]
    result = subprocess.run(command, cwd=repo, text=True, capture_output=True)
    if result.returncode not in (0, 1):
        raise RuntimeError(f"git merge-tree {target} {ref}: {result.stderr.strip()}")
    return result.returncode == 1


def open_pull_requests(repo):
    listing = subprocess.run(
        ["gh", "pr", "list", "--state", "open", "--limit", "1000", "--json", "number,isDraft"],
        cwd=repo, text=True, capture_output=True, check=True).stdout
    prs = json.loads(listing)
    specs = [f"+refs/pull/{pr['number']}/head:refs/prs/{pr['number']}" for pr in prs]
    git(repo, "fetch", "--quiet", "origin", *specs)
    return [(f"refs/prs/{pr['number']}", f"#{pr['number']}", pr["isDraft"]) for pr in prs]


def forecast(repo, candidate, base, refs):
    rows = []
    for ref, label, draft in refs:
        already = conflicts(repo, base, ref, False)
        rows.append({
            "pr": label, "draft": draft, "conflicts_with_base": already,
            "newly_conflicting_default": not already and conflicts(repo, candidate, ref, False),
            "newly_conflicting_with_renames": not already and conflicts(repo, candidate, ref, True),
        })
    return rows


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("candidate")
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--repo", type=Path, default=Path(__file__).resolve().parent.parent)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--open-prs", action="store_true")
    source.add_argument("--refs", nargs="+")
    args = parser.parse_args()
    refs = open_pull_requests(args.repo) if args.open_prs else [(r, r.rsplit("/", 1)[-1], False) for r in args.refs]
    rows = forecast(args.repo, args.candidate, args.base, refs)
    count = lambda key, ready=None: sum(1 for r in rows if r[key] and (ready is None or r["draft"] != ready))
    print(json.dumps({
        "pull_requests": len(rows),
        "conflict_with_base": count("conflicts_with_base"),
        "newly_conflicting_default": count("newly_conflicting_default"),
        "newly_conflicting_default_ready": count("newly_conflicting_default", True),
        "newly_conflicting_with_renames": count("newly_conflicting_with_renames"),
        "newly_conflicting_with_renames_ready": count("newly_conflicting_with_renames", True),
        "newly_conflicting_with_renames_prs": [r["pr"] for r in rows if r["newly_conflicting_with_renames"]],
    }, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
