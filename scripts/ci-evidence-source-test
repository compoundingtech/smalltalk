#!/usr/bin/env python3
"""Exercise the real source receipt producer against shallow, synthetic Git checkouts."""
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

sys.dont_write_bytecode = True
# st2#3014: git exports GIT_DIR (and more) to a hook, and `git -C <tmp>` below would still act on the caller's repository. Fixtures here need none.
for _name in [name for name in os.environ if name.startswith('GIT_')]:
    del os.environ[_name]
ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / 'scripts/ci-evidence-source'
loader = importlib.machinery.SourceFileLoader('source_receipt', str(SCRIPT))
spec = importlib.util.spec_from_loader(loader.name, loader)
source_receipt = importlib.util.module_from_spec(spec)
loader.exec_module(source_receipt)


class WorkflowBoundary(unittest.TestCase):
    def test_generated_producer_has_the_same_bytes_as_the_pinned_recipe(self):
        workflow = (ROOT / '.github/workflows/fleet.yml').read_text()
        job = workflow.split('  evidence-source:\n', 1)[1].split('  upgrade-impact:\n', 1)[0]
        embedded = job.split("<<'EVIDENCE_SOURCE_PY'\n", 1)[1].split('          EVIDENCE_SOURCE_PY\n', 1)[0]
        recipe = '\n'.join(line.removeprefix('          ') for line in embedded.splitlines()) + '\n'
        self.assertEqual(recipe.encode(), SCRIPT.read_bytes())
        self.assertIn('    continue-on-error: true\n', job)
        self.assertIn('      contents: read\n', job)
        self.assertNotRegex(job, r'(?m)^    needs:|secrets\.|GH_TOKEN|contents: write')
        gate = workflow.split('  linux-gate:\n', 1)[1].split('\n  perf-cost:', 1)[0]
        self.assertNotIn('evidence-source', gate)
        self.assertIn('ci-evidence-source-' + chr(36) + '{{ github.run_attempt }}', job)


class SourceReceipt(unittest.TestCase):
    def setUp(self):
        self.scratch = tempfile.TemporaryDirectory()
        self.addCleanup(self.scratch.cleanup)
        self.root = Path(self.scratch.name)
        self.repo = self.root / 'repo'
        self.repo.mkdir()
        self.git('init', '-q')
        self.configure_fixture(self.repo)
        self.git('config', 'user.name', 'Fixture Observer')
        self.git('config', 'user.email', 'observer@example.invalid')
        self.commit('initial', {'unchanged': 'same', 'deleted': 'old'})
        self.base = self.git('rev-parse', 'HEAD')
        self.commit('author', {'changed': 'reviewed'})
        self.author = self.git('rev-parse', 'HEAD')
        self.git('checkout', '-q', '-b', 'accepted-main', self.base)
        self.commit('main changed', {'unrelated-main': 'new'})
        self.accepted = self.git('rev-parse', 'HEAD')
        self.git('merge', '-q', '--no-ff', self.author, '-m', 'synthetic checked merge')
        self.source = self.git('rev-parse', 'HEAD')
        self.tree = self.git('rev-parse', 'HEAD^{tree}')
        self.event = {'repository': {'full_name': 'example/project'}, 'number': 7,
                      'pull_request': {'number': 7, 'head': {'sha': self.author}}}
        self.event_path = self.root / 'event.json'
        self.event_path.write_text(json.dumps(self.event))
        self.environment = {
            'GITHUB_SHA': self.source, 'GITHUB_REPOSITORY': 'example/project',
            'GITHUB_EVENT_NAME': 'pull_request', 'GITHUB_EVENT_PATH': str(self.event_path),
            'GITHUB_RUN_ID': '123', 'GITHUB_RUN_ATTEMPT': '2',
        }

    def git(self, *args, repo=None):
        return source_receipt.git(repo or self.repo, *args, text=True).strip()

    def configure_fixture(self, repo):
        # These small disposable repositories have no maintenance lifecycle.
        # A detached Git writer can otherwise outlive its command and race
        # TemporaryDirectory cleanup, even though every subprocess was waited.
        self.git('config', 'maintenance.auto', 'false', repo=repo)
        self.git('config', 'gc.auto', '0', repo=repo)

    def commit(self, message, files):
        for name, contents in files.items():
            (self.repo / name).write_text(contents)
        self.git('add', '.')
        self.git('commit', '-qm', message)

    def produce(self, environment=None, repo=None):
        return source_receipt.produce(repo or self.repo, self.root / 'receipt',
                                      environment or self.environment, SCRIPT.read_bytes())

    def test_synthetic_tree_survives_shallow_checkout_and_import(self):
        shallow = self.root / 'shallow'
        subprocess.run(['git', '-c', 'maintenance.auto=false', '-c', 'gc.auto=0',
                        'clone', '-q', '--depth=1', self.repo.as_uri(), str(shallow)], check=True)
        self.configure_fixture(shallow)
        self.assertEqual(self.git('rev-parse', '--is-shallow-repository', repo=shallow), 'true')
        receipt = self.produce(repo=shallow)
        self.assertEqual(receipt['source'], self.source)
        self.assertNotEqual(receipt['source'], self.author)
        self.assertEqual(receipt['tree'], self.tree)
        self.assertEqual(receipt['change_id'], 'github:example/project#7')
        self.assertEqual(receipt['producer_sha256'], hashlib.sha256(SCRIPT.read_bytes()).hexdigest())
        destination = self.root / 'observer.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(destination)], check=True)
        self.configure_fixture(destination)
        pack = (self.root / 'receipt/source.pack').read_bytes()
        self.assertEqual(receipt['pack_bytes'], len(pack))
        self.assertEqual(receipt['pack_sha256'], hashlib.sha256(pack).hexdigest())
        subprocess.run(['git', '-C', str(destination), 'index-pack', '--stdin'],
                       input=pack, check=True, stdout=subprocess.DEVNULL)
        self.assertEqual(self.git('rev-parse', self.source + '^{tree}', repo=destination), self.tree)
        self.assertEqual(self.git('ls-tree', '-rz', self.source, repo=destination),
                         self.git('ls-tree', '-rz', self.source))
        self.assertEqual(self.git('show', self.source + ':unrelated-main', repo=destination), 'new')
        self.assertEqual(self.git('show', self.source + ':changed', repo=destination), 'reviewed')
        # No history or configurable executables are carried into the signer's scratch repo.
        result = subprocess.run(['git', '-C', str(destination), 'cat-file', '-e', self.base],
                                capture_output=True)
        self.assertNotEqual(result.returncode, 0)

    def test_wrong_checkout_does_not_leave_an_artifact(self):
        environment = {**self.environment, 'GITHUB_SHA': self.author}
        with self.assertRaisesRegex(ValueError, 'effective tested'):
            self.produce(environment)
        self.assertFalse((self.root / 'receipt').exists())

    def test_replacement_objects_do_not_rewrite_the_observed_source(self):
        self.git('replace', self.source, self.author)
        receipt = self.produce()
        self.assertEqual(receipt['source'], self.source)
        self.assertEqual(receipt['tree'], self.tree)

    def test_new_attempt_and_source_have_distinct_provenance(self):
        receipt = self.produce()
        environment = {**self.environment, 'GITHUB_RUN_ATTEMPT': '3'}
        other = source_receipt.produce(self.repo, self.root / 'rerun', environment, SCRIPT.read_bytes())
        self.assertEqual(other['tree'], receipt['tree'])
        self.assertNotEqual(other['run_attempt'], receipt['run_attempt'])
        self.assertEqual(other['pack_sha256'], receipt['pack_sha256'])

    def test_queue_identity_names_entry_but_retains_whole_merge(self):
        event = {'repository': {'full_name': 'example/project'}, 'merge_group': {
            'head_sha': self.source,
            'head_ref': 'refs/heads/gh-readonly-queue/main/pr-7-' + self.source}}
        self.event_path.write_text(json.dumps(event))
        receipt = self.produce({**self.environment, 'GITHUB_EVENT_NAME': 'merge_group'})
        self.assertEqual(receipt['source'], self.source)
        self.assertEqual(receipt['change_id'], 'github:example/project#7')
        event['merge_group']['head_sha'] = self.author
        with self.assertRaises(ValueError):
            source_receipt.change_identity('example/project', 'merge_group', event, self.source)

    def test_dispatch_identity_does_not_invent_a_pull_request(self):
        self.assertEqual(source_receipt.change_identity(
            'example/project', 'workflow_dispatch', self.event, self.source),
            'github:example/project@' + self.source)

    def test_identity_rejects_ambiguous_events_and_bad_ids(self):
        for number in (True, 0, -1, '7', None):
            event = copy.deepcopy(self.event)
            event['number'] = number
            with self.assertRaises(ValueError):
                source_receipt.change_identity('example/project', 'pull_request', event, self.source)
        for repository in ('other/project', '../project', 'example/project/extra'):
            with self.assertRaises(ValueError):
                source_receipt.change_identity(repository, 'pull_request', self.event, self.source)
        for value in ('0', '-1', '01', '1\n', '1/2'):
            with self.assertRaises(ValueError):
                source_receipt.positive(value)
        with self.assertRaises(ValueError):
            source_receipt.change_identity('example/project', 'push', self.event, self.source)

    def test_existing_destination_is_never_reused(self):
        self.produce()
        with self.assertRaises(FileExistsError):
            self.produce()

    def test_actual_entrypoint_measures_its_embedded_bytes(self):
        producer = self.root / 'trusted-producer.py'
        producer.write_bytes(SCRIPT.read_bytes())
        summary = self.root / 'summary'
        result = subprocess.run([sys.executable, str(producer)], cwd=self.repo,
                                env={**os.environ, **self.environment,
                                     'RUNNER_TEMP': str(self.root),
                                     'GITHUB_STEP_SUMMARY': str(summary)},
                                capture_output=True, text=True, check=True)
        receipt = json.loads(result.stdout)
        self.assertEqual(receipt['producer_sha256'], hashlib.sha256(producer.read_bytes()).hexdigest())
        self.assertEqual(json.loads((self.root / 'ci-evidence-source/receipt.json').read_bytes()), receipt)
        self.assertIn(self.source, summary.read_text())
        self.assertIn('neither check success nor signing trust', summary.read_text())


class FixtureIsolation(unittest.TestCase):
    def test_fixture_does_not_launch_inherited_automatic_maintenance(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            config = root / 'gitconfig'
            config.write_text('[maintenance]\n\tauto = true\n[gc]\n\tauto = 1\n\tautoDetach = false\n')
            trace = root / 'trace.jsonl'
            # Keep the diagnostic run synchronous even before the fix, so this
            # control can expose maintenance without itself leaving a writer.
            with patch.dict(os.environ, GIT_CONFIG_GLOBAL=str(config),
                            GIT_TRACE2_EVENT=str(trace)):
                case = SourceReceipt('test_dispatch_identity_does_not_invent_a_pull_request')
                result = unittest.TestResult()
                case.run(result)
            self.assertTrue(result.wasSuccessful(), result.errors + result.failures)
            events = [json.loads(line) for line in trace.read_text().splitlines()]
            maintenance = [event for event in events
                           if event.get('event') == 'child_start'
                           and 'maintenance' in event.get('argv', [])]
            self.assertEqual(maintenance, [], 'temporary Git fixtures must have no automatic maintenance writer')


if __name__ == '__main__':
    unittest.main()
