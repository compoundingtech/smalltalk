#!/usr/bin/env python3
"""Main baselines and durable main/same-PR Performance snapshots."""
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor


def api(path):
    return json.loads(subprocess.check_output(['gh', 'api', path], text=True))


def trusted(run):
    return (run.get('head_branch') == 'main' and run.get('conclusion') == 'success'
            and run.get('event') in ('push', 'schedule', 'workflow_dispatch')
            and run.get('path') == '.github/workflows/perf.yml')


def trusted_snapshot(run):
    # A completed workload can miss a latency budget while its compiled outputs and
    # generated source stores remain valid. Failed reports never become baselines.
    return run.get('conclusion') in ('success', 'failure') and trusted(dict(run, conclusion='success'))


def valid_report(report):
    # Never substitute tiny fixture reports or measurements with a different workload.
    def number(value):
        return (type(value) is int or type(value) is float and math.isfinite(value)) and value >= 0
    return (isinstance(report, dict) and number(report.get('scale')) and report['scale'] == 1
            and number(report.get('seconds')) and report['seconds'] >= 120
            and type(report.get('claims')) is int and report['claims'] > 0
            and report.get('long_poll_seats') == 30 and number(report.get('daemon_cores'))
            and isinstance(report.get('paths'), dict) and bool(report['paths'])
            and isinstance(report.get('failed'), dict)
            and all(isinstance(path, dict) and all(number(path.get(key)) for key in
                    ('count', 'p50_ms', 'p99_ms', 'max_ms', 'budget_ms'))
                    for path in report['paths'].values()))


def own_pr(run, number, repository, branch, commits):
    return (run.get('event') == 'pull_request' and run.get('conclusion') in ('success', 'failure')
            and run.get('path') == '.github/workflows/perf.yml'
            and (run.get('head_repository') or {}).get('full_name') == repository
            and run.get('head_branch') == branch and run.get('head_sha') in commits
            and (not run.get('pull_requests') or
                 any(pr.get('number') == number for pr in run['pull_requests'])))


def download(repo, run, name, dest):
    subprocess.run(['gh', 'run', 'download', str(run['id']), '--repo', repo,
                    '--name', name, '--dir', str(dest)], check=True)


def git(work, *args):
    return subprocess.check_output(['git', '-C', str(work), *args], text=True,
                                   env=dict(os.environ, GIT_OPTIONAL_LOCKS='0')).rstrip('\n')


def source_paths(work):
    paths = set()
    for name in git(work, 'ls-files', '-z').split('\0'):
        if name:
            path = Path(name)
            paths.add(path)
            paths.update(path.parents)
    return {path for path in paths if (work / path).exists() or (work / path).is_symlink()}


def remember_sources():
    work = Path(os.environ['GITHUB_WORKSPACE'])
    checkpoint = Path(os.environ['RUNNER_TEMP']) / 'perf-source-state.json'
    checkpoint.unlink(missing_ok=True)
    if git(work, 'status', '--porcelain'):
        print('Performance source timestamps: dirty checkout; Cargo validates it normally', flush=True)
        return
    checkpoint.write_text(json.dumps(dict(head=git(work, 'rev-parse', 'HEAD'),
        mtimes={str(path): (work / path).lstat().st_mtime_ns for path in source_paths(work)})))


def restore_sources(checkpoint=None):
    work = Path(os.environ['GITHUB_WORKSPACE'])
    checkpoint = checkpoint or Path(os.environ['RUNNER_TEMP']) / 'st-ci-cache/perf-source-state.json'
    if not checkpoint.exists():
        print('Performance source timestamps: no saved checkpoint', flush=True)
        return
    state = json.loads(checkpoint.read_text())
    if not isinstance(state, dict):
        raise ValueError('invalid source timestamp checkpoint')
    if state.get('head') != git(work, 'rev-parse', 'HEAD') or git(work, 'status', '--porcelain'):
        print('Performance source timestamps: source changed; Cargo validates the new checkout', flush=True)
        return
    allowed = source_paths(work)
    mtimes = state.get('mtimes')
    if (not isinstance(mtimes, dict) or set(mtimes) != {str(path) for path in allowed}
            or any(type(stamp) is not int or stamp < 0 for stamp in mtimes.values())):
        raise ValueError('invalid source timestamp checkpoint')
    for name, stamp in mtimes.items():
        path = work / name
        os.utime(path, ns=(path.lstat().st_atime_ns, stamp), follow_symlinks=False)
    print('Performance source timestamps: restored for the exact clean source SHA', flush=True)


def unpack(archive, destination, names):
    # These are main's own archives, but refuse unexpected roots before extracting.
    listing = subprocess.check_output(['tar', '--zstd', '-tf', str(archive)], text=True)
    for name in listing.splitlines():
        path = Path(name)
        if path.is_absolute() or '..' in path.parts or path.parts[0] not in names:
            raise ValueError('unexpected snapshot path')
    subprocess.run(['tar', '--zstd', '-xf', str(archive), '-C', str(destination)], check=True)


def restore():
    repo = os.environ['GITHUB_REPOSITORY']
    work = Path(os.environ['GITHUB_WORKSPACE'])
    temp = Path(os.environ['RUNNER_TEMP'])
    baseline = temp / 'perf-baseline'
    baseline.mkdir(exist_ok=True)
    for report in baseline.glob('load-*.json'):
        report.unlink()
    wanted = {'build': os.environ['PERF_BUILD_SNAPSHOT'],
              'stores': os.environ['PERF_STORES_SNAPSHOT']}
    found = set()
    reports = 0
    def snapshots(run, names, dest, origin):
        def fetch(kind, name):
            start = time.monotonic()
            directory = dest / kind
            download(repo, run, name, directory)
            downloaded = time.monotonic()
            roots = ('target', 'cargo-home', 'perf-sccache', 'st-ci-cache') if kind == 'build' else ('st-bench',)
            extracted = directory / 'extracted'
            extracted.mkdir()
            unpack(directory / f'{kind}.tar.zst', extracted, roots)
            for root in roots:
                if not (extracted / root).is_dir():
                    raise ValueError(f'incomplete {kind} snapshot: missing {root}')
            return extracted, roots, downloaded - start, time.monotonic() - downloaded

        # Download and extract the independent archives together. Keep installation and HIT
        # reporting on this thread, after validating every required root of that snapshot.
        with ThreadPoolExecutor(max_workers=2) as pool:
            pending = [(kind, pool.submit(fetch, kind, name)) for kind, name in wanted.items()
                       if kind not in found and name in names]
            for kind, future in pending:
                extracted, roots, downloaded, unpacked = future.result()
                for root in roots:
                    target = (work if root == 'target' else temp) / root
                    shutil.rmtree(target, ignore_errors=True)
                    shutil.move(extracted / root, target)
                found.add(kind)
                print(f"Performance {kind} cache HIT: {origin} run {run['id']} "
                      f"(download {downloaded:.1f}s, extract {unpacked:.1f}s)", flush=True)

    def artifact_names(run):
        artifacts = api(f"repos/{repo}/actions/runs/{run['id']}/artifacts?per_page=100")
        return {item['name'] for item in artifacts['artifacts'] if not item['expired']}

    # Investigation control only: all after samples use the exact fixture from the
    # three frozen-main before samples. Keep normal build restoration and gate baselines.
    pinned = api(f'repos/{repo}/actions/runs/37281901496')
    if not trusted_snapshot(pinned):
        raise ValueError('the fixed control fixture must be a completed main workload')
    with tempfile.TemporaryDirectory(dir=temp) as tmp:
        snapshots(pinned, {wanted['stores']}, Path(tmp), 'fixed control main fixture')
    if 'stores' not in found:
        raise ValueError('the fixed control fixture is unavailable')

    # PR snapshots can be reused only by that same PR, never by main or another PR.
    # A rerun changes the current run's status: verify its previous successful attempt directly.
    # GitHub may hide that attempt's artifacts; main remains the durable fallback.
    if os.environ['GITHUB_EVENT_NAME'] == 'pull_request':
        number = int(os.environ['PERF_PR_NUMBER'])
        branch = os.environ['GITHUB_HEAD_REF']
        repository = os.environ['PERF_HEAD_REPOSITORY']
        commits = set()
        page = 1
        while True:
            entries = api(f'repos/{repo}/pulls/{number}/commits?per_page=100&page={page}')
            commits.update(entry['sha'] for entry in entries)
            if len(entries) < 100:
                break
            page += 1
        candidates = []
        attempt = int(os.environ['GITHUB_RUN_ATTEMPT'])
        if attempt > 1:
            previous = api(f"repos/{repo}/actions/runs/{os.environ['GITHUB_RUN_ID']}/attempts/{attempt - 1}")
            candidates.append(previous)
        from urllib.parse import quote
        candidates += api(f'repos/{repo}/actions/workflows/perf.yml/runs?event=pull_request&branch={quote(branch, safe="")}&status=completed&per_page=100')['workflow_runs']
        for run in candidates:
            if not own_pr(run, number, repository, branch, commits):
                continue
            with tempfile.TemporaryDirectory(dir=temp) as tmp:
                snapshots(run, artifact_names(run), Path(tmp), 'this PR')
            if len(found) == 2:
                break
    # Bound discovery; seven days of snapshots and thirty days of reports fit comfortably.
    runs = api(f'repos/{repo}/actions/workflows/perf.yml/runs?branch=main&status=completed&per_page=100')
    for run in runs['workflow_runs']:
        if not trusted_snapshot(run):
            continue
        names = artifact_names(run)
        with tempfile.TemporaryDirectory(dir=temp) as tmp:
            dest = Path(tmp)
            snapshots(run, names, dest, 'main')
            if trusted(run) and reports < 5 and 'perf-load-logs' in names:
                download(repo, run, 'perf-load-logs', dest / 'report')
                files = list((dest / 'report').rglob('load.json'))
                if len(files) != 1:
                    raise ValueError('successful main run is missing its load report')
                report = json.loads(files[0].read_text())
                if not valid_report(report):
                    raise ValueError('main load report has an incompatible workload')
                shutil.copyfile(files[0], baseline / f"load-{run['id']}.json")
                reports += 1
        if len(found) == 2 and reports == 5:
            break
    for kind in wanted.keys() - found:
        print(f'::warning::P0: Performance {kind} cache MISS; seed this recipe on main', flush=True)
    restore_sources()
    # Fix the comparison reports too: these are the five successful main reports used by
    # the original unchanged-main controls, not newer successes discovered mid-experiment.
    for report in baseline.glob('load-*.json'):
        report.unlink()
    reports = 0
    for run_id in (37276978494, 37273736714, 37265290064, 37257137831, 37256435588):
        run = api(f'repos/{repo}/actions/runs/{run_id}')
        if not trusted(run):
            raise ValueError('a fixed comparison report must be from successful main')
        with tempfile.TemporaryDirectory(dir=temp) as tmp:
            dest = Path(tmp)
            download(repo, run, 'perf-load-logs', dest)
            files = list(dest.rglob('load.json'))
            if len(files) != 1 or not valid_report(json.loads(files[0].read_text())):
                raise ValueError('invalid fixed comparison report')
            shutil.copyfile(files[0], baseline / f'load-{run_id}.json')
            reports += 1
    print('Performance fixed control baseline: five original successful main reports', flush=True)
    print(f'Performance baseline: {reports} real successful main reports', flush=True)
    with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as summary:
        summary.write(f'Performance caches: build **{"HIT" if "build" in found else "MISS (P0)"}**, '
                      f'stores **{"HIT" if "stores" in found else "MISS (P0)"}**; '
                      f'baseline: **{reports} successful main reports**.\n')
        for kind in wanted.keys() - found:
            summary.write(f'\n⚠️ **P0: Performance {kind} cache MISS**; seed this recipe on main.\n')
    if reports == 0 and os.environ['GITHUB_EVENT_NAME'] == 'pull_request':
        raise ValueError('P0: every PR requires a saved main baseline; run Performance on main first')


def pack():
    work = Path(os.environ['GITHUB_WORKSPACE'])
    temp = Path(os.environ['RUNNER_TEMP'])
    output = temp / 'perf-snapshots'
    output.mkdir(exist_ok=True)
    checkpoint = temp / 'perf-source-state.json'
    saved = temp / 'st-ci-cache/perf-source-state.json'
    saved.unlink(missing_ok=True)
    if checkpoint.exists():
        state = json.loads(checkpoint.read_text())
        if state['head'] == git(work, 'rev-parse', 'HEAD') and not git(work, 'status', '--porcelain'):
            shutil.copyfile(checkpoint, saved)
    # Registry source/config files contain no runner credentials; never archive all of CARGO_HOME.
    subprocess.run(['tar', '--format=pax', '-I', 'zstd -1 -T2', '-cf', str(output / 'build.tar.zst'),
                    '-C', str(work), 'target', '-C', str(temp),
                    'cargo-home/registry', 'cargo-home/git', 'perf-sccache', 'st-ci-cache'], check=True)
    subprocess.run(['tar', '--format=pax', '-I', 'zstd -1 -T2', '-cf', str(output / 'stores.tar.zst'),
                    '-C', str(temp), 'st-bench'], check=True)


def check_report():
    report = Path(os.environ['RUNNER_TEMP']) / 'perf/load.json'
    try:
        complete = valid_report(json.loads(report.read_text()))
    except (OSError, ValueError):
        complete = False
    if not complete:
        print('Performance snapshots skipped: no complete workload report', flush=True)
        return 1
    with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
        output.write('publish=true\n')
    return 0


def main():
    try:
        result = {'restore': restore, 'pack': pack, 'remember-sources': remember_sources,
                  'check-report': check_report}[sys.argv[1]]()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f'::error::P0: Performance cache/baseline operation failed: {error}', file=sys.stderr)
        return 1
    return result or 0


if __name__ == '__main__':
    sys.exit(main())
