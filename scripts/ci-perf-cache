#!/usr/bin/env python3
"""Main baselines and durable main/same-PR Performance snapshots."""
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor


def api(path):
    return json.loads(subprocess.check_output(['gh', 'api', path], text=True))


def trusted(run):
    return (run.get('head_branch') == 'main' and run.get('conclusion') == 'success'
            and run.get('event') in ('push', 'schedule', 'workflow_dispatch')
            and run.get('path') == '.github/workflows/perf.yml')


def trusted_snapshot(run):
    # A completed workload can miss a latency budget while its compiled outputs and
    # generated source stores remain valid. Failed reports never become baselines.
    return run.get('conclusion') in ('success', 'failure') and trusted(dict(run, conclusion='success'))


def valid_report(report):
    # Never substitute tiny fixture reports or measurements with a different workload.
    def number(value):
        return (type(value) is int or type(value) is float and math.isfinite(value)) and value >= 0
    return (isinstance(report, dict) and number(report.get('scale')) and report['scale'] == 1
            and number(report.get('seconds')) and report['seconds'] >= 120
            and type(report.get('claims')) is int and report['claims'] > 0
            and report.get('long_poll_seats') == 30 and number(report.get('daemon_cores'))
            and isinstance(report.get('paths'), dict) and bool(report['paths'])
            and isinstance(report.get('failed'), dict)
            and all(isinstance(path, dict) and all(number(path.get(key)) for key in
                    ('count', 'p50_ms', 'p99_ms', 'max_ms', 'budget_ms'))
                    for path in report['paths'].values()))


def own_pr(run, number, repository, branch, commits):
    return (run.get('event') == 'pull_request' and run.get('conclusion') in ('success', 'failure')
            and run.get('path') == '.github/workflows/perf.yml'
            and (run.get('head_repository') or {}).get('full_name') == repository
            and run.get('head_branch') == branch and run.get('head_sha') in commits
            and (not run.get('pull_requests') or
                 any(pr.get('number') == number for pr in run['pull_requests'])))


def download(repo, run, name, dest):
    subprocess.run(['gh', 'run', 'download', str(run['id']), '--repo', repo,
                    '--name', name, '--dir', str(dest)], check=True)


def git(work, *args):
    return subprocess.check_output(['git', '-C', str(work), *args], text=True,
                                   env=dict(os.environ, GIT_OPTIONAL_LOCKS='0')).rstrip('\n')


def source_paths(work):
    paths = set()
    for name in git(work, 'ls-files', '-z').split('\0'):
        if name:
            path = Path(name)
            paths.add(path)
            paths.update(path.parents)
    return {path for path in paths if (work / path).exists() or (work / path).is_symlink()}


def remember_sources():
    work = Path(os.environ['GITHUB_WORKSPACE'])
    checkpoint = Path(os.environ['RUNNER_TEMP']) / 'perf-source-state.json'
    checkpoint.unlink(missing_ok=True)
    if git(work, 'status', '--porcelain'):
        print('Performance source timestamps: dirty checkout; Cargo validates it normally', flush=True)
        return
    checkpoint.write_text(json.dumps(dict(head=git(work, 'rev-parse', 'HEAD'),
        mtimes={str(path): (work / path).lstat().st_mtime_ns for path in source_paths(work)})))


def restore_sources(checkpoint=None):
    work = Path(os.environ['GITHUB_WORKSPACE'])
    checkpoint = checkpoint or Path(os.environ['RUNNER_TEMP']) / 'st-ci-cache/perf-source-state.json'
    if not checkpoint.exists():
        print('Performance source timestamps: no saved checkpoint', flush=True)
        return
    state = json.loads(checkpoint.read_text())
    if not isinstance(state, dict):
        raise ValueError('invalid source timestamp checkpoint')
    if state.get('head') != git(work, 'rev-parse', 'HEAD') or git(work, 'status', '--porcelain'):
        print('Performance source timestamps: source changed; Cargo validates the new checkout', flush=True)
        return
    allowed = source_paths(work)
    mtimes = state.get('mtimes')
    if (not isinstance(mtimes, dict) or set(mtimes) != {str(path) for path in allowed}
            or any(type(stamp) is not int or stamp < 0 for stamp in mtimes.values())):
        raise ValueError('invalid source timestamp checkpoint')
    for name, stamp in mtimes.items():
        path = work / name
        os.utime(path, ns=(path.lstat().st_atime_ns, stamp), follow_symlinks=False)
    print('Performance source timestamps: restored for the exact clean source SHA', flush=True)


def unpack(archive, destination, names):
    # These are main's own archives, but refuse unexpected roots before extracting.
    listing = subprocess.check_output(['tar', '--zstd', '-tf', str(archive)], text=True)
    for name in listing.splitlines():
        path = Path(name)
        if path.is_absolute() or '..' in path.parts or path.parts[0] not in names:
            raise ValueError('unexpected snapshot path')
    subprocess.run(['tar', '--zstd', '-xf', str(archive), '-C', str(destination)], check=True)


def restore():
    # Measurement branch only: exact inputs from the retained ordinary API failure.
    # There is no moving main discovery or baseline replacement in this experiment.
    import hashlib
    import zipfile
    pins = [{'kind': 'build', 'id': 11367458730, 'name': 'perf-load-build-v1-e3f5b1e3e1711219891666e0d8c73c86c080416ee64870f4f002e1ca4e8890f0', 'run': 37362615036, 'head': '0295286eb051650674b769e5c023aa8acb80d990', 'sha256': 'aee5d4300634f47179dafd9d8028e0453c231f8e2261450b4f763b224c04d0cf'}, {'kind': 'stores', 'id': 11367946163, 'name': 'perf-load-stores-v1-75734d64c41d84a134e428e5fbedfd37448b8c886cf566241ec2bbf5edf2a899', 'run': 37362615036, 'head': '0295286eb051650674b769e5c023aa8acb80d990', 'sha256': 'e98c1a1f47f0792a295cd81b53851d175ba3881add15fc5cfb0ef94222909f03'}, {'kind': 'baseline', 'id': 11367588404, 'name': 'perf-load-logs', 'run': 37362615036, 'head': '0295286eb051650674b769e5c023aa8acb80d990', 'sha256': 'b5a67bc929b79a21655759b309cf40173d5dc300f6f6f5c844d277dd84307daa', 'report_sha256': '07ed1c73a03c7c228e84a0cd7f570b914a56d33121f4154e445d461f120719cd'}, {'kind': 'baseline', 'id': 11364908653, 'name': 'perf-load-logs', 'run': 37357208168, 'head': 'b441fcd503db9388294aa25c97837b231c4b887f', 'sha256': 'abf54abafc392df1f8163bdc8c0f99592172a14333ba78c3449555ae8c8c8ebc', 'report_sha256': '87783d45992f228f3a10201f0b2397347da053ed6758cd04c53b35cbed4c7e2e'}, {'kind': 'baseline', 'id': 11362992663, 'name': 'perf-load-logs', 'run': 37351155671, 'head': '920851128ea52516cf9ec767934c6c2cf3d06fbf', 'sha256': '4f35f483257656b55d430a17c8095f9b167aa8bb19d301619bc00a58da2598fe', 'report_sha256': 'fd718e4df6f3d079e630b2c57ed6c0686c70a129c50fdeb69a0fa0ecb25a18a4'}, {'kind': 'baseline', 'id': 11361304868, 'name': 'perf-load-logs', 'run': 37349336527, 'head': '385832cb6a2219d8b512b106a83eadd2b2042cea', 'sha256': '2fad5b0baede18c05855f8c82dc8ad257e98a7ebe7de9f4471d813dcaf3a985b', 'report_sha256': '371728759409d6588fb05554607df8a8fa61b945a756152a5113a27dbd29a736'}, {'kind': 'baseline', 'id': 11362436563, 'name': 'perf-load-logs', 'run': 37348801011, 'head': 'fb88771d0db7b659d25b6744114e222e86cb581f', 'sha256': 'ca43933cb95790791cc19596619bd3e184b7daa9ab0baacbd3fbece1ce5cf4ac', 'report_sha256': 'd9cce375e75fed3b1d878b7ec47ffc504ccf8ac06e4605dc02d4cc42f5e8b721'}]
    repo = os.environ['GITHUB_REPOSITORY']
    work = Path(os.environ['GITHUB_WORKSPACE'])
    temp = Path(os.environ['RUNNER_TEMP'])
    baseline = temp / 'perf-baseline'
    baseline.mkdir(exist_ok=True)
    for report in baseline.glob('load-*.json'):
        report.unlink()
    receipts = []
    receipt_output = temp / 'perf'
    receipt_output.mkdir(exist_ok=True)
    def sha(path):
        digest = hashlib.sha256()
        with path.open('rb') as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b''):
                digest.update(chunk)
        return digest.hexdigest()
    for pin in pins:
        run = api(f"repos/{repo}/actions/runs/{pin['run']}")
        if not trusted(run) or run['head_sha'] != pin['head']:
            raise ValueError('pinned input is not the qualified successful main source')
        artifact = api(f"repos/{repo}/actions/artifacts/{pin['id']}")
        if (artifact['expired'] or artifact['name'] != pin['name']
                or artifact['workflow_run']['id'] != pin['run']
                or artifact['digest'] != 'sha256:' + pin['sha256']):
            raise ValueError('pinned artifact qualification changed')
        with tempfile.TemporaryDirectory(dir=temp) as directory:
            directory = Path(directory)
            archive = directory / 'artifact.zip'
            with archive.open('wb') as output:
                subprocess.run(['gh', 'api', f"repos/{repo}/actions/artifacts/{pin['id']}/zip"], stdout=output, check=True)
            if sha(archive) != pin['sha256']:
                raise ValueError('downloaded artifact hash mismatch')
            extracted = directory / 'zip'
            extracted.mkdir()
            with zipfile.ZipFile(archive) as zipped:
                for name in zipped.namelist():
                    path = Path(name)
                    if path.is_absolute() or '..' in path.parts:
                        raise ValueError('unexpected ZIP path')
                zipped.extractall(extracted)
            if pin['kind'] == 'baseline':
                files = list(extracted.rglob('load.json'))
                if len(files) != 1 or sha(files[0]) != pin['report_sha256'] or not valid_report(json.loads(files[0].read_text())):
                    raise ValueError('pinned baseline bytes/workload mismatch')
                shutil.copyfile(files[0], baseline / f"load-{pin['run']}.json")
                receipts.append(dict(pin, verified_zip_sha256=sha(archive), verified_report_sha256=sha(files[0])))
            else:
                kind = pin['kind']
                archives = list(extracted.rglob(kind + '.tar.zst'))
                if len(archives) != 1:
                    raise ValueError('snapshot archive missing')
                roots = ('target', 'cargo-home', 'perf-sccache', 'st-ci-cache') if kind == 'build' else ('st-bench',)
                uncompressed = directory / 'tar'
                uncompressed.mkdir()
                unpack(archives[0], uncompressed, roots)
                for root in roots:
                    if not (uncompressed / root).is_dir():
                        raise ValueError('incomplete snapshot root')
                    target = (work if root == 'target' else temp) / root
                    shutil.rmtree(target, ignore_errors=True)
                    shutil.move(uncompressed / root, target)
                receipts.append(dict(pin, verified_zip_sha256=sha(archive), inner_archive_sha256=sha(archives[0])))
        (receipt_output / 'api-input-receipt.json').write_text(json.dumps(receipts, indent=2) + '\n')
        print(f"Pinned {pin['kind']} input verified: run {pin['run']} artifact {pin['id']}", flush=True)
    (temp / 'api-input-receipt.json').write_text(json.dumps(receipts, indent=2) + '\n')
    restore_sources()
    print('Pinned main/API cohort: exact failed-run store artifact and five reconstructed original baselines', flush=True)

def pack():
    work = Path(os.environ['GITHUB_WORKSPACE'])
    temp = Path(os.environ['RUNNER_TEMP'])
    output = temp / 'perf-snapshots'
    output.mkdir(exist_ok=True)
    checkpoint = temp / 'perf-source-state.json'
    saved = temp / 'st-ci-cache/perf-source-state.json'
    saved.unlink(missing_ok=True)
    if checkpoint.exists():
        state = json.loads(checkpoint.read_text())
        if state['head'] == git(work, 'rev-parse', 'HEAD') and not git(work, 'status', '--porcelain'):
            shutil.copyfile(checkpoint, saved)
    # Registry source/config files contain no runner credentials; never archive all of CARGO_HOME.
    subprocess.run(['tar', '--format=pax', '-I', 'zstd -1 -T2', '-cf', str(output / 'build.tar.zst'),
                    '-C', str(work), 'target', '-C', str(temp),
                    'cargo-home/registry', 'cargo-home/git', 'perf-sccache', 'st-ci-cache'], check=True)
    subprocess.run(['tar', '--format=pax', '-I', 'zstd -1 -T2', '-cf', str(output / 'stores.tar.zst'),
                    '-C', str(temp), 'st-bench'], check=True)


def check_report():
    report = Path(os.environ['RUNNER_TEMP']) / 'perf/load.json'
    try:
        complete = valid_report(json.loads(report.read_text()))
    except (OSError, ValueError):
        complete = False
    if not complete:
        print('Performance snapshots skipped: no complete workload report', flush=True)
        return 1
    with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
        output.write('publish=true\n')
    return 0


def main():
    try:
        result = {'restore': restore, 'pack': pack, 'remember-sources': remember_sources,
                  'check-report': check_report}[sys.argv[1]]()
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f'::error::P0: Performance cache/baseline operation failed: {error}', file=sys.stderr)
        return 1
    return result or 0


if __name__ == '__main__':
    sys.exit(main())
