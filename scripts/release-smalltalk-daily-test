#!/usr/bin/env python3
"""Exercise the daily release's failure path: a failing gh names its cause, safely and bounded."""
import hashlib
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile

repo = Path(__file__).resolve().parent.parent
TARGETS = ('x86_64-unknown-linux-gnu', 'aarch64-apple-darwin')
TOKEN = 'ghs_' + 'A1b2C3d4' * 5

# A stand-in gh: just enough of the release flow to reach `release create`, which fails on request.
FAKE_GH = r'''#!/usr/bin/env python3
import json, os, pathlib, shutil, sys
args = sys.argv[1:]
if args[:2] == ['run', 'list']:
    print(json.dumps([{'databaseId': 7, 'headSha': os.environ['FAKE_SHA']}]))
elif args[0] == 'api' and args[-1] == 'repos/example/project/releases?per_page=100':
    print(json.dumps([[{'tag_name': 'v0.3.17', 'draft': False, 'prerelease': False,
                       'published_at': '2026-10-07T00:00:00Z', 'id': 17}]]))
elif args[:2] == ['run', 'download']:
    destination = pathlib.Path(args[args.index('--dir') + 1])
    for item in pathlib.Path(os.environ['FAKE_DIST']).iterdir():
        shutil.copy(item, destination / item.name)
elif args[:2] == ['release', 'create']:
    lines = os.environ['FAKE_FAILURE'].split('|')
    print('\n'.join(lines), file=sys.stderr)
    sys.exit(1)
else:
    print('unexpected gh call: %r' % args, file=sys.stderr); sys.exit(9)
'''

STUB_NOTES = '''class ImpactError(ValueError):
    pass


def render(repo, previous, source, tag, repository='x/y', since=None):
    return 'notes\\n', {'stub': True}
'''


def sh(*cmd, cwd):
    return subprocess.run(cmd, cwd=cwd, check=True, text=True, capture_output=True).stdout.strip()


def build_dist(dist, source):
    dist.mkdir()
    sums = []
    for target in TARGETS:
        package = f'smalltalk-{target}'
        with tarfile.open(dist / f'{package}.tar.gz', 'w:gz') as archive:
            def add(name, data=b'', mode=0o755, link=None):
                info = tarfile.TarInfo(f'{package}/{name}')
                info.mode = mode
                if link:
                    info.type, info.linkname = tarfile.SYMTYPE, link
                    archive.addfile(info)
                else:
                    info.size = len(data)
                    archive.addfile(info, io.BytesIO(data))
            add('BUILD.json', json.dumps({'source': source, 'target': target, 'pty_revision': 'pty', 'tag': ''}).encode(), 0o644)
            add('bin/st3', b'st3'); add('bin/pty', b'pty'); add('bin/st', link='st3')
            add('install.sh'); add('install-macos.py'); add('macos-installation.md', b'', 0o644)
        digest = hashlib.sha256((dist / f'{package}.tar.gz').read_bytes()).hexdigest()
        line = f'{digest}  {package}.tar.gz\n'
        (dist / f'{package}.tar.gz.sha256').write_text(line)
        sums.append(line)
    (dist / 'SHA256SUMS').write_text(''.join(sums))


with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    checkout = root / 'checkout'
    (checkout / 'scripts').mkdir(parents=True)
    shutil.copy(repo / 'scripts/release-smalltalk-daily', checkout / 'scripts/release-smalltalk-daily')
    shutil.copy(repo / 'scripts/release-smalltalk-manifest.py', checkout / 'scripts/release-smalltalk-manifest.py')
    shutil.copy(repo / 'scripts/compat-baseline-release', checkout / 'scripts/compat-baseline-release')
    (checkout / '.github').mkdir()
    pin = {'commit': 'a' * 40, 'tag': 'v0.3.17', 'why': 'Previous stable release fixture',
           'exception_reason': None, 'bundles': {target: {
               'url': f'https://github.com/example/project/releases/download/v0.3.17/smalltalk-{target}.tar.gz',
               'sha256': 'b' * 64} for target in TARGETS}}
    for kind in ('fleet', 'messaging'):
        (checkout / f'.github/{kind}-compat-baseline.json').write_text(json.dumps(pin))
    (checkout / 'scripts/release_notes.py').write_text(STUB_NOTES)
    sh('git', 'init', '-q', '-b', 'main', cwd=checkout)
    sh('git', 'config', 'user.name', 'Fixture', cwd=checkout)
    sh('git', 'config', 'user.email', 'fixture@example.invalid', cwd=checkout)
    shas = []
    for index in range(2):
        (checkout / 'file').write_text(str(index))
        sh('git', 'add', '.', cwd=checkout)
        sh('git', 'commit', '-q', '-m', f'change {index}', cwd=checkout)
        shas.append(sh('git', 'rev-parse', 'HEAD', cwd=checkout))
        if index == 0:
            sh('git', 'tag', 'v0.3.17', cwd=checkout)
    tools = root / 'tools'
    tools.mkdir()
    (tools / 'gh').write_text(FAKE_GH)
    (tools / 'gh').chmod(0o755)
    build_dist(root / 'dist', shas[1])

    def daily(failure, token=TOKEN):
        env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}', GH_TOKEN=token, GH_REPO='example/project',
                   FAKE_SHA=shas[1], FAKE_DIST=str(root / 'dist'), FAKE_FAILURE=failure)
        return subprocess.run(['python3', 'scripts/release-smalltalk-daily'], cwd=checkout, env=env,
                              text=True, capture_output=True, timeout=60)

    # The Oct 10-11 shape: every earlier step passes, then gh release create fails with a cause.
    cause = 'HTTP 403: Resource not accessible by integration (https://api.example.invalid/releases)'
    done = daily(f'{cause}|Authorization: Bearer {TOKEN}|token {TOKEN} was used')
    output = done.stdout + done.stderr
    assert done.returncode == 1, done
    assert 'releasing v0.3.18' in output and 'Validated both release targets' in output, output
    assert 'gh release create exited 1' in output and 'Resource not accessible by integration' in output, output
    assert 'Traceback' not in output and 'CalledProcessError' not in output, output
    assert TOKEN not in output and 'Bearer ' + TOKEN not in output, 'the credential must not be printed'
    assert '--notes-file' not in output and str(root) not in output.split('gh release create exited')[1], output

    # A very long diagnostic is bounded and keeps its end, where the cause is printed.
    done = daily('x' * 9000 + '|final cause: quota exceeded')
    output = done.stdout + done.stderr
    failure_line = next(line for line in output.splitlines() if 'gh release create exited' in line)
    assert done.returncode == 1 and 'final cause: quota exceeded' in output, output
    assert len(output.split('gh release create exited 1:')[1]) < 2300, len(output)

    # A secret in a token-shaped value other than the standard prefixes is removed by value.
    odd = 'opaque-credential-value-123'
    done = daily(f'denied for {odd}', token=odd)
    assert odd not in done.stdout + done.stderr and 'denied for' in done.stdout + done.stderr, done

# run() still returns a successful command's output unchanged.
from importlib.machinery import SourceFileLoader
module = SourceFileLoader('daily', str(repo / 'scripts/release-smalltalk-daily')).load_module()
assert module.run('printf', 'ok\n') == 'ok'
try:
    module.run('sh', '-c', 'echo reason >&2; exit 3')
except module.CommandFailed as error:
    assert str(error) == 'sh exited 3: reason', str(error)
else:
    raise AssertionError('a failing command must raise')
print('Daily release failure path names a bounded, credential-safe cause')
