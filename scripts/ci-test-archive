#!/usr/bin/env python3
"""Build or verify/extract one exact-source workspace test archive."""
import argparse
import hashlib
import http.client
import json
import os
from pathlib import Path
import platform
import re
import signal
import urllib.error
import urllib.parse
import urllib.request
import shutil
import stat
import tempfile
import time
import zipfile
import subprocess
import sys

FILES = ('workspace.tar.zst', 'sekrets-st3', 'production-build.json')


def output(*command):
    return subprocess.check_output(command, text=True).strip()


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def identity():
    return {'source': output('git', 'rev-parse', 'HEAD'), 'tree': output('git', 'rev-parse', 'HEAD^{tree}'),
            'run': os.environ['GITHUB_RUN_ID'], 'attempt': os.environ['GITHUB_RUN_ATTEMPT'],
            'platform': platform.machine(), 'nextest': output('cargo', 'nextest', '--version'),
            'rustc': output('rustc', '-vV'),
            'recipe': digest(Path('scripts/ci-nextest')),
            'paths': digest(Path('scripts/ci-test-paths.rs')),
            'targets': digest(Path('scripts/ci-nextest-targets'))}


def validate_byte_sizes(manifest, actual):
    # Version-2 producers without this optional inventory remain valid. Sizes
    # supplement the mandatory digests; they never replace source/hash checks.
    if 'byte_sizes' not in manifest:
        return
    sizes = manifest['byte_sizes']
    if (not isinstance(sizes, dict) or set(sizes) != set(FILES)
            or any(type(sizes[n]) is not int or sizes[n] < 0 or sizes[n] != actual[n] for n in FILES)):
        raise ValueError('producer byte-size inventory mismatch')


def report_sizes(sizes, *, zip_entries=None):
    """Use existing stat/ZIP metadata only: no extra payload read or archive walk."""
    try:
        rows = [{'name': name, 'payload_bytes': sizes[name]} for name in FILES]
        if zip_entries is not None:
            # These are the complete ZIP's authenticated metadata. CRC and file
            # hashes were checked before reporting, including the manifest.
            rows = [{'name': entry.filename, 'payload_bytes': entry.file_size,
                     'stored_bytes': entry.compress_size} for entry in zip_entries]
        print('Producer artifact component bytes: ' + json.dumps(rows, sort_keys=True), flush=True)
        path = os.environ.get('GITHUB_STEP_SUMMARY')
        if path:
            with open(path, 'a') as stream:
                stream.write('### Exact producer artifact component sizes\n\n')
                stream.write('| Component | Payload bytes | ZIP stored bytes |\n| --- | ---: | ---: |\n')
                for row in rows:
                    stream.write('| ' + row['name'] + ' | ' + str(row['payload_bytes']) + ' | '
                                 + str(row.get('stored_bytes', 'not yet uploaded')) + ' |\n')
                stream.write('\nPayload sizes exclude ZIP framing. workspace.tar.zst is already compressed; '
                             'this does not inventory its members or claim a shrink.\n')
    except Exception:
        # Optional reporting cannot change producer success or verified inputs.
        try:
            print('::warning::optional producer size report unavailable', file=sys.stderr)
        except Exception:
            pass


def verify(manifest, current, directory, producer_attempt):
    expected = {**current, "attempt": producer_attempt}
    if not producer_attempt.isdecimal() or not 1 <= int(producer_attempt) <= int(current["attempt"]):
        raise ValueError("invalid successful producer attempt")
    if manifest.get('standalone_model') is not True:
        raise ValueError('standalone model tests and dependency boundary must pass in the producer')
    if manifest.get('version') != 2 or manifest.get('identity') != expected:
        raise ValueError('test archive source/run/attempt/platform/tool/recipe identity mismatch')
    if set(manifest.get('files', {})) != set(FILES):
        raise ValueError('the workspace archive and production gateway files are required')
    if not Path(manifest['workspace']).is_absolute():
        raise ValueError('build workspace must be absolute')
    validate_byte_sizes(manifest, {name: (directory / name).stat().st_size for name in FILES})
    for name in FILES:
        if digest(directory / name) != manifest['files'][name]:
            raise ValueError(f'test archive digest mismatch: {name}')


def artifact_metadata(document, artifact_id, environment):
    """The successful producer artifact ID, run and attempt remain authoritative."""
    attempt = environment['CI_TEST_ARCHIVE_PRODUCER_ATTEMPT']
    current_attempt = environment['GITHUB_RUN_ATTEMPT']
    if not attempt.isdecimal() or not 1 <= int(attempt) <= int(current_attempt):
        raise ValueError('invalid successful producer attempt')
    # PR artifact metadata names the author head, while GITHUB_SHA is the tested merge.
    # The producer-output manifest hash and consume() bind that effective source.
    run = document.get('workflow_run', {})
    if (document.get('id') != int(artifact_id) or document.get('expired') is not False
            or document.get('name') != 'linux-test-archives-' + attempt
            or str(run.get('id')) != environment['GITHUB_RUN_ID']):
        raise ValueError('download artifact source/run/producer identity mismatch')
    size = document.get('size_in_bytes')
    expected = document.get('digest', '')
    if type(size) is not int or size <= 0 or not re.fullmatch(r'sha256:[a-f0-9]{64}', expected):
        raise ValueError('artifact size and SHA256 are required')
    return size, expected.removeprefix('sha256:')


def extract_verified_zip(archive, destination, expected_size, expected_hash, manifest_hash):
    # Wait for the complete ZIP and its authenticated digest before extracting any input.
    if archive.stat().st_size != expected_size or digest(archive) != expected_hash:
        raise ValueError('downloaded artifact ZIP size/digest mismatch')
    with zipfile.ZipFile(archive) as zipped:
        entries = zipped.infolist()
        expected_names = set(FILES) | {'manifest.json'}
        if len(entries) != len(expected_names) or {e.filename for e in entries} != expected_names:
            raise ValueError('downloaded artifact ZIP must contain exactly the producer files')
        for entry in entries:
            mode = entry.external_attr >> 16
            if entry.is_dir() or stat.S_IFMT(mode) not in (0, stat.S_IFREG) or entry.flag_bits & 1:
                raise ValueError('invalid archive member type')
        if zipped.getinfo('manifest.json').file_size > 65536:
            raise ValueError('producer manifest is too large')
        manifest_bytes = zipped.read('manifest.json')  # Also checks this member's ZIP CRC.
        if hashlib.sha256(manifest_bytes).hexdigest() != manifest_hash:
            raise ValueError('downloaded manifest differs from successful producer output')
        manifest = json.loads(manifest_bytes)
        if set(manifest.get('files', {})) != set(FILES):
            raise ValueError('the workspace archive and production gateway files are required')
        validate_byte_sizes(manifest, {name: zipped.getinfo(name).file_size for name in FILES})
        destination.mkdir(mode=0o700, exist_ok=False)
        for entry in entries:
            target = destination / entry.filename
            with zipped.open(entry) as source, target.open('xb') as stream:
                shutil.copyfileobj(source, stream, length=1024 * 1024)
            # Copy waits for each member's EOF/CRC; the producer manifest binds its bytes.
            expected = manifest_hash if entry.filename == 'manifest.json' else manifest['files'][entry.filename]
            if digest(target) != expected:
                raise ValueError('downloaded producer file digest mismatch: ' + entry.filename)
        report_sizes({name: zipped.getinfo(name).file_size for name in FILES}, zip_entries=entries)


class TransferError(Exception):
    """Safe diagnostic: never include a signed URL, token or HTTP error body."""
    def __init__(self, message, discard=False):
        super().__init__(message)
        self.discard = discard


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, newurl):
        return None


def signed_artifact_url(endpoint, timeout):
    # Authenticate only to GitHub. Resolve its redirect separately so Authorization
    # can never follow the signed storage URL, including a redirect to another host.
    api = os.environ.get('GITHUB_API_URL', 'https://api.github.com').rstrip('/')
    parsed = urllib.parse.urlsplit(api)
    if parsed.scheme != 'https' or not parsed.hostname or parsed.username or parsed.password:
        raise TransferError('invalid GitHub API origin', discard=True)
    token = os.environ.get('GH_TOKEN')
    if not token:
        raise TransferError('artifact job token missing', discard=True)
    request = urllib.request.Request(api + '/' + endpoint + '/zip', headers={
        'Authorization': 'Bearer ' + token, 'Accept': 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28'})
    try:
        response = urllib.request.build_opener(NoRedirect()).open(request, timeout=timeout)
    except urllib.error.HTTPError as response:
        if response.code != 302:
            response.close()
            raise TransferError('artifact redirect HTTP status %s' % response.code) from None
        location = response.headers.get('Location', '')
        response.close()
    else:
        response.close()
        raise TransferError('artifact endpoint did not return a redirect')
    url = urllib.parse.urlsplit(location)
    if url.scheme != 'https' or not url.hostname or url.username or url.password or url.fragment:
        raise TransferError('invalid artifact storage redirect', discard=True)
    return location


def transfer_zip(endpoint, archive, size, metrics, timeout):
    """One bounded attempt. Append only an exact byte-range response for this ID.

    The caller owns the private partial and verifies the entire authenticated ZIP
    before extraction. SIGALRM bounds request setup and every blocking read/write,
    rather than granting a new timeout to each received chunk.
    """
    started = time.monotonic()
    def expired(signum, frame):
        raise TransferError('transfer deadline exceeded')
    previous = signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, timeout)
    try:
        offset = archive.stat().st_size if archive.exists() else 0
        metrics.update(offset_requested=offset, bytes_received=0, response_status=None)
        if offset > size:
            raise TransferError('partial ZIP exceeds authenticated size', discard=True)
        if offset == size:
            return  # interrupted after the final byte: verify without another GET
        location = signed_artifact_url(endpoint, timeout)
        headers = {'Range': 'bytes=%d-' % offset, 'Accept-Encoding': 'identity'}
        # No credential is sent to storage, and a second redirect is refused.
        request = urllib.request.Request(location, headers=headers)
        try:
            response = urllib.request.build_opener(NoRedirect()).open(request, timeout=timeout)
        except urllib.error.HTTPError as error:
            status = error.code
            error.close()
            raise TransferError('artifact storage HTTP status %s' % status,
                                discard=(status == 416)) from None
        with response:
            status = response.status
            metrics['response_status'] = status
            content_range = response.headers.get('Content-Range')
            if status == 206:
                match = re.fullmatch(r'bytes (\d+)-(\d+)/(\d+)', content_range or '')
                if not match or tuple(map(int, match.groups())) != (offset, size - 1, size):
                    raise TransferError('artifact Content-Range mismatch', discard=True)
                mode, expected = 'ab', size - offset
            elif status == 200 and content_range is None:
                mode, expected = 'wb', size  # Range ignored: replace, never append
            else:
                raise TransferError('unexpected artifact range response', discard=True)
            if response.headers.get('Content-Encoding', 'identity') != 'identity':
                raise TransferError('encoded artifact response', discard=True)
            length = response.headers.get('Content-Length')
            if length is not None and (not length.isdecimal() or int(length) != expected):
                raise TransferError('artifact Content-Length mismatch', discard=True)
            next_progress = time.monotonic() + 30
            with archive.open(mode, buffering=0) as stream:
                while True:
                    chunk = response.read1(1024 * 1024)
                    if not chunk:
                        break
                    metrics['bytes_received'] += len(chunk)
                    if metrics['bytes_received'] > expected:
                        raise TransferError('artifact body exceeds authenticated size', discard=True)
                    if stream.write(chunk) != len(chunk):
                        raise TransferError('incomplete local artifact write', discard=True)
                    if time.monotonic() >= next_progress:
                        print('Artifact transfer progress: received=%d expected=%d retained=%d elapsed=%.1fs' %
                              (metrics['bytes_received'], expected, stream.tell(), time.monotonic() - started), flush=True)
                        next_progress = time.monotonic() + 30
            if metrics['bytes_received'] != expected:
                raise TransferError('incomplete artifact body')
    except (urllib.error.URLError, OSError, http.client.HTTPException) as error:
        # Error strings may contain the storage URL or credentials. Types only.
        raise TransferError('artifact transport ' + type(error).__name__) from None
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def download(directory):
    environment = os.environ
    artifact_id = environment['CI_TEST_ARCHIVE_ARTIFACT_ID']
    repository = environment['GITHUB_REPOSITORY']
    manifest_hash = environment['CI_TEST_ARCHIVE_MANIFEST_SHA256']
    if not artifact_id.isdecimal() or int(artifact_id) <= 0:
        raise ValueError('one successful producer artifact ID is required')
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repository):
        raise ValueError('invalid repository')
    if not re.fullmatch(r'[a-f0-9]{64}', manifest_hash):
        raise ValueError('successful producer manifest hash is required')
    if directory.exists() or directory.is_symlink():
        raise ValueError('archive download destination must be fresh')
    endpoint = f'repos/{repository}/actions/artifacts/{artifact_id}'
    metadata = subprocess.run(['gh', 'api', endpoint], capture_output=True, timeout=60)
    if metadata.returncode < 0 or metadata.returncode >= 128:
        raise SystemExit(metadata.returncode if metadata.returncode >= 0 else 128 - metadata.returncode)
    if metadata.returncode:
        raise RuntimeError(f'artifact metadata request failed (exit {metadata.returncode})')
    size, expected_hash = artifact_metadata(json.loads(metadata.stdout), artifact_id, environment)
    print(f'Artifact {artifact_id}: authenticated ZIP size={size} bytes; at most two 600s transfer attempts.', flush=True)
    deadline = time.monotonic() + 1200
    with tempfile.TemporaryDirectory(prefix='ci-test-transfer-', dir=directory.parent) as scratch:
        scratch = Path(scratch)
        archive, verified = scratch / 'artifact.zip', scratch / 'verified'
        for attempt in (1, 2):
            started = time.monotonic()
            metrics = dict(bytes_received=0, offset_requested=archive.stat().st_size if archive.exists() else 0)
            try:
                remaining = min(600, deadline - started)
                if remaining <= 0:
                    raise TransferError('overall transfer budget exhausted')
                transfer_zip(endpoint, archive, size, metrics, remaining)
                extract_verified_zip(archive, verified, size, expected_hash, manifest_hash)
                if directory.exists() or directory.is_symlink():
                    raise ValueError('archive destination appeared during transfer')
                verified.rename(directory)
                print(f'Artifact {artifact_id}: complete ZIP {size} bytes SHA256 {expected_hash}; '
                      f'all producer files verified, transfer attempt {attempt}.', flush=True)
                return
            except (TransferError, OSError, ValueError, zipfile.BadZipFile) as error:
                discard = not isinstance(error, TransferError) or error.discard
                if discard:
                    archive.unlink(missing_ok=True)
                shutil.rmtree(verified, ignore_errors=True)
                # Only our own fixed messages are safe to print. No URL/error body.
                detail = str(error) if isinstance(error, TransferError) else type(error).__name__
                print(f'::warning::Artifact {artifact_id} transfer attempt {attempt} failed ({detail}); '
                      f'partial {"discarded" if discard else "retained privately"}; no tests started.', flush=True)
                if attempt == 2:
                    raise RuntimeError('exact producer artifact transfer failed after two bounded attempts') from None
            finally:
                retained = archive.stat().st_size if archive.exists() else 0
                print(f'Artifact {artifact_id} attempt {attempt}: offset={metrics["offset_requested"]} '
                      f'received={metrics["bytes_received"]} retained={retained} expected={size} '
                      f'elapsed={time.monotonic() - started:.1f}s status={metrics.get("response_status")}.', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('build', 'download', 'consume'))
    args = parser.parse_args()
    directory = Path(os.environ['RUNNER_TEMP']) / 'ci-test-archives'
    if args.action == 'download':
        download(directory)
        return
    current = identity()
    if current['source'] != os.environ['GITHUB_SHA']:
        raise ValueError('checkout must match the workflow tested SHA')
    if args.action == 'build':
        directory.mkdir(parents=True, exist_ok=True)
        targets = output('python3', 'scripts/ci-nextest-targets')
        subprocess.run(['cargo', 'nextest', 'archive', '--workspace', '--locked',
                        '--profile', 'ci', '-E', targets,
                        '--archive-file', str(directory / FILES[0])], check=True)
        # Keep the original no-default-features unit/integration/doc tests and dependency gate,
        # using the producer's compiler cache instead of rebuilding in the runtime consumer.
        subprocess.run(['bash', 'scripts/ci-linux', 'conversation-model'], check=True)
        # The real-user gateway must retain the standalone production feature set.
        with (directory / 'production-build.json').open('w') as stream:
            subprocess.run(['cargo', 'build', '--locked', '-p', 'st3', '--bin', 'st3',
                            '--message-format=json'], check=True, stdout=stream)
        artifacts = [json.loads(line) for line in (directory / 'production-build.json').read_text().splitlines()]
        binaries = [item for item in artifacts if item.get('reason') == 'compiler-artifact'
                    and item['target']['name'] == 'st3' and item.get('executable')]
        if len(binaries) != 1 or 'test-support' in binaries[0]['features'] or binaries[0]['profile']['test']:
            raise ValueError('standalone production gateway feature/profile identity required')
        import shutil
        shutil.copy2(binaries[0]['executable'], directory / 'sekrets-st3')
        manifest = {'version': 2, 'standalone_model': True, 'identity': current, 'workspace': str(Path.cwd().resolve()),
                    'files': {name: digest(directory / name) for name in FILES},
                    'byte_sizes': {name: (directory / name).stat().st_size for name in FILES}}
        (directory / 'manifest.json').write_text(json.dumps(manifest, sort_keys=True, indent=2) + '\n')
        report_sizes(manifest['byte_sizes'])
        with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
            stream.write('producer-attempt=' + current['attempt'] + '\n')
            stream.write('manifest-sha256=' + digest(directory / 'manifest.json') + '\n')
    else:
        manifest_path = directory / 'manifest.json'
        if digest(manifest_path) != os.environ['CI_TEST_ARCHIVE_MANIFEST_SHA256']:
            raise ValueError('test archive manifest differs from the successful producer output')
        manifest = json.loads(manifest_path.read_text())
        verify(manifest, current, directory, os.environ['CI_TEST_ARCHIVE_PRODUCER_ATTEMPT'])
        extracted = Path(os.environ['RUNNER_TEMP']) / 'ci-test-extracted'
        destination = extracted / 'workspace'
        destination.mkdir(parents=True, exist_ok=True)
        # Extract/list metadata once. Subsequent inventories and runs use these metadata files,
        # without another extraction or invoking a build.
        subprocess.run(['cargo', 'nextest', 'list', '--archive-file', str(directory / FILES[0]),
                        '--extract-to', str(destination), '--extract-overwrite', '--workspace-remap',
                        str(Path.cwd()), '--list-type', 'binaries-only', '--message-format', 'json'], check=True)
        hooks = destination / 'target/debug/ci-hooks-install'
        if not hooks.is_file() or not os.access(hooks, os.X_OK):
            raise ValueError('the matching rendered-hook executable must be archived')
        scratch = Path(os.environ['RUNNER_TEMP']) / 'ci-test-scratch'
        scratch.mkdir(exist_ok=True)
        production = directory / 'sekrets-st3'
        # Actions artifact transfer does not retain executable permissions; bytes were just
        # hash-verified against the producer manifest, so restore the intended binary mode.
        production.chmod(0o755)
        with open(os.environ['GITHUB_ENV'], 'a') as stream:
            for key, value in {'CI_TEST_EXTRACTED': str(extracted),
                               'CI_TEST_BUILD_WORKSPACE': manifest['workspace'],
                               'CI_TEST_WORKSPACE': str(Path.cwd()),
                               'CI_TEST_HOOKS_BINARY': str(hooks),
                               'CI_TEST_TARGET_TMPDIR': str(scratch),
                               'CI_SEKRETS_BINARY': str(production)}.items():
                if '\n' in value or '\r' in value:
                    raise ValueError('invalid workflow environment path')
                stream.write(f'{key}={value}\n')
        print('Verified exact-source workspace test archive:', current, flush=True)


if __name__ == '__main__':
    main()
