#!/usr/bin/env python3
"""Build one pair of nextest archives, or verify/extract that run's exact-source pair."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import stat
import tempfile
import time
import zipfile
import subprocess

FILES = ('workspace.tar.zst', 'st2.tar.zst', 'sekrets-st3', 'production-build.json')


def output(*command):
    return subprocess.check_output(command, text=True).strip()


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def identity():
    return {'source': output('git', 'rev-parse', 'HEAD'), 'tree': output('git', 'rev-parse', 'HEAD^{tree}'),
            'run': os.environ['GITHUB_RUN_ID'], 'attempt': os.environ['GITHUB_RUN_ATTEMPT'],
            'platform': platform.machine(), 'nextest': output('cargo', 'nextest', '--version'),
            'rustc': output('rustc', '-vV'),
            'recipe': digest(Path('scripts/ci-nextest')),
            'paths': digest(Path('scripts/ci-test-paths.rs'))}


def verify(manifest, current, directory, producer_attempt):
    expected = {**current, "attempt": producer_attempt}
    if not producer_attempt.isdecimal() or not 1 <= int(producer_attempt) <= int(current["attempt"]):
        raise ValueError("invalid successful producer attempt")
    if manifest.get('standalone_model') is not True:
        raise ValueError('standalone model tests and dependency boundary must pass in the producer')
    if manifest.get('version') != 1 or manifest.get('identity') != expected:
        raise ValueError('test archive source/run/attempt/platform/tool/recipe identity mismatch')
    if set(manifest.get('files', {})) != set(FILES):
        raise ValueError('both selected archive groups are required')
    if not Path(manifest['workspace']).is_absolute():
        raise ValueError('build workspace must be absolute')
    for name in FILES:
        if digest(directory / name) != manifest['files'][name]:
            raise ValueError(f'test archive digest mismatch: {name}')


def artifact_metadata(document, artifact_id, environment):
    """The successful producer artifact ID, run and attempt remain authoritative."""
    attempt = environment['CI_TEST_ARCHIVE_PRODUCER_ATTEMPT']
    current_attempt = environment['GITHUB_RUN_ATTEMPT']
    if not attempt.isdecimal() or not 1 <= int(attempt) <= int(current_attempt):
        raise ValueError('invalid successful producer attempt')
    # PR artifact metadata names the author head, while GITHUB_SHA is the tested merge.
    # The producer-output manifest hash and consume() bind that effective source.
    run = document.get('workflow_run', {})
    if (document.get('id') != int(artifact_id) or document.get('expired') is not False
            or document.get('name') != 'linux-test-archives-' + attempt
            or str(run.get('id')) != environment['GITHUB_RUN_ID']):
        raise ValueError('download artifact source/run/producer identity mismatch')
    size = document.get('size_in_bytes')
    expected = document.get('digest', '')
    if type(size) is not int or size <= 0 or not re.fullmatch(r'sha256:[a-f0-9]{64}', expected):
        raise ValueError('artifact size and SHA256 are required')
    return size, expected.removeprefix('sha256:')


def extract_verified_zip(archive, destination, expected_size, expected_hash, manifest_hash):
    # Wait for the complete ZIP and its authenticated digest before extracting any input.
    if archive.stat().st_size != expected_size or digest(archive) != expected_hash:
        raise ValueError('downloaded artifact ZIP size/digest mismatch')
    with zipfile.ZipFile(archive) as zipped:
        entries = zipped.infolist()
        expected_names = set(FILES) | {'manifest.json'}
        if len(entries) != len(expected_names) or {e.filename for e in entries} != expected_names:
            raise ValueError('downloaded artifact ZIP must contain exactly the five producer files')
        for entry in entries:
            mode = entry.external_attr >> 16
            if entry.is_dir() or stat.S_IFMT(mode) not in (0, stat.S_IFREG) or entry.flag_bits & 1:
                raise ValueError('invalid archive member type')
        if zipped.getinfo('manifest.json').file_size > 65536:
            raise ValueError('producer manifest is too large')
        manifest_bytes = zipped.read('manifest.json')  # Also checks this member's ZIP CRC.
        if hashlib.sha256(manifest_bytes).hexdigest() != manifest_hash:
            raise ValueError('downloaded manifest differs from successful producer output')
        manifest = json.loads(manifest_bytes)
        if set(manifest.get('files', {})) != set(FILES):
            raise ValueError('both selected archive groups are required')
        destination.mkdir(mode=0o700, exist_ok=False)
        for entry in entries:
            target = destination / entry.filename
            with zipped.open(entry) as source, target.open('xb') as stream:
                shutil.copyfileobj(source, stream, length=1024 * 1024)
            # Copy waits for each member's EOF/CRC; the producer manifest binds its bytes.
            expected = manifest_hash if entry.filename == 'manifest.json' else manifest['files'][entry.filename]
            if digest(target) != expected:
                raise ValueError('downloaded producer file digest mismatch: ' + entry.filename)


def download(directory):
    environment = os.environ
    artifact_id = environment['CI_TEST_ARCHIVE_ARTIFACT_ID']
    repository = environment['GITHUB_REPOSITORY']
    manifest_hash = environment['CI_TEST_ARCHIVE_MANIFEST_SHA256']
    if not artifact_id.isdecimal() or int(artifact_id) <= 0:
        raise ValueError('one successful producer artifact ID is required')
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repository):
        raise ValueError('invalid repository')
    if not re.fullmatch(r'[a-f0-9]{64}', manifest_hash):
        raise ValueError('successful producer manifest hash is required')
    if directory.exists() or directory.is_symlink():
        raise ValueError('archive download destination must be fresh')
    endpoint = f'repos/{repository}/actions/artifacts/{artifact_id}'
    # gh receives the read-only job token in GH_TOKEN, never in argv or diagnostics.
    metadata = subprocess.run(['gh', 'api', endpoint], capture_output=True, timeout=60)
    if metadata.returncode < 0 or metadata.returncode >= 128:
        raise SystemExit(metadata.returncode if metadata.returncode >= 0 else 128 - metadata.returncode)
    if metadata.returncode:
        raise RuntimeError(f'artifact metadata request failed (exit {metadata.returncode})')
    size, expected_hash = artifact_metadata(json.loads(metadata.stdout), artifact_id, environment)
    for attempt in (1, 2):
        started = time.monotonic()
        with tempfile.TemporaryDirectory(prefix='ci-test-transfer-', dir=directory.parent) as scratch:
            scratch = Path(scratch)
            archive = scratch / 'artifact.zip'
            try:
                with archive.open('xb') as stream:
                    result = subprocess.run(['gh', 'api', endpoint + '/zip'], stdout=stream,
                                            stderr=subprocess.DEVNULL, timeout=600)
                if result.returncode < 0 or result.returncode >= 128:
                    raise SystemExit(result.returncode if result.returncode >= 0 else 128 - result.returncode)
                if result.returncode:
                    raise RuntimeError(f'artifact ZIP request failed (exit {result.returncode})')
                verified = scratch / 'verified'
                extract_verified_zip(archive, verified, size, expected_hash, manifest_hash)
                if directory.exists() or directory.is_symlink():
                    raise ValueError('archive destination appeared during transfer')
                verified.rename(directory)
                print(f'Artifact {artifact_id}: complete ZIP {size} bytes SHA256 {expected_hash}; '
                      f'all producer files verified, transfer attempt {attempt}, '
                      f'{time.monotonic() - started:.1f}s', flush=True)
                return
            except (OSError, ValueError, zipfile.BadZipFile, RuntimeError, subprocess.TimeoutExpired) as error:
                print(f'::warning::Artifact {artifact_id} transfer attempt {attempt} failed '
                      f'({type(error).__name__}: {error}); private partial input discarded; no tests started.', flush=True)
                if attempt == 2:
                    raise RuntimeError('exact producer artifact transfer failed after two bounded attempts') from None
    raise AssertionError('unreachable')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('build', 'download', 'consume'))
    args = parser.parse_args()
    directory = Path(os.environ['RUNNER_TEMP']) / 'ci-test-archives'
    if args.action == 'download':
        download(directory)
        return
    current = identity()
    if current['source'] != os.environ['GITHUB_SHA']:
        raise ValueError('checkout must match the workflow tested SHA')
    if args.action == 'build':
        directory.mkdir(parents=True, exist_ok=True)
        subprocess.run(['cargo', 'nextest', 'archive', '--workspace', '--exclude', 'st2', '--locked',
                        '--profile', 'ci', '--archive-file', str(directory / FILES[0])], check=True)
        subprocess.run(['cargo', 'nextest', 'archive', '-p', 'st2', '--test', 'integration', '--test',
                        'agent_resource', '--test', 'driver_expansion', '--locked', '--profile', 'ci',
                        '--archive-file', str(directory / FILES[1])], check=True)
        # Keep the original no-default-features unit/integration/doc tests and dependency gate,
        # using the producer's compiler cache instead of rebuilding in the runtime consumer.
        subprocess.run(['bash', 'scripts/ci-linux', 'conversation-model'], check=True)
        # The real-user gateway must retain the standalone production feature set.
        with (directory / 'production-build.json').open('w') as stream:
            subprocess.run(['cargo', 'build', '--locked', '-p', 'st3', '--bin', 'st3',
                            '--message-format=json'], check=True, stdout=stream)
        artifacts = [json.loads(line) for line in (directory / 'production-build.json').read_text().splitlines()]
        binaries = [item for item in artifacts if item.get('reason') == 'compiler-artifact'
                    and item['target']['name'] == 'st3' and item.get('executable')]
        if len(binaries) != 1 or 'test-support' in binaries[0]['features'] or binaries[0]['profile']['test']:
            raise ValueError('standalone production gateway feature/profile identity required')
        import shutil
        shutil.copy2(binaries[0]['executable'], directory / 'sekrets-st3')
        manifest = {'version': 1, 'standalone_model': True, 'identity': current, 'workspace': str(Path.cwd().resolve()),
                    'files': {name: digest(directory / name) for name in FILES}}
        (directory / 'manifest.json').write_text(json.dumps(manifest, sort_keys=True, indent=2) + '\n')
        with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
            stream.write('producer-attempt=' + current['attempt'] + '\n')
            stream.write('manifest-sha256=' + digest(directory / 'manifest.json') + '\n')
    else:
        manifest_path = directory / 'manifest.json'
        if digest(manifest_path) != os.environ['CI_TEST_ARCHIVE_MANIFEST_SHA256']:
            raise ValueError('test archive manifest differs from the successful producer output')
        manifest = json.loads(manifest_path.read_text())
        verify(manifest, current, directory, os.environ['CI_TEST_ARCHIVE_PRODUCER_ATTEMPT'])
        extracted = Path(os.environ['RUNNER_TEMP']) / 'ci-test-extracted'
        for group, name in zip(('workspace', 'st2'), FILES):
            destination = extracted / group
            destination.mkdir(parents=True, exist_ok=True)
            # Extract/list metadata once. Subsequent inventories and runs use these metadata files,
            # without another extraction or invoking a build.
            subprocess.run(['cargo', 'nextest', 'list', '--archive-file', str(directory / name),
                            '--extract-to', str(destination), '--extract-overwrite', '--workspace-remap',
                            str(Path.cwd()), '--list-type', 'binaries-only', '--message-format', 'json'], check=True)
        hooks = extracted / 'st2/target/debug/st2'
        if not hooks.is_file() or not os.access(hooks, os.X_OK):
            raise ValueError('the matching rendered-hook executable must be archived')
        scratch = Path(os.environ['RUNNER_TEMP']) / 'ci-test-scratch'
        scratch.mkdir(exist_ok=True)
        production = directory / 'sekrets-st3'
        # Actions artifact transfer does not retain executable permissions; bytes were just
        # hash-verified against the producer manifest, so restore the intended binary mode.
        production.chmod(0o755)
        with open(os.environ['GITHUB_ENV'], 'a') as stream:
            for key, value in {'CI_TEST_EXTRACTED': str(extracted),
                               'CI_TEST_BUILD_WORKSPACE': manifest['workspace'],
                               'CI_TEST_WORKSPACE': str(Path.cwd()),
                               'CI_TEST_HOOKS_BINARY': str(hooks),
                               'CI_TEST_TARGET_TMPDIR': str(scratch),
                               'CI_SEKRETS_BINARY': str(production)}.items():
                if '\n' in value or '\r' in value:
                    raise ValueError('invalid workflow environment path')
                stream.write(f'{key}={value}\n')
        print('Verified both exact-source test archives:', current, flush=True)


if __name__ == '__main__':
    main()
