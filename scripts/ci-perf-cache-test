#!/usr/bin/env python3
"""Main provenance, workload validation, snapshot layout and required PR baseline."""
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import sys
import tempfile
import threading
from unittest.mock import patch

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('ci_perf_cache', str(root / 'scripts/ci-perf-cache'))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)

with tempfile.TemporaryDirectory() as tmp:
    temp = Path(tmp)
    calls, sleeps = [], []
    replies = [(1, 'HTTP 503: Egress is over the account limit. '
                   '(https://example.invalid/artifact?sig=private)'),
               (1, 'HTTP 504: gateway timeout'), (0, '')]
    def transfer(cmd, capture_output, text):
        assert capture_output and text
        calls.append(cmd)
        stage = Path(cmd[-1])
        stage.mkdir()
        code, error = replies.pop(0)
        (stage / 'load.json').write_text('partial' if code else 'complete baseline')
        return module.subprocess.CompletedProcess(cmd, code, '', error)
    output = io.StringIO()
    with patch.object(module.subprocess, 'run', transfer), patch.object(module.time, 'sleep', sleeps.append):
        with contextlib.redirect_stdout(output), contextlib.redirect_stderr(output):
            module.download('example/project', {'id': 123}, 'perf-load-logs', temp / 'report')
    assert sleeps == [5, 15] and len(calls) == 3
    assert all(cmd[:-1] == calls[0][:-1] for cmd in calls), 'retry exactly the selected artifact'
    assert (temp / 'report/load.json').read_text() == 'complete baseline'
    assert len({cmd[-1] for cmd in calls}) == 3, 'partial downloads must never be reused'
    assert [path.name for path in temp.iterdir()] == ['report']
    assert 'sig=private' not in output.getvalue() and 'https://' not in output.getvalue()
    assert 'P0:' in output.getvalue() and 'attempt 3' in output.getvalue()
    for error, attempts in [('HTTP 503: busy', 3), ('HTTP 403: forbidden', 1),
                            ('HTTP 404: missing', 1), ('invalid archive', 1)]:
        calls.clear()
        sleeps.clear()
        replies[:] = [(1, error)] * attempts
        with patch.object(module.subprocess, 'run', transfer), patch.object(module.time, 'sleep', sleeps.append):
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                try:
                    module.download('example/project', {'id': 123}, 'perf-load-logs', temp / 'failed')
                except module.subprocess.CalledProcessError:
                    pass
                else:
                    raise AssertionError('failed restoration must remain fatal')
        assert len(calls) == attempts and not (temp / 'failed').exists()
        assert [path.name for path in temp.iterdir()] == ['report']

run = dict(id=1, head_branch='main', conclusion='success', event='schedule', path='.github/workflows/perf.yml')
report = dict(scale=1, claims=1000, seconds=135, daemon_cores=1, long_poll_seats=30,
              failed={}, paths={'mail': dict(count=100, p50_ms=1, p99_ms=2, max_ms=3, budget_ms=100)})
assert module.trusted(run)
for field, value in [('head_branch', 'example-branch'), ('conclusion', 'failure'),
                     ('event', 'pull_request'), ('path', '.github/workflows/fleet.yml')]:
    assert not module.trusted(dict(run, **{field: value}))
assert module.trusted_snapshot(dict(run, conclusion='failure'))
assert not module.trusted_snapshot(dict(run, conclusion='cancelled'))
assert module.valid_report(report)
for field, value in [('scale', 0.1), ('claims', 0), ('seconds', 5), ('long_poll_seats', 1),
                     ('paths', {}), ('paths', []), ('daemon_cores', float('nan')),
                     ('daemon_cores', True), ('seconds', None)]:
    assert not module.valid_report(dict(report, **{field: value}))
assert not module.valid_report([]) and not module.valid_report(None)

with tempfile.TemporaryDirectory() as tmp:
    temp = Path(tmp)
    os.environ.update(RUNNER_TEMP=str(temp), GITHUB_OUTPUT=str(temp / 'output'))
    with contextlib.redirect_stdout(io.StringIO()):
        assert module.check_report() == 1
    (temp / 'perf').mkdir()
    (temp / 'perf/load.json').write_text(json.dumps(dict(report, seconds=5)))
    with contextlib.redirect_stdout(io.StringIO()):
        assert module.check_report() == 1
    assert not (temp / 'output').exists()
    # Latency failure preserves caches, but never turns the failed report into a baseline.
    (temp / 'perf/load.json').write_text(json.dumps(dict(report, failed={'mail': True})))
    assert module.check_report() == 0
    assert (temp / 'output').read_text() == 'publish=true\n'

with tempfile.TemporaryDirectory() as tmp:
    temp = Path(tmp)
    work = temp / 'work'
    (work / 'src').mkdir(parents=True)
    source = work / 'src/main.rs'
    source.write_text('fn main() {}\n')
    (work / '.gitignore').write_text('target/\n')
    def git_command(*args):
        module.subprocess.run(['git', '-C', str(work), *args], check=True,
                              stdout=module.subprocess.DEVNULL, stderr=module.subprocess.DEVNULL)
    git_command('init', '-b', 'main')
    git_command('add', '.')
    git_command('-c', 'user.name=Example Builder', '-c', 'user.email=builder@example.invalid',
                '-c', 'commit.gpgSign=false', 'commit', '-m', 'initial fixture')
    os.environ.update(GITHUB_WORKSPACE=str(work), RUNNER_TEMP=str(temp))
    (temp / 'st-ci-cache').mkdir()
    module.remember_sources()
    checkpoint = temp / 'st-ci-cache/perf-source-state.json'
    checkpoint.write_bytes((temp / 'perf-source-state.json').read_bytes())
    before = source.stat().st_mtime_ns
    source.touch()
    (work / '.git/index').touch()
    index_after = (work / '.git/index').stat().st_mtime_ns
    module.restore_sources()
    assert source.stat().st_mtime_ns == before
    assert (work / '.git/index').stat().st_mtime_ns == index_after, 'never rewrite Git metadata'
    # A dirty tree or another real revision must never borrow old compilation timestamps.
    source.write_text('fn main() { println!("changed"); }\n')
    dirty_mtime = source.stat().st_mtime_ns
    module.restore_sources()
    assert source.stat().st_mtime_ns == dirty_mtime
    git_command('add', '.')
    git_command('-c', 'user.name=Example Builder', '-c', 'user.email=builder@example.invalid',
                '-c', 'commit.gpgSign=false', 'commit', '-m', 'changed fixture')
    module.restore_sources()
    assert source.stat().st_mtime_ns == dirty_mtime
    module.remember_sources()
    state = json.loads((temp / 'perf-source-state.json').read_text())
    state['mtimes']['../outside'] = 1
    checkpoint.write_text(json.dumps(state))
    try:
        module.restore_sources()
    except ValueError:
        pass
    else:
        raise AssertionError('timestamp checkpoint may only address the checkout inputs')
    for name in ('cargo-home/registry', 'cargo-home/git', 'perf-sccache', 'st-bench'):
        (temp / name).mkdir(parents=True)
    (work / 'target').mkdir()
    module.remember_sources()
    module.pack()
    assert json.loads(checkpoint.read_text())['head'] == module.git(work, 'rev-parse', 'HEAD')
    (work / 'untracked-source').write_text('changed during the test')
    module.pack()
    assert not checkpoint.exists(), 'a dirty build must not retain an older clean checkpoint'

pr_run = dict(run, id=10, event='pull_request', head_branch='example-branch',
              head_repository=dict(full_name='example/project'), head_sha='b' * 40,
              pull_requests=[])
commits = {'b' * 40}
assert module.own_pr(dict(pr_run, conclusion='failure'), 1, 'example/project', 'example-branch', commits)
assert module.own_pr(pr_run, 1, 'example/project', 'example-branch', commits)
for field, value in [('head_branch', 'other-branch'), ('head_sha', 'c' * 40),
                     ('head_repository', dict(full_name='example/fork')),
                     ('head_repository', None), ('conclusion', 'cancelled'),
                     ('pull_requests', [dict(number=2)])]:
    assert not module.own_pr(dict(pr_run, **{field: value}), 1, 'example/project', 'example-branch', commits)

with tempfile.TemporaryDirectory() as tmp:
    temp = Path(tmp)
    work = temp / 'work'
    work.mkdir()
    os.environ.update(GITHUB_REPOSITORY='example/project', GITHUB_EVENT_NAME='pull_request',
                      GITHUB_WORKSPACE=str(work), RUNNER_TEMP=str(temp),
                      GITHUB_STEP_SUMMARY=str(temp / 'summary'),
                      PERF_BUILD_SNAPSHOT='build-recipe', PERF_STORES_SNAPSHOT='stores-recipe',
                      PERF_PR_NUMBER='1', PERF_HEAD_REPOSITORY='example/project',
                      GITHUB_HEAD_REF='example-branch', GITHUB_RUN_ATTEMPT='1', GITHUB_RUN_ID='10')
    # Exercise real archives: both workspace outputs and temp caches survive a round trip.
    for name in ('cargo-home/registry', 'cargo-home/git', 'perf-sccache', 'st-ci-cache', 'st-bench'):
        directory = temp / name
        directory.mkdir(parents=True)
        (directory / 'sample').write_text(name)
    (work / 'target').mkdir()
    (work / 'target/sample').write_text('build output')
    precise_mtime = 1720000000123456789
    os.utime(work / 'target/sample', ns=(precise_mtime, precise_mtime))
    module.pack()
    extracted = temp / 'extracted'
    extracted.mkdir()
    module.unpack(temp / 'perf-snapshots/build.tar.zst', extracted,
                  ('target', 'cargo-home', 'perf-sccache', 'st-ci-cache'))
    module.unpack(temp / 'perf-snapshots/stores.tar.zst', extracted, ('st-bench',))
    assert (extracted / 'target/sample').read_text() == 'build output'
    assert (extracted / 'target/sample').stat().st_mtime_ns == precise_mtime
    assert (extracted / 'st-bench/sample').read_text() == 'st-bench'
    # API ordering includes untrusted entries: none may supply caches or a baseline.
    runs = [dict(run, id=9, event='pull_request')] + [dict(run, id=i) for i in range(8, 0, -1)]
    downloads = []
    candidates = []
    previous = pr_run
    missing_previous_artifacts = False
    overlap_probe = True
    archive_downloads = threading.Barrier(2)

    def api(path):
        if '/pulls/1/commits?' in path:
            return [dict(sha='b' * 40)]
        if '/attempts/' in path:
            return previous
        if 'event=pull_request' in path:
            return dict(workflow_runs=candidates)
        if '/workflows/' in path:
            return dict(workflow_runs=runs)
        assert '/runs/9/' not in path
        if missing_previous_artifacts and '/runs/10/' in path:
            return dict(artifacts=[])
        return dict(artifacts=[dict(name=name, expired=False) for name in
                              ('build-recipe', 'stores-recipe', 'perf-load-logs')])

    def download(repo, selected, name, dest):
        assert repo == 'example/project'
        assert module.trusted_snapshot(selected) or module.own_pr(selected, 1, repo, 'example-branch', commits)
        if name == 'perf-load-logs':
            assert module.trusted(selected), 'PR reports must never become baselines'
        elif overlap_probe:
            # Both archives must be in flight before either can finish downloading.
            archive_downloads.wait(timeout=5)
        downloads.append((selected['id'], name))
        dest.mkdir(parents=True)
        if name == 'perf-load-logs':
            (dest / 'load.json').write_text(json.dumps(report))

    def unpack(archive, destination, names):
        for name in names:
            (destination / name).mkdir()
            (destination / name / 'cached').write_text('snapshot')

    module.api, module.download, original_unpack = api, download, module.unpack
    module.unpack = unpack
    with contextlib.redirect_stdout(io.StringIO()):
        module.restore()
    overlap_probe = False
    assert len(downloads) == 7  # two snapshots, five newest real reports
    assert sorted(p.name for p in (temp / 'perf-baseline').iterdir()) == [f'load-{i}.json' for i in range(4, 9)]
    assert (work / 'target/cached').read_text() == 'snapshot'
    assert (temp / 'st-ci-cache/cached').exists() and (temp / 'st-bench/cached').exists()
    # Reruns may reuse their successful previous attempt despite the current in-progress status.
    os.environ['GITHUB_RUN_ATTEMPT'] = '2'
    downloads.clear()
    with contextlib.redirect_stdout(io.StringIO()):
        module.restore()
    assert set(downloads[:2]) == {(10, 'build-recipe'), (10, 'stores-recipe')}
    assert downloads[2:] == [(i, 'perf-load-logs') for i in range(8, 3, -1)]
    previous = dict(pr_run, conclusion='failure')
    downloads.clear()
    with contextlib.redirect_stdout(io.StringIO()):
        module.restore()
    assert set(downloads[:2]) == {(10, 'build-recipe'), (10, 'stores-recipe')}
    assert downloads[2:] == [(i, 'perf-load-logs') for i in range(8, 3, -1)]
    previous = pr_run
    # GitHub can expose the successful attempt while hiding all of its artifacts on rerun.
    # That must restore main's snapshots and actual main reports, rather than become cold.
    missing_previous_artifacts = True
    downloads.clear()
    with contextlib.redirect_stdout(io.StringIO()):
        module.restore()
    assert set(downloads[:2]) == {(8, 'build-recipe'), (8, 'stores-recipe')}
    assert downloads[2:] == [(i, 'perf-load-logs') for i in range(8, 3, -1)]
    missing_previous_artifacts = False
    runs.insert(0, dict(run, id=11, conclusion='failure'))
    missing_previous_artifacts = True
    downloads.clear()
    with contextlib.redirect_stdout(io.StringIO()):
        module.restore()
    assert set(downloads[:2]) == {(11, 'build-recipe'), (11, 'stores-recipe')}
    assert downloads[2:] == [(i, 'perf-load-logs') for i in range(8, 3, -1)]
    runs.pop(0)
    missing_previous_artifacts = False
    # Main must not promote PR snapshots, even when a same-PR cache exists.
    os.environ['GITHUB_EVENT_NAME'] = 'push'
    candidates.append(pr_run)
    downloads.clear()
    with contextlib.redirect_stdout(io.StringIO()):
        module.restore()
    assert all(selected != 10 for selected, _ in downloads)
    os.environ.update(GITHUB_EVENT_NAME='pull_request', GITHUB_RUN_ATTEMPT='1')
    candidates.clear()
    def incomplete(archive, destination, names):
        (destination / names[0]).mkdir()
    module.unpack = incomplete
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            module.restore()
    except ValueError as error:
        assert 'incomplete build snapshot' in str(error)
    else:
        raise AssertionError('partial snapshot must not claim a cache hit')
    module.unpack = unpack
    runs.clear()
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            module.restore()
    except ValueError as error:
        assert 'every PR requires' in str(error)
    else:
        raise AssertionError('PR without a real main baseline must fail')
    assert list((temp / 'perf-baseline').iterdir()) == []

    # Validate archive roots before extraction, including traversal and absolute paths.
    module.unpack = original_unpack
    def output(cmd, text):
        assert cmd[:3] == ['tar', '--zstd', '-tf']
        return bad
    module.subprocess.check_output = output
    for bad in ('/target/file', 'target/../file', 'other/file'):
        try:
            module.unpack(temp / 'build.tar.zst', temp, ('target',))
        except ValueError:
            pass
        else:
            raise AssertionError('unexpected archive root accepted')

print('Performance cache tests passed: main baselines, same-PR snapshots, rerun provenance, archive completeness')
