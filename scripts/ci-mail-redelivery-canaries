#!/usr/bin/env python3
"""Fail closed when any required harness redelivery regression is absent or skipped."""
import argparse
import json
import os
from pathlib import Path
import subprocess

HARNESSES = ("claude", "codex", "opencode", "pi", "omp")
REQUIRED = {
    *(f"api::mailbox::tests::{harness}_boot_and_reconnect_never_inject_old_mail" for harness in HARNESSES),
    *(f"api::mailbox::tests::{harness}_restart_recovers_recent_unoffered_mail_once" for harness in HARNESSES),
    *(f"boot_canaries::{harness}::a_suspended_seat_resumes_its_own_native_session" for harness in HARNESSES),
    "daemon_restart::delivered_unread_mail_stays_in_the_mailbox_after_seat_restart",
    "api::mailbox::tests::native_poll_recovers_unoffered_preboot_mail_until_its_current_offer_finishes",
    "boot_canaries::claude_missing_channel_blocks_and_recovers_early_mail_without_replay",
    "boot_canaries::claude_uninitialized_channel_blocks_until_native_attachment",
    "boot_canaries::claude_permanent_channel_failure_parks_after_three_attempts_without_a_restart_loop",
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--package-only", action="store_true", help="local compatibility: build only st3")
    args = parser.parse_args()
    selection = ["-p", "st3"] if args.package_only else ["--workspace", "--exclude", "st2"]
    filters = " or ".join(f"test(={name})" for name in sorted(REQUIRED))
    common = selection + ["--locked", "--profile", "ci", "-E", filters]
    if os.environ.get("CI_TEST_EXTRACTED"):
        target = Path(os.environ['CI_TEST_EXTRACTED']) / 'workspace/target'
        common = ["--binaries-metadata", str(target / 'nextest/binaries-metadata.json'),
                  "--cargo-metadata", str(target / 'nextest/cargo-metadata.json'),
                  "--target-dir-remap", str(target), "--workspace-remap", os.environ['CI_TEST_WORKSPACE'],
                  "--profile", "ci", "-E", filters]
    listed = subprocess.check_output(["cargo", "nextest", "list", *common, "--message-format", "json"], text=True)
    suites = json.loads(listed)["rust-suites"]
    selected = {name for suite in suites.values() for name, test in suite["testcases"].items()
                if not test["ignored"] and test["filter-match"]["status"] == "matches"}
    missing = REQUIRED - selected
    if missing:
        raise SystemExit("missing, ignored or filtered required canaries: " + ", ".join(sorted(missing)))
    print(f"Running all {len(REQUIRED)} required mail redelivery canaries with zero retries", flush=True)
    subprocess.run(["cargo", "nextest", "run", *common,
                    "--test-threads", os.environ.get("CI_TEST_THREADS", "8"),
                    "--retries", "0", "--no-tests", "fail"], check=True)
    if os.environ.get("GITHUB_STEP_SUMMARY"):
        with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a") as summary:
            summary.write(f"All {len(REQUIRED)} required mail redelivery canaries passed with zero retries.\n")


if __name__ == "__main__":
    main()
