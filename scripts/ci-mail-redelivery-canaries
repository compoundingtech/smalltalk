#!/usr/bin/env python3
"""Fail closed when any required harness redelivery regression is absent or skipped."""
import argparse
import json
import os
from pathlib import Path
import subprocess

HARNESSES = ("claude", "codex", "opencode", "pi", "omp")
REQUIRED = {
    *(f"api::mailbox::tests::{harness}_boot_and_reconnect_never_inject_old_mail" for harness in HARNESSES),
    *(f"boot_canaries::{harness}::a_suspended_seat_resumes_its_own_native_session" for harness in HARNESSES),
    "daemon_restart::delivered_unread_mail_stays_in_the_mailbox_after_seat_restart",
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--package-only", action="store_true", help="local focused build of st3 only")
    args = parser.parse_args()
    selection = ["-p", "st3", "--lib", "--test", "integration"] if args.package_only else ["--workspace", "--exclude", "st2"]
    filters = " or ".join(f"test(={name})" for name in sorted(REQUIRED))
    common = selection + ["--locked", "--profile", "ci", "-E", filters]
    listed = subprocess.check_output(["cargo", "nextest", "list", *common, "--message-format", "json"], text=True)
    suites = json.loads(listed)["rust-suites"]
    selected = {name for suite in suites.values() for name, test in suite["testcases"].items()
                if not test["ignored"] and test["filter-match"]["status"] == "matches"}
    missing = REQUIRED - selected
    if missing:
        raise SystemExit("missing, ignored or filtered required canaries: " + ", ".join(sorted(missing)))
    print(f"Running all {len(REQUIRED)} required mail redelivery canaries with zero retries", flush=True)
    subprocess.run(["cargo", "nextest", "run", *common, "--retries", "0", "--no-tests", "fail"], check=True)
    if os.environ.get("GITHUB_STEP_SUMMARY"):
        with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a") as summary:
            summary.write(f"All {len(REQUIRED)} required mail redelivery canaries passed with zero retries.\n")


if __name__ == "__main__":
    main()
