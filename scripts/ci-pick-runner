#!/usr/bin/env python3
"""Choose roles from the shared owned pool; execute inline on a hosted picker."""
import datetime as dt
import json
import re
import time
import os
import subprocess


def queue_waits(env):
    """Advisory complete live-run snapshot, never a gate or a polling loop.

    Each picker takes a new snapshot. Unknown keeps the idle-role policy. A
    public repo token reads jobs; the org runner credential is never substituted.
    """
    repo = env.get("REPOSITORY", "")
    token = env.get("GH_REPO_TOKEN", "")
    if not token or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*", repo):
        return None, "no repository queue reader"
    deadline = time.monotonic() + 40
    def request(path):
        left = deadline - time.monotonic()
        if left <= 0:
            raise TimeoutError("queue snapshot deadline")
        result = subprocess.run(["gh", "api", path],
            env={**env, "GH_TOKEN": token}, check=True, capture_output=True,
            text=True, timeout=min(8, left))
        return json.loads(result.stdout)
    def get(path):
        # GITHUB_TOKEN's 1000/h repository quota is shared with unrelated jobs.
        # Recheck before EVERY charged call; do not use an initial stale balance
        # for all 26 calls. This is advisory, not an atomic quota reservation.
        quota = request("rate_limit")["resources"]["core"]["remaining"]
        if type(quota) is not int or quota < 300:
            raise ValueError("repository API reserve below 300 requests")
        return request(f"repos/{repo}/{path}")
    def rows(data, field):
        items = data[field]
        total = data["total_count"]
        if type(total) is not int or total < 0 or not isinstance(items, list) or total != len(items):
            raise ValueError("incomplete " + field)
        return items
    try:
        runs = {}
        for status in ("queued", "in_progress"):
            for run in rows(get(f"actions/runs?status={status}&per_page=100"), "workflow_runs"):
                if type(run.get("id")) is not int or type(run.get("run_attempt")) is not int:
                    raise ValueError("run identity")
                if run["id"] in runs:
                    raise ValueError("run changed during listing")
                runs[run["id"]] = run
        if len(runs) > 24:
            raise ValueError("live-run snapshot exceeds 24-run bound")
        now = dt.datetime.now(dt.timezone.utc)
        waits = {"owned": 0.0, "namespace": 0.0}
        queued = {"owned": 0, "namespace": 0}
        for run in runs.values():
            for job in rows(get(f"actions/runs/{run['id']}/jobs?per_page=100"), "jobs"):
                if job.get("run_attempt") != run["run_attempt"] or job.get("head_sha") != run["head_sha"]:
                    raise ValueError("job identity changed")
                if job.get("status") != "queued":
                    continue
                labels = job["labels"]
                if not isinstance(labels, list) or not all(isinstance(x, str) for x in labels):
                    raise ValueError("job labels")
                pool = ("namespace" if any(x.startswith(("nscloud-", "namespace-profile-")) for x in labels)
                        else "owned" if any(x in ("ci1", "ci1-priority", "ci1-merge") for x in labels) else None)
                if pool:
                    created = dt.datetime.fromisoformat(job["created_at"].replace("Z", "+00:00"))
                    waits[pool] = max(waits[pool], max(0, (now-created).total_seconds()))
                    queued[pool] += 1
        return waits, f"complete advisory queue view: {len(runs)} runs, queued={queued}, oldest_seconds={waits}"
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError, AttributeError) as error:
        return None, f"queue view UNKNOWN ({type(error).__name__}); idle-role fallback"
def producer_host(pages):
    """Advisory, complete six-member host census; no reservation or API mutation.

    Return host affinity only with <=3 busy of six online members and two idle
    priority workers (a race margin, not a reservation). Missing ephemeral registrations or ambiguous views fall back.
    """
    try:
        totals = {page['total_count'] for page in pages}
        if len(totals) != 1 or any(type(page['total_count']) is not int for page in pages):
            return None
        rows = [runner for page in pages for runner in page['runners']]
        if len(rows) != next(iter(totals)):
            return None
        ids, names, hosts = set(), set(), {host: {} for host in ('ci1', 'ci2')}
        for row in rows:
            name, ident = row['name'], row['id']
            if (not isinstance(name, str) or type(ident) is not int or ident < 1
                    or ident in ids or name in names or type(row['busy']) is not bool
                    or row['status'] not in ('online', 'offline')):
                return None
            ids.add(ident); names.add(name)
            labels = {label['name'] for label in row['labels']}
            if not all(isinstance(label, str) for label in labels):
                return None
            for host in hosts:
                expected = {host+'-'+str(i) for i in range(1, 6)} | {host+'-merge-1'}
                if name in expected:
                    hosts[host][name] = (row['status'], row['busy'], labels)
        choices = []
        for host, members in hosts.items():
            if len(members) != 6 or any(status != 'online' for status, busy, labels in members.values()):
                continue
            busy = sum(busy for status, busy, labels in members.values())
            eligible = sum(not occupied and {'ci1-priority', 'ci-host-'+host} <= labels
                           for status, occupied, labels in members.values())
            if busy <= 3 and eligible >= 2:
                choices.append((busy, host))
        return min(choices)[1] if choices else None
    except (KeyError, TypeError, ValueError):
        return None


def main():
    env = os.environ
    event = env.get("EVENT", "")
    priority = event == "merge_group" or env.get("MODE") == "priority"
    try:
        priority = priority or (event == "pull_request" and "ci-priority" in json.loads(env.get("PR_LABELS", "[]")))
    except (ValueError, TypeError):
        pass
    output = open(env["GITHUB_OUTPUT"], "a")
    summary = open(env["GITHUB_STEP_SUMMARY"], "a")
    def emit_labels(key, labels):
        print(f'{key}={json.dumps(labels, separators=(",", ":"))}', file=output)
        print(f'{key}: {json.dumps(labels)}', file=summary)
    def emit(key, label):
        labels = [label] if isinstance(label, str) else label
        print(f'{key}={json.dumps(labels, separators=(",", ":"))}', file=output)
        print(f'{key}: **{labels[0].split("-")[0]}** ({labels})', file=summary)
    producer_mode = env.get('MERGE_PRODUCER_OWNED', '') if event == 'merge_group' else ''
    run_id = env.get('RUN_ID', '')
    profile = env.get('MERGE_NAMESPACE_PROFILE') or 'linux-x86-64'
    producer_fallback = [f'namespace-profile-{profile};job.priority=1;github.run-id={run_id}'] if run_id.isascii() and run_id.isdigit() and int(run_id) > 0 else []
    def pick_producer(pages=None):
        if not producer_mode or not producer_fallback:
            return
        host = producer_host(pages) if producer_mode == 'on' and pages else None
        labels = ['ci-host-'+host, 'ci1-priority'] if host else producer_fallback
        emit_labels('ci1_build', labels)
        print('Merge producer: %s; census is advisory, not a reservation' % (host or 'Namespace'), file=summary)
    def unavailable(reason):
        pick_producer()
        print(reason)
        if priority:
            emit("ci1", "ci1-priority")
        else:
            print(f'Unpicked runners: **Namespace** ({reason})', file=summary)
    if event == "pull_request" and env.get("HEAD_REPOSITORY") != env.get("REPOSITORY"):
        print('Unpicked runners: **Namespace** (fork pull request)', file=summary)
        return
    if not env.get("GH_TOKEN"):
        unavailable("no runner status token")
        return
    need = env.get("NEED", "1")
    if not need.isascii() or not need.isdigit() or int(need) < 1:
        unavailable("invalid minimum idle runner count")
        return
    try:
        result = subprocess.run(["gh", "api", "--paginate", "--slurp",
            f'orgs/{env["OWNER"]}/actions/runner-groups/3/runners?per_page=100'],
            check=True, capture_output=True, text=True, timeout=20)
        pages = json.loads(result.stdout)
        if not isinstance(pages, list):
            raise ValueError("runner pages")
        by_id = {}
        expected = None
        count = 0
        for page in pages:
            if not isinstance(page, dict) or not isinstance(page.get("runners"), list):
                raise ValueError("runner page")
            total = page.get("total_count")
            if type(total) is not int or total < 0 or (expected is not None and expected != total):
                raise ValueError("inconsistent runner count")
            expected = total
            count += len(page["runners"])
            for runner in page["runners"]:
                if not isinstance(runner, dict) or type(runner.get("id")) is not int:
                    raise ValueError("runner identity")
                if not isinstance(runner.get("labels"), list):
                    raise ValueError("runner labels")
                labels = {label["name"] for label in runner["labels"]}
                if not all(isinstance(label, str) for label in labels):
                    raise ValueError("runner label")
                record = (runner.get("status"), runner.get("busy"), labels)
                if runner["id"] in by_id and by_id[runner["id"]] != record:
                    raise ValueError("conflicting duplicate runner")
                by_id[runner["id"]] = record
        if expected is None or count != expected or len(by_id) != count:
            raise ValueError("incomplete or duplicate runner view")
        idle = {key: labels for key, (status, busy, labels) in by_id.items()
                if status == "online" and busy is False}
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError):
        unavailable("runner list unavailable or invalid")
        return
    if (event == "merge_group" and env.get("MERGE_OVERFLOW", "on") != "off"
            and any(key < 1 or status not in ("online", "offline") or type(busy) is not bool
                    for key, (status, busy, labels) in by_id.items())):
        unavailable("unqualified merge capacity status")
        return
    pick_producer(pages)
    # Group 3 is the common pool. These compatibility role names are shared on both hosts.
    online = sum(status == "online" for status, busy, labels in by_id.values())
    def candidates(label):
        return [key for key, labels in idle.items() if label in labels]
    census = (f'common pool group3: {online} online, {len(idle)} idle; '
              f'{len(candidates("ci1"))} general idle, {len(candidates("ci1-priority"))} priority idle')
    print(census)
    print(census, file=summary)
    # No queue read can improve a decision with no usable general/priority
    # admission slot. Preserve tokens for jobs doing actual work.
    observe_queue = (env.get("MODE") != "priority" and
                     (len(candidates("ci1-priority")) >= 3 if event == "merge_group"
                      else bool(candidates("ci1"))))
    waits, queue_note = queue_waits(env) if observe_queue else (None, "idle-role decision sufficient; queue API not queried")
    print(queue_note)
    print(queue_note, file=summary)
    if event == "merge_group" and env.get("MERGE_OVERFLOW", "on") != "off":
        merge_need = env.get("MERGE_NEED", "3")
        run_id = env.get("RUN_ID", "")
        if (merge_need.isascii() and merge_need.isdigit() and int(merge_need) > 0
                and run_id.isascii() and run_id.isdigit() and int(run_id) > 0):
            if (len(candidates("ci1-priority")) < int(merge_need)
                    or (waits is not None and waits["owned"] > 300
                        and waits["namespace"] + 60 < waits["owned"])):
                # Build/test stages use the qualified 8x16 shape, avoiding the
                # VM profile's smaller concurrency limit. Only VM needs KVM.
                emit("ci1", ["nscloud-ubuntu-24.04-amd64-8x16-with-features;job.priority=1",
                             f"namespace-features:github.run-id={run_id}"])
                emit("ci1_profile", f"namespace-profile-linux-x86-64;job.priority=1;github.run-id={run_id}")
                print('Merge overflow: **Namespace** (qualified pool census below admission minimum)', file=summary)
                return
        else:
            print('Merge overflow refused: invalid admission minimum or run identity', file=summary)
    if priority:
        emit("ci1", "ci1-priority")
        # A dual-labelled runner can take the priority primary; do not also offer it.
        available = candidates("ci1-priority")
        if available:
            idle.pop(available[0])
        if event == "merge_group" or env.get("MODE") == "priority":
            return
    elif (waits is not None and waits["owned"] > waits["namespace"] + 60):
        print('PR admission: **Namespace** (shorter measured queue); merge roles retained', file=summary)
        return
    elif len(candidates("ci1")) >= int(need):
        emit("ci1", "ci1")
        idle.pop(candidates("ci1")[0])
    else:
        print('Primary runner: **Namespace** (minimum idle count unmet)', file=summary)
    for key in ("ci1_secondary", "ci1_mail"):
        available = candidates("ci1")
        if available:
            emit(key, "ci1")
            idle.pop(available[0])
        else:
            print(f'{key}: **Namespace** (no distinct idle general worker)', file=summary)


if __name__ == "__main__":
    main()
