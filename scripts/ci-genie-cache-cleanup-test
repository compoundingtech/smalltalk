#!/usr/bin/env python3
"""Copied Nix directories are read-only; cleanup must preserve inputs and the original exit."""
import os
from pathlib import Path
import stat
import subprocess
import tempfile

assert os.geteuid() != 0, 'cleanup permission fixtures require an unprivileged user'

root = Path(__file__).resolve().parent.parent
script = (root / 'scripts/ci-genie-cache-verify').read_text()
# Load the actual EXIT function without starting Nix or a build. The fixtures exercise
# filesystem behavior and exit propagation, not a mocked chmod/rm implementation.
cleanup = script[script.index('cleanup() {'):script.index('\ntrap cleanup EXIT')]

with tempfile.TemporaryDirectory(prefix='genie-cleanup-test-') as tmp:
    base = Path(tmp)
    original = base / 'original-cache'
    original.mkdir()
    nar = original / 'input.nar'
    nar.write_bytes(b'unchanged cache input')
    nar.chmod(0o444)
    original.chmod(0o555)
    before = (nar.read_bytes(), stat.S_IMODE(nar.stat().st_mode),
              stat.S_IMODE(original.stat().st_mode))

    def run_fixture(name, initial_exit, blocked_parent=False):
        parent = base / name
        parent.mkdir()
        proof = parent / 'proof'
        for store in ('complete-store', 'incomplete-store'):
            leaf = proof / store / 'nix/store/fixture/lib'
            leaf.mkdir(parents=True)
            (leaf / 'library').write_text('copied Nix output')
            (leaf / 'library').chmod(0o444)
            (leaf / 'outside').symlink_to(original, target_is_directory=True)
            for directory in (leaf, *leaf.parents):
                if directory == proof:
                    break
                directory.chmod(0o555)
        cache = proof / 'incomplete-cache'
        cache.mkdir()
        os.link(nar, cache / 'input.nar')
        if blocked_parent:
            parent.chmod(0o555)
        try:
            command = cleanup + '\nproof=$CLEANUP_FIXTURE\ntrap cleanup EXIT\nexit "$INITIAL_EXIT"\n'
            done = subprocess.run(['bash', '-euc', command], text=True, capture_output=True,
                                  env={**os.environ, 'CLEANUP_FIXTURE': str(proof),
                                       'INITIAL_EXIT': str(initial_exit)})
            if blocked_parent:
                assert done.returncode != 0, 'a cleanup failure must fail a successful proof'
                assert 'could not remove temporary Genie cache proof' in done.stdout
            else:
                assert done.returncode == initial_exit, (done.returncode, done.stdout, done.stderr)
                assert not proof.exists(), 'read-only copied stores leaked'
            assert before == (nar.read_bytes(), stat.S_IMODE(nar.stat().st_mode),
                              stat.S_IMODE(original.stat().st_mode)), 'input or symlink target changed'
        finally:
            parent.chmod(0o755)
            if proof.exists():
                proof.rmdir()

    try:
        run_fixture('success', 0)
        run_fixture('failed-proof', 23)
        run_fixture('failed-cleanup', 0, blocked_parent=True)
    finally:
        original.chmod(0o755)

print('PASS: read-only temporary stores removed; failure preserved; cleanup errors fail; inputs unchanged')
