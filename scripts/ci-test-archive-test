#!/usr/bin/env python3
"""Archive consumers fail closed on source, attempt, tool or artifact mismatches."""
import copy
import json
import importlib.machinery
import importlib.util
from pathlib import Path
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('archive', str(ROOT / 'scripts/ci-test-archive'))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
with tempfile.TemporaryDirectory() as tmp:
    directory = Path(tmp)
    for name in module.FILES:
        (directory / name).write_bytes(name.encode())
    current = dict(source='a' * 40, tree='b' * 40, run='123', attempt='2', platform='x86_64',
                   nextest='same nextest', rustc='same rustc', recipe='same recipe', paths='same paths', targets='same targets')
    manifest = dict(version=2, standalone_model=True, identity=current, workspace='/producer/source',
                    files={name: module.digest(directory / name) for name in module.FILES})
    module.verify(manifest, current, directory, "2")
    inherited = copy.deepcopy(manifest)
    inherited['identity']['attempt'] = '1'
    module.verify(inherited, current, directory, '1')
    for expected in ('0', '3', 'unknown', '2'):
        try:
            module.verify(inherited, current, directory, expected)
        except ValueError:
            pass
        else:
            raise AssertionError('unbound inherited attempt accepted')
    variants = []
    for key in current:
        wrong = copy.deepcopy(manifest)
        wrong['identity'][key] = 'different'
        variants.append(wrong)
    for change in [dict(standalone_model=False), dict(version=1), dict(workspace='relative'), dict(files={}),
                   dict(files={**manifest['files'], 'extra.tar.zst': 'extra'}),
                   dict(files={**manifest['files'], module.FILES[0]: 'bad digest'})]:
        variants.append({**manifest, **change})
    for wrong in variants:
        try:
            module.verify(wrong, current, directory, "2")
        except ValueError:
            pass
        else:
            raise AssertionError('mismatched archive accepted')
    (directory / module.FILES[0]).unlink()
    try:
        module.verify(manifest, current, directory, "2")
    except FileNotFoundError:
        pass
    else:
        raise AssertionError('missing archive accepted')
# Workspace membership is authoritative; an existing legacy member must retain all
# three integration targets, while its absence needs no stale nextest predicates.
target_loader = importlib.machinery.SourceFileLoader('targets', str(ROOT / 'scripts/ci-nextest-targets'))
target_spec = importlib.util.spec_from_loader(target_loader.name, target_loader)
targets_module = importlib.util.module_from_spec(target_spec)
target_loader.exec_module(targets_module)
legacy = dict(id='legacy', name='st2', targets=[
    dict(name=name, kind=['test']) for name in ('integration', 'agent_resource', 'driver_expansion')])
assert 'package(=st2)' in targets_module.selection(dict(workspace_members=['legacy'], packages=[legacy]))
assert targets_module.selection(dict(workspace_members=['shared'], packages=[
    dict(id='shared', name='st-drivers', targets=[])])) == 'all()'
# A same-named dependency outside the workspace must not impose legacy test selection.
assert targets_module.selection(dict(workspace_members=['shared'], packages=[legacy])) == 'all()'
try:
    targets_module.selection(dict(workspace_members=['legacy'], packages=[
        {**legacy, 'targets': legacy['targets'][:-1]}]))
except ValueError:
    pass
else:
    raise AssertionError('an existing legacy member silently lost integration coverage')

print('Archive identity controls passed: source/tree/run/attempt/platform/tools/recipes, manifest version, selected workspace targets, hashes and missing bytes')

# Exercise the actual build/consume entry points with a fake nextest, never a compiler/test binary.
import os
import subprocess
with tempfile.TemporaryDirectory() as tmp:
    scratch = Path(tmp)
    bin_dir = scratch / 'bin'
    bin_dir.mkdir()
    cargo = bin_dir / 'cargo'
    cargo.write_text('#!' + sys.executable + '''
import json, os, sys
from pathlib import Path
args = sys.argv[1:]
with open(os.environ['CALLS'], 'a') as stream: stream.write(json.dumps(args) + '\\n')
if args == ['nextest', '--version']:
    print('cargo-nextest fixture')
elif args[:1] == ['metadata']:
    print(json.dumps({'workspace_members': ['st2'], 'packages': [{'id': 'st2', 'name': 'st2', 'targets': [{'name': name, 'kind': ['test']} for name in ('integration', 'agent_resource', 'driver_expansion')]}]}))
elif args[:2] == ['nextest', 'archive']:
    Path(args[args.index('--archive-file') + 1]).write_bytes(json.dumps(args).encode())
elif args[:1] == ['test']:
    print('test result: ok. 1 passed')
elif args[:1] == ['tree']:
    print('standalone model -> std')
elif args[:1] == ['build']:
    binary = Path(os.environ['RUNNER_TEMP']) / 'production-st3'
    binary.write_text('#!/bin/sh\\nexit 0\\n')
    binary.chmod(0o755)
    print(json.dumps({'reason': 'compiler-artifact', 'target': {'name': 'st3'}, 'executable': str(binary), 'features': [], 'profile': {'test': False}}))
elif args[:2] == ['nextest', 'list']:
    target = Path(args[args.index('--extract-to') + 1]) / 'target'
    (target / 'nextest').mkdir(parents=True)
    for name in ('binaries-metadata', 'cargo-metadata'):
        (target / 'nextest' / (name + '.json')).write_text('{}')
    (target / 'debug').mkdir()
    hooks = target / 'debug/ci-hooks-install'
    hooks.write_text('#!/bin/sh\\nexit 0\\n')
    hooks.chmod(0o755)
else:
    sys.exit('unexpected build or test command: ' + repr(args))
''')
    cargo.chmod(0o755)
    bash = bin_dir / 'bash'
    bash.write_text("#!" + sys.executable + "\nimport json, os, sys\nassert sys.argv[1:] == ['scripts/ci-linux', 'conversation-model']\nwith open(os.environ['CALLS'], 'a') as stream: stream.write(json.dumps(['bash', *sys.argv[1:]]) + '\\n')\n")
    bash.chmod(0o755)
    rustc = bin_dir / 'rustc'
    rustc.write_text('#!/bin/sh\necho fixture-rustc\n')
    rustc.chmod(0o755)
    calls, env_file, outputs = (scratch / name for name in ('calls', 'env', 'outputs'))
    sha = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
    environment = {**os.environ, 'PATH': f"{bin_dir}:{os.environ['PATH']}", 'RUNNER_TEMP': str(scratch),
                   'GITHUB_RUN_ID': '123', 'GITHUB_RUN_ATTEMPT': '2', 'GITHUB_SHA': sha,
                   'GITHUB_ENV': str(env_file), 'GITHUB_OUTPUT': str(outputs), 'CALLS': str(calls)}
    subprocess.run([sys.executable, 'scripts/ci-test-archive', 'build'], cwd=ROOT, env=environment, check=True, capture_output=True)
    commands = [__import__('json').loads(line) for line in calls.read_text().splitlines()]
    groups = [command for command in commands if 'archive' in command]
    assert ['bash', 'scripts/ci-linux', 'conversation-model'] in commands
    assert len(groups) == 1 and '--workspace' in groups[0] and '--exclude' not in groups[0]
    assert groups[0][groups[0].index('-E') + 1] == 'not package(=st2) or (kind(test) and (binary(=integration) or binary(=agent_resource) or binary(=driver_expansion)))'
    assert not any('-p' in command and 'st2' in command for command in commands)
    produced = dict(line.split('=', 1) for line in outputs.read_text().splitlines())
    produced_manifest = json.loads((scratch / 'ci-test-archives/manifest.json').read_text())
    assert produced_manifest['byte_sizes'] == {name: (scratch / 'ci-test-archives' / name).stat().st_size for name in module.FILES}
    environment['CI_TEST_ARCHIVE_MANIFEST_SHA256'] = produced['manifest-sha256']
    environment['CI_TEST_ARCHIVE_PRODUCER_ATTEMPT'] = produced['producer-attempt']
    (scratch / 'ci-test-archives/sekrets-st3').chmod(0o644)
    environment['GITHUB_RUN_ATTEMPT'] = '3'  # failed-only rerun inherits this exact attempt-2 producer
    subprocess.run([sys.executable, 'scripts/ci-test-archive', 'consume'], cwd=ROOT, env=environment, check=True, capture_output=True)
    assert os.access(scratch / 'ci-test-archives/sekrets-st3', os.X_OK)
    exported = dict(line.split('=', 1) for line in env_file.read_text().splitlines())
    assert exported['CI_TEST_WORKSPACE'] == str(ROOT) and exported['CI_TEST_BUILD_WORKSPACE'] == str(ROOT)
    assert exported['CI_TEST_HOOKS_BINARY'].endswith('/workspace/target/debug/ci-hooks-install')
    before = calls.read_text()
    environment['CI_TEST_ARCHIVE_MANIFEST_SHA256'] = '0' * 64
    failed = subprocess.run([sys.executable, 'scripts/ci-test-archive', 'consume'], cwd=ROOT, env=environment, capture_output=True)
    assert failed.returncode != 0 and 'manifest differs' in failed.stderr.decode()
    commands_after = calls.read_text()[len(before):]
    assert 'archive' not in commands_after and 'list' not in commands_after, 'reject before extracting or rebuilding'
print('Archive entry-point controls passed: original selected targets in one archive, exact manifest, extraction/env export, tamper rejection before extraction; fake nextest only')

# A completed, hash-bound ZIP is published atomically; transport/CRC/setup failures
# cannot become successful test inputs. All fixtures here are tiny text files.
import hashlib
import io
import stat
import unittest
from unittest.mock import patch
import zipfile


class DownloadControls(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        self.destination = self.root / 'ci-test-archives'
        self.files = {name: name.encode() for name in module.FILES}
        self.manifest = json.dumps({'files': {name: hashlib.sha256(data).hexdigest()
                                             for name, data in self.files.items()}}).encode()
        self.manifest_hash = hashlib.sha256(self.manifest).hexdigest()
        self.zip_bytes = self.make_zip()
        self.environment = dict(GITHUB_REPOSITORY='owner/repo', GITHUB_RUN_ID='123',
                                GITHUB_RUN_ATTEMPT='2', GITHUB_SHA='a' * 40,
                                CI_TEST_ARCHIVE_ARTIFACT_ID='456',
                                CI_TEST_ARCHIVE_PRODUCER_ATTEMPT='1',
                                CI_TEST_ARCHIVE_MANIFEST_SHA256=self.manifest_hash,
                                GH_TOKEN='test-token-never-in-argv')
        self.metadata = dict(id=456, expired=False, name='linux-test-archives-1',
                             size_in_bytes=len(self.zip_bytes),
                             digest='sha256:' + hashlib.sha256(self.zip_bytes).hexdigest(),
                             workflow_run=dict(id=123, head_sha='a' * 40))
        self.calls = []

    def make_zip(self, extra=None, duplicate=False, symlink=False):
        stream = io.BytesIO()
        with zipfile.ZipFile(stream, 'w', compression=zipfile.ZIP_STORED) as archive:
            archive.writestr('manifest.json', self.manifest)
            for name, data in self.files.items():
                if symlink and name == module.FILES[0]:
                    info = zipfile.ZipInfo(name)
                    info.external_attr = (stat.S_IFLNK | 0o777) << 16
                    archive.writestr(info, data)
                else:
                    archive.writestr(name, data)
            if extra:
                archive.writestr(extra, b'unexpected')
            if duplicate:
                archive.writestr('manifest.json', self.manifest)
        return stream.getvalue()

    def extract(self, data=None, expected_hash=None, manifest_hash=None):
        blob = self.root / 'artifact.zip'
        data = self.zip_bytes if data is None else data
        blob.write_bytes(data)
        module.extract_verified_zip(blob, self.destination, len(data),
                                    expected_hash or hashlib.sha256(data).hexdigest(),
                                    manifest_hash or self.manifest_hash)

    def fake_gh(self, blobs, codes=None, timeout=False):
        codes = [] if codes is None else codes.copy()
        blobs = list(blobs)
        def run(argv, **kwargs):
            self.calls.append(argv)
            self.assertNotIn(self.environment['GH_TOKEN'], ' '.join(argv))
            self.assertEqual(argv[:2], ['gh', 'api'])
            return subprocess.CompletedProcess(argv, 0, stdout=json.dumps(self.metadata).encode())
        def transfer(endpoint, archive, size, metrics, limit):
            self.calls.append(['transport', endpoint + '/zip'])
            metrics.update(bytes_received=0, response_status=200)
            if timeout:
                raise module.TransferError('transfer deadline exceeded')
            blob = blobs.pop(0) if blobs else self.zip_bytes
            archive.write_bytes(blob)
            metrics['bytes_received'] = len(blob)
            code = codes.pop(0) if codes else 0
            if code >= 128 or code < 0:
                raise SystemExit(code if code >= 0 else 128 - code)
            if code:
                raise module.TransferError('artifact transport failed')
        run.transfer = transfer
        return run

    def download(self, fake):
        with patch.dict(os.environ, self.environment, clear=True), patch.object(module.subprocess, 'run', fake), patch.object(module, 'transfer_zip', fake.transfer):
            module.download(self.destination)

    def test_authenticated_size_mismatch_rejected_before_extract(self):
        value = json.loads(self.manifest)
        value['byte_sizes'] = {name: len(data) for name, data in self.files.items()}
        value['byte_sizes'][module.FILES[0]] += 1
        self.manifest = json.dumps(value).encode()
        data = self.make_zip()
        with self.assertRaisesRegex(ValueError, 'byte-size inventory mismatch'):
            self.extract(data, manifest_hash=hashlib.sha256(self.manifest).hexdigest())
        self.assertFalse(self.destination.exists())

    def test_verified_zip_component_lengths_reported(self):
        import contextlib
        value = json.loads(self.manifest)
        value['byte_sizes'] = {name: len(data) for name, data in self.files.items()}
        self.manifest = json.dumps(value).encode()
        data = self.make_zip()
        out = io.StringIO()
        with patch.dict(os.environ, {}, clear=True), contextlib.redirect_stdout(out):
            self.extract(data, manifest_hash=hashlib.sha256(self.manifest).hexdigest())
        rows = json.loads(out.getvalue().split(': ', 1)[1])
        self.assertEqual({row['name'] for row in rows}, {*module.FILES, 'manifest.json'})
        for row in rows:
            self.assertEqual(row['payload_bytes'], row['stored_bytes'])
            if row['name'] in self.files:
                self.assertEqual(row['payload_bytes'], len(self.files[row['name']]))

    def test_complete_zip_and_producer_hashes(self):
        self.download(self.fake_gh([self.zip_bytes]))
        self.assertEqual(len(self.calls), 2)
        for name, data in self.files.items():
            self.assertEqual((self.destination / name).read_bytes(), data)
        self.assertFalse(list(self.root.glob('ci-test-transfer-*')))

    def test_truncated_transfer_recovers_before_any_consumer(self):
        self.download(self.fake_gh([self.zip_bytes[:80], self.zip_bytes]))
        self.assertEqual(len(self.calls), 3)
        self.assertTrue((self.destination / 'manifest.json').is_file())
        self.assertFalse(list(self.root.glob('ci-test-transfer-*')))

    def test_two_incomplete_transfers_fail_without_publishing(self):
        with self.assertRaises(RuntimeError):
            self.download(self.fake_gh([b'partial', b'partial']))
        self.assertEqual(len(self.calls), 3)
        self.assertFalse(self.destination.exists())
        self.assertFalse(list(self.root.glob('ci-test-transfer-*')))

    def test_cli_nonzero_then_complete_transfer(self):
        self.download(self.fake_gh([b'partial', self.zip_bytes], codes=[7, 0]))
        self.assertEqual(len(self.calls), 3)

    def test_timeout_is_bounded_and_partial_removed(self):
        with self.assertRaises(RuntimeError):
            self.download(self.fake_gh([], timeout=True))
        self.assertEqual(len(self.calls), 3)
        self.assertFalse(self.destination.exists())
        self.assertFalse(list(self.root.glob('ci-test-transfer-*')))

    def test_interruption_never_retries(self):
        for status in [143, 137, -15]:
            self.calls.clear()
            with self.assertRaises(SystemExit) as raised:
                self.download(self.fake_gh([b'partial'], codes=[status]))
            self.assertEqual(raised.exception.code, status if status > 0 else 143)
            self.assertEqual(len(self.calls), 2)
            self.assertFalse(self.destination.exists())

    def test_stale_destination_is_refused_without_gh(self):
        self.destination.mkdir()
        with self.assertRaises(ValueError):
            self.download(self.fake_gh([]))
        self.assertEqual(self.calls, [])

    def test_metadata_mismatch_refuses_download(self):
        variants = [dict(id=999), dict(name='linux-test-archives-2'), dict(expired=True),
                    dict(size_in_bytes=0), dict(digest=None),
                    dict(workflow_run=dict(id=999, head_sha='a' * 40))]
        for variant in variants:
            with self.subTest(variant=variant), self.assertRaises((ValueError, TypeError)):
                module.artifact_metadata({**self.metadata, **variant}, '456', self.environment)

    def test_pr_author_head_does_not_masquerade_as_tested_merge(self):
        # GitHub run metadata exposes the author SHA; downstream producer manifest
        # still verifies the effective merge SHA using the unchanged consume path.
        size, digest = module.artifact_metadata(
            {**self.metadata, 'workflow_run': dict(id=123, head_sha='b' * 40)},
            '456', self.environment)
        self.assertEqual(size, len(self.zip_bytes))
        self.assertEqual(digest, self.metadata['digest'].split(':')[1])

    def test_malformed_or_future_attempt_refuses_metadata(self):
        for attempt in ['0', '3', 'x']:
            with self.assertRaises(ValueError):
                module.artifact_metadata(self.metadata, '456',
                                         {**self.environment, 'CI_TEST_ARCHIVE_PRODUCER_ATTEMPT': attempt})

    def test_zip_digest_and_manifest_output_are_mandatory(self):
        for kwargs in [dict(expected_hash='0' * 64), dict(manifest_hash='0' * 64)]:
            with self.assertRaises(ValueError):
                self.extract(**kwargs)
            self.assertFalse(self.destination.exists())

    def test_entry_set_and_type(self):
        for data in [self.make_zip(extra='../escape'), self.make_zip(duplicate=True),
                     self.make_zip(symlink=True)]:
            with self.assertRaises(ValueError):
                self.extract(data)
            self.assertFalse(self.destination.exists())

    def test_correct_zip_hash_does_not_override_producer_file_hash(self):
        self.files[module.FILES[0]] = b'wrong producer file'
        with self.assertRaises(ValueError):
            self.extract(self.make_zip())

    def test_crc_failure_refuses_even_with_whole_zip_digest(self):
        data = bytearray(self.zip_bytes)
        position = data.index(self.files[module.FILES[0]])
        data[position] ^= 1
        with self.assertRaises(zipfile.BadZipFile):
            self.extract(bytes(data))


class StreamingControls(unittest.TestCase):
    setUp = DownloadControls.setUp
    make_zip = DownloadControls.make_zip
    fake_gh = DownloadControls.fake_gh
    download = DownloadControls.download
    # These controls exercise the real streaming/range validator; no network call.
    def response(self, data, status=200, headers=None, fail_after=None):
        class Response:
            def __init__(self):
                self.status = status
                self.headers = headers or {'Content-Length': str(len(data))}
                self.offset = 0
            def __enter__(self): return self
            def __exit__(self, *args): pass
            def close(self): pass
            def read1(self, size):
                if fail_after is not None and self.offset >= fail_after:
                    raise TimeoutError('signed-secret-URL-must-not-print')
                end = min(len(data), self.offset + (fail_after or size))
                chunk, self.offset = data[self.offset:end], end
                return chunk
        return Response()

    def stream(self, response, partial=b'', expected=None, timeout=1):
        blob = self.root / 'partial.zip'
        blob.write_bytes(partial)
        metrics = {}
        requests = []
        class Opener:
            def open(self, request, **kwargs):
                requests.append(request)
                return response
        with patch.object(module, 'signed_artifact_url', return_value='https://storage.invalid/?signed-secret'), patch.object(module.urllib.request, 'build_opener', return_value=Opener()):
            try:
                module.transfer_zip('repos/owner/repo/actions/artifacts/456', blob,
                                    len(self.zip_bytes) if expected is None else expected,
                                    metrics, timeout)
            finally:
                self.last_metrics, self.requests = metrics, requests
        return blob

    def test_interrupted_bytes_resume_with_exact_range(self):
        first = self.response(self.zip_bytes, fail_after=80)
        with self.assertRaises(module.TransferError) as raised:
            self.stream(first)
        self.assertNotIn('signed-secret', str(raised.exception))
        blob = self.root / 'partial.zip'
        self.assertEqual(blob.read_bytes(), self.zip_bytes[:80])
        remaining = self.zip_bytes[80:]
        self.stream(self.response(remaining, 206, {'Content-Range': 'bytes 80-%d/%d' % (len(self.zip_bytes)-1, len(self.zip_bytes)), 'Content-Length': str(len(remaining))}), partial=blob.read_bytes())
        self.assertEqual(blob.read_bytes(), self.zip_bytes)
        self.assertEqual(self.requests[0].get_header('Range'), 'bytes=80-')
        self.assertIsNone(self.requests[0].get_header('Authorization'))
        self.assertEqual(self.last_metrics['bytes_received'], len(remaining))
        self.assertEqual(self.last_metrics['offset_requested'], 80)

    def test_real_resume_publishes_only_after_complete_verification(self):
        first = self.response(self.zip_bytes, fail_after=80)
        remaining = self.zip_bytes[80:]
        responses = [first, self.response(remaining, 206, {
            'Content-Range': 'bytes 80-%d/%d' % (len(self.zip_bytes)-1, len(self.zip_bytes)),
            'Content-Length': str(len(remaining))})]
        requests = []
        class Opener:
            def open(inner, request, **kwargs):
                requests.append(request)
                return responses.pop(0)
        metadata = self.fake_gh([])
        from contextlib import redirect_stdout
        log = io.StringIO()
        with patch.dict(os.environ, self.environment, clear=True), patch.object(module.subprocess, 'run', metadata), patch.object(module, 'signed_artifact_url', return_value='https://storage.invalid/?signed-secret'), patch.object(module.urllib.request, 'build_opener', return_value=Opener()), redirect_stdout(log):
            module.download(self.destination)
        self.assertEqual([r.get_header('Range') for r in requests], ['bytes=0-', 'bytes=80-'])
        for name, data in self.files.items():
            self.assertEqual((self.destination/name).read_bytes(), data)
        self.assertIn('received=80', log.getvalue())
        self.assertNotIn('signed-secret', log.getvalue())
        self.assertFalse(list(self.root.glob('ci-test-transfer-*')))

    def test_full_200_replaces_partial(self):
        blob = self.stream(self.response(self.zip_bytes), partial=b'old prefix')
        self.assertEqual(blob.read_bytes(), self.zip_bytes)

    def test_malformed_wrong_offset_or_changed_total_refused_before_append(self):
        size = len(self.zip_bytes)
        for value in ['', 'bytes 0-%d/%d' % (size-1, size),
                      'bytes 80-%d/%d' % (size-1, size+1), 'bytes 80-90/*']:
            with self.subTest(value=value), self.assertRaises(module.TransferError) as raised:
                self.stream(self.response(b'bad', 206, {'Content-Range': value}), partial=b'x'*80)
            self.assertTrue(raised.exception.discard)
            self.assertEqual((self.root / 'partial.zip').read_bytes(), b'x'*80)

    def test_body_cannot_exceed_authenticated_size(self):
        with self.assertRaises(module.TransferError) as raised:
            self.stream(self.response(b'x'*20, headers={'Content-Length': '10'}), expected=10)
        self.assertTrue(raised.exception.discard)

    def test_wrong_length_or_encoded_body_refused(self):
        for headers in [{'Content-Length': '999'}, {'Content-Encoding': 'gzip'}]:
            with self.subTest(headers=headers), self.assertRaises(module.TransferError) as raised:
                self.stream(self.response(self.zip_bytes, headers=headers))
            self.assertTrue(raised.exception.discard)

    def test_short_body_retains_only_private_prefix(self):
        with self.assertRaises(module.TransferError) as raised:
            self.stream(self.response(self.zip_bytes[:80], headers={
                'Content-Length': str(len(self.zip_bytes))}))
        self.assertFalse(raised.exception.discard)
        self.assertEqual((self.root / 'partial.zip').read_bytes(), self.zip_bytes[:80])

    def test_deadline_covers_blocking_read(self):
        import time
        response = self.response(self.zip_bytes)
        response.read1 = lambda size: time.sleep(1)
        with self.assertRaises(module.TransferError) as raised:
            self.stream(response, timeout=0.01)
        self.assertIn('deadline', str(raised.exception))

    def test_complete_partial_is_verified_without_http(self):
        blob = self.stream(self.response(b'never read'), partial=self.zip_bytes)
        self.assertEqual(blob.read_bytes(), self.zip_bytes)
        self.assertEqual(self.requests, [])

    def test_resumed_corruption_cannot_publish(self):
        fake = self.fake_gh([])
        calls = []
        def transfer(endpoint, archive, size, metrics, timeout):
            calls.append(timeout)
            if len(calls) == 1:
                archive.write_bytes(b'bad prefix')
                raise module.TransferError('interrupted')
            archive.write_bytes(b'bad prefix' + self.zip_bytes[len(b'bad prefix'):])
        fake.transfer = transfer
        with self.assertRaises(RuntimeError): self.download(fake)
        self.assertEqual(len(calls), 2)
        self.assertFalse(self.destination.exists())
        self.assertFalse(list(self.root.glob('ci-test-transfer-*')))

    def test_resume_and_progress_use_same_overall_budget(self):
        from contextlib import redirect_stdout
        fake = self.fake_gh([]); clock = [0]; limits = []
        def transfer(endpoint, archive, size, metrics, timeout):
            limits.append(timeout)
            if len(limits) == 1:
                archive.write_bytes(self.zip_bytes[:80]); metrics['bytes_received'] = 80
                clock[0] = 600
                raise module.TransferError('interrupted')
            self.assertEqual(archive.read_bytes(), self.zip_bytes[:80])
            archive.write_bytes(self.zip_bytes); metrics['bytes_received'] = len(self.zip_bytes)-80
        fake.transfer = transfer
        log = io.StringIO()
        with patch.object(module.time, 'monotonic', side_effect=lambda: clock[0]), redirect_stdout(log):
            self.download(fake)
        self.assertEqual(limits, [600, 600])
        self.assertIn('offset=80', log.getvalue())
        self.assertIn('received=80', log.getvalue())
        self.assertIn('expected=%d' % len(self.zip_bytes), log.getvalue())
        self.assertNotIn('test-token', log.getvalue())

    def test_overall_budget_is_not_reset_for_second_attempt(self):
        fake = self.fake_gh([]); clock = [0]; limits = []
        def transfer(endpoint, archive, size, metrics, timeout):
            limits.append(timeout)
            if len(limits) == 1:
                clock[0] = 650  # transfer plus verification/diagnostic overhead
                archive.write_bytes(self.zip_bytes[:80])
                raise module.TransferError('interrupted')
            archive.write_bytes(self.zip_bytes)
        fake.transfer = transfer
        with patch.object(module.time, 'monotonic', side_effect=lambda: clock[0]):
            self.download(fake)
        self.assertEqual(limits, [600, 550])

    def test_exhausted_budget_makes_no_second_transfer(self):
        fake = self.fake_gh([]); clock = [0]; calls = []
        def transfer(endpoint, archive, size, metrics, timeout):
            calls.append(timeout); clock[0] = 1200
            raise module.TransferError('interrupted')
        fake.transfer = transfer
        with patch.object(module.time, 'monotonic', side_effect=lambda: clock[0]), self.assertRaises(RuntimeError):
            self.download(fake)
        self.assertEqual(calls, [600])
        self.assertFalse(self.destination.exists())

    def test_redirect_token_is_not_forwarded(self):
        import urllib.error
        captured = []
        class Opener:
            def open(inner, request, **kwargs):
                captured.append(request)
                raise urllib.error.HTTPError(request.full_url, 302, 'redirect',
                    {'Location': 'https://storage.invalid/?signed-secret'}, None)
        with patch.dict(os.environ, self.environment, clear=True), patch.object(module.urllib.request, 'build_opener', return_value=Opener()):
            url = module.signed_artifact_url('repos/owner/repo/actions/artifacts/456', 1)
        self.assertEqual(url, 'https://storage.invalid/?signed-secret')
        self.assertEqual(captured[0].get_header('Authorization'), 'Bearer test-token-never-in-argv')
        self.assertEqual(captured[0].host, 'api.github.com')
        handler = module.NoRedirect()
        self.assertIsNone(handler.redirect_request(None, None, 302, '', {}, url))

    def test_invalid_redirect_refused_and_http_error_is_redacted(self):
        import urllib.error
        for status, location in [(302, 'http://storage.invalid/secret'), (403, 'signed-secret')]:
            class Opener:
                def open(inner, request, **kwargs):
                    raise urllib.error.HTTPError('https://signed-secret', status, 'secret body',
                        {'Location': location}, None)
            with patch.dict(os.environ, self.environment, clear=True), patch.object(module.urllib.request, 'build_opener', return_value=Opener()), self.assertRaises(module.TransferError) as raised:
                module.signed_artifact_url('repos/owner/repo/actions/artifacts/456', 1)
            self.assertNotIn('signed-secret', str(raised.exception))


class SizeInventoryControls(unittest.TestCase):
    def test_legacy_manifest_without_sizes_stays_valid(self):
        module.validate_byte_sizes({'version': 2}, {name: 1 for name in module.FILES})

    def test_wrong_size_type_keys_or_value_refused(self):
        actual = {name: 11 for name in module.FILES}
        module.validate_byte_sizes({'byte_sizes': actual}, actual)
        for sizes in [None, {}, {**actual, 'extra': 1}, {**actual, module.FILES[0]: True},
                      {**actual, module.FILES[0]: -1}, {**actual, module.FILES[0]: 10}]:
            with self.subTest(sizes=sizes), self.assertRaises(ValueError):
                module.validate_byte_sizes({'byte_sizes': sizes}, actual)

    def test_size_inventory_cannot_replace_mandatory_digests(self):
        with tempfile.TemporaryDirectory() as d:
            root = Path(d)
            for name in module.FILES: (root / name).write_bytes(b'fixture')
            current = {'attempt': '1'}
            manifest = dict(version=2, standalone_model=True, identity=current, workspace='/producer',
                            files={name: '0' * 64 for name in module.FILES},
                            byte_sizes={name: 7 for name in module.FILES})
            with self.assertRaisesRegex(ValueError, 'digest mismatch'):
                module.verify(manifest, current, root, '1')

    def test_report_uses_metadata_without_reading_payload(self):
        import contextlib, io
        from types import SimpleNamespace
        entries = [SimpleNamespace(filename=name, file_size=100, compress_size=80) for name in (*module.FILES, 'manifest.json')]
        out = io.StringIO()
        with patch.dict(os.environ, {}, clear=True), patch.object(Path, 'open', side_effect=AssertionError('payload read')), contextlib.redirect_stdout(out):
            module.report_sizes({name: 100 for name in module.FILES}, zip_entries=entries)
        rows = json.loads(out.getvalue().split(': ', 1)[1])
        self.assertEqual(len(rows), 4)
        self.assertEqual(sum(row['stored_bytes'] for row in rows), 320)

    def test_report_summary_failure_is_optional(self):
        import contextlib, io
        with patch.dict(os.environ, {'GITHUB_STEP_SUMMARY': '/fixture/unwritable'}), patch('builtins.open', side_effect=OSError('fixture')):
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                module.report_sizes({name: 1 for name in module.FILES})


suite = unittest.TestSuite([
    unittest.defaultTestLoader.loadTestsFromTestCase(DownloadControls),
    unittest.defaultTestLoader.loadTestsFromTestCase(StreamingControls),
    unittest.defaultTestLoader.loadTestsFromTestCase(SizeInventoryControls),
])
result = unittest.TextTestRunner(verbosity=2).run(suite)
if not result.wasSuccessful():
    sys.exit(1)
