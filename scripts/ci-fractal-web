#!/usr/bin/env bash
# The fractal-web execution lanes, run inside `nix develop .#web`. Each lane is timed into the
# job summary. Packages that join the workspace add their lanes here.
set -euo pipefail
cd "$(dirname "$0")/.."

summary=${GITHUB_STEP_SUMMARY:-/dev/null}
printf '| Lane | Elapsed |\n| --- | --- |\n' >> "$summary"
lane() {
  local name=$1 start=$SECONDS
  shift
  echo "::group::$name"
  "$@"
  echo "::endgroup::"
  printf '| %s | %ss |\n' "$name" "$((SECONDS - start))" >> "$summary"
}

toolchain() {
  [ "$(pnpm --version)" = 12.7.0 ] || { echo "pnpm $(pnpm --version) is not 12.7.0" >&2; return 1; }
  [ "$(node --version)" = v24.20.0 ] || { echo "Node $(node --version) is not 24.20.0" >&2; return 1; }
  grep -q '"packageManager": "pnpm@12.7.0"' package.json || { echo 'package.json must declare pnpm@12.7.0' >&2; return 1; }
  # The checked-in Buck root is the Nix-rendered consumer root below Genie's three-line header.
  [ -n "${FRACTAL_WEB_BUCK_ROOT:-}" ] || { echo 'run inside nix develop .#web' >&2; return 1; }
  [ ! -s .buckroot ] || { echo '.buckroot must be empty' >&2; return 1; }
  local file expected
  for file in .buckconfig BUCK buck2/toolchains/BUCK; do
    expected="$FRACTAL_WEB_BUCK_ROOT/$file"
    if ! tail -n +4 "$file" | head -c "$(wc -c < "$expected")" | cmp -s - "$expected"; then
      echo "$file no longer starts with the mkConsumerBuckRoot rendering; regenerate buck2/root.ts from $expected" >&2
      return 1
    fi
  done
  pnpm --version && node --version && buck2 --version
}

production_build() (
  local out_dir
  out_dir=$(mktemp -d "${TMPDIR:-/tmp}/fractal-web-build.XXXXXX")
  trap 'rm -rf "$out_dir"' EXIT
  pnpm --dir apps/fractal-web exec vite build --config vite.config.ts --configLoader runner --outDir "$out_dir"
)

lane "Toolchain and Buck root" toolchain
lane "Frozen install" pnpm install --frozen-lockfile
lane "Dependency licenses" python3 scripts/ci-fractal-web-licenses --check
lane "Buck typecheck" buck2 build //:typecheck
lane "Scenario typecheck" pnpm --filter @smalltalk/st3-scenarios typecheck
lane "Scenario tests" pnpm --filter @smalltalk/st3-scenarios test
lane "Scenario freshness" pnpm --filter @smalltalk/st3-scenarios emit:check
lane "Scenario decode" pnpm --filter @smalltalk/st3-scenarios decode
lane "Scenario privacy" pnpm --filter @smalltalk/st3-scenarios scan
lane "Measurement contracts" node --experimental-strip-types --test apps/fractal-web/src/telemetry/measurement/measurement.node-test.ts
lane "Measurement bundle exclusion" bun apps/fractal-web/src/telemetry/measurement/check-bundles.mjs
lane "Synthetic fixtures" bash apps/fractal-web/scripts/ci/fixtures-gate.sh
lane "Extension registry" node --experimental-strip-types --test apps/fractal-web/src/extensions/registry.unit.test.ts
lane "Folders core" node --test apps/fractal-web/src/folders/core.node-test.mjs
lane "App typecheck" pnpm --filter fractal-web typecheck
lane "App production build" production_build
lane "App unit tests" pnpm --filter fractal-web test
lane "SDK unit tests" pnpm --dir apps/fractal-web/packages/st3-sdk exec vitest run --config vitest.config.ts
lane "SDK frame CPU budgets" pnpm --dir apps/fractal-web/packages/st3-sdk exec vitest run --config vitest.perf.config.ts
lane "UI kit typecheck" pnpm --filter @smalltalk/fractal-ui typecheck
lane "Composed Fractal Storybooks" bash scripts/ci-fractal-web-storybooks
