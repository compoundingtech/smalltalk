#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  printf '%s\n' 'Usage: scripts/omp-parity-e2e/run --st3 BINARY --stui BINARY --out DIRECTORY [--corpus OMP.jsonl] [--keep]'
}
ST3='' STUI='' OUT='' CORPUS='' KEEP=0
while (($#)); do
  case "$1" in
    --st3|--stui|--out|--corpus)
      (($# >= 2)) || { usage >&2; exit 2; }
      case "$1" in
        --st3) ST3=$2;; --stui) STUI=$2;; --out) OUT=$2;; --corpus) CORPUS=$2;;
      esac
      shift 2;;
    --keep) KEEP=1; shift;;
    --help|-h) usage; exit 0;;
    *) usage >&2; exit 2;;
  esac
done
[[ -n "$ST3" && -n "$STUI" && -n "$OUT" ]] || { usage >&2; exit 2; }
mkdir -p -- "$OUT"
OUT=$(realpath "$OUT")
REPORT="$OUT/report.txt"
: > "$REPORT"
FAILURES=0
check() {
  local label=$1; shift
  if "$@"; then
    printf 'PASS %s\n' "$label" | tee -a "$REPORT"
  else
    printf 'FAIL %s\n' "$label" | tee -a "$REPORT" >&2
    FAILURES=$((FAILURES + 1))
  fi
}
require() {
  local before=$FAILURES
  check "$@"
  ((FAILURES == before)) || exit 1
}
# Unexpected failures are checks too, never an apparently successful partial report.
on_error() {
  local status=$?
  printf 'FAIL runner command at line %s (exit %s)\n' "$1" "$status" | tee -a "$REPORT" >&2
  exit "$status"
}
trap 'on_error "$LINENO"' ERR
has_command() { command -v "$1" >/dev/null; }
for dependency in curl jq node tmux realpath mktemp; do
  require "dependency $dependency" has_command "$dependency"
done
ST3=$(realpath "$ST3")
STUI=$(realpath "$STUI")
[[ -z "$CORPUS" ]] || CORPUS=$(realpath "$CORPUS")
require 'st3 executable' test -x "$ST3"
require 'stui executable' test -x "$STUI"
ROOT=$(realpath "$(dirname "${BASH_SOURCE[0]}")/../..")
FIXTURE="$ROOT/crates/st3/fixtures/native-records/omp-parity.jsonl"
CHILD_FIXTURE="$ROOT/crates/st3/fixtures/native-records/omp-parity-child.jsonl"
require 'parent fixture readable' test -r "$FIXTURE"
require 'child fixture readable' test -r "$CHILD_FIXTURE"
ISO=$(mktemp -d "${TMPDIR:-/tmp}/omp-parity-e2e.XXXXXX")
CORPUS_UUID=''
DAEMON='' TMUX_STARTED=0
# Use the agent automation socket root, not an ambient/user tmux server.
TMUX_SOCKET="${TMPDIR:-/tmp}/agent-tmux-sockets/omp-e2e-${ISO##*.}.sock"
TARGET='omp-e2e:stui.0'
cleanup() {
  local status=$?
  trap - ERR EXIT
  if ((TMUX_STARTED)); then
    tmux -S "$TMUX_SOCKET" kill-server >/dev/null 2>&1 || true
  fi
  if [[ -n "$DAEMON" ]]; then
    kill -TERM "$DAEMON" 2>/dev/null || true
    wait "$DAEMON" 2>/dev/null || true
  fi
  if ((KEEP)); then
    printf 'INFO retained isolation %s (may contain private corpus)\n' "$ISO" >> "$REPORT"
  else
    rm -rf -- "$ISO"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
export HOME="$ISO/home" XDG_RUNTIME_DIR="$ISO/run" XDG_STATE_HOME="$ISO/state" XDG_CONFIG_HOME="$ISO/config" XDG_CACHE_HOME="$ISO/cache"
unset ST_AGENT ST3_PERSON ST3_ENDPOINT
mkdir -p "$HOME" "$XDG_RUNTIME_DIR" "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "${TMUX_SOCKET%/*}"
SOCKET="$ISO/run/st3.sock"
CLIENT_SOCKET="$ISO/run/st3-client.sock"
PROJECT="$HOME/e2e-project"
mkdir -p "$PROJECT" "$HOME/.omp/agent/sessions/e2e-project"
UUID=$(node -e 'console.log(require("node:crypto").randomUUID())')
PARENT="$HOME/.omp/agent/sessions/e2e-project/$UUID.jsonl"
mkdir -p "${PARENT%.jsonl}"
# Preserve native record ids. Only the discovery header gets this run's identity/cwd.
# Older padding ensures limit=200 has a genuine second page without pushing typed
# coverage out of the newest page. The oversized output guarantees a content ref.
jq -cs --arg id "$UUID" --arg cwd "$PROJECT" '
  ([.[] | select(.type == "session")][0] // {type:"session",timestamp:"2026-10-06T00:00:00Z"})
    + {id:$id,cwd:$cwd,title:"OMPParityE2E"},
  (range(0;220) | {type:"message",id:("e2e-padding-" + tostring),timestamp:"2026-10-05T00:00:00Z",
    message:{role:"assistant",content:[{type:"text",text:("E2E-PADDING-" + tostring)}]}}),
  (.[] | select(.type != "session") |
    if .id == "result-12" then .message.content = [{type:"text",text:("E2E-REF-PAYLOAD:" + ("x" * 20000))}] else . end)
' "$FIXTURE" > "$PARENT"
cp -- "$CHILD_FIXTURE" "${PARENT%.jsonl}/ParityChild.jsonl"
# A compact recent showcase puts bash and the child card together in stui's viewport.
jq -cn '{type:"message",id:"e2e-showcase-call",timestamp:"2026-10-06T00:00:09Z",message:{role:"assistant",content:[
  {type:"toolCall",id:"e2e-showcase-bash",name:"bash",arguments:{command:"printf E2E-BASH-ROW",i:"Showing parity bash",cwd:"/synthetic/e2e",timeout:30,async:false}},
  {type:"toolCall",id:"e2e-showcase-task",name:"task",arguments:{context:"E2E-PARENT-CONTEXT\nContract: E2E-PARENT-CONTRACT",tasks:[{name:"ParityChild",agent:"scout",task:"Inspect synthetic parity\nE2E-FULL-ASSIGNMENT"}]}}
]}}' >> "$PARENT"
jq -cn '{type:"message",id:"e2e-showcase-bash-result",timestamp:"2026-10-06T00:00:10Z",message:{role:"toolResult",toolCallId:"e2e-showcase-bash",toolName:"bash",content:[{type:"text",text:"E2E-BASH-ROW"}],details:{exitCode:0,wallTimeMs:1},isError:false}}' >> "$PARENT"
jq -cn '{type:"message",id:"e2e-showcase-task-result",timestamp:"2026-10-06T00:00:11Z",message:{role:"toolResult",toolCallId:"e2e-showcase-task",toolName:"task",content:[{type:"text",text:"Synthetic child"}],details:{async:{state:"running",jobId:"e2e-task",type:"task"},progress:[{id:"ParityChild",agent:"scout",status:"running",task:"Inspect synthetic parity",assignment:"Inspect synthetic parity\nE2E-FULL-ASSIGNMENT",durationMs:10,tokens:20,cost:0.001,requests:1,toolCount:1}],results:[]},isError:false}}' >> "$PARENT"
if [[ -n "$CORPUS" ]]; then
  check 'corpus readable' test -r "$CORPUS"
  CORPUS_UUID=$(node -e 'console.log(require("node:crypto").randomUUID())')
  mkdir -p "$HOME/.omp/agent/sessions/corpus-project" "$HOME/corpus-project"
  CORPUS_COPY="$HOME/.omp/agent/sessions/corpus-project/$CORPUS_UUID.jsonl"
  # Read-only original; private copies and responses stay inside ISO.
  jq -cs --arg id "$CORPUS_UUID" --arg cwd "$HOME/corpus-project" '
    ([.[] | select(.type == "session")][0] // {type:"session"}) + {id:$id,cwd:$cwd},
    (.[] | select(.type != "session"))
  ' "$CORPUS" > "$CORPUS_COPY"
fi
"$ST3" up --node omp-parity-e2e --state-dir "$ISO/state/st3" --socket "$SOCKET" --client-gateway-socket "$CLIENT_SOCKET" > "$ISO/daemon.log" 2>&1 &
DAEMON=$!
TIMEOUT=${OMP_E2E_TIMEOUT:-45}
[[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || require 'positive OMP_E2E_TIMEOUT' false
wait_doctor() {
  local deadline=$((SECONDS + TIMEOUT))
  until "$ST3" --endpoint "$SOCKET" doctor >/dev/null 2>&1; do
    kill -0 "$DAEMON" 2>/dev/null || return 1
    ((SECONDS < deadline)) || return 1
    sleep 0.1
  done
}
require 'isolated daemon ready (doctor)' wait_doctor
http() {
  curl --silent --show-error --fail --max-time "$TIMEOUT" --unix-socket "$SOCKET" \
    -H 'x-st3-person: person/omp-e2e' "$@"
}
negotiated() { http -H 'x-st3-features: conversation-blocks.v1' "$@"; }
uri() { jq -rn --arg value "$1" '$value | @uri'; }
wait_session() {
  local native=$1 destination=$2 deadline=$((SECONDS + TIMEOUT))
  while ((SECONDS < deadline)); do
    http 'http://localhost/v1/client/sessions?history=true&native_only=true&limit=200' > "$ISO/sessions.json" || return 1
    if jq -e --arg native "$native" '.value.items | any(.native_session_id == $native)' "$ISO/sessions.json" >/dev/null; then
      jq -r --arg native "$native" '.value.items[] | select(.native_session_id == $native) | .id' "$ISO/sessions.json" > "$destination"
      return 0
    fi
    sleep 0.1
  done
  return 1
}
require 'discover isolated OMP parent via historical native sessions' wait_session "$UUID" "$ISO/parent-id"
SESSION=$(<"$ISO/parent-id")
URL="http://localhost/v1/client/sessions/$(uri "$SESSION")/timeline"
require 'fetch negotiated parent page' negotiated "$URL?limit=200" -o "$OUT/page.json"
PAGE="$OUT/page.json"
assert_json() { jq -e "$@" >/dev/null; }
for type in bash edit write read search todo ask task hub eval generic; do
  check "tool_call view.type=$type" assert_json --arg type "$type" '.value.items | any(.[] | .body.blocks[]?; .kind == "tool_call" and .view.type == $type)' "$PAGE"
done
for type in bash edit search todo ask task hub generic; do
  check "tool_output view.type=$type" assert_json --arg type "$type" '.value.items | any(.[] | .body.blocks[]?; .kind == "tool_output" and .view.type == $type)' "$PAGE"
done
for type in irc job skill compaction model_change thinking_level title session_exit tool_start; do
  check "bookkeeping view.type=$type" assert_json --arg type "$type" '.value.items | any(.[] | .body.blocks[]?; .view.type == $type)' "$PAGE"
done
check 'irc block kind' assert_json '.value.items | any(.[] | .body.blocks[]?; .kind == "irc")' "$PAGE"
check 'tool starts are internal' assert_json '[.value.items[].body.blocks[]? | select(.view.type == "tool_start")] | length > 0 and all(.visibility == "internal")' "$PAGE"
for field in model context cost todos; do
  check "header $field has transcript provenance and value" assert_json --arg field "$field" '.value.header[$field] | .source == "transcript" and has("value") and (.as_of | type == "string")' "$PAGE"
done
check 'header model/context/cost/todos are populated' assert_json '.value.header | (.model.value | type == "string") and (.context.value.tokens > 0) and (.cost.value.usd > 0) and (.todos.value | length > 0)' "$PAGE"
check 'header todos preserve all five OMP statuses' assert_json '[.value.header.todos.value[].items[].status] | sort == (["completed", "pending", "in_progress", "blocked", "abandoned"] | sort)' "$PAGE"
check 'task output links ParityChild conversation' assert_json '.value.items | any(.[] | .body.blocks[]?; .kind == "tool_output" and .view.type == "task" and any(.view.agents[]?; .id == "ParityChild" and (.conversation.session_id | startswith("session/external-child-"))))' "$PAGE"
check 'task carries source name type and full assignment' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "task" and any(.view.agents[]?; .name == "ParityChild" and .agent == "scout" and (.task | contains("E2E-FULL-ASSIGNMENT"))))' "$PAGE"
check 'task carries parent context and contract' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "task" and (.view.context // "" | contains("E2E-PARENT-CONTEXT") and contains("E2E-PARENT-CONTRACT")))' "$PAGE"
check 'assistant error is explicit in API' assert_json '.value.items | any(.[] | .body.blocks[]?; .kind == "error" and .view.type == "assistant_error" and .view.message == "E2E-ASSISTANT-ERROR" and .view.status == "failed")' "$PAGE"
check 'assistant retry recovery preserves original error' assert_json '.value.items | any(.[] | .body.blocks[]?; .kind == "error" and .view.type == "assistant_error" and .view.status == "recovered" and .view.presentation == "compact-recovered" and .view.is_error == false and .view.label == "E2E-RETRIED-RECOVERED" and .view.message == "E2E-RECOVERED-ORIGINAL-ERROR")' "$PAGE"
check 'bash carries cwd and timeout' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "bash" and .view.cwd == "/synthetic/e2e" and .view.timeout_s == 30)' "$PAGE"
check 'grep carries explicit flags and native counts' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "search" and .view.engine == "grep" and .view.case == false and .view.gitignore == true and .view.skip == 2)' "$PAGE"
check 'grep carries native warning and truncation summary' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "search" and .view.engine == "grep" and .view.match_count == 7 and .view.file_count == 3 and .view.truncated == true and .view.file_limit_reached == 3 and .view.per_file_limit_reached == 2)' "$PAGE"
check 'glob carries flags limit and native file count' assert_json '(.value.items | any(.[] | .body.blocks[]?; .view.type == "search" and .view.engine == "glob" and .view.hidden == true and .view.gitignore == false and .view.limit == 10)) and (.value.items | any(.[] | .body.blocks[]?; .view.type == "search" and .view.engine == "glob" and .view.file_count == 1))' "$PAGE"
check 'hub carries sent message body' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "hub" and .view.op == "send" and (.view.message | contains("E2E-SENT-BODY") and contains("E2E-SENT-LAST")))' "$PAGE"
check 'write carries content and complete line count' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "write" and .view.line_count == 2 and (.view.content | contains("E2E-WRITE-FIRST") and contains("E2E-WRITE-LAST")))' "$PAGE"
check 'ask carries every alternative and description' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "ask" and any(.view.questions[]?; (.options | length) == 2 and .options[0].description == "E2E-ASK-STRICT-DESCRIPTION" and .options[1].description == "E2E-ASK-LOOSE-DESCRIPTION"))' "$PAGE"
check 'eval carries code language timeout and reset' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "eval" and .view.language == "py" and .view.timeout_s == 5 and .view.reset == false and (.view.code | contains("E2E-EVAL-CODE")))' "$PAGE"
check 'compaction carries complete synthetic summary' assert_json '.value.items | any(.[] | .body.blocks[]?; .view.type == "compaction" and (.view.summary // "" | contains("E2E-COMPACTION-FIRST") and contains("E2E-COMPACTION-LAST")))' "$PAGE"
check 'inline image has owner ref without inline pixels' assert_json '.value.items | any(.[] | .body.blocks[]?; .kind == "image" and .continuation.reason == "on-demand" and (.continuation.ref | type == "string") and .payload == {})' "$PAGE"
IMAGE_REF=$(jq -r '[.value.items[].body.blocks[]? | select(.kind == "image") | .continuation.ref][0]' "$PAGE")
check 'inline image content is readable for automatic clients' negotiated "http://localhost/v1/client/conversations/$(uri "${SESSION#session/}")/content/$(uri "$IMAGE_REF")/chunk?offset=0" -o "$OUT/image-chunk.json"
check 'automatic image fetch returns passive PNG bytes' assert_json '.value.media_type == "image/png" and .value.size > 0 and .value.next_offset == null' "$OUT/image-chunk.json"
check 'fetch legacy parent page' http "$URL?limit=200" -o "$OUT/legacy-page.json"
check 'unnegotiated page omits blocks and header' assert_json '(.value | has("header") | not) and all(.value.items[]; (.body | has("blocks") | not))' "$OUT/legacy-page.json"
CHILD=$(jq -r '[.value.items[].body.blocks[]? | select(.view.type == "task") | .view.agents[]? | select(.id == "ParityChild") | .conversation.session_id][0]' "$PAGE")
check 'fetch linked child timeline' negotiated "http://localhost/v1/client/sessions/$(uri "$CHILD")/timeline?limit=200" -o "$OUT/child-page.json"
check 'child contains all child records, not parent records' assert_json '
  [.value.items[].body.blocks[]? | select(.kind == "source_record") | .payload.raw | select(.type == "message") | .id] | unique | sort == (["child-assistant","child-call","child-result","child-complete"] | sort)
' "$OUT/child-page.json"
check 'child assistant and tool content' assert_json '[.value.items[].body | tostring] | join("\n") | contains("PARITY-CHILD-START") and contains("PARITY-CHILD-TOOL") and contains("PARITY-CHILD-COMPLETE")' "$OUT/child-page.json"
check 'first page has an older keyset cursor' assert_json '.value.page.has_more == true and (.value.page.next_cursor | type == "string")' "$PAGE"
CURSOR=$(jq -r '.value.page.next_cursor' "$PAGE")
check 'read baseline older page' negotiated --get "$URL" --data-urlencode "cursor=$CURSOR" --data-urlencode 'limit=200' -o "$OUT/baseline-page2.json"
walk_history() {
  local fetch=$1 first=$2 prefix=$3 manifest=$4 current=$2 count=1 cursor
  local request_url=${5:-$URL} max_pages=${6:-20} summary=${7:-}
  local files=("$first") file
  while assert_json '.value.page.has_more == true' "$current"; do
    ((count < max_pages)) || return 1
    cursor=$(jq -er '.value.page.next_cursor | select(type == "string")' "$current") || return 1
    count=$((count + 1))
    current="$prefix-page$count.json"
    "$fetch" --get "$request_url" --data-urlencode "cursor=$cursor" --data-urlencode 'limit=200' -o "$current" || return 1
    files+=("$current")
  done
  assert_json '.value.page.has_more == false' "$current" || return 1
  # Parse one bounded page at a time; only ids and counters are accumulated.
  : > "$manifest.ndjson"
  [[ -z "$summary" ]] || : > "$summary.ndjson"
  for file in "${files[@]}"; do
    jq -c '.value.items[].id' "$file" >> "$manifest.ndjson" || return 1
    if [[ -n "$summary" ]]; then
      jq -c '
        def counts: group_by(.) | map({key:.[0],value:length}) | from_entries;
        [.value.items[].body.blocks[]?] as $blocks |
        {
          entries:(.value.items | length),
          kinds:([$blocks[].kind] | counts),
          views:([$blocks[].view.type? | select(type == "string")] | counts),
          unknown_sources:([$blocks[] | select(.kind == "unknown") | .source_type // "<missing>"] | counts),
          tool_calls_without_view:([$blocks[] | select(.kind == "tool_call") |
            select(.view | if type == "object" then (.type | type) != "string" or .type == "" else true end)] | length)
        }
      ' "$file" >> "$summary.ndjson" || return 1
    fi
  done
  jq -s '.' "$manifest.ndjson" > "$manifest" || return 1
  if [[ -n "$summary" ]]; then
    jq -s '
      def merge_counts($left; $right):
        reduce ($right | to_entries[]) as $entry ($left; .[$entry.key] = ((.[$entry.key] // 0) + $entry.value));
      reduce .[] as $page ({entries:0,kinds:{},views:{},unknown_sources:{},tool_calls_without_view:0};
        .entries += $page.entries |
        .tool_calls_without_view += $page.tool_calls_without_view |
        .kinds = merge_counts(.kinds; $page.kinds) |
        .views = merge_counts(.views; $page.views) |
        .unknown_sources = merge_counts(.unknown_sources; $page.unknown_sources))
    ' "$summary.ndjson" > "$summary" || return 1
  fi
  return 0
}
check 'walk all negotiated baseline pages to exhaustion' walk_history negotiated "$PAGE" "$OUT/baseline-negotiated" "$OUT/baseline-ids.json"
check 'negotiated history walk has unique entry ids' assert_json 'length == (unique | length)' "$OUT/baseline-ids.json"
check 'walk all legacy baseline pages to exhaustion' walk_history http "$OUT/legacy-page.json" "$OUT/baseline-legacy" "$OUT/legacy-ids.json"
check 'legacy history walk has unique entry ids' assert_json 'length == (unique | length)' "$OUT/legacy-ids.json"
check 'negotiated full history ids equal legacy full history ids' jq -en --slurpfile modern "$OUT/baseline-ids.json" --slurpfile legacy "$OUT/legacy-ids.json" '($modern[0] | sort) == ($legacy[0] | sort)' >/dev/null
REF=$(jq -r '[.value.items[].body.blocks[]? | .continuation.ref? | select(type == "string")][0] // empty' "$PAGE")
check 'first page issued an oversized-content ref' test -n "$REF"
REF_URL="http://localhost/v1/client/conversations/$(uri "$SESSION")/content/$(uri "$REF")/chunk"
check 'read original content chunk' negotiated "$REF_URL" -o "$OUT/chunk-before.json"
append_assistant() {
  jq -cn '{type:"message",id:"e2e-appended-assistant",timestamp:"2026-10-06T00:00:12Z",message:{role:"assistant",content:[{type:"text",text:"E2E-APPEND-VISIBLE"}],model:"synthetic/appended-model",provider:"synthetic",usage:{input:31,output:7,totalTokens:38,cost:{total:0.25}},contextSnapshot:{promptTokens:31},stopReason:"stop"}}' >> "$1"
}
append_assistant "$PARENT"
wait_append() {
  local deadline=$((SECONDS + TIMEOUT))
  while ((SECONDS < deadline)); do
    negotiated "$URL?limit=200" -o "$OUT/appended-page.json" || return 1
    if assert_json '.value.items | any(.type == "content" and .body.text == "E2E-APPEND-VISIBLE")' "$OUT/appended-page.json"; then return 0; fi
    sleep 0.1
  done
  return 1
}
check 'append appears on refreshed first page' wait_append
check 'append contributes usage cost and latest model/context' jq -en --slurpfile before "$PAGE" --slurpfile after "$OUT/appended-page.json" '
  ($after[0].value.header.cost.value.usd > $before[0].value.header.cost.value.usd) and
  (($after[0].value.header.cost.value.usd - $before[0].value.header.cost.value.usd - 0.25) | fabs < 0.000001) and
  ($after[0].value.header.model.value == "synthetic/appended-model") and ($after[0].value.header.context.value.tokens == 31)
' >/dev/null
check 'old cursor reads page two after append' negotiated --get "$URL" --data-urlencode "cursor=$CURSOR" --data-urlencode 'limit=200' -o "$OUT/page2.json"
check 'keyset page two has identical ids after append' jq -en --slurpfile before "$OUT/baseline-page2.json" --slurpfile after "$OUT/page2.json" '[$before[0].value.items[].id] == [$after[0].value.items[].id]' >/dev/null
check 'old first plus second page contain no duplicate or skipped ids in that range' jq -en --slurpfile first "$PAGE" --slurpfile baseline "$OUT/baseline-page2.json" --slurpfile second "$OUT/page2.json" '
  ([$first[0].value.items[].id] + [$second[0].value.items[].id]) as $actual |
  ([$first[0].value.items[].id] + [$baseline[0].value.items[].id]) as $expected |
  ($actual | length) == ($actual | unique | length) and ($actual | sort) == ($expected | sort)
' >/dev/null
check 'walk original first page and old keysets after append to exhaustion' walk_history negotiated "$PAGE" "$OUT/post-append" "$OUT/post-append-ids.json"
check 'post-append old-keyset walk has no duplicate or skipped ids across full history' jq -en --slurpfile baseline "$OUT/baseline-ids.json" --slurpfile actual "$OUT/post-append-ids.json" '
  ($actual[0] | length) == ($actual[0] | unique | length) and ($actual[0] | sort) == ($baseline[0] | sort)
' >/dev/null
check 'old content ref still fetches after append' negotiated "$REF_URL" -o "$OUT/chunk-after.json"
check 'old ref returns identical content bytes after append' jq -en --slurpfile before "$OUT/chunk-before.json" --slurpfile after "$OUT/chunk-after.json" '
  $before[0].value as $b | $after[0].value as $a |
  $a.kind == "conversation-content-chunk" and $a.data == $b.data and $a.size == $b.size and $a.ref == $b.ref and $a.size > 8192
' >/dev/null
check 'TypeScript shared renderer runs' bash -c 'node "$1" "$2" > "$3"' _ "$ROOT/scripts/omp-parity-e2e/render.mjs" "$PAGE" "$OUT/ts-rows.txt"
contains_text() { grep -Fq -- "$1" "$2"; }
check 'TypeScript bash row' contains_text '$ ' "$OUT/ts-rows.txt"
check 'TypeScript completed todo' contains_text '[x] Verify parity' "$OUT/ts-rows.txt"
check 'TypeScript pending todo' contains_text '[ ] Check pending work' "$OUT/ts-rows.txt"
check 'TypeScript in-progress todo' contains_text '[~] Exercise progress' "$OUT/ts-rows.txt"
check 'TypeScript blocked todo' contains_text '[!] Await dependency' "$OUT/ts-rows.txt"
check 'TypeScript abandoned todo' contains_text '[/] Discard obsolete approach' "$OUT/ts-rows.txt"
check 'TypeScript child open row' contains_text "open $CHILD" "$OUT/ts-rows.txt"
check 'TypeScript IRC sender and message' grep -Eq 'ParityChild.*Synthetic child message' "$OUT/ts-rows.txt"
check 'TypeScript compact transcript header and completed count' grep -Eq 'model synthetic/model.*context .*cost .*todo 1/5.* · transcript · .* ago$' "$OUT/ts-rows.txt"
for marker in E2E-PARENT-CONTEXT E2E-PARENT-CONTRACT E2E-FULL-ASSIGNMENT E2E-ASSISTANT-ERROR E2E-RETRIED-RECOVERED E2E-RECOVERED-ORIGINAL-ERROR E2E-SENT-BODY E2E-SENT-LAST E2E-WRITE-FIRST E2E-WRITE-LAST E2E-ASK-STRICT-DESCRIPTION E2E-ASK-LOOSE-DESCRIPTION E2E-EVAL-CODE E2E-COMPACTION-FIRST E2E-COMPACTION-LAST; do
  check "TypeScript parity detail $marker" contains_text "$marker" "$OUT/ts-rows.txt"
done
for marker in 'cwd: /synthetic/e2e' 'timeout: 30s' 'case: false' 'hidden: true' 'gitignore: false' 'limit: 10' 'skip: 2' '7 matches / 3 files' 'warning: search results truncated' 'warning: file limit reached (3)' 'warning: per-file limit reached (2)' '1 files' '1. Strict [selected]' 'language: py' 'reset: false' 'ParityChild · running · scout' '[image'; do
  check "TypeScript parity row $marker" contains_text "$marker" "$OUT/ts-rows.txt"
done

# Open the actual saved session through Ctrl+K's direct session-id affordance.
# No host-wide fake OMP process: the fixture remains a historical session.
export ST3_ENDPOINT="$SOCKET" ST3_PERSON='person/omp-e2e'
printf -v UI_COMMAND '%q --local' "$STUI"
check 'start isolated stui terminal' tmux -f /dev/null -S "$TMUX_SOCKET" new-session -d -s omp-e2e -n stui -x 240 -y 100 "$UI_COMMAND"
TMUX_STARTED=1
printf 'INFO monitor: tmux -S %s attach -t omp-e2e\n' "$TMUX_SOCKET" | tee -a "$REPORT"
wait_pane() {
  local expression=$1 destination=$2 deadline=$((SECONDS + TIMEOUT))
  while ((SECONDS < deadline)); do
    tmux -S "$TMUX_SOCKET" capture-pane -p -J -t "$TARGET" > "$destination" || return 1
    if grep -Eq -- "$expression" "$destination"; then return 0; fi
    sleep 0.1
  done
  return 1
}
check 'stui connected and palette ready' wait_pane 'ctrl\+k|ctrl.k|Ctrl.K' "$OUT/stui-start.txt"
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" C-k
check 'stui palette opened' wait_pane 'start|agents|Open|open' "$OUT/stui-palette.txt"
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" -l "$SESSION"
check 'stui offers saved session in palette' wait_pane "${SESSION#session/}" "$OUT/stui-palette.txt"
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" Enter
check 'stui opens saved parent content' wait_pane 'Synthetic assistant response|E2E-APPEND-VISIBLE|E2E-BASH-ROW' "$OUT/stui.txt"
# The header sits above the entries inside the scrolling document: Home shows it,
# End returns to the newest rows. Both captures are the real terminal.
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" Home
check 'stui compact conversation transcript header visible' wait_pane 'model synthetic/appended-model.* · transcript · ' "$OUT/stui-header.txt"
# Shift+O toggles full density; o opens all tool outputs; End follows the showcase.
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" O o End
check 'stui bash command row visible' wait_pane '\$ printf E2E-BASH-ROW' "$OUT/stui.txt"
check 'stui subagent named open row visible' wait_pane 'open ParityChild' "$OUT/stui.txt"
check 'stui source agent name and type visible' contains_text 'ParityChild · running · scout' "$OUT/stui.txt"
check 'stui full assignment visible' contains_text 'E2E-FULL-ASSIGNMENT' "$OUT/stui.txt"
check 'stui parent context visible' contains_text 'E2E-PARENT-CONTEXT' "$OUT/stui.txt"
check 'stui parent contract visible' contains_text 'E2E-PARENT-CONTRACT' "$OUT/stui.txt"
check 'stui bash cwd visible' contains_text 'cwd: /synthetic/e2e' "$OUT/stui.txt"
check 'stui bash timeout visible' contains_text 'timeout: 30s' "$OUT/stui.txt"
# PaneIntent::Open is a left-button mouse hit. The document has no keyboard row
# focus/Enter binding: use the real SGR terminal mouse event on the captured row.
if contains_text "open ParityChild" "$OUT/stui.txt"; then
read -r CLICK_X CLICK_Y < <(node --input-type=module - "$OUT/stui.txt" "ParityChild" <<'JS'
import { readFileSync } from 'node:fs';
const lines = readFileSync(process.argv[2], 'utf8').split('\n');
const row = lines.findIndex(line => line.includes(`open ${process.argv[3]}`));
if (row < 0) throw new Error('Child open row not visible');
console.log(`${[...lines[row].slice(0, lines[row].indexOf('open '))].length + 2} ${row + 1}`);
JS
)
printf -v CLICK '\033[<0;%s;%sM\033[<0;%s;%sm' "$CLICK_X" "$CLICK_Y" "$CLICK_X" "$CLICK_Y"
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" -l "$CLICK"
check 'stui card opens actual child content' wait_pane 'PARITY-CHILD-COMPLETE' "$OUT/stui-child.txt"
tmux -S "$TMUX_SOCKET" send-keys -t "$TARGET" Home
check 'stui child shows its own first assistant content' wait_pane 'PARITY-CHILD-START' "$OUT/stui-child.txt"
check 'stui child excludes parent assistant content' bash -c '! grep -Fq "Synthetic assistant response" "$1"' _ "$OUT/stui-child.txt"
else
  check 'stui card activation unavailable without visible child open row' false
fi

if [[ -n "$CORPUS" ]]; then
  check 'discover private corpus copy' wait_session "$CORPUS_UUID" "$ISO/corpus-id"
  CORPUS_SESSION=$(<"$ISO/corpus-id")
  CORPUS_URL="http://localhost/v1/client/sessions/$(uri "$CORPUS_SESSION")/timeline?limit=200"
  timed_corpus_page() {
    negotiated "$CORPUS_URL" -o "$ISO/corpus-$1.json" -w '%{time_total}\n' > "$ISO/corpus-$1.time"
  }
  check 'fetch private corpus first page' timed_corpus_page before
  append_assistant "$CORPUS_COPY"
  check 'fetch private corpus after append' timed_corpus_page after
  for phase in before after; do
    printf 'INFO corpus %s seconds=%s\n' "$phase" "$(<"$ISO/corpus-$phase.time")" >> "$REPORT"
    # Only known enum/discriminator names and counts; no text, paths, ids, raw data.
    jq -r --arg phase "$phase" '
      [.value.items[].body.blocks[]?] as $blocks |
      "INFO corpus \($phase) entries=\(.value.items | length) blocks=\($blocks | length) unknown=\([$blocks[] | select(.kind == "unknown")] | length)",
      ($blocks | group_by(.kind)[] | .[0].kind as $kind |
        "INFO corpus \($phase) kind=\(if (["text","reasoning","tool_call","tool_output","status","job","irc","image","error","unknown","source_record"] | index($kind)) != null then $kind else "other" end) count=\(length)"),
      ([$blocks[] | select(.view.type != null)] | group_by(.view.type)[] | .[0].view.type as $type |
        "INFO corpus \($phase) view=\(if (["bash","edit","write","read","search","todo","ask","task","hub","eval","generic","irc","job","skill","compaction","model_change","thinking_level","title","session_exit","tool_start"] | index($type)) != null then $type else "other" end) count=\(length)")
    ' "$ISO/corpus-$phase.json" >> "$REPORT"
  done
  check 'walk all corpus negotiated pages to exhaustion (maximum 100)' walk_history negotiated \
    "$ISO/corpus-after.json" "$ISO/corpus-full" "$ISO/corpus-full-ids.json" "${CORPUS_URL%%\?*}" 100 "$ISO/corpus-full-stats.json"
  check 'full corpus walk has unique entry ids' assert_json 'length == (unique | length)' "$ISO/corpus-full-ids.json"
  corpus_has_no_unknown() {
    if assert_json '.unknown_sources | length == 0' "$ISO/corpus-full-stats.json"; then
      return 0
    fi
    jq -r '.unknown_sources | to_entries[] |
      "INFO corpus full unknown source_type=\(.key | @json) count=\(.value)"' "$ISO/corpus-full-stats.json" >> "$REPORT"
    return 1
  }
  check 'full corpus window has zero unknown blocks' corpus_has_no_unknown
  check 'every corpus tool_call has a typed view' assert_json '.tool_calls_without_view == 0' "$ISO/corpus-full-stats.json"
  jq -r '
    "INFO corpus full entries=\(.entries) blocks=\([.kinds[]] | add // 0) unknown=\([.unknown_sources[]] | add // 0) tool_calls_without_view=\(.tool_calls_without_view)",
    (.kinds | to_entries[] | .key as $kind |
      "INFO corpus full kind=\(if (["text","reasoning","tool_call","tool_output","status","job","irc","image","error","unknown","source_record"] | index($kind)) != null then $kind else "other" end) count=\(.value)"),
    (.views | to_entries[] | .key as $type |
      "INFO corpus full view=\(if (["bash","edit","write","read","search","todo","ask","task","hub","eval","generic","irc","job","skill","compaction","model_change","thinking_level","title","session_exit","tool_start"] | index($type)) != null then $type else "other" end) count=\(.value)")
  ' "$ISO/corpus-full-stats.json" >> "$REPORT"
fi
if ((FAILURES)); then
  printf 'FAIL complete OMP parity end-to-end proof (%s failed checks)\n' "$FAILURES" | tee -a "$REPORT" >&2
  exit 1
fi
printf 'PASS complete OMP parity end-to-end proof\n' | tee -a "$REPORT"
