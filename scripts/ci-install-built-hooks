#!/usr/bin/env bash
# Workspace collection builds this matching CI executable before tests start.
set -euo pipefail
if [[ -n "${CI_TEST_HOOKS_BINARY:-}" ]]; then
  test -x "$CI_TEST_HOOKS_BINARY"
  exec "$CI_TEST_HOOKS_BINARY"
fi
target=$(cargo metadata --locked --no-deps --format-version 1 | jq -er .target_directory)
test -x "$target/debug/ci-hooks-install"
"$target/debug/ci-hooks-install"
