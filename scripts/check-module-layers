#!/usr/bin/env python3
"""Check the st3 module graph against .st/module-layers.json, and report what a change affects.

  check-module-layers                  fail on a module cycle outside the allowlist or a stale entry
  check-module-layers --layers         print the computed layer of every module
  check-module-layers --affected PATH  modules whose dependency closure contains the changed paths
  check-module-layers --metric         read a JSON list of changed-path lists on stdin, print the
                                       distribution of affected-set sizes
"""
import argparse
import json
from pathlib import Path
import statistics
import sys
sys.dont_write_bytecode = True
import module_layers as ml


def affected(root, edges, paths):
    modules, other = ml.modules_of_paths(root, paths)
    modules &= set(edges)
    return sorted(ml.reverse_closure(edges, modules)), other


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--layers", action="store_true")
    mode.add_argument("--affected", nargs="+", metavar="PATH")
    mode.add_argument("--metric", action="store_true")
    args = parser.parse_args()
    root = str(args.root)
    modules, edges = ml.production_graph(root)
    if args.layers:
        allowed = ml.load_layers(root)
        depth = ml.layers(ml.without(edges, allowed))
        for level in sorted(set(depth.values())):
            print(f"{level:2}  " + " ".join(sorted(m for m in depth if depth[m] == level)))
        return 0
    if args.affected:
        names, other = affected(root, edges, args.affected)
        print(json.dumps({"modules": names, "size": len(names), "of": len(modules), "other_paths": other}))
        return 0
    if args.metric:
        sizes = sorted(len(affected(root, edges, paths)[0]) for paths in json.load(sys.stdin))
        sizes = [s for s in sizes if s]
        if not sizes:
            print("no change touches a module")
            return 0
        print(json.dumps({"changes": len(sizes), "median": statistics.median(sizes),
                          "p25": sizes[len(sizes) // 4], "p75": sizes[3 * len(sizes) // 4],
                          "at_most_15": sum(s <= 15 for s in sizes), "at_most_30": sum(s <= 30 for s in sizes),
                          "of_modules": len(modules)}))
        return 0
    problems = ml.findings(root)
    for problem in problems:
        print(problem, file=sys.stderr)
    if problems:
        return 1
    print(f"module graph passed: {len(modules)} modules, {len(ml.load_layers(root))} allowed upward pairs")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
