#!/usr/bin/env python3
"""Exercise removal, replacement, API failure and successful queue completion."""
from pathlib import Path
import runpy

root = Path(__file__).resolve().parent.parent
module = runpy.run_path(str(root / "scripts/ci-queue-watch"))
watch, required = module["watch"], module["REQUIRED"]
sha = "a" * 40
ref = "refs/heads/gh-readonly-queue/main/pr-42-" + "b" * 40
pending = (200, {"jobs": [{"name": name, "status": "in_progress"} for name in required]})
finished = (200, {"jobs": [{"name": name, "status": "completed"} for name in required]})
current = (200, {"object": {"sha": sha}})
removed = (404, {})
moved = (200, {"object": {"sha": "c" * 40}})


def check(name, responses, cancel=False):
    replies = iter(responses)
    calls, pauses = [], []

    def api(path, method="GET"):
        calls.append((path, method))
        return next(replies)

    result = watch(api, "example/project", "123", ref, sha, pause=pauses.append)
    posts = [path for path, method in calls if method == "POST"]
    assert bool(posts) == cancel, (name, calls)
    assert all(path == "repos/example/project/actions/runs/123/force-cancel" for path in posts), (name, calls)
    assert "canceled" in result if cancel else "finished" in result, (name, result)
    assert next(replies, None) is None, (name, "unused response")
    print("passed:", name)


check("current group remains active", [pending, current, finished])
check("removed ref cancels only its own run", [pending, removed, pending, removed, (202, {})], True)
check("replaced ref cancels only its own run", [pending, moved, pending, moved, (202, {})], True)
check("completed checks preserve the workflow result even after ref removal", [finished])
check("brief ref disappearance is debounced", [pending, removed, pending, current, pending, removed, finished])
check("transient ref errors reset the confirmation", [pending, removed, pending, (503, {}), pending, removed, finished])
check("permission errors never cancel", [pending, (403, {}), finished])
check("malformed ref response never cancels", [pending, (200, {}), finished])
check("job lookup failures never cancel", [(503, {}), finished])
check("jobs not yet created keep watching", [(200, {"jobs": []}), current, finished])
check("cancellation failure retries", [pending, removed, pending, removed, (503, {}), pending, removed, (202, {})], True)

# Waiting for a producer is not waiting for a runner. API gaps reset continuous evidence.
for producer, labels, gap, expected in [
    ('completed', ['ci1-priority'], False, 1),
    ('in_progress', ['ci1-priority'], False, 0),
    ('completed', ['namespace-profile-linux-x86-64'], False, 0),
    ('completed', ['ci1-priority'], True, 0),
]:
    jobs = (200, {'jobs': [{'name': 'build', 'status': producer},
                          {'name': 'tests', 'status': 'queued', 'runner_id': 0, 'labels': labels}]})
    replies = iter([jobs, current, *([(503, {})] if gap else []), jobs, current, finished])
    times, alerts = iter([0, 300]), []
    def api(_path, method='GET'):
        assert method == 'GET', 'wait alert must never cancel current work'
        return next(replies)
    watch(api, 'example/project', '123', ref, sha, pause=lambda _: None,
          dependencies={'tests': ['build']}, clock=lambda: next(times), alert=alerts.append)
    assert len(alerts) == expected, (producer, labels, gap, alerts)
    assert next(replies, None) is None
print('passed: eligible owned-job five-minute alert, dependency wait and uncertain evidence exclusion')

# Optional alert metadata errors cannot disable current-ref cancellation.
for labels, expected_alerts in [(None, 0), (42, 1)]:
    jobs = (200, {'jobs': [{'name': 'tests', 'status': 'queued', 'runner_id': 0, 'labels': labels}]})
    responses = iter([jobs, current, jobs, removed, jobs, removed, (202, {})])
    alerts, posts = [], []
    def api(path, method='GET'):
        if method == 'POST': posts.append(path)
        return next(responses)
    result = watch(api, 'example/project', '123', ref, sha, pause=lambda _: None,
                   dependencies={'tests': []}, alert=alerts.append)
    assert 'canceled' in result and len(posts) == 1
    assert len(alerts) == expected_alerts and all('observation failed' in a for a in alerts)
    assert next(responses, None) is None

import os
previous = os.environ.pop('QUEUE_DEPENDENCIES', None)
try:
    alerts = []
    assert module['queue_dependencies'](alerts.append) == {} and not alerts
    for value in ('{broken', '[]', '{"tests":null}', '{"tests":[42]}'):
        os.environ['QUEUE_DEPENDENCIES'] = value
        assert module['queue_dependencies'](alerts.append) == {}
    assert len(alerts) == 4 and all('watchdog continues' in a for a in alerts)
    os.environ['QUEUE_DEPENDENCIES'] = '{"tests":["build"]}'
    assert module['queue_dependencies'](alerts.append) == {'tests': ['build']}
finally:
    if previous is None: os.environ.pop('QUEUE_DEPENDENCIES', None)
    else: os.environ['QUEUE_DEPENDENCIES'] = previous
print('passed: absent/config/null-label diagnostics preserve ref-watch cancellation; invalid observation reported')

workflow = (root / ".github/workflows/fleet.yml").read_text()
guard = workflow.split("  namespace-capacity:\n", 1)[1].split("  genie-freshness:\n", 1)[0]
assert "ubuntu-latest" in guard
assert "actions: write" in guard
assert "Cancel superseded merge groups" in guard
assert "actions/checkout" not in guard
assert "github.event.merge_group.head_ref" in guard
assert "github.event.merge_group.head_sha" in guard
print("passed: generated guard uses hosted capacity and event identity without checkout")
runpy.run_path(str(root / "scripts/ci-workflow-concurrency-test"))

import ast, json, re
encoded = re.search(r"QUEUE_DEPENDENCIES: (.+)", guard)[1]
dependencies = json.loads(ast.literal_eval(encoded))
blocks = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", workflow.split("\njobs:\n", 1)[1]))
for name in ('linux-test-build', 'linux-tests', 'linux-tests-shard-2', 'isolation-vm', 'mail-redelivery-canaries'):
    # Job-level `needs` may be one line, a list or a bracketed block, and sits before or after `steps`.
    actual = re.search(r"^    needs:(.*?)(?=^    \S|\Z)", blocks[name], re.M | re.S)
    needs = re.findall(r"[A-Za-z][A-Za-z0-9_-]*", actual[1]) if actual else []
    assert dependencies[name] == needs, (name, dependencies[name], needs)
print('passed: observer uses actual generated stage dependencies')
