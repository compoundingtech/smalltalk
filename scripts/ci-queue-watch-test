#!/usr/bin/env python3
"""Exercise removal, replacement, API failure and successful queue completion."""
from pathlib import Path
import runpy

root = Path(__file__).resolve().parent.parent
module = runpy.run_path(str(root / "scripts/ci-queue-watch"))
watch, required = module["watch"], module["REQUIRED"]
sha = "a" * 40
ref = "refs/heads/gh-readonly-queue/main/pr-42-" + "b" * 40
pending = (200, {"jobs": [{"name": name, "status": "in_progress"} for name in required]})
finished = (200, {"jobs": [{"name": name, "status": "completed"} for name in required]})
current = (200, {"object": {"sha": sha}})
removed = (404, {})
moved = (200, {"object": {"sha": "c" * 40}})


def check(name, responses, cancel=False):
    replies = iter(responses)
    calls, pauses = [], []

    def api(path, method="GET"):
        calls.append((path, method))
        return next(replies)

    result = watch(api, "example/project", "123", ref, sha, pause=pauses.append)
    posts = [path for path, method in calls if method == "POST"]
    assert bool(posts) == cancel, (name, calls)
    assert all(path == "repos/example/project/actions/runs/123/force-cancel" for path in posts), (name, calls)
    assert "canceled" in result if cancel else "finished" in result, (name, result)
    assert next(replies, None) is None, (name, "unused response")
    print("passed:", name)


check("current group remains active", [pending, current, finished])
check("removed ref cancels only its own run", [pending, removed, pending, removed, (202, {})], True)
check("replaced ref cancels only its own run", [pending, moved, pending, moved, (202, {})], True)
check("completed checks preserve the workflow result even after ref removal", [finished])
check("brief ref disappearance is debounced", [pending, removed, pending, current, pending, removed, finished])
check("transient ref errors reset the confirmation", [pending, removed, pending, (503, {}), pending, removed, finished])
check("permission errors never cancel", [pending, (403, {}), finished])
check("malformed ref response never cancels", [pending, (200, {}), finished])
check("job lookup failures never cancel", [(503, {}), finished])
check("jobs not yet created keep watching", [(200, {"jobs": []}), current, finished])
check("cancellation failure retries", [pending, removed, pending, removed, (503, {}), pending, removed, (202, {})], True)

workflow = (root / ".github/workflows/fleet.yml").read_text()
guard = workflow.split("  namespace-capacity:\n", 1)[1].split("  genie-freshness:\n", 1)[0]
assert "ubuntu-latest" in guard
assert "actions: write" in guard
assert "Cancel superseded merge groups" in guard
assert "actions/checkout" not in guard
assert "github.event.merge_group.head_ref" in guard
assert "github.event.merge_group.head_sha" in guard
print("passed: generated guard uses hosted capacity and event identity without checkout")
