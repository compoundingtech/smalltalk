#!/usr/bin/env python3
"""The nextest filterset of a test tier: `fast` (pull requests), `heavy` (merge queue, schedule) or `all`.

  scripts/ci-test-tiers filter fast|heavy|all

HEAVY is the end-to-end modules listed in scripts/ci-test-tiers.json; FAST is defined as the complement of HEAVY, so a test
cannot belong to neither. `all` prints nothing (no extra filter). scripts/ci-nextest ANDs the printed filterset with the
workspace selection; scripts/ci-test-partitions proves that fast and heavy are disjoint and together are the whole selection."""
import json
from pathlib import Path
import re
import sys

NAME = re.compile(r'[A-Za-z0-9_]+')
PATH = Path(__file__).resolve().with_name('ci-test-tiers.json')


def heavy(document):
    if not (isinstance(document, dict) and document.get('version') == 1 and isinstance(document.get('heavy'), list) and document['heavy']):
        raise ValueError('ci-test-tiers.json: version 1 and a nonempty heavy list are required')
    terms = []
    for entry in document['heavy']:
        if not (isinstance(entry, dict) and set(entry) == {'package', 'binary', 'modules'}):
            raise ValueError('ci-test-tiers.json: a heavy entry has exactly package, binary and modules')
        modules = entry['modules']
        names = [entry['package'], entry['binary'], *(modules if isinstance(modules, list) else [None])]
        if not modules or not all(isinstance(name, str) and NAME.fullmatch(name) for name in names):
            raise ValueError('ci-test-tiers.json: package, binary and every module must be plain names, and modules nonempty')
        if len(set(modules)) != len(modules):
            raise ValueError('ci-test-tiers.json: a module is listed twice')
        terms.append(f"(package(={entry['package']}) and binary(={entry['binary']}) and test(/^({'|'.join(sorted(modules))})::/))")
    return ' or '.join(terms)


def tier_filter(tier, document):
    if tier == 'all':
        return ''
    if tier == 'heavy':
        return heavy(document)
    if tier == 'fast':
        return f'not ({heavy(document)})'
    raise ValueError(f'unknown test tier {tier!r}: all, fast or heavy')


def main():
    if len(sys.argv) != 3 or sys.argv[1] != 'filter':
        print(__doc__, file=sys.stderr)
        return 2
    try:
        print(tier_filter(sys.argv[2], json.loads(PATH.read_text())))
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print(f'ci-test-tiers: {error}', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
