#!/usr/bin/env bash
# Client, shared-view and iOS checks over the root workspace's frozen installation
# (`pnpm install --frozen-lockfile`).
set -euo pipefail
cd "$(dirname "$0")/.."

pnpm --filter @smalltalk/st3-client test
pnpm --filter @smalltalk/st3-client typecheck
pnpm --filter @smalltalk/st3-views test
pnpm --filter @smalltalk/st3-views typecheck
pnpm --filter smalltalk-ios-starter exec tsc --noEmit -p .
pnpm --filter smalltalk-ios-starter test
