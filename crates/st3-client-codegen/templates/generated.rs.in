        let header = ResourceHeader::deserialize(Value::Object(fields.clone()))
            .map_err(D::Error::custom)?;
        for name in ["id", "revision", "updated_at", "operational"] {
            fields.remove(name);
        }
        Ok(Self {
            kind,
            header,
            fields,
        })
    }
}

