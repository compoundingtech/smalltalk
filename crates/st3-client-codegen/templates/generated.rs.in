    pub fn header(&self) -> &ResourceHeader {
        match self {
            Self::Attention(v) => &v.header,
            Self::Message(v) => &v.header,
            Self::Launch(v) => &v.header,
            Self::LaunchVariant(v) => &v.header,
            Self::LaunchDecision(v) => &v.header,
