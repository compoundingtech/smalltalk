    pub compactions: u64,
    pub last_compaction_ms: Option<u64>,
    pub last_compaction_trigger: Option<String>,
    pub observed_at_unix_ms: u64,
}
#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
pub struct UsageSummary {
    pub total_tokens: u64,
    pub input_tokens: u64,
    pub output_tokens: u64,
    pub cached_tokens: u64,
    #[serde(default)]
    pub cache_write_tokens: u64,
    pub cost: Option<f64>,
    pub currency: Option<String>,
    pub incarnation_count: usize,
    pub aggregation: String,
    pub context: Option<UsageContext>,
}
#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
pub struct Mission {
    #[serde(flatten)]
    pub header: ResourceHeader,
    #[serde(flatten)]
    pub extra: BTreeMap<String, Value>,
    pub title: String,
    pub state: String,
    pub mission_revision: String,
    #[serde(default)]
    pub runs: Vec<String>,
    #[serde(default)]
    pub run_details: Vec<MissionRunSummary>,
    pub must_act: Option<String>,
    #[serde(default)]
    pub active_runs: Option<usize>,
    #[serde(default)]
    pub total_runs: Option<usize>,
    #[serde(default)]
    pub run_counts: BTreeMap<String, u64>,
    #[serde(default)]
    pub runs_truncated: bool,
    #[serde(default)]
    pub run_generations: BTreeMap<String, String>,
    #[serde(default)]
    pub visualization: Option<Visualization>,
    #[serde(default)]
    pub usage: Option<UsageSummary>,
    /// The resources the current published revision names. An older daemon omits them.
