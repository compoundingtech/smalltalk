#[cfg(test)]
mod native_pattern_tests {
    use super::*;

    #[test]
    fn generic_subject_patterns_follow_the_generated_base_schema() {
        let base_schema:Value=serde_json::from_str(include_str!("../../../docs/st3/client-v0/schemas/client-v0.schema.json")).unwrap();
        let schema=&native_definitions()["ArrangementSubject"];
        assert_eq!(schema,&base_schema["$defs"]["ArrangementSubject"]);
        for reference in ["message/example","future-family/example","pty-extra/example","session-extra/example"] {
            assert!(native_valid(schema,&Value::String(reference.into())),"{reference}");
        }
        for reference in ["pty/example","session/example","message/","message/has whitespace","Message/example"] {
            assert!(!native_valid(schema,&Value::String(reference.into())),"{reference}");
        }
    }

    #[test]
    fn native_reference_extensions_retain_the_registry_validator() {
        let registry_schema=st3_schema::subject_reference_schema(&[]);
        for header in ["NativeClaimHeader","NativeSubjectHeader"] {
            let schema=&native_definitions()[header]["properties"]["ref"];
            assert_eq!(schema,&registry_schema);
            for reference in ["message/example","custom/team/example","pty/example"] {
                assert!(native_valid(schema,&Value::String(reference.into())),"{header}: {reference}");
            }
            for reference in ["custom/team//example","message/has whitespace"] {
                assert!(!native_valid(schema,&Value::String(reference.into())),"{header}: {reference}");
            }
        }
    }

    #[test]
    fn generic_subject_patterns_handle_long_values() {
        let schema=&native_definitions()["ArrangementSubject"];
        let mut reference=format!("future-family/{}","a".repeat(65_536));
        assert!(native_valid(schema,&Value::String(reference.clone())));
        reference.push(' ');
        assert!(!native_valid(schema,&Value::String(reference)));
    }

    #[test]
    fn pathological_backtracking_exhausts_the_budget_and_fails_closed() {
        // Synthetic stress pattern, not a second copy of the registry grammar.
        let pattern=native_pattern("(?i)(a|b|ab)*(?>c)");
        let text="ab".repeat(32_768);
        assert!(matches!(
            pattern.is_match(&text),
            Err(fancy_regex::Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded))
        ));
        assert!(!native_pattern_matches(&pattern,&text));
    }
}
