version 2
mission "st/onboarding" state="ready" {
  goal "You meet the Smalltalk Assistant, watch two agents talk and a small mission run, then tell it what you want to do in Smalltalk and it starts that work."
  assigned-to "agent/st/assistant"
  baseline "the bundled guide is available" {
    document "@GUIDE@"
  }
  baseline "the ready-made missions are available" {
    document "@WEEKLY@"
    document "@SCHEDULE@"
    document "@PULL_REQUEST@"
  }
  constraint "Read @GUIDE@ before you speak. It says how to run each act and which commands to use. Read the configured person, the machine and the doctor results from the graph; do not assume installation facts."
  constraint "In act three, when it fits what they tell you, offer one of these ready-made missions and apply it for them if they say yes. Read one with st documents get REFERENCE --raw. A weekly review of how they work with their agents: @WEEKLY@. Running that review every Monday: @SCHEDULE@. A review of one pull request, which needs read access to its repository: @PULL_REQUEST@. Only the pull request review involves GitHub."
  constraint "Everything you say goes to the person as you, in this conversation. Never send them to Home or to an attention item, never ask them to run st themselves, and never mention steps, checks, gates, verifying or the graph."
  constraint "Never ask for or type a password. Keep demo work inside the demo folder and the graph, with invented names, and publish nothing outside this machine. The person can say skip at any time."
  step "hello" timeout="10m" {
    goal "Within 15 seconds you are greeted, told in one sentence what is about to happen, and told you can say skip at any time."
  }
  step "act-one" timeout="20m" {
    depends-on { step "hello" completed }
    goal "You watch two agents talk: the Assistant starts a second agent beside the conversation, asks it a question, and you see both sides of the exchange before the Assistant says in two sentences what happened."
    gate "the second agent exists" { exists "agent/st/demo" }
  }
  step "act-two" timeout="30m" {
    depends-on { step "act-one" completed }
    goal "You watch a small mission, written by the Assistant for those two agents, run in a split until it is done, without answering any question."
    gate "the demo note exists" {
      // Gates run with a minimal environment and no HOME: the demo folder sits beside this
      // run's workspace, under ~/st/agents.
      exec "[ -s ../st-demo/welcome.md ]"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "1m"
    }
  }
  step "act-three" timeout="2h" {
    depends-on { step "act-two" completed }
    goal "You are asked what you want to accomplish in Smalltalk today, and the Assistant asks follow-ups until it can start a seat or a mission for your project, in a folder you name."
    goal "You leave knowing the Assistant stays here for questions, and that phone pairing, a second machine and GitHub are there when you want them."
  }
}
