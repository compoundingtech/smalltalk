version 2
mission "st/onboarding" state="ready" {
  goal "You meet the Fractal Assistant, watch two agents talk and a small mission run, see how an alert reaches you, then tell it what you want to do in Fractal and it starts that work."
  assigned-to "agent/st/assistant"
  baseline "the bundled guide is available" {
    document "@GUIDE@"
  }
  constraint "Read @GUIDE@ before you speak. It says how to run each act and which commands to use. Read the configured person, the machine and the doctor results from the graph; do not assume installation facts."
  constraint "The harnesses that are installed, selected and ready on this machine: @HARNESSES@."
  constraint "Everything you say goes to the person as you, in this conversation, in short sentences. Write nothing between tool calls that is not addressed to them. Never send them to Home or to an attention item, never ask them to run st themselves, never speak of them in the third person, and never mention steps, checks, gates, verifying or the graph."
  constraint "Never ask for or type a password. Keep demo work inside the work folder and the graph, with invented names, and publish nothing outside this machine. Never list, search or open the home folder, Documents, Desktop or Downloads. The person can say skip at any time."
  step "hello" timeout="10m" {
    goal "Within 15 seconds you are greeted, told in one sentence what is about to happen, and told you can say skip at any time."
  }
  step "act-one" timeout="20m" {
    depends-on { step "hello" completed }
    goal "You watch two agents talk: the Assistant starts a second agent beside the conversation, on the other of your ready harnesses when you have two, asks it a question, and you see both sides of the exchange before the Assistant says in two sentences what happened."
    gate "the second agent exists" { exists "agent/st/demo" }
  }
  step "act-two" timeout="30m" {
    depends-on { step "act-one" completed }
    goal "You watch a small mission, written by the Assistant for those two agents, run in a split until it is done, without answering any question."
    gate "the demo note exists" {
      // Gates run with a minimal environment and no HOME: the demo agent's folder sits beside
      // this run's workspace, inside the work folder.
      exec "[ -s ../st/demo/welcome.md ]"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "1m"
    }
  }
  step "act-three" timeout="2h" {
    depends-on { step "act-two" completed }
    goal "You see a short, true alert from the Assistant appear above the message input, are told in a sentence or two that you can read and dismiss it, and the Assistant waits for that."
    goal "You are asked what you want to accomplish in Fractal today, and the Assistant asks follow-ups until it can start a seat or a mission for your project, in a folder you name or in the work folder."
    goal "You leave knowing the Assistant stays here for questions, and that phone pairing, a second machine and GitHub are there when you want them."
  }
}
