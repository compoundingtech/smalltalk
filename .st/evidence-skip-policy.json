{
  "version": 1,
  "checks": {
    "linux-gate": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "linux-gate",
            "aggregate",
            "genie-freshness",
            "isolation-vm",
            "linux-clippy",
            "linux-fleet-compat",
            "linux-gate",
            "linux-test-build",
            "linux-tests",
            "linux-tests-shard-2",
            "linux-tests-shard-3",
            "linux-tests-shard-4",
            "mail-redelivery-canaries",
            "typescript-client",
            "upgrade-impact"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    },
    "typescript-client": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "sample_one_in": 5,
      "inputs": [
        "apps/fractal-web/package.json",
        "apps/fractal-web/packages/st3-sdk/package.json",
        "apps/ios",
        "clients/typescript",
        "crates/stui/tests/fixtures/quality-hour.json",
        "docs/st3/client-v0/fixtures",
        "fixtures/clients",
        "flake.lock",
        "flake.nix",
        "package.json",
        "packages/fractal-ui/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/ci-typescript-client"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "bash",
            "scripts/ci-typescript-client"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt",
            "job",
            "steps",
            "step_outcomes"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    },
    "isolation-vm": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "isolation-vm",
            "nixos-test-driver",
            "transport-isolation-vm",
            "sekrets-vm"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt",
            "job",
            "steps",
            "step_outcomes"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    },
    "genie-freshness": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "bash",
            "scripts/ci-genie-freshness"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt",
            "job",
            "steps",
            "step_outcomes"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    },
    "mail-redelivery-canaries": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "bash",
            "scripts/ci-linux",
