          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt",
            "stage",
            "job"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    }
  }
}
