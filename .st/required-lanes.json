{
  "version": 1,
  "lanes": {
    "genie-freshness": {
      "argv": [
        "nix",
        "develop",
        ".#genie",
        "-c",
        "bash",
        "scripts/ci-genie-freshness"
      ],
      "definition_paths": [
        ".st",
        "flake.lock",
        "flake.nix",
        "scripts"
      ]
    },
    "typescript-client": {
      "argv": [
        "nix",
        "develop",
        ".#web",
        "-c",
        "bash",
        "-c",
        "pnpm install --frozen-lockfile && bash scripts/ci-typescript-client"
      ],
      "definition_paths": [
        "flake.lock",
        "flake.nix",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/ci-typescript-client"
      ],
      "tree_inputs": [
        "apps/fractal-web/package.json",
        "apps/fractal-web/packages/st3-sdk/package.json",
        "apps/ios",
        "clients/typescript",
        "crates/stui/tests/fixtures/quality-hour.json",
        "docs/st3/client-v0/fixtures",
        "fixtures/clients",
        "flake.lock",
        "flake.nix",
        "package.json",
        "packages/fractal-ui/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/ci-typescript-client"
      ]
    }
  }
}
