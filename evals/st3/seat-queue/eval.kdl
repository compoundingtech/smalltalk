version 2

agent "eval/seat-queue/worker" {
  workspace "${EVAL_ROOT}"
  restart "never"
  harness "claude" {
    model "claude-sonnet-5"
    effort "medium"
    args "--permission-mode" "bypassPermissions"
  }
  env {
    PATH "${EVAL_ROOT}/audit-bin:${PATH}"
    PTY_AUDIT_LOG "${EVAL_ROOT}/pty-audit.log"
  }
}

agent "eval/seat-queue/chief" {
  workspace "${EVAL_ROOT}"
  restart "never"
  command "sleep 3600"
  queue-authority {
    move "eval/seat-queue/worker"
  }
}

mission "eval/seat-queue" state="ready" timeout="20m" {
  goal "One durable seat serves three finite mission runs in the order its queue sets, and an authorized agent reorders it."

  step "exercise-seat-queue" timeout="15m" {
    agentless
    title "Three runs share one seat while an authorized agent reorders them and one waits on a gate"
    exec "seat-queue/controller" {
      host "local"
      workspace "${ST_WORKSPACE}"
      cwd "${ST_WORKSPACE}"
      command "bash ./controller.sh"
      restart "never"
    }
    gate "the queue controller completed its scenario" {
      field "exit_code" "exec/${ST_MISSION_RUN}/seat-queue/controller" is 0
    }
  }

  step "held-out-gates" timeout="4m" {
    agentless
    depends-on { step "exercise-seat-queue" completed }
    gate "the seat claimed work in queue order" {
      exec "bash ./judges/queue-order.sh"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "2m"
    }
    gate "no held claim was preempted" {
      exec "bash ./judges/no-preemption.sh"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "2m"
    }
    gate "no terminal input path participated" {
      exec "bash ./judges/no-terminal-input.sh"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "1m"
    }
  }
}
