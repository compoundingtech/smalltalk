#!/usr/bin/env bash
set -euo pipefail

self="$(readlink -f "$0")"
real=""
IFS=:
for directory in $PATH; do
  candidate="$directory/pty"
  if [ -x "$candidate" ] && [ "$(readlink -f "$candidate")" != "$self" ]; then
    real="$candidate"
    break
  fi
done
unset IFS

if [ -z "$real" ]; then
  printf 'the audit shim could not find the real pty executable\n' >&2
  exit 127
fi

case "${1:-}" in
  send|attach)
    if [ -n "${PTY_AUDIT_LOG:-}" ]; then
      printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" "${ST_AGENT:-unknown}" "$*" >>"$PTY_AUDIT_LOG"
    fi
    ;;
esac

exec "$real" "$@"
