version 2

// Variant of eval.kdl: only the durable seat changes, to Claude claude-sonnet-5.

agent "eval/seat-mission-work/worker" {
  workspace "${EVAL_ROOT}"
  restart "never"
  harness "claude" {
    model "claude-sonnet-5"
    effort "medium"
    args "--permission-mode" "bypassPermissions"
  }
}

mission "eval/seat-mission-work" state="ready" timeout="20m" {
  goal "A first-class durable seat completes ordinary finite mission work."

  step "work" timeout="15m" {
    assigned-to "agent/eval/seat-mission-work/worker"
    goal "Create seat-proof.txt containing exactly the text seat completed work, then report the work complete."
    gate "the durable seat produced the requested artifact" {
      exec "test \"$(cat seat-proof.txt)\" = \"seat completed work\""
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "30s"
    }
  }
}
