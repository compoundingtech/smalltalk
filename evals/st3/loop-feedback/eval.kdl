version 2

mission "eval/loop-feedback" state="ready" timeout="20m" {
  completion { when "all-steps-exhausted" }
  goal "Give the next round the exact immutable result from the prior round."

  loop "improve" timeout="1m" {
    max-rounds 3
    until {
      gate "round two passes" {
        exec "test \"${ST_LOOP_ROUND}\" -eq 2"
        host "local"
        workspace "${ST_WORKSPACE}"
        time-limit "30s"
      }
    }
    round {
      completion { when "all-steps-exhausted" }
      step "inspect-feedback" {
        agentless
        exec "inspect-feedback" {
          host "local"
          workspace "${ST_WORKSPACE}"
          command "bash ./inspect-feedback.sh"
          restart "never"
        }
        gate "the round accepted its feedback context" {
          field "exit_code" "exec/${ST_MISSION_RUN}/inspect-feedback" "is" 0
        }
      }
    }
  }
}
