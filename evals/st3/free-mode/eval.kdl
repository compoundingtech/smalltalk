version 2

mission "eval/free-mode" state="ready" timeout="20m" {
  completion { when "all-steps-exhausted" }
  goal "Let ungranted agents publish, start, and revise missions as themselves."

  agent "planner" {
    workspace "${ST_WORKSPACE}"
    command "sleep 300"
    restart "never"
  }

  step "produce" timeout="2m" {
    assigned-to "agent/${ST_MISSION_RUN}/planner"
    goal "Publish the produced mission through this claimed step."
    produces-mission "eval/free-mode/produced"
  }

  step "verify" timeout="3m" {
    agentless
    exec "free-mode/controller" {
      host "local"
      workspace "${ST_WORKSPACE}"
      command "bash ./controller.sh"
      restart "never"
    }
    gate "the free mode controller passed" {
      field "exit_code" "exec/${ST_MISSION_RUN}/free-mode/controller" is 0
    }
  }

  finally {
    step "cleanup" timeout="1m" {
      agentless
      stop "agent/${ST_MISSION_RUN}/planner"
    }
  }
}
