version 2

mission "eval/codex-compaction-message-delivery" state="ready" timeout="25m" {
  completion { when "all-steps-exhausted" }
  goal "A controlled Codex seat accepts a message during a working turn, survives a manual native /compact, and accepts another message afterward through Small Talk."

  agent "compact.codex" {
    workspace "${ST_WORKSPACE}"
    harness "codex" {
      model "gpt-6-sol"
      effort "medium"
      args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
    }
    restart "never"
  }

  step "message-target" timeout="18m" {
    assigned-to "agent/${ST_MISSION_RUN}/compact.codex"
    title "Process the graph-backed delivery sequence"
    goal "Claim this step, then end your turn and wait at the native harness prompt for the anchor, working-turn steer, and post-compaction Small Talk messages sent by this eval. Do not poll, sleep, or invoke trace wait while waiting: st3 will inject each message. Those messages are instructions within this claimed work. Execute them exactly. After replying to the post-compaction message, complete this step."
  }

  step "exercise-delivery" timeout="20m" {
    agentless
    title "Steer while working, compact, then deliver again"
    exec "codex-compaction-message-delivery/controller" {
      host "local"
      workspace "${ST_WORKSPACE}"
      cwd "${ST_WORKSPACE}"
      command "bash ./controller.sh"
      restart "never"
    }
    gate "the lifecycle controller passed" {
      field "exit_code" "exec/${ST_MISSION_RUN}/codex-compaction-message-delivery/controller" is 0
    }
  }

  step "held-out-gates" timeout="3m" {
    agentless
    depends-on { step "message-target" completed; step "exercise-delivery" completed }
    gate "working, compaction, and post-compaction evidence is complete" {
      exec "bash ./judges/lifecycle.sh"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "2m"
    }
  }

  finally {
    step "cleanup-agent" timeout="2m" {
      agentless
      stop "agent/${ST_MISSION_RUN}/compact.codex"
    }
  }
}
