version 2

mission "eval/cross-harness-message-wake" state="ready" timeout="40m" {
  completion { when "all-steps-exhausted" }
  goal "Codex, Claude, Pi, and OMP wake through durable messages at startup and from exact idle, then reach paired consensus without terminal input."

  agent "wake.codex" {
    workspace "${ST_WORKSPACE}"
    harness "codex" {
      model "gpt-6-sol"
      effort "medium"
      args "--dangerously-bypass-approvals-and-sandbox" "--dangerously-bypass-hook-trust"
    }
    restart "never"
    env {
      PATH "${ST_WORKSPACE}/audit-bin:${PATH}"
      PTY_AUDIT_LOG "${ST_WORKSPACE}/pty-audit.log"
    }
  }

  agent "wake.claude" {
    workspace "${ST_WORKSPACE}"
    under "agent/${ST_MISSION_RUN}/wake.codex" reason="participate in one bounded cross-harness consensus"
    harness "claude" {
      model "opus"
      effort "medium"
      args "--permission-mode" "bypassPermissions"
    }
    restart "never"
    env {
      PATH "${ST_WORKSPACE}/audit-bin:${PATH}"
      PTY_AUDIT_LOG "${ST_WORKSPACE}/pty-audit.log"
    }
  }

  agent "wake.pi" {
    workspace "${ST_WORKSPACE}"
    under "agent/${ST_MISSION_RUN}/wake.codex" reason="prove native Pi message wake"
    harness "pi" {
      model "openai-codex/gpt-5.6-terra"
      effort "medium"
    }
    restart "never"
    env {
      PATH "${ST_WORKSPACE}/audit-bin:${PATH}"
      PTY_AUDIT_LOG "${ST_WORKSPACE}/pty-audit.log"
    }
  }

  agent "wake.omp" {
    workspace "${ST_WORKSPACE}"
    under "agent/${ST_MISSION_RUN}/wake.pi" reason="prove native OMP message wake"
    harness "omp" {
      model "openai-codex/gpt-5.6-terra"
      effort "medium"
    }
    restart "never"
    env {
      PATH "${ST_WORKSPACE}/audit-bin:${PATH}"
      PTY_AUDIT_LOG "${ST_WORKSPACE}/pty-audit.log"
    }
  }

  step "exercise-message-wake" timeout="35m" {
    agentless
    title "All four harnesses complete startup and idle message-only consensus"
    exec "cross-harness-message-wake/controller" {
      host "local"
      workspace "${ST_WORKSPACE}"
      cwd "${ST_WORKSPACE}"
      command "bash ./controller.sh"
      restart "never"
    }
    gate "the controller observed both final reports" {
      field "exit_code" "exec/${ST_MISSION_RUN}/cross-harness-message-wake/controller" is 0
    }
  }

  step "held-out-gates" timeout="4m" {
    agentless
    depends-on { step "exercise-message-wake" completed }
    gate "the canonical conversation proves wake, exchange, and consensus" {
      exec "bash ./judges/coordination.sh"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "3m"
    }
    gate "no terminal input path participated" {
      exec "bash ./judges/no-terminal-input.sh"
      host "local"
      workspace "${ST_WORKSPACE}"
      time-limit "1m"
    }
  }

  finally {
    step "cleanup-agents" timeout="2m" {
      agentless
      stop "agent/${ST_MISSION_RUN}/wake.codex"
      stop "agent/${ST_MISSION_RUN}/wake.claude"
      stop "agent/${ST_MISSION_RUN}/wake.pi"
      stop "agent/${ST_MISSION_RUN}/wake.omp"
    }
  }
}
